</style>

@code {
    private List<ReportePlantillaDto> _plantillas = new();
    private IReadOnlyList<EntidadReportableDto> _entidades = new List<EntidadReportableDto>();
    private bool _editando;
    private bool _trabajando;
    private string _error = "";

    private Guid? _edId;
    private string _nombre = "";
    private string? _descripcion;
    private string? _categoria;
    private bool _mostrarEncabezado = true;
    private string? _codigo;
    private string? _version;
    private string? _subtitulo;
    private List<HojaEdit> _hojas = new();

    private ReporteHojaResultado? _preview;
    private int _previewHoja = -1;

    protected override async Task OnInitializedAsync()
    {
        _entidades = Builder.ListarEntidades();
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        _plantillas = (await Builder.ListarAsync()).ToList();
    }

    private void NuevoReporte()
    {
        _edId = null;
        _nombre = "";
        _descripcion = null;
        _categoria = null;
        _mostrarEncabezado = true;
        _codigo = null;
        _version = null;
        _subtitulo = null;
        _hojas = new() { new HojaEdit { Nombre = "Hoja 1" } };
        _preview = null; _previewHoja = -1;
        _error = "";
        _editando = true;
    }

    private async Task NuevoCenso()
    {
        _error = "";
        _trabajando = true;
        try
        {
            var id = await Builder.CrearCensoAsync();
            await RecargarAsync();
            await EditarAsync(id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task EditarAsync(Guid id)
    {
        var d = await Builder.ObtenerAsync(id);
        if (d is null) { return; }
        _edId = d.Id;
        _nombre = d.Nombre;
        _descripcion = d.Descripcion;
        _categoria = d.Categoria;
        _mostrarEncabezado = d.MostrarEncabezado;
        _codigo = d.Codigo;
        _version = d.Version;
        _subtitulo = d.Subtitulo;
        _hojas = d.Hojas.Select(HojaEdit.Desde).ToList();
        if (_hojas.Count == 0) { _hojas.Add(new HojaEdit { Nombre = "Hoja 1" }); }
        _preview = null; _previewHoja = -1;
        _error = "";
        _editando = true;
    }

    private void Cancelar()
    {
        _editando = false;
        _preview = null; _previewHoja = -1;
    }

    private void AgregarHoja() => _hojas.Add(new HojaEdit { Nombre = $"Hoja {_hojas.Count + 1}" });
    private void QuitarHoja(int idx)
    {
        _hojas.RemoveAt(idx);
        _preview = null; _previewHoja = -1;
    }

    private void CambiarEntidad(HojaEdit hoja, ChangeEventArgs e)
    {
        hoja.EntidadKey = e.Value?.ToString() ?? "";
        hoja.Columnas.Clear();
        hoja.GroupBy.Clear();
        hoja.Agregados.Clear();
        hoja.Filtros.Clear();
        hoja.OrdenRef = "";
        _preview = null; _previewHoja = -1;
    }

    private static void ToggleCol(List<ColSel> lista, string reff)
    {
        var existe = lista.FirstOrDefault(x => x.Ref == reff);
        if (existe is not null) { lista.Remove(existe); }
        else { lista.Add(new ColSel { Ref = reff }); }
    }

    private static string FuncLabel(ReporteAgregadoFunc f) => f switch
    {
        ReporteAgregadoFunc.Count => "Conteo",
        ReporteAgregadoFunc.CountDistinct => "Conteo distinto",
        ReporteAgregadoFunc.Sum => "Suma",
        ReporteAgregadoFunc.Avg => "Promedio",
        ReporteAgregadoFunc.Min => "Minimo",
        ReporteAgregadoFunc.Max => "Maximo",
        ReporteAgregadoFunc.PctTotal => "% del total (indice)",
        _ => f.ToString()
    };

    private string LabelRef(string entidadKey, string reff) =>
        CamposDe(entidadKey).FirstOrDefault(c => c.Ref == reff).Label ?? reff;

    private List<(string Ref, string Label, string Kind)> CamposDe(string entidadKey)
    {
        var ent = _entidades.FirstOrDefault(x => x.Key == entidadKey);
        var res = new List<(string, string, string)>();
        if (ent is null) { return res; }
        foreach (var c in ent.Campos) { res.Add((c.Key, c.Label, c.Kind)); }
        foreach (var r in ent.Relaciones)
        {
            foreach (var c in r.Campos)
            {
                res.Add(($"{r.Key}.{c.Key}", $"{r.Label}: {c.Label}", c.Kind));
            }
        }
        return res;
    }

    private ReporteHojaDef ADef(HojaEdit h)
    {
        var filtros = h.Filtros
            .Where(f => !string.IsNullOrWhiteSpace(f.CampoRef))
            .Select(f => new ReporteFiltroDef(f.CampoRef, f.Op,
                (f.Op is ReporteFiltroOp.IsNull or ReporteFiltroOp.NotNull)
                    ? null
                    : (f.Valor ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList()))
            .ToList();

        var orden = string.IsNullOrWhiteSpace(h.OrdenRef)
            ? new List<ReporteOrdenDef>()
            : new List<ReporteOrdenDef> { new(h.OrdenRef!, h.OrdenDesc) };

        if (h.Modo == "Agregado")
        {
            var groupBy = h.GroupBy.Select(c => new ReporteColumnaDef(c.Ref)).ToList();
            var agg = h.Agregados
                .Select(a => new ReporteAgregadoDef(a.Func, string.IsNullOrWhiteSpace(a.CampoRef) ? null : a.CampoRef,
                    string.IsNullOrWhiteSpace(a.Titulo) ? null : a.Titulo))
                .ToList();
            ReportePivoteDef? pivote =
                h.PivotOn && !string.IsNullOrWhiteSpace(h.PivotFila) && !string.IsNullOrWhiteSpace(h.PivotColumna)
                    ? new ReportePivoteDef(h.PivotFila!, h.PivotColumna!)
                    : null;
            return ReporteHojaDef.Agregado(h.Nombre, h.EntidadKey, groupBy, agg, filtros, orden, pivote: pivote);
        }

        var cols = h.Columnas.Select(c => new ReporteColumnaDef(c.Ref)).ToList();
        return ReporteHojaDef.Detalle(h.Nombre, h.EntidadKey, cols, filtros, orden);
    }

    private async Task PreviewAsync(HojaEdit h)
    {
        _error = "";
        _trabajando = true;
        try
        {
            _preview = await Builder.PreviewAsync(ADef(h), 50);
            _previewHoja = _hojas.IndexOf(h);
        }
        catch (Exception ex) { _error = ex.Message; _preview = null; _previewHoja = -1; }
        finally { _trabajando = false; }
    }

    private async Task GuardarAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_nombre)) { _error = "El reporte necesita un nombre."; return; }
        _trabajando = true;
        try
        {
            var req = new GuardarPlantillaRequest(
                _nombre, _descripcion, _categoria, 0, true,
                _hojas.Select(ADef).ToList(),
                _mostrarEncabezado, _codigo, _version, _subtitulo);
            await Builder.GuardarAsync(_edId, req);
            await RecargarAsync();
            _editando = false;
            _preview = null; _previewHoja = -1;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        _error = "";
        try
        {
            await Builder.EliminarAsync(id);
            await RecargarAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DescargarAsync(Guid id)
    {
        _error = "";
        _trabajando = true;
        try
        {
            var bytes = await Builder.GenerarExcelAsync(id);
            var nombre = _plantillas.FirstOrDefault(p => p.Id == id)?.Nombre ?? "reporte";
            var safe = new string(nombre.Where(c => char.IsLetterOrDigit(c) || c is '-' or '_').ToArray());
            if (string.IsNullOrWhiteSpace(safe)) { safe = "reporte"; }
            await Descargar($"{safe}-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task Descargar(string fileName, string mime, byte[] bytes)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $@"
            (function(){{
                try {{
                    var bin = atob('{base64}');
                    var len = bin.length;
                    var arr = new Uint8Array(len);
                    for (var i = 0; i < len; i++) {{ arr[i] = bin.charCodeAt(i); }}
                    var blob = new Blob([arr], {{ type: '{mime}' }});
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url; a.download = '{fileName}';
                    document.body.appendChild(a); a.click(); a.remove();
                    setTimeout(function(){{ URL.revokeObjectURL(url); }}, 1500);
                }} catch (e) {{ console.error('descarga reporte', e); }}
            }})();");
    }

    // ===== view models del editor =====

    private sealed class HojaEdit
    {
        public string Nombre { get; set; } = "";
        public string EntidadKey { get; set; } = "";
        public string Modo { get; set; } = "Detalle";
        public List<ColSel> Columnas { get; set; } = new();
        public List<ColSel> GroupBy { get; set; } = new();
        public List<AggEdit> Agregados { get; set; } = new();
        public List<FiltroEdit> Filtros { get; set; } = new();
        public string? OrdenRef { get; set; } = "";
        public bool OrdenDesc { get; set; }
        public bool PivotOn { get; set; }
        public string? PivotFila { get; set; } = "";
        public string? PivotColumna { get; set; } = "";

        public static HojaEdit Desde(ReporteHojaDef d)
        {
            var h = new HojaEdit
            {
                Nombre = d.Nombre,
                EntidadKey = d.EntidadKey,
                Modo = d.Modo.ToString(),
                Columnas = d.Columnas.Select(c => new ColSel { Ref = c.CampoRef }).ToList(),
                GroupBy = d.GroupBy.Select(c => new ColSel { Ref = c.CampoRef }).ToList(),
                Agregados = d.Agregados.Select(a => new AggEdit { Func = a.Func, CampoRef = a.CampoRef ?? "", Titulo = a.Titulo ?? "" }).ToList(),
                Filtros = d.Filtros.Select(f => new FiltroEdit { CampoRef = f.CampoRef, Op = f.Op, Valor = f.Valores is null ? "" : string.Join(", ", f.Valores) }).ToList(),
            };
            var o = d.Orden.FirstOrDefault();
            if (o is not null) { h.OrdenRef = o.CampoRef; h.OrdenDesc = o.Desc; }
            if (d.Pivote is not null)
            {
                h.PivotOn = true;
                h.PivotFila = d.Pivote.FilaCampoRef;
                h.PivotColumna = d.Pivote.ColumnaCampoRef;
            }
            return h;
        }
    }

    private sealed class ColSel { public string Ref { get; set; } = ""; }
    private sealed class FiltroEdit { public string CampoRef { get; set; } = ""; public ReporteFiltroOp Op { get; set; } = ReporteFiltroOp.Eq; public string? Valor { get; set; } = ""; }
    private sealed class AggEdit { public ReporteAgregadoFunc Func { get; set; } = ReporteAgregadoFunc.Count; public string CampoRef { get; set; } = ""; public string Titulo { get; set; } = ""; }
}
