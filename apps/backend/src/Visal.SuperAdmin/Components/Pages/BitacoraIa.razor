@page "/revision/bitacora-ia"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Visal.Application.Common
@using Visal.Application.Revision.Bitacora
@using Visal.Application.Tenancy
@inject IBitacoraIaService Svc
@inject ITenantContext Tenant
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Bitacora auditor IA - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Infraestructura &amp; IA</div>
        <h1 class="ase-title">Bitacora del auditor IA</h1>
        <small class="text-muted">
            Cada revision que hizo el agente REVISOR CLINICO IA: que historia reviso, cuantos intentos hubo, que
            recibio, que encontro y como lo justifico. Al abrir una historia se comparan sus intentos: que cambio el
            profesional entre uno y otro, y si el agente repitio o invento hallazgos sobre campos que ya estaban
            corregidos.
        </small>
    </div>
</div>

@if (!_puede)
{
    <div class="ase-alert">No tienes permiso para este modulo. Pide el permiso "Bitacora del auditor IA" a un administrador.</div>
}
else
{
    <div class="az-tabs">
        <button class="az-tab @(_tab == "hc" ? "az-tab-on" : "")" @onclick="@(() => _tab = "hc")">Historias</button>
        <button class="az-tab @(_tab == "prof" ? "az-tab-on" : "")" @onclick="@(() => _tab = "prof")">Por profesional</button>
        @if (_esAdmin)
        {
            <button class="az-tab @(_tab == "api" ? "az-tab-on" : "")" @onclick="AbrirApiAsync">Conexion API</button>
        }
    </div>

    @if (_tab != "api")
    {
        <div class="bia-filtros">
            <div><label>Desde</label><input type="date" class="form-control form-control-sm" @bind="_fDesde" /></div>
            <div><label>Hasta</label><input type="date" class="form-control form-control-sm" @bind="_fHasta" /></div>
            <div>
                <label>Resultado</label>
                <select class="form-select form-select-sm" @bind="_fResultado">
                    <option value="">(todos)</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Rechazado">Rechazado</option>
                    <option value="Neutral">Neutral</option>
                    <option value="Fallida">Fallida (sin respuesta)</option>
                </select>
            </div>
            <div>
                <label>Origen</label>
                <select class="form-select form-select-sm" @bind="_fOrigen">
                    <option value="">(todos)</option>
                    <option value="Cierre">Al cerrar la HC</option>
                    <option value="Revision">Ordenes / revision</option>
                </select>
            </div>
            <div><label>Profesional</label><input class="form-control form-control-sm" @bind="_fProfesional" placeholder="nombre" /></div>
            <div><label>HC o documento</label><input class="form-control form-control-sm" @bind="_fHc" placeholder="HC-033421" /></div>
            <div><label>Formato</label><input class="form-control form-control-sm" @bind="_fFormato" placeholder="codigo o nombre" /></div>
            <div class="bia-chks">
                <label class="az-chk"><input type="checkbox" @bind="_fSoloAlertas" /> Solo con incoherencias</label>
                <label class="az-chk"><input type="checkbox" @bind="_fSoloPulgarAbajo" /> Solo con pulgar abajo</label>
            </div>
            <div class="bia-acc">
                <button class="btn btn-primary btn-sm" @onclick="AplicarAsync" disabled="@_cargando">Aplicar</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarAsync" disabled="@_cargando">Hoy</button>
            </div>
        </div>

        @if (_error is not null) { <div class="ase-alert">@_error</div> }

        @if (_resumen is { } r)
        {
            <div class="bia-kpis">
                <div class="bia-kpi"><div class="l">Corridas</div><div class="v">@r.Corridas.ToString("N0")</div></div>
                <div class="bia-kpi"><div class="l">Historias revisadas</div><div class="v">@r.Historias.ToString("N0")</div></div>
                <div class="bia-kpi ok"><div class="l">Aprobadas</div><div class="v">@r.Aprobadas.ToString("N0")</div></div>
                <div class="bia-kpi bad"><div class="l">Rechazadas</div><div class="v">@r.Rechazadas.ToString("N0")</div></div>
                <div class="bia-kpi"><div class="l">Fallidas</div><div class="v">@r.Fallidas.ToString("N0")</div></div>
                <div class="bia-kpi"><div class="l">HC con varios intentos</div><div class="v">@r.HistoriasConVariosIntentos.ToString("N0")</div></div>
                <div class="bia-kpi warn" title="Historias donde el agente trajo un hallazgo nuevo sobre algo que no cambio (no lo marco antes) o volvio a marcar un campo donde se copio su propia sugerencia">
                    <div class="l">HC con incoherencias</div>
                    <div class="v">@r.HistoriasConAlertas.ToString("N0")@(r.AlertasParciales ? "+" : "")</div>
                </div>
                <div class="bia-kpi"><div class="l">Calificacion</div><div class="v">&#128077; @r.PulgarArriba &nbsp; &#128078; @r.PulgarAbajo</div></div>
                <div class="bia-kpi"><div class="l">Tokens (entrada / salida)</div><div class="v sm">@Miles(r.TokensIn) / @Miles(r.TokensOut)</div></div>
            </div>
        }
    }

    @if (_tab == "hc")
    {
        <div class="ase-card">
            <div class="ase-card-body bia-tablewrap">
                @if (_cargando) { <div class="text-muted">Cargando...</div> }
                else if (_pagina is null || _pagina.Items.Count == 0) { <div class="text-muted">Sin revisiones con estos filtros.</div> }
                else
                {
                    <table class="table table-sm bia-table">
                        <thead>
                            <tr>
                                <th>HC</th><th>Paciente</th><th>Formato</th><th>Profesional</th>
                                <th class="text-center">Intentos</th><th>Ultimo resultado</th>
                                <th>Incoherencias</th><th class="text-center">Calif.</th><th>Ultima corrida</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in _pagina.Items)
                            {
                                <tr class="bia-row @(h.Senales.Total > 0 ? "bia-row-alerta" : "")" @onclick="() => AbrirDetalleAsync(h.HistoriaClinicaId)">
                                    <td class="mono-s">@h.Hc<div class="bia-sub">@h.EstadoHc</div></td>
                                    <td>@h.Paciente<div class="bia-sub">@h.PacienteDocumento</div></td>
                                    <td>@h.FormatoCodigo<div class="bia-sub">@h.Formato</div></td>
                                    <td>@(h.Profesional ?? "-")</td>
                                    <td class="text-center">@h.Corridas@(h.Fallidas > 0 ? $" ({h.Fallidas} fallida{(h.Fallidas == 1 ? "" : "s")})" : "")</td>
                                    <td><span class="bia-res @ClaseRes(h.UltimoResultado)">@(h.UltimoResultado ?? "-")</span> @Pct(h.UltimaConfianza)</td>
                                    <td>
                                        @if (h.Senales.NuevoSinCambio > 0) { <span class="bia-al" title="@BitacoraIaAnalisis.TextoAlerta(BitacoraIaAnalisis.AlertaNuevoSinCambio)">Nuevo sin cambio @h.Senales.NuevoSinCambio</span> }
                                        @if (h.Senales.ContradiceSugerencia > 0) { <span class="bia-al" title="@BitacoraIaAnalisis.TextoAlerta(BitacoraIaAnalisis.AlertaContradiceSugerencia)">Contradice sugerencia @h.Senales.ContradiceSugerencia</span> }
                                        @if (h.Senales.RepiteTrasCorregir > 0) { <span class="bia-al gris" title="@BitacoraIaAnalisis.TextoAlerta(BitacoraIaAnalisis.AlertaRepiteTrasCorregir)">Insiste tras corregir @h.Senales.RepiteTrasCorregir</span> }
                                        @if (h.Senales.Total == 0 && h.Senales.RepiteTrasCorregir == 0) { <span class="text-muted">-</span> }
                                    </td>
                                    <td class="text-center">@(h.PulgarArriba > 0 ? $"\U0001F44D{h.PulgarArriba} " : "")@(h.PulgarAbajo > 0 ? $"\U0001F44E{h.PulgarAbajo}" : "")</td>
                                    <td>@F(h.UltimaEn)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="bia-pag">
                        <span>@_pagina.Total.ToString("N0") historias - pagina @_page de @TotalPaginas</span>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(_page <= 1 || _cargando)" @onclick="() => IrPaginaAsync(_page - 1)">Anterior</button>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@(_page >= TotalPaginas || _cargando)" @onclick="() => IrPaginaAsync(_page + 1)">Siguiente</button>
                    </div>
                }
            </div>
        </div>
    }
    else if (_tab == "prof")
    {
        <div class="ase-card">
            <div class="ase-card-body bia-tablewrap">
                @if (_resumen is null || _resumen.Profesionales.Count == 0) { <div class="text-muted">Sin datos.</div> }
                else
                {
                    <table class="table table-sm bia-table">
                        <thead><tr><th>Profesional</th><th class="text-end">Historias</th><th class="text-end">Corridas</th><th class="text-end">Rechazadas</th><th class="text-end">% rechazo</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in _resumen.Profesionales)
                            {
                                <tr>
                                    <td>@p.Profesional</td>
                                    <td class="text-end">@p.Historias</td>
                                    <td class="text-end">@p.Corridas</td>
                                    <td class="text-end">@p.Rechazadas</td>
                                    <td class="text-end">@(p.Corridas == 0 ? "-" : (100.0 * p.Rechazadas / p.Corridas).ToString("0") + "%")</td>
                                    <td><button class="btn btn-link btn-sm p-0" @onclick="() => FiltrarProfesionalAsync(p.Profesional)">Ver historias</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
    else if (_tab == "api")
    {
        <div class="ase-card">
            <div class="ase-card-body">
                <p class="text-muted" style="font-size:13px">
                    Llave de SOLO LECTURA para consultar la bitacora desde fuera de la aplicacion (por ejemplo, para que
                    un asistente analice las revisiones y proponga mejoras al agente). La API entrega los datos clinicos
                    completos que vio el agente: comparte la llave solo con quien deba analizarlos. Cada consulta queda en
                    la auditoria. Si se filtra, regenerala: la anterior deja de funcionar al instante.
                </p>
                @if (_api is null) { <div class="text-muted">Cargando...</div> }
                else
                {
                    <div class="bia-api">
                        <div><b>Estado:</b> @(!_api.HasKey ? "sin llave" : _api.IsEnabled ? "habilitada" : "deshabilitada")</div>
                        @if (_api.HasKey)
                        {
                            <div><b>Ultimo uso:</b> @(_api.LastUsedAt is { } lu ? F(lu) : "nunca")</div>
                            <div class="bia-key">
                                <code>@(_verLlave ? _api.ApiKey : Enmascarar(_api.ApiKey))</code>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _verLlave = !_verLlave">@(_verLlave ? "Ocultar" : "Mostrar")</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => CopiarAsync(_api.ApiKey)">Copiar</button>
                            </div>
                        }
                        <div class="bia-api-acc">
                            <button class="btn btn-primary btn-sm" @onclick="RegenerarAsync" disabled="@_busy">@(_api.HasKey ? "Regenerar llave" : "Generar llave")</button>
                            @if (_api.HasKey)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleApiAsync" disabled="@_busy">@(_api.IsEnabled ? "Deshabilitar" : "Habilitar")</button>
                            }
                        </div>
                        @if (_copiado) { <div class="text-success" style="font-size:12px">Copiado.</div> }
                    </div>
                    <h6 class="mt-3">Endpoints</h6>
                    <pre class="bia-pre">@EjemploApi()</pre>
                }
            </div>
        </div>
    }
}

@if (_detalle is { } d)
{
    <div class="cie-backdrop" @onclick="CerrarDetalle"></div>
    <div class="cie-modal bia-modal">
        <div class="cie-modal-h">
            <h3>@d.Historia.Hc - @d.Historia.Paciente <small class="text-muted">(@d.Historia.PacienteDocumento)</small></h3>
            <button class="cie-modal-close" @onclick="CerrarDetalle">&times;</button>
        </div>
        <div class="cie-modal-body">
            <div class="bia-hc-info">
                <span><b>Formato:</b> @d.Historia.FormatoCodigo - @d.Historia.Formato</span>
                <span><b>Profesional:</b> @(d.Historia.Profesional ?? "-")</span>
                <span><b>Estado HC:</b> @d.Historia.EstadoHc</span>
                <span><b>Intentos:</b> @d.Historia.Corridas</span>
            </div>

            @foreach (var c in d.Corridas.Reverse())
            {
                var a = d.Analisis.FirstOrDefault(x => x.Id == c.Id);
                <div class="bia-int @(a is { Alertas: > 0 } ? "bia-int-alerta" : "")">
                    <div class="bia-int-h">
                        <span class="bia-num">Intento @(a?.Numero ?? 0)</span>
                        <span>@F(c.En)</span>
                        <span class="bia-tag">@(c.Origen == "Cierre" ? "Al cerrar la HC" : "Ordenes / revision")</span>
                        @if (c.Ok) { <span class="bia-res @ClaseRes(c.Resultado)">@c.Resultado</span> <span>@Pct(c.Confianza)</span> }
                        else { <span class="bia-res fail">Fallida</span> }
                        <span class="bia-sub">por @(c.DisparadoPor ?? "sistema") - @c.Modelo - @Miles(c.TokensIn)/@Miles(c.TokensOut) tokens</span>
                        @if (c.FeedbackUtil == true) { <span title="Le sirvio">&#128077;</span> }
                        @if (c.FeedbackUtil == false) { <span title="No le sirvio">&#128078;</span> }
                    </div>

                    @if (!c.Ok)
                    {
                        <div class="bia-err">@c.Error</div>
                    }
                    else
                    {
                        @if (a is { AnteriorId: not null })
                        {
                            <details class="bia-sec" open="@(a.CamposCambiados.Count > 0 && a.CamposCambiados.Count <= 4)">
                                <summary>Que cambio el profesional desde el intento anterior (@a.CamposCambiados.Count campo@(a.CamposCambiados.Count == 1 ? "" : "s"))</summary>
                                @if (a.CamposCambiados.Count == 0) { <div class="text-muted bia-sm">No cambio ningun campo de la historia.</div> }
                                @foreach (var cc in a.CamposCambiados)
                                {
                                    <div class="bia-diff">
                                        <div class="bia-diff-c">@cc.Campo</div>
                                        <div class="bia-diff-g">
                                            <div class="antes"><span>Antes</span>@(string.IsNullOrWhiteSpace(cc.Antes) ? "(vacio)" : cc.Antes)</div>
                                            <div class="despues"><span>Despues</span>@(string.IsNullOrWhiteSpace(cc.Despues) ? "(vacio)" : cc.Despues)</div>
                                        </div>
                                    </div>
                                }
                                @if (a.SugerenciasAdoptadas.Count > 0)
                                {
                                    <div class="bia-sm mt-1">Copio la sugerencia del agente en: <b>@string.Join(", ", a.SugerenciasAdoptadas)</b></div>
                                }
                            </details>
                        }

                        <div class="bia-sec">
                            <div class="bia-sec-t">Justificacion del agente</div>
                            <div class="bia-nota">@(c.Nota ?? "(sin nota)")</div>
                        </div>

                        @if (a is { Hallazgos.Count: > 0 })
                        {
                            <div class="bia-sec">
                                <div class="bia-sec-t">Hallazgos (@a.Hallazgos.Count)</div>
                                <ul class="bia-hall">
                                    @foreach (var h in a.Hallazgos)
                                    {
                                        var esInsiste = h.Alerta == BitacoraIaAnalisis.AlertaRepiteTrasCorregir;
                                        <li class="@(h.Alerta is null ? "" : esInsiste ? "al-gris" : "al")">
                                            <span class="bia-est @h.Estado.ToLowerInvariant()">@h.Estado</span>
                                            @h.Texto
                                            @if (h.Alerta is not null) { <div class="bia-al-t @(esInsiste ? "gris" : "")">&#9888; @BitacoraIaAnalisis.TextoAlerta(h.Alerta)@(h.CamposMencionados.Count > 0 ? " (" + string.Join(", ", h.CamposMencionados) + ")" : "")</div> }
                                            @if (h.HallazgoAnterior is not null && h.Estado == "Repetido") { <div class="bia-sm text-muted">Antes: @h.HallazgoAnterior</div> }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (c.Observaciones.Count > 0)
                        {
                            <div class="bia-sec">
                                <div class="bia-sec-t">Observaciones (@c.Observaciones.Count) &mdash; no impiden aprobar</div>
                                <ul class="bia-hall res">@foreach (var ob in c.Observaciones) { <li>@ob</li> }</ul>
                            </div>
                        }
                        @if (a is { HallazgosResueltos.Count: > 0 })
                        {
                            <div class="bia-sec">
                                <div class="bia-sec-t">Ya no los menciona (resueltos desde el intento anterior)</div>
                                <ul class="bia-hall res">@foreach (var h in a.HallazgosResueltos) { <li>@h</li> }</ul>
                            </div>
                        }
                        @if (c.Sugerencias.Count > 0)
                        {
                            <details class="bia-sec">
                                <summary>Texto sugerido (@c.Sugerencias.Count)</summary>
                                @foreach (var s in c.Sugerencias)
                                {
                                    <div class="bia-diff"><div class="bia-diff-c">@s.Campo</div><div class="bia-pre-s">@s.TextoSugerido</div></div>
                                }
                            </details>
                        }
                        @if (c.FeedbackComentario is not null)
                        {
                            <div class="bia-sec bia-fb">
                                <div class="bia-sec-t">Comentario del usuario @(c.FeedbackPor is null ? "" : "(" + c.FeedbackPor + ")")</div>
                                @c.FeedbackComentario
                            </div>
                        }
                    }

                    <div class="bia-sec">
                        @if (_completa.TryGetValue(c.Id, out var comp))
                        {
                            <div class="az-tabs">
                                @foreach (var t in TabsCompleta)
                                {
                                    <button class="az-tab @(TabDe(c.Id) == t ? "az-tab-on" : "")" @onclick="() => _tabCompleta[c.Id] = t">@t</button>
                                }
                                <button class="az-tab" @onclick="() => CopiarAsync(TextoCompleta(comp, TabDe(c.Id)))">Copiar</button>
                            </div>
                            <pre class="bia-pre">@(TextoCompleta(comp, TabDe(c.Id)) ?? "(vacio)")</pre>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => CargarCompletaAsync(c.Id)">Ver lo que recibio y respondio</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .bia-filtros { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; margin-bottom: 12px; }
    .bia-filtros label { display: block; font-size: 11px; font-weight: 600; color: #475569; margin-bottom: 2px; }
    .bia-filtros > div { min-width: 130px; }
    .bia-chks { display: flex; flex-direction: column; gap: 2px; }
    .bia-acc { display: flex; gap: 6px; }
    .bia-kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; margin-bottom: 12px; }
    .bia-kpi { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 8px 10px; }
    .bia-kpi .l { font-size: 11px; color: #64748b; font-weight: 600; }
    .bia-kpi .v { font-size: 20px; font-weight: 700; color: #0f172a; }
    .bia-kpi .v.sm { font-size: 14px; }
    .bia-kpi.ok .v { color: #15803d; } .bia-kpi.bad .v { color: #b91c1c; } .bia-kpi.warn .v { color: #b45309; }
    .bia-tablewrap { overflow-x: auto; }
    .bia-table { font-size: 13px; }
    .bia-row { cursor: pointer; } .bia-row:hover { background: #f1f5f9; }
    .bia-row-alerta { background: #fffbeb; }
    .bia-sub { font-size: 11px; color: #64748b; }
    .mono-s { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 600; }
    .bia-res { border-radius: 999px; padding: 1px 8px; font-size: 11px; font-weight: 700; background: #e2e8f0; color: #334155; }
    .bia-res.aprobado { background: #dcfce7; color: #166534; } .bia-res.rechazado { background: #fee2e2; color: #991b1b; }
    .bia-res.neutral { background: #e0e7ff; color: #3730a3; } .bia-res.fail { background: #f1f5f9; color: #64748b; }
    .bia-al { display: inline-block; background: #fef3c7; color: #92400e; border-radius: 6px; padding: 0 6px; font-size: 11px; font-weight: 600; margin: 1px 2px; }
    .bia-al.gris { background: #f1f5f9; color: #475569; }
    .bia-hall li.al-gris { background: #f8fafc; border-radius: 6px; padding: 2px 4px; }
    .bia-al-t.gris { color: #475569; }
    .bia-pag { display: flex; gap: 8px; align-items: center; justify-content: flex-end; font-size: 12px; color: #64748b; }
    .bia-modal { width: 1100px; }
    .bia-hc-info { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; margin-bottom: 12px; }
    .bia-int { border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; margin-bottom: 12px; }
    .bia-int-alerta { border-color: #f59e0b; box-shadow: 0 0 0 1px #fde68a inset; }
    .bia-int-h { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 13px; margin-bottom: 6px; }
    .bia-num { font-weight: 700; }
    .bia-tag { background: #f1f5f9; border-radius: 6px; padding: 0 6px; font-size: 11px; }
    .bia-sec { margin-top: 8px; font-size: 13px; }
    .bia-sec summary { cursor: pointer; font-weight: 600; color: #334155; }
    .bia-sec-t { font-weight: 600; color: #334155; margin-bottom: 2px; }
    .bia-nota { white-space: pre-line; background: #f8fafc; border-radius: 6px; padding: 6px 8px; }
    .bia-hall { margin: 0; padding-left: 18px; } .bia-hall li { margin-bottom: 4px; }
    .bia-hall li.al { background: #fffbeb; border-radius: 6px; padding: 2px 4px; }
    .bia-hall.res li { color: #15803d; }
    .bia-est { border-radius: 4px; padding: 0 5px; font-size: 10px; font-weight: 700; margin-right: 4px; text-transform: uppercase; }
    .bia-est.nuevo { background: #dbeafe; color: #1e40af; } .bia-est.repetido { background: #e2e8f0; color: #334155; } .bia-est.primero { background: #f1f5f9; color: #64748b; }
    .bia-al-t { color: #92400e; font-size: 12px; font-weight: 600; }
