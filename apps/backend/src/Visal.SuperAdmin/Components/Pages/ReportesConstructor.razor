@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _puede;

    private List<ReportePlantillaDto> _plantillas = new();
    private IReadOnlyList<EntidadReportableDto> _entidades = new List<EntidadReportableDto>();
    private bool _editando;
    private bool _trabajando;
    private string _error = "";
    private string _importMsg = "";

    private Guid? _edId;
    private string _nombre = "";
    private string? _descripcion;
    private string? _categoria;
    private bool _mostrarEncabezado = true;
    private string? _codigo;
    private string? _version;
    private string? _subtitulo;
    private List<HojaEdit> _hojas = new();
    private List<ParamEdit> _parametros = new();

    private ReporteHojaResultado? _preview;
    private int _previewHoja = -1;

    // Dialogo de parametros al descargar.
    private bool _runAbierto;
    private Guid _runId;
    private string _runNombre = "";
    private List<RunParam> _runParams = new();
    private List<SedeOpcionDto> _runSedes = new();

    private DotNetObjectReference<ReportesConstructor>? _dnetRef;

    protected override async Task OnInitializedAsync()
    {
        await ResolverPermisoAsync();
        if (!_puede) { return; }
        _entidades = await Builder.ListarEntidadesAsync();
        await RecargarAsync();
    }

    private async Task ResolverPermisoAsync()
    {
        if (AuthState is null) { _puede = false; return; }
        var st = await AuthState;
        var rol = st.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        var tenantRole = st.User.FindFirst("tenant_role")?.Value ?? "";
        var platformRole = st.User.FindFirst("platform_role")?.Value ?? "";
        var esAdmin = string.Equals(tenantRole, "Owner", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(tenantRole, "Admin", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(rol, "Administrador", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(platformRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
        var perms = st.User.FindFirst("perms")?.Value;
        var tienePermiso = !string.IsNullOrEmpty(perms)
            && perms.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Any(p => string.Equals(p.Trim(), "reportes-constructor", StringComparison.OrdinalIgnoreCase));
        _puede = esAdmin || tienePermiso;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _puede)
        {
            _dnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("visalReportesDnd.init", _dnetRef);
        }
    }

    public ValueTask DisposeAsync()
    {
        _dnetRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task RecargarAsync()
    {
        _plantillas = (await Builder.ListarAsync()).ToList();
    }

    private void NuevoReporte()
    {
        _edId = null;
        _nombre = "";
        _descripcion = null;
        _categoria = null;
        _mostrarEncabezado = true;
        _codigo = null;
        _version = null;
        _subtitulo = null;
        _hojas = new() { new HojaEdit { Nombre = "Hoja 1" } };
        _parametros = new();
        _preview = null; _previewHoja = -1;
        _error = "";
        _editando = true;
    }

    private async Task NuevoCenso()
    {
        _error = "";
        _trabajando = true;
        try
        {
            var id = await Builder.CrearCensoAsync();
            await RecargarAsync();
            await EditarAsync(id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task EditarAsync(Guid id)
    {
        var d = await Builder.ObtenerAsync(id);
        if (d is null) { return; }
        _edId = d.Id;
        _nombre = d.Nombre;
        _descripcion = d.Descripcion;
        _categoria = d.Categoria;
        _mostrarEncabezado = d.MostrarEncabezado;
        _codigo = d.Codigo;
        _version = d.Version;
        _subtitulo = d.Subtitulo;
        _hojas = d.Hojas.Select(HojaEdit.Desde).ToList();
        if (_hojas.Count == 0) { _hojas.Add(new HojaEdit { Nombre = "Hoja 1" }); }
        _parametros = (d.Parametros ?? [])
            .Select(p => new ParamEdit { Clave = p.Clave, Etiqueta = p.Etiqueta, Tipo = p.Tipo, Fuente = p.Fuente })
            .ToList();
        _preview = null; _previewHoja = -1;
        _error = "";
        _editando = true;
    }

    private void Cancelar()
    {
        _editando = false;
        _preview = null; _previewHoja = -1;
    }

    private void AgregarHoja() => _hojas.Add(new HojaEdit { Nombre = $"Hoja {_hojas.Count + 1}" });
    private void QuitarHoja(int idx)
    {
        _hojas.RemoveAt(idx);
        _preview = null; _previewHoja = -1;
    }

    private void CambiarEntidad(HojaEdit hoja, ChangeEventArgs e)
    {
        hoja.EntidadKey = e.Value?.ToString() ?? "";
        hoja.Columnas.Clear();
        hoja.GroupBy.Clear();
        hoja.Agregados.Clear();
        hoja.Filtros.Clear();
        hoja.OrdenRef = "";
        _preview = null; _previewHoja = -1;
    }

    private static void ToggleCol(List<ColSel> lista, string reff)
    {
        var existe = lista.FirstOrDefault(x => x.Ref == reff);
        if (existe is not null) { lista.Remove(existe); }
        else { lista.Add(new ColSel { Ref = reff }); }
    }

    // Activa un campo (lo agrega al final del orden) desde el selector "+ Agregar campo".
    private static void AgregarCol(List<ColSel> lista, string? reff)
    {
        if (string.IsNullOrEmpty(reff)) { return; }
        if (lista.Any(x => x.Ref == reff)) { return; }
        lista.Add(new ColSel { Ref = reff });
    }

    // Activa todos los campos de la entidad que falten, respetando el orden del catalogo.
    private void AgregarTodasCols(List<ColSel> lista, string entidadKey)
    {
        foreach (var c in CamposDe(entidadKey))
        {
            if (!lista.Any(x => x.Ref == c.Ref)) { lista.Add(new ColSel { Ref = c.Ref }); }
        }
    }

    // Reordena una columna dentro de la lista (el orden de la lista es el orden de salida).
    private static void MoverCol(List<ColSel> lista, int idx, int delta)
    {
        var destino = idx + delta;
        if (idx < 0 || idx >= lista.Count || destino < 0 || destino >= lista.Count) { return; }
        (lista[idx], lista[destino]) = (lista[destino], lista[idx]);
    }

    // Reordena un item con las flechas (intercambio con el vecino). Generico: sirve para
    // GroupBy (ColSel) y Agregados (AggEdit).
    private static void MoverDelta<T>(List<T> lista, int idx, int delta)
    {
        var destino = idx + delta;
        if (idx < 0 || idx >= lista.Count || destino < 0 || destino >= lista.Count) { return; }
        (lista[idx], lista[destino]) = (lista[destino], lista[idx]);
    }

    // Arrastrar y soltar de las listas ordenables del editor (columnas, agrupar por, agregados).
    // Complementa a las flechas. El DnD vive en JS a nivel document (reportes-dnd.js) porque el
    // DnD nativo no funciona con los @ondragover de Blazor Server; JS devuelve aqui el movimiento.
    // Solo reordena dentro de la misma lista y hoja.
    [JSInvokable]
    public void MoverItemFromJs(int hojaIdx, string kind, int from, int to)
    {
        if (hojaIdx < 0 || hojaIdx >= _hojas.Count) { return; }
        var hoja = _hojas[hojaIdx];
        switch (kind)
        {
            case "col": MoverPorDnd(hoja.Columnas, from, to); break;
            case "grp": MoverPorDnd(hoja.GroupBy, from, to); break;
            case "agg": MoverPorDnd(hoja.Agregados, from, to); break;
            default: return;
        }
        StateHasChanged();
    }

    private static void MoverPorDnd<T>(List<T> lista, int from, int to)
    {
        if (from < 0 || from >= lista.Count || to < 0 || to >= lista.Count || from == to) { return; }
        var item = lista[from];
        lista.RemoveAt(from);
        if (to > from) { to--; } // al remover, el destino por debajo del origen se corre uno
        if (to < 0) { to = 0; }
        if (to > lista.Count) { to = lista.Count; }
        lista.Insert(to, item);
    }

    private static readonly (ReporteColumnaFormato Val, string Label)[] FormatosColumna =
    {
        (ReporteColumnaFormato.Auto, "Automatico"),
        (ReporteColumnaFormato.Texto, "Texto"),
        (ReporteColumnaFormato.Entero, "Numero entero"),
        (ReporteColumnaFormato.Decimal, "Decimal (2)"),
        (ReporteColumnaFormato.Moneda, "Moneda ($)"),
        (ReporteColumnaFormato.Porcentaje, "Porcentaje"),
        (ReporteColumnaFormato.Fecha, "Fecha"),
        (ReporteColumnaFormato.FechaHora, "Fecha y hora"),
    };

    private static string FuncLabel(ReporteAgregadoFunc f) => f switch
    {
        ReporteAgregadoFunc.Count => "Conteo",
        ReporteAgregadoFunc.CountDistinct => "Conteo distinto",
        ReporteAgregadoFunc.Sum => "Suma",
        ReporteAgregadoFunc.Avg => "Promedio",
        ReporteAgregadoFunc.Min => "Minimo",
        ReporteAgregadoFunc.Max => "Maximo",
        ReporteAgregadoFunc.PctTotal => "% del total (indice)",
        _ => f.ToString()
    };

    private string LabelRef(string entidadKey, string reff) =>
        CamposDe(entidadKey).FirstOrDefault(c => c.Ref == reff).Label ?? reff;

    private List<(string Ref, string Label, string Kind)> CamposDe(string entidadKey)
    {
        var ent = _entidades.FirstOrDefault(x => x.Key == entidadKey);
        var res = new List<(string, string, string)>();
        if (ent is null) { return res; }
        foreach (var c in ent.Campos) { res.Add((c.Key, c.Label, c.Kind)); }
        foreach (var r in ent.Relaciones)
        {
            foreach (var c in r.Campos)
            {
                res.Add(($"{r.Key}.{c.Key}", $"{r.Label}: {c.Label}", c.Kind));
            }
        }
        return res;
    }

    private ReporteHojaDef ADef(HojaEdit h)
    {
        var filtros = h.Filtros
            .Where(f => !string.IsNullOrWhiteSpace(f.CampoRef))
            .Select(f => string.IsNullOrWhiteSpace(f.ParamClave)
                ? new ReporteFiltroDef(f.CampoRef, f.Op,
                    (f.Op is ReporteFiltroOp.IsNull or ReporteFiltroOp.NotNull)
                        ? null
                        : (f.Valor ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList())
                : new ReporteFiltroDef(f.CampoRef, f.Op, null, f.ParamClave))
            .ToList();

        var orden = string.IsNullOrWhiteSpace(h.OrdenRef)
            ? new List<ReporteOrdenDef>()
            : new List<ReporteOrdenDef> { new(h.OrdenRef!, h.OrdenDesc) };

        if (h.Modo == "Agregado")
        {
            var groupBy = h.GroupBy.Select(c => new ReporteColumnaDef(c.Ref)).ToList();
            var agg = h.Agregados
                .Select(a => new ReporteAgregadoDef(a.Func, string.IsNullOrWhiteSpace(a.CampoRef) ? null : a.CampoRef,
                    string.IsNullOrWhiteSpace(a.Titulo) ? null : a.Titulo))
                .ToList();
            ReportePivoteDef? pivote =
                h.PivotOn && !string.IsNullOrWhiteSpace(h.PivotFila) && !string.IsNullOrWhiteSpace(h.PivotColumna)
                    ? new ReportePivoteDef(h.PivotFila!, h.PivotColumna!)
                    : null;
            return ReporteHojaDef.Agregado(h.Nombre, h.EntidadKey, groupBy, agg, filtros, orden, pivote: pivote);
        }

        var cols = h.Columnas.Select(c => new ReporteColumnaDef(
            c.Ref,
            string.IsNullOrWhiteSpace(c.Titulo) ? null : c.Titulo.Trim(),
            c.Formato)).ToList();
        return ReporteHojaDef.Detalle(h.Nombre, h.EntidadKey, cols, filtros, orden);
    }

    private async Task PreviewAsync(HojaEdit h)
    {
        _error = "";
        _trabajando = true;
        try
        {
            _preview = await Builder.PreviewAsync(ADef(h), 50);
            _previewHoja = _hojas.IndexOf(h);
        }
        catch (Exception ex) { _error = ex.Message; _preview = null; _previewHoja = -1; }
        finally { _trabajando = false; }
    }

    private async Task GuardarAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_nombre)) { _error = "El reporte necesita un nombre."; return; }
        _trabajando = true;
        try
        {
            var parametros = _parametros
                .Where(p => !string.IsNullOrWhiteSpace(p.Etiqueta))
                .Select(p => new ReporteParametroDef(p.Clave, p.Etiqueta.Trim(), p.Tipo, p.Fuente))
                .ToList();
            var req = new GuardarPlantillaRequest(
                _nombre, _descripcion, _categoria, 0, true,
                _hojas.Select(ADef).ToList(),
                _mostrarEncabezado, _codigo, _version, _subtitulo, parametros);
            await Builder.GuardarAsync(_edId, req);
            await RecargarAsync();
            _editando = false;
            _preview = null; _previewHoja = -1;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        _error = "";
        try
        {
            await Builder.EliminarAsync(id);
            await RecargarAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DescargarAsync(Guid id)
    {
        _error = "";
        _trabajando = true;
        try
        {
            // Si el reporte declara parametros de ejecucion, abre el dialogo para pedirlos;
            // si no, descarga directo.
            var d = await Builder.ObtenerAsync(id);
            var pars = d?.Parametros ?? [];
            if (pars.Count == 0)
            {
                await GenerarYDescargarAsync(id, null);
                return;
            }
            _runId = id;
            _runNombre = d!.Nombre;
            _runParams = pars
                .Select(p => new RunParam { Clave = p.Clave, Etiqueta = p.Etiqueta, Tipo = p.Tipo, Fuente = p.Fuente })
                .ToList();
            _runSedes = pars.Any(p => p.Fuente == ReporteParametroFuente.Sedes)
                ? (await Builder.ListarSedesAsync()).ToList()
                : new();
            _runAbierto = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task ExportarAsync(Guid id)
    {
        _error = "";
        _importMsg = "";
        _trabajando = true;
        try
        {
            var json = await Builder.ExportarAsync(id);
            var nombre = _plantillas.FirstOrDefault(p => p.Id == id)?.Nombre ?? "reporte";
            var safe = new string(nombre.Where(c => char.IsLetterOrDigit(c) || c is '-' or '_').ToArray());
            if (string.IsNullOrWhiteSpace(safe)) { safe = "reporte"; }
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            await Descargar($"{safe}-{DateTime.Now:yyyyMMdd-HHmmss}.json", "application/json", bytes);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task ImportarArchivoAsync(InputFileChangeEventArgs e)
    {
        _error = "";
        _importMsg = "";
        if (e.File is null) { return; }
        _trabajando = true;
        try
        {
            // 1 MB es de sobra para una definicion de plantilla (es solo texto/JSON).
            using var stream = e.File.OpenReadStream(1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var res = await Builder.ImportarAsync(json);
            await RecargarAsync();
            _importMsg = res.Reemplazada
                ? $"Reporte \"{res.Nombre}\" actualizado desde el archivo."
                : $"Reporte \"{res.Nombre}\" importado.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task EjecutarRunAsync()
    {
        _error = "";
        _trabajando = true;
        try
        {
            var dict = new Dictionary<string, IReadOnlyList<string>>();
            foreach (var rp in _runParams)
            {
                var vals = rp.Valores();
                if (vals.Count > 0) { dict[rp.Clave] = vals; }
            }
            _runAbierto = false;
            await GenerarYDescargarAsync(_runId, dict);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task GenerarYDescargarAsync(Guid id, IReadOnlyDictionary<string, IReadOnlyList<string>>? parametros)
    {
        var bytes = await Builder.GenerarExcelAsync(id, parametros);
        var nombre = _plantillas.FirstOrDefault(p => p.Id == id)?.Nombre ?? "reporte";
        var safe = new string(nombre.Where(c => char.IsLetterOrDigit(c) || c is '-' or '_').ToArray());
        if (string.IsNullOrWhiteSpace(safe)) { safe = "reporte"; }
        await Descargar($"{safe}-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
    }

