@page "/reportes/constructor"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.IO
@using Visal.Application.Tenancy.Reportes
@using Microsoft.AspNetCore.Components.Forms
@inject IReporteBuilderService Builder
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Constructor de Reportes - Visal</PageTitle>

@if (!_puede)
{
    <div class="rc-page"><div class="rc-error">No tienes permiso para este modulo. Pide el permiso "Constructor de Reportes" a un administrador.</div></div>
}
else
{
<div class="rc-page">
    <div class="rc-head">
        <div>
            <div class="rc-eyebrow">Reportes multi-hoja</div>
            <h1 class="rc-title">Constructor de Reportes</h1>
            <div class="rc-sub">Arma reportes de varias hojas (tipo CENSO) eligiendo datos, campos y filtros. Sin SQL.</div>
        </div>
        <div class="rc-head-actions">
            <button class="btn-ghost" disabled="@_trabajando" @onclick="NuevoCenso">Plantilla CENSO 2026</button>
            <label class="btn-ghost rc-importbtn">
                Importar JSON
                <InputFile OnChange="ImportarArchivoAsync" accept=".json" disabled="@_trabajando" />
            </label>
            <button class="btn-primary" @onclick="NuevoReporte">+ Crear nuevo reporte</button>
        </div>
    </div>

    @if (!_editando && !string.IsNullOrEmpty(_error))
    {
        <div class="rc-error">@_error</div>
    }

    @if (!_editando && !string.IsNullOrEmpty(_importMsg))
    {
        <div class="rc-ok">@_importMsg</div>
    }

    @if (_plantillas.Count == 0)
    {
        <div class="rc-empty">Aun no hay reportes. Crea el primero con "Crear nuevo reporte".</div>
    }
    else
    {
            <div class="rc-cards">
                @foreach (var p in _plantillas)
                {
                    <div class="rc-card">
                        <div class="rc-card-body">
                            <div class="rc-card-title">@p.Nombre</div>
                            <div class="rc-card-desc">@(string.IsNullOrWhiteSpace(p.Descripcion) ? "(Sin descripcion)" : p.Descripcion)</div>
                            <div class="rc-card-meta">
                                @if (!string.IsNullOrWhiteSpace(p.Categoria)) { <span class="rc-tag">@p.Categoria</span> }
                                <span class="rc-tag rc-tag-soft">@p.Hojas hoja(s)</span>
                            </div>
                        </div>
                        <div class="rc-card-actions">
                            <button class="btn-export" disabled="@_trabajando" @onclick="() => DescargarAsync(p.Id)">Descargar Excel</button>
                            <button class="btn-ghost" disabled="@_trabajando" @onclick="() => ExportarAsync(p.Id)">Exportar JSON</button>
                            <button class="btn-ghost" @onclick="() => EditarAsync(p.Id)">Editar</button>
                            <button class="btn-ghost btn-danger" @onclick="() => EliminarAsync(p.Id)">Eliminar</button>
                        </div>
                    </div>
                }
            </div>
        }

    @if (_editando)
    {
        <div class="rc-modal-backdrop">
            <div class="rc-modal">
                <div class="rc-modal-head">
                    <h2 class="rc-modal-title">@(_edId is null ? "Nuevo reporte" : "Editar reporte")</h2>
                    <button class="rc-modal-x" @onclick="Cancelar" title="Cerrar">&times;</button>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="rc-error">@_error</div>
                }
                <div class="rc-editor">
            <div class="rc-editor-meta">
                <div class="rc-field rc-grow">
                    <label>Nombre del reporte</label>
                    <input type="text" @bind="_nombre" placeholder="Ej: Censo 2026" />
                </div>
                <div class="rc-field">
                    <label>Categoria</label>
                    <input type="text" @bind="_categoria" placeholder="Opcional" />
                </div>
                <div class="rc-field rc-grow">
                    <label>Descripcion</label>
                    <input type="text" @bind="_descripcion" placeholder="Opcional" />
                </div>
            </div>

            <div class="rc-editor-meta rc-encabezado">
                <label class="rc-inline">
                    <input type="checkbox" @bind="_mostrarEncabezado" />
                    Cabecera institucional en el Excel (agencia, titulo, codigo/version, fecha)
                </label>
                @if (_mostrarEncabezado)
                {
                    <div class="rc-field">
                        <label>Codigo</label>
                        <input type="text" @bind="_codigo" placeholder="Ej: PP-FO-200" />
                    </div>
                    <div class="rc-field">
                        <label>Version</label>
                        <input type="text" @bind="_version" placeholder="Ej: 1" />
                    </div>
                    <div class="rc-field rc-grow">
                        <label>Subtitulo / periodo</label>
                        <input type="text" @bind="_subtitulo" placeholder="Ej: Censo 2026 - I Trimestre" />
                    </div>
                }
            </div>

            <div class="rc-params">
                <div class="rc-block-title">Parametros al ejecutar (filtros globales)</div>
                <div class="rc-params-help">
                    Define filtros que se piden al descargar (ej. Fecha, Sede) y enlazalos en los filtros de cada hoja.
                    Al descargar, lo que dejes en blanco no filtra esa hoja.
                </div>
                @foreach (var pa in _parametros)
                {
                    var par = pa;
                    <div class="rc-row rc-param-row">
                        <input type="text" class="rc-param-et" @bind="par.Etiqueta" placeholder="Etiqueta (ej. Fecha, Sede)" />
                        <select @bind="par.Tipo">
                            @foreach (var t in Enum.GetValues<ReporteParametroTipo>())
                            {
                                <option value="@t">@ParamTipoLabel(t)</option>
                            }
                        </select>
                        <select @bind="par.Fuente">
                            @foreach (var fu in Enum.GetValues<ReporteParametroFuente>())
                            {
                                <option value="@fu">@ParamFuenteLabel(fu)</option>
                            }
                        </select>
                        <button class="btn-ghost btn-danger" @onclick="() => _parametros.Remove(par)">x</button>
                    </div>
                }
                <button class="btn-ghost" @onclick="AgregarParametro">+ Parametro</button>
            </div>

            <div class="rc-sheets">
                @for (var hi = 0; hi < _hojas.Count; hi++)
                {
                    var hoja = _hojas[hi];
                    var idx = hi;
                    <div class="rc-sheet">
                        <div class="rc-sheet-head">
                            <div class="rc-field rc-grow">
                                <label>Nombre de la hoja @(idx + 1)</label>
                                <input type="text" @bind="hoja.Nombre" placeholder="Ej: Base de Pacientes Valle" />
                            </div>
                            <div class="rc-field">
                                <label>Conjunto de datos</label>
                                <select value="@hoja.EntidadKey" @onchange="e => CambiarEntidad(hoja, e)">
                                    <option value="">-- Elegir --</option>
                                    @foreach (var ent in _entidades)
                                    {
                                        <option value="@ent.Key">@ent.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="rc-field">
                                <label>Modo</label>
                                <select @bind="hoja.Modo">
                                    <option value="Detalle">Detalle</option>
                                    <option value="Agregado">Agregado</option>
                                </select>
                            </div>
                            <button class="btn-ghost btn-danger rc-sheet-del" @onclick="() => QuitarHoja(idx)">Quitar hoja</button>
                        </div>

                        @if (!string.IsNullOrEmpty(hoja.EntidadKey))
                        {
                            var campos = CamposDe(hoja.EntidadKey);

                            @if (hoja.Modo == "Detalle")
                            {
                                <div class="rc-block">
                                    <div class="rc-block-title">Columnas (activa, ordena y da formato)</div>
                                    <div class="rc-selcols-head">
                                        <select class="rc-addcol" @onchange="e => AgregarCol(hoja.Columnas, e.Value?.ToString())">
                                            <option value="">+ Agregar campo...</option>
                                            @foreach (var c in campos.Where(cc => !hoja.Columnas.Any(x => x.Ref == cc.Ref)))
                                            {
                                                <option value="@c.Ref">@c.Label</option>
                                            }
                                        </select>
                                        <button type="button" class="rc-selcol-btn rc-addbtn" @onclick="() => AgregarTodasCols(hoja.Columnas, hoja.EntidadKey)">Agregar todas</button>
                                        <button type="button" class="rc-selcol-btn rc-addbtn" disabled="@(hoja.Columnas.Count == 0)" @onclick="() => hoja.Columnas.Clear()">Quitar todas</button>
                                    </div>
                                    @if (hoja.Columnas.Count == 0)
                                    {
                                        <div class="rc-hint">Agrega campos para armar las columnas de esta hoja.</div>
                                    }
                                    else
                                    {
                                        <div class="rc-selcols" data-rcsort="col" data-hoja="@hi">
                                            @for (var ci = 0; ci < hoja.Columnas.Count; ci++)
                                            {
                                                var col = hoja.Columnas[ci];
                                                var colIdx = ci;
                                                <div class="rc-selcol" @key="col" data-rcidx="@colIdx">
                                                    <span class="rc-grip" title="Arrastra para reordenar" draggable="true"></span>
                                                    <span class="rc-selcol-pos">@(ci + 1)</span>
                                                    <span class="rc-selcol-name" title="@col.Ref">@LabelRef(hoja.EntidadKey, col.Ref)</span>
                                                    <input class="rc-selcol-title" type="text" @bind="col.Titulo" placeholder="Renombrar (opcional)" />
                                                    <select class="rc-selcol-fmt" @bind="col.Formato">
                                                        @foreach (var f in FormatosColumna)
                                                        {
                                                            <option value="@f.Val">@f.Label</option>
                                                        }
                                                    </select>
                                                    <button class="rc-selcol-btn" title="Subir" disabled="@(colIdx == 0)" @onclick="() => MoverCol(hoja.Columnas, colIdx, -1)">&uarr;</button>
                                                    <button class="rc-selcol-btn" title="Bajar" disabled="@(colIdx == hoja.Columnas.Count - 1)" @onclick="() => MoverCol(hoja.Columnas, colIdx, 1)">&darr;</button>
                                                    <button class="rc-selcol-btn rc-selcol-x" title="Quitar" @onclick="() => ToggleCol(hoja.Columnas, col.Ref)">&times;</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="rc-block">
                                    <div class="rc-block-title">Agrupar por</div>
                                    <div class="rc-chips">
                                        @foreach (var c in campos)
                                        {
                                            var reff = c.Ref;
                                            <label class="rc-chip @(hoja.GroupBy.Any(x => x.Ref == reff) ? "rc-chip-on" : "")">
                                                <input type="checkbox" checked="@hoja.GroupBy.Any(x => x.Ref == reff)"
                                                       @onchange="() => ToggleCol(hoja.GroupBy, reff)" />
                                                @c.Label
                                            </label>
                                        }
                                    </div>
                                    @if (hoja.GroupBy.Count > 0)
                                    {
                                        <div class="rc-hint">Orden de agrupacion (arrastra o usa las flechas):</div>
                                        <div class="rc-selcols" data-rcsort="grp" data-hoja="@hi">
                                            @for (var gi = 0; gi < hoja.GroupBy.Count; gi++)
                                            {
                                                var g = hoja.GroupBy[gi];
                                                var grpIdx = gi;
                                                <div class="rc-selcol" @key="g" data-rcidx="@grpIdx">
                                                    <span class="rc-grip" title="Arrastra para reordenar" draggable="true"></span>
                                                    <span class="rc-selcol-pos">@(gi + 1)</span>
                                                    <span class="rc-selcol-name" title="@g.Ref">@LabelRef(hoja.EntidadKey, g.Ref)</span>
                                                    <button class="rc-selcol-btn" title="Subir" disabled="@(grpIdx == 0)" @onclick="() => MoverDelta(hoja.GroupBy, grpIdx, -1)">&uarr;</button>
                                                    <button class="rc-selcol-btn" title="Bajar" disabled="@(grpIdx == hoja.GroupBy.Count - 1)" @onclick="() => MoverDelta(hoja.GroupBy, grpIdx, 1)">&darr;</button>
                                                    <button class="rc-selcol-btn rc-selcol-x" title="Quitar" @onclick="() => ToggleCol(hoja.GroupBy, g.Ref)">&times;</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="rc-block-title">Agregados</div>
                                    <div class="rc-selcols" data-rcsort="agg" data-hoja="@hi">
                                        @for (var ai = 0; ai < hoja.Agregados.Count; ai++)
                                        {
                                            var agr = hoja.Agregados[ai];
                                            var aggIdx = ai;
                                            <div class="rc-row" @key="agr" data-rcidx="@aggIdx">
                                                <span class="rc-grip" title="Arrastra para reordenar" draggable="true"></span>
                                                <select @bind="agr.Func">
                                                    @foreach (var f in Enum.GetValues<ReporteAgregadoFunc>())
                                                    {
                                                        <option value="@f">@FuncLabel(f)</option>
                                                    }
                                                </select>
                                                <select @bind="agr.CampoRef">
                                                    <option value="">(todas las filas)</option>
                                                    @foreach (var c in campos)
                                                    {
                                                        <option value="@c.Ref">@c.Label</option>
                                                    }
                                                </select>
                                                <input type="text" @bind="agr.Titulo" placeholder="Titulo (ej: Cant Px's)" />
                                                <button class="rc-selcol-btn" title="Subir" disabled="@(aggIdx == 0)" @onclick="() => MoverDelta(hoja.Agregados, aggIdx, -1)">&uarr;</button>
                                                <button class="rc-selcol-btn" title="Bajar" disabled="@(aggIdx == hoja.Agregados.Count - 1)" @onclick="() => MoverDelta(hoja.Agregados, aggIdx, 1)">&darr;</button>
                                                <button class="btn-ghost btn-danger" @onclick="() => hoja.Agregados.Remove(agr)">x</button>
                                            </div>
                                        }
                                    </div>
                                    <button class="btn-ghost" @onclick="() => hoja.Agregados.Add(new AggEdit())">+ Agregado</button>

                                    <div class="rc-pivote">
                                        <label class="rc-inline">
                                            <input type="checkbox" @bind="hoja.PivotOn" />
                                            Pivotear (abrir un campo en columnas, tipo Consolidado Encuesta)
                                        </label>
                                        @if (hoja.PivotOn)
                                        {
                                            <div class="rc-pivote-help">
                                                Requiere <b>exactamente 2</b> campos en "Agrupar por". La celda usa el <b>primer agregado</b>.
                                            </div>
                                            <div class="rc-row">
                                                <span class="rc-inline">Filas:</span>
                                                <select @bind="hoja.PivotFila">
                                                    <option value="">-- Campo --</option>
                                                    @foreach (var g in hoja.GroupBy)
                                                    {
                                                        <option value="@g.Ref">@LabelRef(hoja.EntidadKey, g.Ref)</option>
                                                    }
                                                </select>
                                                <span class="rc-inline">Columnas:</span>
                                                <select @bind="hoja.PivotColumna">
                                                    <option value="">-- Campo --</option>
                                                    @foreach (var g in hoja.GroupBy)
                                                    {
                                                        <option value="@g.Ref">@LabelRef(hoja.EntidadKey, g.Ref)</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="rc-block">
                                <div class="rc-block-title">Filtros</div>
                                @foreach (var fi in hoja.Filtros)
                                {
                                    var fil = fi;
                                    <div class="rc-row">
                                        <select @bind="fil.CampoRef">
                                            <option value="">-- Campo --</option>
                                            @foreach (var c in campos)
                                            {
                                                <option value="@c.Ref">@c.Label</option>
                                            }
                                        </select>
                                        <select @bind="fil.Op">
                                            @foreach (var op in Enum.GetValues<ReporteFiltroOp>())
                                            {
                                                <option value="@op">@op</option>
                                            }
                                        </select>
                                        @if (_parametros.Count > 0)
                                        {
                                            <select @bind="fil.ParamClave" title="Valor fijo o parametro al ejecutar">
                                                <option value="">(valor fijo)</option>
                                                @foreach (var pa in _parametros)
                                                {
                                                    <option value="@pa.Clave">@(string.IsNullOrWhiteSpace(pa.Etiqueta) ? pa.Clave : pa.Etiqueta)</option>
                                                }
                                            </select>
                                        }
                                        @if (string.IsNullOrWhiteSpace(fil.ParamClave))
                                        {
                                            <input type="text" @bind="fil.Valor" placeholder="Valor (coma para varios)" />
                                        }
                                        else
                                        {
                                            <span class="rc-param-pill">se pide al ejecutar</span>
                                        }
                                        <button class="btn-ghost btn-danger" @onclick="() => hoja.Filtros.Remove(fil)">x</button>
                                    </div>
                                }
                                <button class="btn-ghost" @onclick="() => hoja.Filtros.Add(new FiltroEdit())">+ Filtro</button>
                            </div>

                            <div class="rc-block rc-order">
                                <div class="rc-block-title">Orden</div>
                                <div class="rc-row">
                                    <select @bind="hoja.OrdenRef">
                                        <option value="">(sin orden)</option>
                                        @foreach (var c in campos)
                                        {
                                            <option value="@c.Ref">@c.Label</option>
                                        }
                                        @foreach (var ag in hoja.Agregados.Where(a => !string.IsNullOrWhiteSpace(a.Titulo)))
                                        {
                                            <option value="@ag.Titulo">@ag.Titulo (agregado)</option>
                                        }
                                    </select>
                                    <label class="rc-inline"><input type="checkbox" @bind="hoja.OrdenDesc" /> Descendente</label>
                                </div>
                            </div>

                            <div class="rc-sheet-foot">
                                <button class="btn-ghost" disabled="@_trabajando" @onclick="() => PreviewAsync(hoja)">Vista previa</button>
                                @if (_preview is not null && _previewHoja == idx)
                                {
                                    <span class="rc-preview-meta">@_preview.TotalFilas fila(s)</span>
                                }
                            </div>

                            @if (_preview is not null && _previewHoja == idx)
                            {
                                <div class="rc-preview">
                                    <table class="rc-table">
                                        <thead><tr>@foreach (var col in _preview.Columnas) { <th>@col</th> }</tr></thead>
                                        <tbody>
                                            @foreach (var row in _preview.Filas)
                                            {
                                                <tr>
                                                    @for (var i = 0; i < _preview.Columnas.Count; i++)
                                                    {
                                                        <td>@(i < row.Count ? row[i]?.ToString() : "")</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                }
                <button class="btn-dashed" @onclick="AgregarHoja">+ Agregar hoja</button>
            </div>

            <div class="rc-editor-foot">
                <button class="btn-primary" disabled="@_trabajando" @onclick="GuardarAsync">Guardar reporte</button>
                <button class="btn-ghost" @onclick="Cancelar">Cancelar</button>
            </div>
                </div>
            </div>
        </div>
    }

    @if (_runAbierto)
    {
        <div class="rc-modal-backdrop">
            <div class="rc-modal rc-modal-sm">
                <div class="rc-modal-head">
                    <h2 class="rc-modal-title">Filtros para: @_runNombre</h2>
                    <button class="rc-modal-x" @onclick="() => _runAbierto = false" title="Cerrar">&times;</button>
                </div>
                <div class="rc-editor">
                    <div class="rc-params-help">Deja en blanco lo que no quieras filtrar.</div>
                    @foreach (var rp in _runParams)
                    {
                        var par = rp;
                        <div class="rc-field rc-grow">
                            <label>@(string.IsNullOrWhiteSpace(par.Etiqueta) ? par.Clave : par.Etiqueta)</label>
                            @if (par.Tipo == ReporteParametroTipo.RangoFecha)
                            {
                                <div class="rc-row rc-run-rango">
                                    <input type="date" value="@par.Valor1" @onchange="e => par.Valor1 = e.Value?.ToString()" />
                                    <span>a</span>
                                    <input type="date" value="@par.Valor2" @onchange="e => par.Valor2 = e.Value?.ToString()" />
                                </div>
                            }
                            else if (par.Fuente == ReporteParametroFuente.Sedes)
                            {
                                <select @bind="par.Valor1">
                                    <option value="">(todas)</option>
                                    @foreach (var s in _runSedes)
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                </select>
                            }
                            else if (par.Tipo == ReporteParametroTipo.Fecha)
                            {
                                <input type="date" value="@par.Valor1" @onchange="e => par.Valor1 = e.Value?.ToString()" />
                            }
                            else if (par.Tipo == ReporteParametroTipo.FechaHora)
                            {
                                <input type="datetime-local" value="@par.Valor1" @onchange="e => par.Valor1 = e.Value?.ToString()" />
                            }
                            else if (par.Tipo == ReporteParametroTipo.Numero)
                            {
                                <input type="number" @bind="par.Valor1" />
                            }
                            else
                            {
                                <input type="text" @bind="par.Valor1"
                                       placeholder="@(par.Tipo == ReporteParametroTipo.Lista ? "Coma para varios" : "")" />
                            }
                        </div>
                    }
                </div>
                <div class="rc-editor-foot">
                    <button class="btn-primary" disabled="@_trabajando" @onclick="EjecutarRunAsync">Descargar Excel</button>
                    <button class="btn-ghost" @onclick="() => _runAbierto = false">Cancelar</button>
                </div>
            </div>
        </div>
    }
</div>
}

<style>
.rc-page { padding: 1rem 1.25rem; }
.rc-head { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap; margin-bottom:1rem; }
.rc-head-actions { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
.rc-eyebrow { color:#64748b; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; }
.rc-title { margin:.15rem 0 0; font-size:1.55rem; color:#0f172a; }
.rc-sub { color:#64748b; font-size:.85rem; margin-top:.2rem; max-width:640px; }
.rc-error { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; padding:.6rem .85rem; border-radius:6px; margin-bottom:.75rem; }
.rc-ok { background:#f0fdf4; border:1px solid #bbf7d0; color:#15803d; padding:.6rem .85rem; border-radius:6px; margin-bottom:.75rem; }
.rc-empty { padding:2rem; text-align:center; color:#94a3b8; }

.rc-cards { display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap:.85rem; }
.rc-card { display:flex; flex-direction:column; justify-content:space-between; background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:.9rem 1rem; }
.rc-card-title { font-weight:600; color:#0f172a; }
.rc-card-desc { color:#64748b; font-size:.82rem; margin:.2rem 0 .4rem; }
.rc-card-meta { display:flex; gap:.35rem; flex-wrap:wrap; margin-bottom:.6rem; }
.rc-tag { background:#eff6ff; color:#1e3a8a; font-size:.7rem; padding:.1rem .5rem; border-radius:99px; }
.rc-tag-soft { background:#f1f5f9; color:#475569; }
.rc-card-actions { display:flex; gap:.4rem; flex-wrap:wrap; }

.rc-editor { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:1rem 1.15rem; }

.rc-modal-backdrop { position:fixed; inset:0; background:rgba(15,23,42,.45); display:flex; align-items:flex-start; justify-content:center; padding:2.5vh 1rem; z-index:1000; overflow:auto; }
