@page "/verificar-orden/{Codigo}"
@attribute [AllowAnonymous]
@layout Visal.SuperAdmin.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Caching.Memory
@using Visal.Application.Tenancy
@inject IOrdenMedicamentoPublicaService PubSvc
@inject IMemoryCache Cache

@*
   Pagina PUBLICA (sin autenticacion) de verificacion de una orden de
   medicamentos. Se llega escaneando el QR o tipeando el codigo. Muestra solo
   datos seguros: iniciales del paciente, items prescritos, profesional y
   registro medico. Nunca documento completo, direccion ni telefono.
   Render estatico (SSR) — no necesita interactividad. Rate limit por IP.
*@

<PageTitle>Verificacion de orden - Visal</PageTitle>

<style>
    .vo-wrap { min-height: 100vh; background: #f1f5f9; color: #0f172a; font-family: 'Segoe UI', Arial, sans-serif; padding: 24px 12px; }
    .vo-card { max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 8px 30px rgba(15,23,42,.08); overflow: hidden; }
    .vo-head { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #eef2f7; }
    .vo-head img { max-height: 44px; max-width: 150px; object-fit: contain; }
    .vo-head .vo-inst { font-weight: 800; color: #1565c0; font-size: 16px; }
    .vo-body { padding: 20px; }
    .vo-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; font-weight: 700; font-size: 13px; }
    .vo-ok { background: #dcfce7; color: #166534; }
    .vo-bad { background: #fee2e2; color: #991b1b; }
    .vo-warn { background: #fef9c3; color: #854d0e; }
    .vo-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; letter-spacing: 2px; font-size: 18px; margin-top: 10px; }
    .vo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; margin: 16px 0; }
    .vo-grid .k { font-size: 11px; text-transform: uppercase; color: #64748b; letter-spacing: .04em; }
    .vo-grid .v { font-size: 14px; font-weight: 600; }
    .vo-items { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; }
    .vo-items th { text-align: left; background: #f8fafc; border-bottom: 2px solid #e2e8f0; padding: 6px 8px; font-size: 11px; text-transform: uppercase; color: #475569; }
    .vo-items td { border-bottom: 1px solid #f1f5f9; padding: 6px 8px; vertical-align: top; }
    .vo-foot { padding: 12px 20px; border-top: 1px solid #eef2f7; font-size: 11px; color: #94a3b8; text-align: center; }
    .vo-h { font-size: 13px; text-transform: uppercase; color: #475569; letter-spacing: .04em; margin: 18px 0 4px; font-weight: 700; }
</style>

<div class="vo-wrap">
    <div class="vo-card">
        @if (_rateLimited)
        {
            <div class="vo-body">
                <span class="vo-badge vo-warn">Demasiadas solicitudes</span>
                <p style="margin-top:14px;color:#475569;">Has consultado demasiadas veces en poco tiempo. Intenta de nuevo en un minuto.</p>
            </div>
        }
        else if (_dto is null)
        {
            <div class="vo-head"><span class="vo-inst">Verificacion de orden</span></div>
            <div class="vo-body">
                <span class="vo-badge vo-bad">Orden no encontrada</span>
                <p style="margin-top:14px;color:#475569;">
                    No existe una orden con el codigo <b>@Codigo</b>. Verifica que lo hayas
                    escrito correctamente (sin espacios) o escanea de nuevo el QR.
                </p>
            </div>
        }
        else
        {
            <div class="vo-head">
                @if (!string.IsNullOrWhiteSpace(_dto.TenantLogoUrl))
                {
                    <img src="@_dto.TenantLogoUrl" alt="logo" />
                }
                <span class="vo-inst">@(_dto.TenantNombre ?? "Visal")</span>
            </div>
            <div class="vo-body">
                @if (_dto.Revocada)
                {
                    <span class="vo-badge vo-bad">Orden revocada - no valida</span>
                    <p style="margin-top:10px;color:#475569;">Esta orden fue revocada por la institucion y no debe considerarse vigente.</p>
                }
                else
                {
                    <span class="vo-badge vo-ok">&#10003; Orden verificada</span>
                }
                <div class="vo-code">@_dto.Codigo</div>

                <div class="vo-grid">
                    <div><div class="k">Fecha de emision</div><div class="v">@_dto.FechaEmision.LocalDateTime.ToString("dd/MM/yyyy")</div></div>
                    <div><div class="k">Paciente</div><div class="v">@_dto.PacienteIniciales</div></div>
                    <div><div class="k">Profesional</div><div class="v">@(_dto.ProfesionalNombre ?? "-")</div></div>
                    <div><div class="k">Registro medico</div><div class="v">@(_dto.ProfesionalRegistro ?? "-")</div></div>
                </div>

                <div class="vo-h">Medicamentos prescritos</div>
                <table class="vo-items">
                    <thead>
                        <tr><th style="width:26px">#</th><th>Medicamento</th><th>Posologia</th></tr>
                    </thead>
                    <tbody>
                        @if (_dto.Items.Count == 0)
                        {
                            <tr><td colspan="3" style="text-align:center;color:#94a3b8;padding:12px;">Sin items.</td></tr>
                        }
                        else
                        {
                            var n = 0;
                            @foreach (var it in _dto.Items)
                            {
                                n++;
                                <tr>
                                    <td>@n</td>
                                    <td><b>@it.Nombre</b>@(string.IsNullOrWhiteSpace(it.Codigo) ? "" : $" ({it.Codigo})")</td>
                                    <td>@(string.IsNullOrWhiteSpace(it.Posologia) ? "-" : it.Posologia)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="vo-foot">Verificacion emitida por @(_dto.TenantNombre ?? "la institucion") &middot; Documento de circulacion controlada</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Codigo { get; set; } = "";
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private OrdenVerificacionPublicaDto? _dto;
    private bool _rateLimited;

    protected override async Task OnInitializedAsync()
    {
        // Rate limit por IP: max 10 consultas por minuto (ventana fija en memoria).
        // Evita enumeracion por fuerza bruta del codigo (12 chars alfanumericos).
        var ip = ResolverIp();
        var ventana = DateTimeOffset.UtcNow.Ticks / TimeSpan.FromMinutes(1).Ticks;
        var rlKey = $"verord-rl:{ip}:{ventana}";
        var count = Cache.TryGetValue(rlKey, out int c) ? c : 0;
        if (count >= 10)
        {
            _rateLimited = true;
            return;
        }
        Cache.Set(rlKey, count + 1, TimeSpan.FromMinutes(2));

        var ua = HttpContext?.Request.Headers.UserAgent.ToString();
        _dto = await PubSvc.VerificarPorCodigoAsync(Codigo, ip, ua);
    }

    private string ResolverIp()
    {
        if (HttpContext is null) { return "unknown"; }
        var fwd = HttpContext.Request.Headers["X-Forwarded-For"].ToString();
        if (!string.IsNullOrWhiteSpace(fwd)) { return fwd.Split(',')[0].Trim(); }
        return HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
    }
}
