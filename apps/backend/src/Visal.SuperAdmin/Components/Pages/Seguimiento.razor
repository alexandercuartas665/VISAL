@code {
    private static readonly (int idx, string texto)[] Preguntas = new[]
    {
        (1, "El profesional se presento oportunamente"),
        (2, "Buena presentacion personal del profesional"),
        (3, "Amable y respetuoso durante la atencion"),
        (4, "Como calificaria su experiencia global con VISAL RT S.A.S"),
        (5, "Recomendaria a VISAL RT S.A.S a un familiar o amigo")
    };

    private sealed class EditForm
    {
        public DateTime? FechaLlamada { get; set; }
        public int? Pregunta1 { get; set; }
        public int? Pregunta2 { get; set; }
        public int? Pregunta3 { get; set; }
        public int? Pregunta4 { get; set; }
        public int? Pregunta5 { get; set; }
        public string? PersonaAtiende { get; set; }
        public string? Observaciones { get; set; }
    }

    private DateOnly _desde = DateOnly.FromDateTime(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1));
    private DateOnly _hasta = DateOnly.FromDateTime(DateTime.Now);
    private int _desdeMes => _desde.Year * 100 + _desde.Month;
    private int _hastaMes => _hasta.Year * 100 + _hasta.Month;
    private bool _traerBusy;
    private string? _traerMsg;
    private bool _loading = true;
    private List<SeguimientoEncuestaDto> _items = new();
    private Guid? _openId;
    private EditForm _edit = new();
    private string _msg = string.Empty;
    private string _actorNombre = string.Empty;

    // Tabs: "kanban" | "historial"
    private string _tab = "kanban";

    // Filtro dias hacia atras en columna Realizada. 0 = todas.
    private int _diasRealizada = 7;

    // Drag & drop entre columnas.
    private Guid? _dragId;
    private string? _dragOverCol;

    // Historial (todas las realizadas del tenant).
    private bool _histLoading = false;
    private List<SeguimientoEncuestaDto> _historial = new();
    private string _histFiltro = string.Empty;
    private bool _histCargado = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _actorNombre = auth.User?.Identity?.Name ?? string.Empty;
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _items = (await SegSvc.ListarPorRangoAsync(_desdeMes, _hastaMes)).ToList();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task TraerAsync()
    {
        _traerBusy = true; _traerMsg = null; StateHasChanged();
        try
        {
            var (creados, existentes) = await SegSvc.TraerPacientesAsync(_desde, _hasta, await Actor());
            _traerMsg = $"Traidos: {creados} nuevo(s) a la bandeja, {existentes} ya estaban.";
            await RecargarAsync();
        }
        catch (Exception ex) { _traerMsg = "Error al traer: " + ex.Message; }
        finally { _traerBusy = false; StateHasChanged(); }
    }

    private bool _vozBusy;
    private string? _vozMsg;

    private async Task<Guid> Actor()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        return Guid.TryParse(auth.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task LlamarPendientes(bool dryRun)
    {
        if (!dryRun)
        {
            var ok = await JS.InvokeAsync<bool>("confirm",
                $"Esto hara LLAMADAS TELEFONICAS REALES con IA a todos los pacientes PENDIENTES en la bandeja ({_desde:dd/MM/yyyy} a {_hasta:dd/MM/yyyy}) que tengan telefono. Cada llamada tiene costo. Continuar?");
            if (!ok) { return; }
        }
        _vozBusy = true; _vozMsg = null; StateHasChanged();
        try
        {
            var r = await VozSvc.LlamarPendientesAsync(_desdeMes, _hastaMes, dryRun, await Actor());
            _vozMsg = dryRun
                ? $"Simulacion: {r.Lanzadas} se llamarian, {r.Omitidas} omitidas (sin telefono o ya en curso)."
                : $"Listo: {r.Lanzadas} llamada(s) lanzada(s), {r.Omitidas} omitidas, {r.Errores} con error.";
            if (r.Mensajes.Count > 0) { _vozMsg += " | " + string.Join(" · ", r.Mensajes.Take(5)); }
            if (!dryRun) { await RecargarAsync(); }
        }
        catch (Exception ex) { _vozMsg = "Error: " + ex.Message; }
        finally { _vozBusy = false; StateHasChanged(); }
    }

    private int Count(string estado) => _items.Count(x => x.Estado == estado);

    private RenderFragment RenderColumna(string estado, string titulo, string colClass) => __b =>
    {
        var filas = _items.Where(x => x.Estado == estado).ToList();
