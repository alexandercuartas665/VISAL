@using System.Text
@using System.Text.Json
@using Visal.Application.Tenancy.Forms
@inject Visal.Application.Common.IQrCodeGenerator Qr
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject NavigationManager Nav

@*
    DocumentoImprimible — renderer compartido tipo "documento imprimible"
    para HCs y ordenes. Antes cada pagina de impresion (ImprimirPaquete,
    ImprimirHcsPaciente, ImprimirOrdenesFiltradas) tenia su propio renderer:
    - ImprimirPaquete usaba clases .pack-* (documento denso)
    - Las otras dos usaban <FormViewer ReadOnly> (formulario editable con
      textareas de altura fija, que en impresion se cortaban)

    Este componente centraliza el renderer .pack-* para que todas las vistas
    de impresion produzcan el mismo look-and-feel de documento (tabla con
    celdas expandibles, sin scrollbars) y respeten VisibleWhen + HideIfEmpty.

    Parametros:
      Schema           — FormSchema del formato (obligatorio)
      Values           — Diccionario name -> valor
      PacienteNombre   — Para la meta del header
      PacienteTipoDoc  — CC/TI/RC/etc.
      PacienteDoc      — numero de documento
      EspecialistaNombre — sale como "Atiende:" si no es null
      OrdenNum         — texto del "HC N°" (top-right); ej. "019F9A07"
      FechaLinea       — segunda linea del top-right (Apertura/Cerrada + fecha)
      TipoCortoHeader  — prefijo del top-right (default "HC")
      TituloFallback   — usado cuando FormSchema.Header.Titulo esta vacio
      SeccionesOpcionalesIncluidas — set de ids de secciones PrintOptional
                        que el usuario marco para imprimir; el resto se omite
*@

<div class="pack-doc">
    @{
        var hd = Schema?.Header ?? new FormHeader();
        var tituloFinal = !string.IsNullOrWhiteSpace(hd.Titulo) ? hd.Titulo! : (TituloFallback ?? "");
    }
    <div class="pack-header">
        <div class="pack-hdr-top">
            <div class="pack-hdr-brand">
                @if (!string.IsNullOrWhiteSpace(hd.LogoUrl))
                {
                    <img class="pack-hdr-logo" src="@hd.LogoUrl" alt="logo" />
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                }
                <div>
                    <div class="pack-hdr-inst">@hd.Institucion</div>
                    <div class="pack-hdr-tag">@hd.Tagline</div>
                </div>
            </div>
            @* Bloque HC N° / Apertura. El flag por-formato ImprimirCodigoFecha
               decide si el bloque se muestra. WYSIWYG: si esta apagado no se
               renderiza ni en pantalla ni en el PDF (antes se ocultaba solo en
               el PDF via d-print-none, lo que confundia porque en pantalla se
               seguia viendo). Util para notas donde el usuario escribe la fecha
               dentro del cuerpo del formato. *@
            @if (hd.ImprimirCodigoFecha)
            {
                <div class="pack-hdr-nohist">
                    @if (!string.IsNullOrWhiteSpace(OrdenNum))
                    {
                        @($"{TipoCortoHeader} N°: ")<b>@OrdenNum</b><br />
                    }
                    @if (!string.IsNullOrWhiteSpace(FechaLinea))
                    {
                        @FechaLinea<br />
                    }
                    @if (!string.IsNullOrWhiteSpace(HcConsecutivo))
                    {
                        <text>HC: </text><b>@HcConsecutivo</b>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(FechaLinea) || !string.IsNullOrWhiteSpace(HcConsecutivo))
            {
                @* Formatos con el bloque HC N°/apertura oculto (p.ej. la formula
                   medica, ver FAT-5) que aun asi deben mostrar la fecha de
                   expedicion y la trazabilidad de la HC (N° de historia). *@
                <div class="pack-hdr-nohist">
                    @if (!string.IsNullOrWhiteSpace(FechaLinea))
                    {
                        @FechaLinea<br />
                    }
                    @if (!string.IsNullOrWhiteSpace(HcConsecutivo))
                    {
                        <text>HC: </text><b>@HcConsecutivo</b>
                    }
                </div>
            }
        </div>
        <div class="pack-hdr-title">@tituloFinal</div>
        <div class="pack-hdr-meta">
            @if (!string.IsNullOrWhiteSpace(PacienteNombre))
            {
                <span><b>Paciente:</b> @PacienteNombre</span>
            }
            @if (!string.IsNullOrWhiteSpace(PacienteDoc))
            {
                <span><b>Doc:</b> @PacienteTipoDoc @PacienteDoc</span>
            }
            @if (!string.IsNullOrWhiteSpace(EspecialistaNombre))
            {
                <span><b>Atiende:</b> @EspecialistaNombre</span>
            }
        </div>
    </div>

    @if (Schema is not null)
    {
        @foreach (var node in Schema.Children)
        {
            @RenderTopNode(node)
        }
    }

    @* ===== Pie de formula medica: firma (izq) + QR/codigo (centro) +
       recibido (der), y barra final con fecha de impresion y la URL del
       programa. Solo cuando el llamador lo pide (orden emitida). ===== *@
    @if (MostrarPieFormula)
    {
        var _firma = Values.TryGetValue("firma_profesional", out var _fp) ? _fp : null;
        var _profNom = (Values.TryGetValue("profesional_nombre", out var _pn) ? _pn : null);
        if (string.IsNullOrWhiteSpace(_profNom)) { _profNom = EspecialistaNombre ?? ""; }
        var _profReg = (Values.TryGetValue("profesional_registro", out var _pr) ? _pr : null) ?? "";
        var _cod = (Values.TryGetValue("orden_codigo_verificacion", out var _cc) ? _cc : null)?.Trim() ?? "";
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-top:26px;">
            <div style="flex:1 1 38%;text-align:center;font-size:11px;">
                @if (IsImageUrl(_firma)) { <img src="@_firma" alt="firma" style="max-height:54px;max-width:190px;object-fit:contain;display:block;margin:0 auto 2px;" /> }
                <div style="border-top:1px solid #000;margin:2px auto 3px;width:82%;"></div>
                <div style="font-weight:700;">@_profNom</div>
                <div style="color:#333;">@(string.IsNullOrWhiteSpace(_profReg) ? "" : $"R.M. {_profReg} - ")Firmado Electronicamente.</div>
            </div>
            <div style="flex:0 0 auto;text-align:center;font-size:11px;">
                @if (!string.IsNullOrEmpty(_cod))
                {
                    var _qurl = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(_cod)}";
                    <img src="@Qr.GenerarPngDataUri(_qurl, 116)" alt="QR de verificacion" width="116" height="116" style="display:block;margin:0 auto;" />
                    <div style="font-weight:600;margin-top:2px;">Codigo de Seguridad</div>
                    <div style="font-family:monospace;font-weight:700;color:#c1121f;letter-spacing:1px;">@_cod</div>
                }
            </div>
            <div style="flex:1 1 34%;font-size:11px;color:#555;">
                <div style="display:flex;gap:6px;align-items:flex-end;margin-bottom:9px;"><span>Recibido:</span><span style="flex:1;border-bottom:1px solid #999;">&nbsp;</span></div>
                <div style="display:flex;gap:6px;align-items:flex-end;margin-bottom:9px;"><span>Telefono:</span><span style="flex:1;border-bottom:1px solid #999;">&nbsp;</span></div>
                <div style="display:flex;gap:6px;align-items:flex-end;"><span>Direccion:</span><span style="flex:1;border-bottom:1px solid #999;">&nbsp;</span></div>
            </div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:9px;color:#777;border-top:1px solid #ccc;margin-top:12px;padding-top:4px;">
            <span>Impreso el @FechaImpresion()</span>
            <span>@ProgramaUrl()</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public FormSchema? Schema { get; set; }
    [Parameter, EditorRequired] public Dictionary<string, string?> Values { get; set; } = new();
    [Parameter] public string? PacienteNombre { get; set; }
    [Parameter] public string? PacienteTipoDoc { get; set; }
    [Parameter] public string? PacienteDoc { get; set; }
    [Parameter] public string? EspecialistaNombre { get; set; }
    [Parameter] public string? OrdenNum { get; set; }
    [Parameter] public string? FechaLinea { get; set; }
    /// <summary>Consecutivo/N. de la HC de origen. Se imprime como "HC: {valor}" para
    /// trazabilidad, incluso cuando ImprimirCodigoFecha esta apagado (p.ej. formula medica).</summary>
    [Parameter] public string? HcConsecutivo { get; set; }
    [Parameter] public string TipoCortoHeader { get; set; } = "HC";
    [Parameter] public string? TituloFallback { get; set; }
    [Parameter] public HashSet<string>? SeccionesOpcionalesIncluidas { get; set; }
    /// <summary>Cuando true, agrega el pie de formula medica (firma + QR/codigo
    /// + recibido + barra con fecha de impresion y URL del programa).</summary>
    [Parameter] public bool MostrarPieFormula { get; set; }

    // ── Renderer (copia fiel del que vivia en ImprimirPaquete.razor) ─────

    private RenderFragment RenderTopNode(FormNode n) => __builder =>
    {
        if (!VisibleWhenEvaluator.ShouldShow(n.VisibleWhen, Values)) { return; }
        if (n.NoImprimir) { return; }
        if (n.HideIfEmpty && VisibleWhenEvaluator.IsFieldEmpty(n, Values)) { return; }
        if (n.IsSection && n.PrintOptional
            && (SeccionesOpcionalesIncluidas is null || !SeccionesOpcionalesIncluidas.Contains(n.Id)))
        {
            return;
        }
        // Con el pie de formula medica activo, el QR y las secciones de
        // firma/verificacion/pie que el schema traiga como fallback las pinta
        // el pie hardcodeado. Se saltan aqui para no duplicarlas.
        if (MostrarPieFormula && n.IsQr) { return; }
        if (MostrarPieFormula && n.IsSection && EsSeccionPieFallback(n.Label)) { return; }

        if (n.IsText)
        {
            <div class="pack-para">@(n.Content ?? "")</div>
            return;
        }
        if (n.IsSection)
        {
            if (!string.IsNullOrWhiteSpace(n.Label))
            {
                <div class="pack-sub">@n.Label</div>
            }
            <div class="pack-grid">
                @foreach (var ch in n.Children ?? new())
                {
                    if (!VisibleWhenEvaluator.ShouldShow(ch.VisibleWhen, Values)) { continue; }
                    if (ch.NoImprimir) { continue; }
                    if (ch.HideIfEmpty && VisibleWhenEvaluator.IsFieldEmpty(ch, Values)) { continue; }
                    @RenderDocNode(ch)
                }
            </div>
            return;
        }
        <div class="pack-grid">
            @RenderDocNode(n)
        </div>
    };

    private RenderFragment RenderDocNode(FormNode n) => __builder =>
    {
        // El pie hardcodeado ya pinta el QR + codigo. Evitar duplicado cuando
        // el QR viene como hijo de una seccion del schema.
        if (n.IsQr && MostrarPieFormula) { return; }
        var span = Math.Clamp(n.WidthColumns <= 0 ? 12 : n.WidthColumns, 1, 12);
        if (n.IsText)
        {
            <div class="pack-para" style="grid-column: span @span;">@(n.Content ?? "")</div>
            return;
        }
        if (n.IsTable)
        {
            var tblKey = $"tbl:{n.Id}";
            var seedCount = n.SeedRows?.Count ?? 0;
            int extraRows = 0;
            if (!n.LockRows && Values.TryGetValue($"{tblKey}:_rows", out var rs)
                && int.TryParse(rs, out var parsed) && parsed > 0)
            {
                extraRows = parsed;
            }
            var totalRows = seedCount + extraRows;
            if (totalRows == 0 && !n.LockRows) { totalRows = 1; }
            <div style="grid-column: span @span; border-bottom:1px solid #000;">
                <table class="pack-table">
                    <thead>
                        <tr>
                            @foreach (var col in n.Columns ?? new()) { <th>@col.Label</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var r = 0; r < totalRows; r++)
                        {
                            var idx = r;
                            var isSeed = r < seedCount;
                            var seedRow = isSeed ? n.SeedRows![r] : null;
                            var _pBannerAlign = isSeed && n.SeedRowBanner is not null
                                && n.SeedRowBanner.TryGetValue(r.ToString(), out var _pba) ? _pba : null;
                            if (_pBannerAlign is not null && seedRow is not null)
                            {
                                var _pText = seedRow.Count > 0 ? seedRow[0] ?? "" : "";
                                var _pCols = (n.Columns?.Count ?? 0);
                                var _pAlign = _pBannerAlign == "left" || _pBannerAlign == "right" ? _pBannerAlign : "center";
                                <tr>
                                    <td colspan="@_pCols" style="text-align:@_pAlign; font-weight:700; background:#eff6ff; color:#1e3a8a; padding:6px 10px; letter-spacing:.04em;">
                                        @_pText
                                    </td>
                                </tr>
                                continue;
                            }
                            <tr>
                                @{ var colIdx = 0; }
                                @foreach (var col in n.Columns ?? new())
                                {
                                    var seedVal = (seedRow is not null && colIdx < seedRow.Count) ? seedRow[colIdx] : null;
                                    string? cellVal;
                                    if (!string.IsNullOrEmpty(seedVal)) { cellVal = seedVal; }
                                    else { Values.TryGetValue($"{tblKey}:{idx}:{col.Id}", out cellVal); }
                                    var displayVal = FormatCellForPrint(cellVal, col.FieldType);
                                    <td>@(string.IsNullOrWhiteSpace(displayVal) ? new MarkupString("&nbsp;") : (MarkupString)System.Net.WebUtility.HtmlEncode(displayVal))</td>
                                    colIdx++;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            return;
        }
        if (n.IsQr)
        {
            var qrKey = string.IsNullOrWhiteSpace(n.QrSource) ? (n.Name ?? "") : n.QrSource!;
            var codigo = (Values.TryGetValue(qrKey, out var cv) ? cv : null)?.Trim() ?? "";
            var qrSize = n.QrSize is int qs && qs > 0 ? Math.Clamp(qs, 80, 600) : 200;
            <div class="pack-cell" style="grid-column: span @span; text-align:center;">
                @if (n.Label is { Length: > 0 }) { <div class="pack-label">@n.Label</div> }
                @if (string.IsNullOrEmpty(codigo))
                {
                    <div class="pack-value">(QR pendiente de emision)</div>
                }
                else
                {
                    var url = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(codigo)}";
                    <img src="@Qr.GenerarPngDataUri(url, qrSize)" alt="QR de verificacion"
                         width="@qrSize" height="@qrSize" style="width:@(qrSize)px;height:@(qrSize)px;display:inline-block;" />
                    @if (n.ShowCode)
                    {
                        <div style="font-family:monospace;font-weight:600;letter-spacing:1px;margin-top:4px;">@codigo</div>
                    }
                }
            </div>
            return;
        }
        var key = n.Name ?? $"fld:{n.Id}";
        var val = Values.TryGetValue(key, out var vv) ? vv : null;
        var fieldDisplay = FormatCellForPrint(val, n.FieldType);
        <div class="pack-cell" style="grid-column: span @span;">
            <div class="pack-label">@n.Label</div>
            @if (IsImageUrl(val))
            {
                <img class="pack-firma-img" src="@val" alt="firma" />
            }
            else
            {
                <div class="pack-value">@(fieldDisplay ?? "")</div>
            }
        </div>
    };

    /// <summary>Base URL publica para el QR: config Branding:PublicBaseUrl o el host actual.</summary>
    private string QrBaseUrl()
    {
        var cfg = Config["Branding:PublicBaseUrl"];
        return (string.IsNullOrWhiteSpace(cfg) ? Nav.BaseUri : cfg).TrimEnd('/');
    }

    /// <summary>URL del programa que ejecuta el proceso, para la barra del pie.
    /// Config Branding:ProgramUrl con fallback al dominio de produccion.</summary>
    private string ProgramaUrl()
    {
        var cfg = Config["Branding:ProgramUrl"];
        return string.IsNullOrWhiteSpace(cfg) ? "https://axon.ipsvisalrt.com/" : cfg;
    }

    /// <summary>Fecha/hora de impresion en formato "dd/MM/yyyy - h:mm:ss a.m./p.m.".</summary>
    private static string FechaImpresion()
    {
        var n = DateTime.Now;
        return n.ToString("dd/MM/yyyy - h:mm:ss") + " " + (n.Hour < 12 ? "a.m." : "p.m.");
    }

    /// <summary>True si la seccion es un fallback de firma/verificacion/pie que
    /// el schema pudo traer antes de existir el pie hardcodeado. Comparacion
    /// insensible a mayusculas y acentos (se normalizan a ASCII).</summary>
    private static bool EsSeccionPieFallback(string? label)
    {
        var lbl = SinAcentos((label ?? string.Empty).Trim().ToLowerInvariant());
        return lbl.Contains("firma y verificacion")
            || lbl.Contains("pie de impresion")
            || lbl == "verificacion";
    }

    /// <summary>Quita diacriticos (a/e/i/o/u/n con acento o tilde) para permitir
    /// comparaciones ASCII-safe sin literales acentuados en el codigo.</summary>
    private static string SinAcentos(string s)
    {
        var d = s.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(d.Length);
        foreach (var c in d)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                sb.Append(c);
            }
        }
        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    /// <summary>True cuando el formato es una orden de medicamentos: el codigo
    /// empieza por "ORD-MEDI" o el codigo secundario/tipo es "ORDEN_MEDICAMENTOS".
    /// Lo usan las paginas de impresion para activar MostrarPieFormula solo
    /// cuando aplica.</summary>
    public static bool EsFormatoOrdenMedicamentos(string? codigo, string? codigoSecundario = null, string? tipo = null)
    {
        if (!string.IsNullOrWhiteSpace(codigo)
            && codigo.Trim().StartsWith("ORD-MEDI", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        if (string.Equals(codigoSecundario?.Trim(), "ORDEN_MEDICAMENTOS", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }
        return string.Equals(tipo?.Trim(), "ORDEN_MEDICAMENTOS", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsImageUrl(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) { return false; }
        var s = v.Trim();
        if (s.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)) { return true; }
        if (s.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) { return true; }
        if (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || s.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            var lower = s.ToLowerInvariant();
            return lower.EndsWith(".png") || lower.EndsWith(".jpg") || lower.EndsWith(".jpeg")
                || lower.EndsWith(".svg") || lower.EndsWith(".gif") || lower.EndsWith(".webp");
        }
        return false;
    }

    private static string? FormatCellForPrint(string? raw, string? fieldType)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return raw; }
        if (string.Equals(fieldType, "date", StringComparison.OrdinalIgnoreCase))
        {
            if (DateOnly.TryParseExact(raw, "yyyy-MM-dd", out var d))
            {
                return d.ToString("dd/MM/yyyy");
            }
            return raw;
        }
        if (string.Equals(fieldType, "datetime", StringComparison.OrdinalIgnoreCase))
        {
            if (DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeLocal, out var dt))
            {
                return dt.ToString("dd/MM/yyyy HH:mm");
            }
            return raw;
        }
        return raw;
    }
}
