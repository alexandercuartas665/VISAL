@page "/asignacion-agendas"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Visal.Application.Tenancy
@using Visal.Application.Tenancy.Agendas
@inject IAsignacionAgendasService Svc
@inject ISucursalService Sedes
@inject IAsignacionService Asig
@inject ICatalogoPacienteService CatPac

<PageTitle>Asignacion por agendas - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Operacion Clinica</div>
        <h1 class="ase-title">Asignacion por agendas</h1>
        <small class="text-muted">
            Elige el paciente, su contrato y un servicio (solo los que tienen doctores con agenda),
            el doctor y la sede; luego agenda una cita en un dia disponible (mes actual y siguiente).
        </small>
    </div>
</div>

@if (_error is not null) { <div class="ase-alert">@_error</div> }

<div class="aa-wrap">
    @* ===== Filtro ===== *@
    <div class="ase-card aa-filter">
        <div class="ase-f">
            <label>Paciente</label>
            @if (_pacSel is null)
            {
                <div style="display:flex;gap:6px;">
                    <input class="form-control form-control-sm" placeholder="Documento o nombre..."
                           @bind="_pacQuery" @bind:event="oninput" @onkeyup="BuscarPacientesKey" />
                    <button class="btn btn-outline-secondary btn-sm" @onclick="BuscarPacientesAsync">Buscar</button>
                </div>
                @if (_pacResultados.Count > 0)
                {
                    <div class="aa-paclist">
                        @foreach (var p in _pacResultados)
                        {
                            <div class="aa-pacrow" @onclick="() => SeleccionarPacienteAsync(p)">
                                <strong>@p.NombreCompleto</strong> <span class="text-muted">@p.NumeroDocumento</span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="aa-pacsel">
                    <div><strong>@_pacSel.NombreCompleto</strong><br /><span class="text-muted small">@_pacSel.NumeroDocumento</span></div>
                    <button class="btn btn-link btn-sm" @onclick="LimpiarPaciente">cambiar</button>
                </div>
            }
        </div>

        @if (_pacSel is not null)
        {
            <div class="ase-f">
                <label>Contrato</label>
                <select class="form-select form-select-sm" @bind="_contratoId" @bind:after="OnContratoChanged">
                    <option value="@Guid.Empty">-- Selecciona --</option>
                    @foreach (var c in _contratos)
                    {
                        <option value="@c.ContratoId">@c.CodigoContrato — @c.AseguradoraNombre</option>
                    }
                </select>
                @if (_contratos.Count == 0) { <div class="text-muted small mt-1">El paciente no tiene contratos.</div> }
            </div>
        }

        @if (_contratoId != Guid.Empty)
        {
            <div class="ase-f">
                <label>Servicio</label>
                <select class="form-select form-select-sm" @bind="_servicio" @bind:after="OnServicioChanged">
                    <option value="">-- Selecciona --</option>
                    @foreach (var s in _servicios)
                    {
                        <option value="@s.Codigo">@s.Nombre (@s.Doctores)</option>
                    }
                </select>
                @if (_servicios.Count == 0) { <div class="text-muted small mt-1">Este contrato no tiene servicios con doctores con agenda.</div> }
            </div>

            <div class="ase-f">
                <label>Doctor</label>
                <select class="form-select form-select-sm" @bind="_doctorId" @bind:after="OnDoctorChanged" disabled="@(_doctores.Count == 0)">
                    <option value="@Guid.Empty">-- Selecciona --</option>
                    @foreach (var d in _doctores)
                    {
                        <option value="@d.ProfesionalId">@d.NombreCompleto</option>
                    }
                </select>
            </div>
        }

        <div class="ase-f">
            <label>Sede</label>
            <select class="form-select form-select-sm" @bind="_sucursalId" @bind:after="OnSedeChanged">
                @foreach (var s in _sedes)
                {
                    <option value="@s.Id">@s.Nombre</option>
                }
            </select>
            <div class="text-muted small mt-1">La sede define los dias inactivos que cierran la agenda.</div>
        </div>

        @if (_doctorSel is not null)
        {
            <div class="aa-docinfo">
                <div><strong>@_doctorSel.NombreCompleto</strong></div>
                <div class="text-muted small">@(_doctorSel.TipoProfesional ?? "—") &middot; @_doctorSel.Turnos turno(s) &middot; @_doctorSel.CuposSemana cupos/sem</div>
            </div>
        }
    </div>

    @* ===== Disponibilidad ===== *@
    <div class="ase-card aa-disp">
        <div class="aa-disp-head">
            <div>
                <span style="font-weight:700;">Disponibilidad</span>
                @if (_doctorSel is not null) { <span class="text-muted"> &middot; @_doctorSel.NombreCompleto</span> }
            </div>
            @if (_disp is not null)
            {
                <div style="display:flex;align-items:center;gap:8px;">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="MesAnterior">&larr;</button>
                    <button class="btn btn-sm btn-link" @onclick="IrHoy">Hoy</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="MesSiguiente">&rarr;</button>
                </div>
            }
        </div>

        @if (_doctorId == Guid.Empty)
        {
            <div class="ase-empty" style="padding:40px;">Elige paciente, contrato, servicio y doctor para ver la disponibilidad.</div>
        }
        else if (_loadingDisp)
        {
            <div class="ase-empty" style="padding:40px;">Calculando disponibilidad...</div>
        }
        else if (_disp is not null)
        {
            <div class="aa-months">
                @foreach (var mes in _disp.Meses)
                {
                    var offset = ((int)new DateOnly(mes.Anio, mes.Mes, 1).DayOfWeek + 6) % 7;
                    <div class="aa-month">
                        <div class="aa-month-title">@NombreMes(mes.Mes) @mes.Anio</div>
                        <div class="cal-grid cal-head">
                            @foreach (var d in new[] { "Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom" }) { <div class="cal-dow">@d</div> }
                        </div>
                        <div class="cal-grid">
                            @for (var i = 0; i < offset; i++) { <div class="cal-cell cal-empty"></div> }
                            @foreach (var dia in mes.Dias)
                            {
                                var hoy = dia.Fecha == _hoy ? " cal-hoy" : "";
                                var clic = dia.Estado == EstadoDiaAgenda.Disponible ? " cal-clic" : "";
                                var clase = $"cal-cell {ClaseDia(dia.Estado)}{hoy}{clic}";
                                <div class="@clase" title="@Tooltip(dia)" @onclick="() => AbrirAgendar(dia)">
                                    <div class="cal-num">@dia.Fecha.Day</div>
                                    @if (dia.Estado == EstadoDiaAgenda.Disponible) { <div class="aa-cupos">@dia.Cupos</div> }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="aa-legend text-muted">
                <span><span class="cal-dot d-disp"></span> Disponible (nº = cupos) — clic para agendar</span>
                <span><span class="cal-dot d-completo"></span> Completo (sin cupos)</span>
                <span><span class="cal-dot d-sinturno"></span> Sin turno</span>
                <span><span class="cal-dot d-fest"></span> Festivo</span>
                <span><span class="cal-dot d-inact"></span> Dia inactivo (sede)</span>
                <span><span class="cal-dot d-nov"></span> Novedad</span>
            </div>
        }
    </div>
</div>

@* ============= MODAL AGENDAR ============= *@
@if (_agOpen)
{
    <div class="cie-backdrop" @onclick="() => _agOpen = false"></div>
    <div class="cie-modal" style="width:540px; max-width:96vw;">
        <div class="cie-modal-h">
            <h3>Agendar cita &middot; @_agFecha.ToString("dd/MM/yyyy")</h3>
            <button class="cie-modal-close" @onclick="() => _agOpen = false">&times;</button>
        </div>
        <div class="cie-modal-body">
            <div class="text-muted small" style="margin-bottom:10px;">
                @_pacSel?.NombreCompleto &middot; @_doctorSel?.NombreCompleto &middot; @_servicioNombre &middot; @SedeNombre()
            </div>
            <div class="ase-form">
                <div class="ase-f">
                    <label>Hora</label>
                    <select class="form-select form-select-sm" @bind="_agSlot">
                        <option value="">-- Selecciona hora --</option>
                        @foreach (var s in _agSlots)
                        {
                            <option value="@s.ToString("HH\\:mm")">@s.ToString("HH\\:mm")</option>
                        }
                    </select>
                    @if (_agSlots.Count == 0) { <div class="text-muted small mt-1">No quedan slots libres ese dia.</div> }
                </div>

                <div class="ase-f">
                    <label>Servicio del contrato</label>
                    <select class="form-select form-select-sm" @bind="_agServicioContratoId" disabled="@(_agServiciosContrato.Count == 0)">
                        <option value="@Guid.Empty">-- Selecciona --</option>
                        @foreach (var s in _agServiciosContrato)
                        {
                            <option value="@s.Id">@(s.Descripcion) @(s.Codigo is null ? "" : $"({s.Codigo})")</option>
                        }
                    </select>
                    @if (_agServiciosContrato.Count == 0) { <div class="text-muted small mt-1">Sin servicios de este modulo en el contrato.</div> }
                </div>

                <div class="ase-f">
                    <label>Via de ingreso (RIPS)</label>
                    <select class="form-select form-select-sm" @bind="_agViaCod">
                        <option value="">-- Selecciona --</option>
                        @foreach (var v in _vias)
                        {
                            <option value="@v.Codigo">@v.Codigo - @v.Nombre</option>
                        }
                    </select>
                </div>

                <div class="ase-f">
                    <label>Nota <small class="text-muted">(opcional)</small></label>
                    <input class="form-control form-control-sm" @bind="_agNota" placeholder="Observacion de la cita" />
                </div>
            </div>
            @if (_agError is not null) { <div class="text-danger small mt-2">@_agError</div> }
        </div>
        <div class="cie-modal-foot" style="justify-content:flex-end;gap:8px;">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _agOpen = false">Cancelar</button>
            <button class="btn btn-primary btn-sm" @onclick="GuardarAgendaAsync" disabled="@_agBusy">Agendar</button>
        </div>
    </div>
}
@if (_ok is not null) { <div class="ase-ok" style="position:fixed;bottom:16px;right:16px;z-index:1200;">@_ok</div> }

<style>
    .aa-wrap { display: grid; grid-template-columns: 320px 1fr; gap: 18px; align-items: start; }
    @@media (max-width: 900px) { .aa-wrap { grid-template-columns: 1fr; } }
    .aa-filter { padding: 16px 18px; display: flex; flex-direction: column; gap: 14px; }
    .aa-pacsel { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: #f8fafc; padding: 8px 10px; border-radius: 8px; }
    .aa-docinfo { border-top: 1px solid #e2e8f0; padding-top: 10px; }
    .aa-disp { padding: 16px 18px; }
    .aa-disp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .aa-months { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @@media (max-width: 720px) { .aa-months { grid-template-columns: 1fr; } }
    .aa-month-title { font-weight: 700; text-align: center; margin-bottom: 8px; }
    .aa-cupos { font-size: 11px; font-weight: 700; color: #16a34a; margin-top: 2px; }
    .aa-legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 14px; font-size: 12px; }

    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
    .cal-head { margin-bottom: 5px; }
    .cal-dow { text-align: center; font-size: 11px; font-weight: 700; color: #64748b; }
    .cal-cell { min-height: 52px; border: 1px solid #e2e8f0; border-radius: 7px; padding: 4px 5px; background: #fff; }
    .cal-empty { border: none; background: transparent; }
    .cal-num { font-weight: 700; font-size: 12px; color: #0f172a; }
    .cal-hoy { outline: 2px solid #2563eb; outline-offset: -2px; }
    .cal-disp { background: #f0fdf4; border-color: #bbf7d0; }
    .cal-clic { cursor: pointer; }
    .cal-clic:hover { background: #dcfce7; }
    .cal-completo { background: #eef2f7; border-color: #cbd5e1; }
    .cal-sinturno { background: #f8fafc; }
    .cal-fest { background: #fef2f2; border-color: #fecaca; }
    .cal-inact { background: #fff7ed; border-color: #fed7aa; }
    .cal-nov { background: #faf5ff; border-color: #e9d5ff; }
    .cal-dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; vertical-align: middle; margin-right: 3px; }
    .d-disp { background: #22c55e; }
    .d-completo { background: #94a3b8; }
    .d-sinturno { background: #cbd5e1; }
    .d-fest { background: #ef4444; }
    .d-inact { background: #f97316; }
    .d-nov { background: #a855f7; }

    .cie-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 1050; }
    .cie-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%); max-width: 96vw; max-height: 92vh; background: #fff; border-radius: 12px; box-shadow: 0 20px 60px rgba(15,23,42,.25); z-index: 1051; display: flex; flex-direction: column; }
    .cie-modal-h { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid #e2e8f0; }
    .cie-modal-h h3 { margin: 0; font-size: 15px; font-weight: 700; color: #0f172a; }
    .cie-modal-close { background: none; border: none; font-size: 22px; line-height: 1; cursor: pointer; color: #64748b; }
    .cie-modal-body { padding: 18px; overflow: auto; }
    .cie-modal-foot { padding: 12px 18px; border-top: 1px solid #e2e8f0; display: flex; }
    .ase-form { display: flex; flex-direction: column; gap: 12px; }
    .ase-f label { display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 3px; }
    .aa-paclist { border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 6px; max-height: 180px; overflow: auto; }
    .aa-pacrow { padding: 7px 10px; cursor: pointer; border-bottom: 1px solid #f1f5f9; font-size: 13px; }
    .aa-pacrow:hover { background: #f1f5f9; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly string[] Meses =
    {
        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    };

    private string? _error;
    private string? _ok;

    private List<SucursalDto> _sedes = new();
    private Guid _sucursalId = Guid.Empty;

    // Paciente
    private string _pacQuery = "";
    private List<PacienteAsignacionDto> _pacResultados = new();
    private PacienteAsignacionDto? _pacSel;

    // Contrato
    private List<ContratoMiniDto> _contratos = new();
    private Guid _contratoId = Guid.Empty;

    // Servicios (modulos con doctores con agenda, intersectados con el contrato)
    private List<ServicioConAgendaDto> _serviciosConAgenda = new(); // global
    private List<ServicioConAgendaDto> _servicios = new();          // filtrado por contrato
    private string _servicio = "";
    private string _servicioNombre = "";

    // Doctor
    private List<DoctorConAgendaDto> _doctores = new();
    private Guid _doctorId = Guid.Empty;
    private DoctorConAgendaDto? _doctorSel;

    // Disponibilidad
    private bool _loadingDisp;
    private DisponibilidadAgendaDto? _disp;
    private int _anioInicio;
    private int _mesInicio;
    private DateOnly _hoy;

    // Vias RIPS
    private List<CatalogoPacienteDto> _vias = new();

    // Modal agendar
    private bool _agOpen;
    private bool _agBusy;
    private string? _agError;
    private DateOnly _agFecha;
    private List<TimeOnly> _agSlots = new();
    private string _agSlot = "";
    private List<ServicioCatalogoDto> _agServiciosContrato = new();
    private Guid _agServicioContratoId = Guid.Empty;
    private string _agViaCod = "";
    private string _agNota = "";

    protected override async Task OnInitializedAsync()
    {
        _hoy = DateOnly.FromDateTime(DateTime.Today);
        _anioInicio = _hoy.Year; _mesInicio = _hoy.Month;
        try
        {
            _sedes = (await Sedes.ListAsync(soloActivas: true)).ToList();
            if (_sedes.Count > 0) { _sucursalId = _sedes[0].Id; }
            _serviciosConAgenda = (await Svc.ListarServiciosConAgendaAsync()).ToList();
            try
            {
                _vias = (await CatPac.ListAsync(CatalogoPacienteTipo.RipsViaIngreso))
                    .Where(v => v.Activo).OrderBy(v => v.Codigo, StringComparer.Ordinal).ToList();
            }
            catch { _vias = new(); }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---------------- Paciente ----------------
    private async Task BuscarPacientesKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { await BuscarPacientesAsync(); }
    }

    private async Task BuscarPacientesAsync()
    {
        var q = (_pacQuery ?? "").Trim();
        if (q.Length < 2) { _pacResultados = new(); return; }
        try { _pacResultados = (await Asig.BuscarPacientesAsync(q, null)).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SeleccionarPacienteAsync(PacienteAsignacionDto p)
    {
        _error = null;
        var full = await Asig.GetPacienteAsync(p.Id);
        _pacSel = full ?? p;
        _contratos = (full?.Contratos ?? p.Contratos ?? new List<ContratoMiniDto>()).ToList();
        _pacResultados = new();
        ResetDesdeContrato();
        _contratoId = _contratos.Count == 1 ? _contratos[0].ContratoId : Guid.Empty;
        if (_contratoId != Guid.Empty) { await OnContratoChanged(); }
    }

    private void LimpiarPaciente()
    {
        _pacSel = null; _contratos = new(); _contratoId = Guid.Empty;
        ResetDesdeContrato();
    }

    private void ResetDesdeContrato()
    {
        _servicios = new(); _servicio = ""; _servicioNombre = "";
        _doctores = new(); _doctorId = Guid.Empty; _doctorSel = null; _disp = null;
    }

    private async Task OnContratoChanged()
    {
        ResetDesdeContrato();
        if (_contratoId == Guid.Empty) { return; }
        try
        {
            var modulos = (await Asig.TiposServicioPorContratoAsync(_contratoId))
                .Select(m => (m ?? "").Trim().ToUpperInvariant()).ToHashSet();
            // Interseccion: modulos con doctores con agenda presentes en este contrato.
            _servicios = _serviciosConAgenda.Where(s => modulos.Contains(s.Codigo.ToUpperInvariant())).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ---------------- Servicio / Doctor ----------------
    private async Task OnServicioChanged()
    {
        _doctores = new(); _doctorId = Guid.Empty; _doctorSel = null; _disp = null;
        _servicioNombre = _servicios.FirstOrDefault(s => s.Codigo == _servicio)?.Nombre ?? _servicio;
        if (_servicio.Length == 0) { return; }
        try { _doctores = (await Svc.ListarDoctoresConAgendaAsync(_servicio)).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnDoctorChanged()
    {
        _doctorSel = _doctores.FirstOrDefault(d => d.ProfesionalId == _doctorId);
        _anioInicio = _hoy.Year; _mesInicio = _hoy.Month;
        await CargarDisponibilidadAsync();
    }

    private async Task OnSedeChanged()
    {
        if (_doctorId != Guid.Empty) { await CargarDisponibilidadAsync(); }
    }

    private async Task CargarDisponibilidadAsync()
    {
        if (_doctorId == Guid.Empty) { _disp = null; return; }
        _loadingDisp = true; _error = null;
        try { _disp = await Svc.ObtenerDisponibilidadAsync(_doctorId, _sucursalId, _anioInicio, _mesInicio, 2); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loadingDisp = false; }
    }

    private async Task MesAnterior() { if (--_mesInicio < 1) { _mesInicio = 12; _anioInicio--; } await CargarDisponibilidadAsync(); }
    private async Task MesSiguiente() { if (++_mesInicio > 12) { _mesInicio = 1; _anioInicio++; } await CargarDisponibilidadAsync(); }
    private async Task IrHoy() { _anioInicio = _hoy.Year; _mesInicio = _hoy.Month; await CargarDisponibilidadAsync(); }

    // ---------------- Modal agendar ----------------
    private async Task AbrirAgendar(DiaDisponibilidadDto dia)
    {
        if (dia.Estado != EstadoDiaAgenda.Disponible) { return; }
        _agFecha = dia.Fecha; _agError = null;
        _agSlot = ""; _agNota = "";
        _agServicioContratoId = Guid.Empty;
        _agViaCod = _vias.FirstOrDefault(v => v.Codigo == "01")?.Codigo ?? _vias.FirstOrDefault()?.Codigo ?? "";
        _agSlots = (await Svc.SlotsDisponiblesAsync(_doctorId, _agFecha)).ToList();
        try { _agServiciosContrato = (await Asig.ServiciosPorContratoAsync(_contratoId, _servicio)).ToList(); }
        catch { _agServiciosContrato = new(); }
        if (_agServiciosContrato.Count == 1) { _agServicioContratoId = _agServiciosContrato[0].Id; }
        _agOpen = true;
    }

    private async Task GuardarAgendaAsync()
    {
        _agError = null;
        if (string.IsNullOrWhiteSpace(_agSlot)) { _agError = "Selecciona la hora."; return; }
        if (_agServicioContratoId == Guid.Empty) { _agError = "Selecciona el servicio del contrato."; return; }
        if (string.IsNullOrWhiteSpace(_agViaCod)) { _agError = "Selecciona la via de ingreso."; return; }
        if (_pacSel is null || _contratoId == Guid.Empty) { _agError = "Falta paciente o contrato."; return; }

        var contrato = _contratos.First(c => c.ContratoId == _contratoId);
        var servicio = _agServiciosContrato.First(s => s.Id == _agServicioContratoId);
        var via = _vias.FirstOrDefault(v => v.Codigo == _agViaCod);
        var hora = TimeOnly.ParseExact(_agSlot, "HH\\:mm");

        _agBusy = true;
        try
        {
            var req = new AgendarDesdeAgendaRequest(
                _doctorId, _pacSel.Id, contrato.CodigoContrato,
                servicio.Id.ToString(), servicio.Descripcion, servicio.Modulo ?? _servicio, servicio.Modulo,
                SedeNombre(), _agFecha, hora,
                _agViaCod, via?.Nombre ?? _agViaCod, _agNota);
            await Svc.AgendarAsync(req, await ActorAsync());
            _agOpen = false;
            _ok = $"Cita agendada: {_agFecha:dd/MM/yyyy} {_agSlot}.";
            await CargarDisponibilidadAsync();
        }
        catch (Exception ex) { _agError = ex.Message; }
        finally { _agBusy = false; }
    }

    // ---------------- Helpers ----------------
    private static string ClaseDia(EstadoDiaAgenda e) => e switch
    {
        EstadoDiaAgenda.Disponible => "cal-disp",
        EstadoDiaAgenda.Completo => "cal-completo",
        EstadoDiaAgenda.Festivo => "cal-fest",
        EstadoDiaAgenda.Inactivo => "cal-inact",
        EstadoDiaAgenda.Novedad => "cal-nov",
        _ => "cal-sinturno"
    };

    private static string Tooltip(DiaDisponibilidadDto d) => d.Estado switch
    {
        EstadoDiaAgenda.Disponible => d.Detalle is null ? $"Disponible ({d.Cupos} cupos) — clic para agendar" : $"Disponible ({d.Cupos} cupos) — {d.Detalle}",
        EstadoDiaAgenda.Completo => $"Completo — {d.Detalle}",
        EstadoDiaAgenda.Festivo => $"Festivo: {d.Detalle}",
        EstadoDiaAgenda.Inactivo => $"Dia inactivo: {d.Detalle}",
        EstadoDiaAgenda.Novedad => $"Novedad: {d.Detalle}",
        _ => "Sin turno"
    };

    private string SedeNombre() => _sedes.FirstOrDefault(s => s.Id == _sucursalId)?.Nombre ?? "";

    private static string NombreMes(int m) => Meses[m - 1];

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : Guid.Empty;
    }
}
