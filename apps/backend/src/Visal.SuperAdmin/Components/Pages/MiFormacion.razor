@page "/mi-formacion"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Visal.Application.Tenancy
@inject IMiFormacionService Svc

<PageTitle>Mis capacitaciones - Visal</PageTitle>

<div class="mf-wrap">
    @if (_error is not null) { <div class="mf-alert err">@_error</div> }

    @if (_curso is null)
    {
        @* ===================== LISTA DE CURSOS ===================== *@
        <div class="mf-head">
            <h1 class="mf-title">Mis capacitaciones</h1>
            <div class="mf-sub">Cursos asignados al personal. Completa las lecciones y presenta la evaluacion.</div>
        </div>

        @if (_cursos.Count == 0)
        {
            <div class="mf-empty">No hay capacitaciones disponibles por ahora.</div>
        }
        else
        {
            <div class="mf-cards">
                @foreach (var c in _cursos)
                {
                    <button class="mf-card" @onclick="() => AbrirCurso(c.Id)">
                        <div class="mf-card-t">@c.Titulo</div>
                        @if (!string.IsNullOrWhiteSpace(c.Descripcion)) { <div class="mf-card-d">@c.Descripcion</div> }
                        <div class="mf-card-m">@c.Modulos modulo(s) - @c.Lecciones leccion(es)</div>
                        <div class="mf-card-badges">
                            @if (c.Aprobado) { <span class="mf-badge ok">Aprobado (@c.MejorNota/100)</span> }
                            else if (c.Iniciado) { <span class="mf-badge wip">En curso@(c.MejorNota > 0 ? $" - mejor {c.MejorNota}" : "")</span> }
                            else { <span class="mf-badge new">Sin iniciar</span> }
                            @if (c.TieneEvaluacion) { <span class="mf-badge eval">Con evaluacion</span> }
                        </div>
                    </button>
                }
            </div>
        }
    }
    else
    {
        @* ===================== REPRODUCTOR ===================== *@
        <div class="mf-player-top">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Volver">&larr; Volver</button>
            <h2 class="mf-player-title">@_curso.Titulo</h2>
            @if (_estado.Aprobado) { <span class="mf-badge ok">Aprobado (@_estado.MejorPuntaje/100)</span> }
        </div>

        <div class="mf-player">
            @* --- Temario --- *@
            <aside class="mf-toc">
                @foreach (var m in _curso.Modulos)
                {
                    <div class="mf-toc-mod">@m.Titulo</div>
                    @foreach (var l in m.Lecciones)
                    {
                        <button class="mf-toc-lec @(!_mostrarEval && _leccionSel?.Id == l.Id ? "sel" : "")" @onclick="() => SeleccionarLeccion(l)">
                            <span class="mf-toc-ico">@IconoTipo(l.Tipo)</span>
                            <span>@l.Titulo</span>
                        </button>
                    }
                }
                @if (_curso.CuestionarioId is not null)
                {
                    <button class="mf-toc-lec eval @(_mostrarEval ? "sel" : "")" @onclick="AbrirEvaluacion">
                        <span class="mf-toc-ico">?</span>
                        <span>Evaluacion final</span>
                    </button>
                }
            </aside>

            @* --- Contenido --- *@
            <section class="mf-main">
                @if (_mostrarEval)
                {
                    @if (_eval is null)
                    {
                        <div class="mf-empty">Esta evaluacion no tiene preguntas todavia.</div>
                    }
                    else if (_resultado is not null)
                    {
                        <div class="mf-result @(_resultado.Aprobado ? "ok" : "no")">
                            <div class="mf-result-n">@_resultado.Puntaje<span>/100</span></div>
                            <div class="mf-result-t">@(_resultado.Aprobado ? "Aprobado" : "No aprobado")</div>
                            <div class="mf-result-d">@_resultado.Correctas de @_resultado.Total correctas (minimo @_eval.PuntajeMinimo).</div>
                            @if (_resultado.Retroalimentacion.Count > 0)
                            {
                                <div class="mf-retro">
                                    <div class="mf-retro-h">Para repasar:</div>
                                    <ul>@foreach (var r in _resultado.Retroalimentacion) { <li>@r</li> }</ul>
                                </div>
                            }
                            <button class="btn btn-primary btn-sm" @onclick="AbrirEvaluacion">Reintentar</button>
                        </div>
                    }
                    else
                    {
                        <div class="mf-eval">
                            <h3 class="mf-eval-t">@_eval.Titulo</h3>
                            @if (!string.IsNullOrWhiteSpace(_eval.Descripcion)) { <div class="mf-eval-d">@_eval.Descripcion</div> }
                            <div class="mf-eval-meta">Minimo para aprobar: @_eval.PuntajeMinimo/100. Intentos previos: @_estado.Intentos.</div>
                            @foreach (var p in _eval.Preguntas)
                            {
                                <div class="mf-q">
                                    <div class="mf-q-e">@p.Orden. @p.Enunciado</div>
                                    @for (var i = 0; i < p.Opciones.Count; i++)
                                    {
                                        var idx = i;
                                        <label class="mf-q-o">
                                            <input type="radio" name="@("q-" + p.Id)" checked="@(_respuestas.GetValueOrDefault(p.Id, -1) == idx)" @onchange="() => _respuestas[p.Id] = idx" />
                                            <span>@p.Opciones[idx]</span>
                                        </label>
                                    }
                                </div>
                            }
                            <button class="btn btn-success btn-sm" disabled="@(!TodasRespondidas)" @onclick="Responder">Enviar respuestas</button>
                            @if (!TodasRespondidas) { <span class="mf-hint">Responde todas las preguntas para enviar.</span> }
                        </div>
                    }
                }
                else if (_leccionSel is not null)
                {
                    var l = _leccionSel;
                    <h3 class="mf-lec-t">@l.Titulo</h3>
                    @if (!string.IsNullOrWhiteSpace(l.Descripcion)) { <div class="mf-lec-d">@l.Descripcion</div> }
                    <div class="mf-media">
                        @if (l.Tipo == "TEXTO")
                        {
                            @if (!string.IsNullOrWhiteSpace(l.DescripcionHtml))
                            {
                                <div class="mf-rich">@((MarkupString)l.DescripcionHtml)</div>
                            }
                            else
                            {
                                <div class="mf-texto">@l.Contenido</div>
                            }
                        }
                        else if (string.IsNullOrEmpty(l.RutaArchivo))
                        {
                            <div class="mf-empty">El recurso de esta leccion aun no esta disponible.</div>
                        }
                        else if (l.Tipo == "VIDEO")
                        {
                            <video controls preload="metadata" class="mf-video" src="@l.RutaArchivo"></video>
                        }
                        else if (l.Tipo == "IMAGEN")
                        {
                            <img class="mf-img" src="@l.RutaArchivo" alt="@l.Titulo" />
                        }
                        else if (l.Tipo == "PDF")
                        {
                            <iframe class="mf-pdf" src="@l.RutaArchivo" title="@l.Titulo"></iframe>
                        }
                    </div>
                    @if (l.Tipo != "TEXTO")
                    {
                        @if (!string.IsNullOrWhiteSpace(l.DescripcionHtml))
                        {
                            <div class="mf-rich">@((MarkupString)l.DescripcionHtml)</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(l.Contenido))
                        {
                            <div class="mf-texto">@l.Contenido</div>
                        }
                    }
                }
                else
                {
                    <div class="mf-empty">Este curso no tiene lecciones todavia.</div>
                }
            </section>
        </div>
    }
</div>

@code {
    private string? _error;
    private List<MiCursoDto> _cursos = new();

    private CursoDetalleDto? _curso;
    private CursoLeccionDto? _leccionSel;
    private bool _mostrarEval;
    private EstadoEvaluacionDto _estado = new(false, 0, 0, false);
    private EvaluacionAlumnoDto? _eval;
    private readonly Dictionary<Guid, int> _respuestas = new();
    private ResultadoIntentoDto? _resultado;

    private bool TodasRespondidas => _eval is not null && _eval.Preguntas.All(p => _respuestas.ContainsKey(p.Id));

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try { _cursos = (await Svc.ListarMisCursosAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task AbrirCurso(Guid id)
    {
        _error = null;
        try
        {
            _curso = await Svc.CursoAsync(id);
            if (_curso is null) { _error = "El curso ya no esta disponible."; await CargarAsync(); return; }
            await Svc.RegistrarInicioAsync(id);
            _estado = await Svc.EstadoAsync(id);
            _mostrarEval = false;
            _resultado = null;
            _eval = null;
            _leccionSel = _curso.Modulos.SelectMany(m => m.Lecciones).FirstOrDefault();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void Volver()
    {
        _curso = null; _leccionSel = null; _mostrarEval = false; _eval = null; _resultado = null;
        _ = CargarAsync();
    }

    private void SeleccionarLeccion(CursoLeccionDto l)
    {
        _leccionSel = l;
        _mostrarEval = false;
        _resultado = null;
    }

    private async Task AbrirEvaluacion()
    {
        if (_curso is null) { return; }
        try
        {
            _mostrarEval = true;
            _resultado = null;
            _respuestas.Clear();
            _eval = await Svc.EvaluacionAsync(_curso.Id);
            _estado = await Svc.EstadoAsync(_curso.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Responder()
    {
        if (_curso is null || _eval is null) { return; }
        try
        {
            var resp = _eval.Preguntas.Select(p => _respuestas.GetValueOrDefault(p.Id, -1)).ToList();
            _resultado = await Svc.ResponderAsync(_curso.Id, resp);
            _estado = await Svc.EstadoAsync(_curso.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string IconoTipo(string tipo) => tipo switch
    {
        "VIDEO" => "▶",   // play
        "IMAGEN" => "▣",  // cuadro
        "PDF" => "≡",     // lineas
        _ => "•",         // bullet (texto)
    };
}

<style>
    .mf-wrap { padding: 16px; max-width: 1200px; margin: 0 auto; }
    .mf-head { margin-bottom: 14px; }
    .mf-title { font-size: 22px; font-weight: 800; margin: 0; color: #0f172a; }
    .mf-sub { color: #64748b; font-size: 13px; }
    .mf-alert { padding: 8px 12px; border-radius: 8px; margin-bottom: 10px; font-size: 13px; }
    .mf-alert.err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .mf-empty { padding: 24px; color: #94a3b8; font-size: 13px; text-align: center; }

    .mf-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
    .mf-card { text-align: left; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; cursor: pointer; display: flex; flex-direction: column; gap: 6px; transition: box-shadow .12s, border-color .12s; }
    .mf-card:hover { box-shadow: 0 6px 18px rgba(99,102,241,.14); border-color: #c7d2fe; }
    .mf-card-t { font-weight: 700; color: #0f172a; font-size: 15px; }
    .mf-card-d { font-size: 12.5px; color: #64748b; }
    .mf-card-m { font-size: 11.5px; color: #94a3b8; }
    .mf-card-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
    .mf-badge { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; text-transform: uppercase; letter-spacing: .02em; }
    .mf-badge.ok { background: #ecfdf5; color: #047857; }
    .mf-badge.wip { background: #fef9c3; color: #a16207; }
    .mf-badge.new { background: #eff6ff; color: #1d4ed8; }
    .mf-badge.eval { background: #eef2ff; color: #4f46e5; }

    .mf-player-top { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
    .mf-player-title { font-size: 18px; font-weight: 800; margin: 0; color: #0f172a; }
    .mf-player { display: grid; grid-template-columns: 280px 1fr; gap: 16px; align-items: start; }
    .mf-toc { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; overflow: hidden; max-height: 72vh; overflow-y: auto; }
    .mf-toc-mod { padding: 10px 12px; font-weight: 700; font-size: 12px; color: #334155; background: #f8fafc; border-bottom: 1px solid #eef2f7; text-transform: uppercase; letter-spacing: .02em; }
    .mf-toc-lec { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; background: none; border: none; border-bottom: 1px solid #f1f5f9; padding: 9px 12px; cursor: pointer; font-size: 13px; color: #0f172a; }
    .mf-toc-lec:hover { background: #f8fafc; }
    .mf-toc-lec.sel { background: #eef2ff; color: #4f46e5; font-weight: 600; }
    .mf-toc-lec.eval { color: #4f46e5; font-weight: 600; }
    .mf-toc-ico { flex: 0 0 auto; width: 18px; text-align: center; color: #6366f1; }

    .mf-main { border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; padding: 16px; min-height: 300px; }
    .mf-lec-t, .mf-eval-t { font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 6px; }
    .mf-lec-d, .mf-eval-d { color: #64748b; font-size: 13px; margin-bottom: 12px; }
    .mf-media { margin-top: 8px; }
    .mf-video { width: 100%; max-height: 60vh; border-radius: 10px; background: #000; }
    .mf-img { max-width: 100%; border-radius: 10px; }
    .mf-pdf { width: 100%; height: 70vh; border: 1px solid #e2e8f0; border-radius: 10px; }
    .mf-texto { white-space: pre-wrap; font-size: 14px; color: #1e293b; line-height: 1.5; margin-top: 10px; }
    .mf-rich { font-size: 14px; color: #1e293b; line-height: 1.6; margin-top: 10px; }
    .mf-rich img { max-width: 100%; height: auto; border-radius: 8px; }
    .mf-rich table { border-collapse: collapse; margin: 8px 0; max-width: 100%; }
    .mf-rich td, .mf-rich th { border: 1px solid #cbd5e1; padding: 6px 10px; }
    .mf-rich ul, .mf-rich ol { padding-left: 22px; }
    .mf-rich a { color: #4f46e5; }

    .mf-eval-meta { font-size: 12px; color: #94a3b8; margin-bottom: 14px; }
    .mf-q { border: 1px solid #eef2f7; border-radius: 10px; padding: 12px; margin-bottom: 10px; }
    .mf-q-e { font-weight: 600; color: #0f172a; font-size: 14px; margin-bottom: 8px; }
    .mf-q-o { display: flex; align-items: center; gap: 8px; padding: 5px 0; font-size: 13.5px; color: #334155; cursor: pointer; }
    .mf-hint { font-size: 12px; color: #94a3b8; margin-left: 10px; }

    .mf-result { text-align: center; padding: 24px; }
    .mf-result-n { font-size: 44px; font-weight: 800; color: #0f172a; }
    .mf-result-n span { font-size: 20px; color: #94a3b8; }
    .mf-result-t { font-size: 18px; font-weight: 700; margin: 4px 0; }
    .mf-result.ok .mf-result-t { color: #047857; }
    .mf-result.no .mf-result-t { color: #b91c1c; }
    .mf-result-d { color: #64748b; font-size: 13px; margin-bottom: 14px; }
    .mf-retro { text-align: left; max-width: 520px; margin: 0 auto 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 12px; }
    .mf-retro-h { font-weight: 700; font-size: 12.5px; color: #92400e; margin-bottom: 4px; }
    .mf-retro ul { margin: 0; padding-left: 18px; font-size: 13px; color: #78350f; }

    @@media (max-width: 860px) {
        .mf-player { grid-template-columns: 1fr; }
        .mf-toc { max-height: 32vh; }
    }
</style>
