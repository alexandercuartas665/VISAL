    private async Task AgregarFiltro()
    {
        if (string.IsNullOrWhiteSpace(_nfCol) || string.IsNullOrWhiteSpace(_nfVal)) { return; }
        _verFiltros.Add(new FiltroColumna(_nfCol, _nfVal.Trim()));
