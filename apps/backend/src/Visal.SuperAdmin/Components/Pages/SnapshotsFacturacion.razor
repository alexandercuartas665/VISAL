    private async Task OnImportColConfigJsonFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || file.Size <= 0) { return; }
        const long max = 4L * 1024 * 1024;
        if (file.Size > max) { _colConfigErr = "El JSON debe pesar menos de 4 MB."; return; }
        _colConfigErr = null;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(max).CopyToAsync(ms);
            var entradas = JsonSerializer.Deserialize<List<ColConfigJson>>(
                ms.ToArray(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

            var actualizadas = 0;
            var ignoradas = 0;
            foreach (var ent in entradas)
            {
                if (ent is null || string.IsNullOrWhiteSpace(ent.ColumnaOriginal)) { continue; }
                // Match por nombre exacto; fallback tolerante por trim.
                var idx = _colConfigItems.FindIndex(c => c.ColumnaOriginal == ent.ColumnaOriginal);
                if (idx < 0) { idx = _colConfigItems.FindIndex(c => c.ColumnaOriginal.Trim() == ent.ColumnaOriginal.Trim()); }
                if (idx < 0) { ignoradas++; continue; } // no existe -> no se crea

                var it = _colConfigItems[idx];
                var fmt = Enum.TryParse<Visal.Domain.Enums.SnapshotColumnaFormato>(ent.FormatoTipo, out var f)
                    ? f : it.FormatoTipo;
                // Solo alias en adelante + error. Orden y Visible NO se tocan.
                _colConfigItems[idx] = it with
                {
                    Alias = string.IsNullOrWhiteSpace(ent.Alias) ? null : ent.Alias,
                    Descripcion = string.IsNullOrWhiteSpace(ent.Descripcion) ? null : ent.Descripcion,
                    RutaOrigen = string.IsNullOrWhiteSpace(ent.RutaOrigen) ? null : ent.RutaOrigen,
                    FormatoTipo = fmt,
                    FormatoPatron = string.IsNullOrWhiteSpace(ent.FormatoPatron) ? null : ent.FormatoPatron,
                    EnError = ent.EnError
                };
                actualizadas++;
            }
            _ok = $"Importadas {actualizadas} columna(s)"
                + (ignoradas > 0 ? $", {ignoradas} ignorada(s) (no existen en este tipo)" : "")
                + ". Revisa los cambios y pulsa Guardar para persistir.";
            StateHasChanged();
        }
        catch (Exception ex) { _colConfigErr = "No se pudo importar: " + ex.Message; }
    }

