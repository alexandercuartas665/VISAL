@page "/config/correos-pqr"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.EntityFrameworkCore
@using Visal.Application.Common
@using Visal.Application.Tenancy.Email
@using Visal.Domain.Enums
@inject IEmailIngestConfigService Svc
@inject IApplicationDbContext Db

<PageTitle>Correos PQR - Visal</PageTitle>

<div class="ep-page">
    <div class="ep-head">
        <div>
            <div class="ep-eyebrow">Configuracion de entidad</div>
            <h1 class="ep-title">Correos &rarr; PQR</h1>
            <div class="ep-sub">Conecta buzones de Gmail (IMAP + App Password). Un agente de IA lee cada correo, decide
                si es una PQRS-F y, si lo es, crea una tarjeta en el tablero PQR con los datos del caso.</div>
        </div>
        <button class="ep-btn ep-btn-primary" @onclick="() => AbrirEditor(null)">+ Nuevo buzon</button>
    </div>

    @if (_cargando)
    {
        <div class="ep-empty"><em>Cargando...</em></div>
    }
    else if (_items.Count == 0)
    {
        <div class="ep-empty">No hay buzones configurados. Crea el primero con "+ Nuevo buzon".</div>
    }
    else
    {
        <div class="ep-cards">
            @foreach (var b in _items)
            {
                <div class="ep-card @(b.IsEnabled ? "ep-on" : "")">
                    <div class="ep-card-top">
                        <div>
                            <div class="ep-card-name">@b.Nombre</div>
                            <div class="ep-card-email">@b.EmailAddress</div>
                        </div>
                        <span class="ep-badge @(b.IsEnabled ? "ep-badge-on" : "ep-badge-off")">@(b.IsEnabled ? "Activo" : "Apagado")</span>
                    </div>
                    <div class="ep-rows">
                        <div><span>Agente</span><strong>@(b.ClassifierAgentName ?? "— sin agente —")</strong></div>
                        <div><span>Tablero</span><strong>@(b.TargetBoardName ?? "— sin tablero —")</strong></div>
                        <div><span>Cadencia</span><strong>cada @b.PollIntervalMinutes min</strong></div>
                        <div><span>App Password</span><strong>@(b.HasAppPassword ? "guardada" : "— falta —")</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(b.LastResultSummary))
                    {
                        <div class="ep-last">Ultima corrida: @b.LastResultSummary</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(b.LastError))
                    {
                        <div class="ep-last ep-err">⚠ @b.LastError</div>
                    }
                    <div class="ep-card-foot">
                        <button class="ep-btn ep-btn-sm" @onclick="() => AbrirEditor(b)">Editar</button>
                        <button class="ep-btn ep-btn-sm" disabled="@(_busyId == b.Id)" @onclick="() => ProbarAsync(b)">Probar conexion</button>
                        <button class="ep-btn ep-btn-sm" disabled="@(_busyId == b.Id)" @onclick="() => ProcesarAsync(b)">
                            @if (_procesandoId == b.Id) { <span class="ep-spin"></span><text> Procesando...</text> }
                            else { <text>Procesar ahora</text> }
                        </button>
                        <button class="ep-btn ep-btn-sm" @onclick="() => AbrirLogsAsync(b)">Ver correos</button>
                        <button class="ep-btn ep-btn-sm ep-btn-danger" @onclick="() => EliminarAsync(b)">Eliminar</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="ep-toast @(_error ? "ep-toast-err" : "ep-toast-ok")">@_msg</div>
    }
</div>

@if (_form is not null)
{
    <div class="ep-modal-back" @onclick="() => _form = null"></div>
    <div class="ep-modal">
        <div class="ep-modal-head">
            <h3>@(_form.Id is null ? "Nuevo buzon" : "Editar buzon")</h3>
            <button class="ep-close" @onclick="() => _form = null">×</button>
        </div>
        <div class="ep-modal-body">
            <div class="ep-grid">
                <div class="ep-field ep-col2">
                    <label>Nombre del buzon</label>
                    <input class="ep-inp" @bind="_form.Nombre" placeholder="ej. PQR FOMAG" />
                </div>
                <div class="ep-field ep-col2">
                    <label>Correo (Gmail)</label>
                    <input class="ep-inp" @bind="_form.EmailAddress" placeholder="buzon@gmail.com" autocomplete="off" />
                </div>
                <div class="ep-field ep-col2">
                    <label>App Password (16 caracteres)</label>
                    <input class="ep-inp" type="password" @bind="_form.AppPassword" autocomplete="new-password"
                           placeholder="@(_form.HasAppPassword ? "Dejar vacio para conservar la actual" : "Pega la App Password de Gmail")" />
                    <div class="ep-hint">Se guarda cifrada. Requiere 2FA + IMAP activo. La clave normal de la cuenta no sirve.</div>
                </div>

                <div class="ep-field">
                    <label>Agente clasificador</label>
                    <select class="ep-inp" @bind="_form.ClassifierAgentId">
                        <option value="">— elige un agente —</option>
                        @foreach (var a in _agentes)
                        {
                            <option value="@a.Id">@a.Name @(a.Provider.ToString())</option>
                        }
                    </select>
                    <div class="ep-hint">Reutiliza un agente existente. Aporta el motor de IA; las instrucciones las pone el sistema.</div>
                </div>
                <div class="ep-field">
                    <label>Tablero destino</label>
                    <select class="ep-inp" @bind="_form.TargetBoardId">
                        <option value="">— elige un tablero —</option>
                        @foreach (var t in _tableros)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                    <div class="ep-hint">Normalmente el tablero "PQR". La tarjeta cae en su primera columna.</div>
                </div>

                <div class="ep-field">
                    <label>Host IMAP</label>
                    <input class="ep-inp" @bind="_form.ImapHost" />
                </div>
                <div class="ep-field ep-field-row">
                    <div>
                        <label>Puerto</label>
                        <input class="ep-inp" type="number" @bind="_form.ImapPort" />
                    </div>
                    <label class="ep-check"><input type="checkbox" @bind="_form.ImapUseSsl" /> SSL</label>
                </div>

                <div class="ep-field">
                    <label>Carpeta</label>
                    <input class="ep-inp" @bind="_form.Folder" />
                </div>
                <div class="ep-field">
                    <label>Revisar cada (min)</label>
                    <input class="ep-inp" type="number" @bind="_form.PollIntervalMinutes" />
                </div>

                <div class="ep-field">
                    <label>Ventana inicial (dias)</label>
                    <input class="ep-inp" type="number" @bind="_form.LookbackDays" />
                </div>
                <div class="ep-field">
                    <label>Max por corrida</label>
                    <input class="ep-inp" type="number" @bind="_form.MaxPorCorrida" />
                </div>

                <div class="ep-field ep-col2 ep-checks">
                    <label class="ep-check"><input type="checkbox" @bind="_form.OnlyUnread" /> Solo correos no leidos</label>
                    <label class="ep-check"><input type="checkbox" @bind="_form.MarkAsRead" /> Marcar como leidos al procesar</label>
                    <label class="ep-check ep-check-strong"><input type="checkbox" @bind="_form.IsEnabled" /> Encendido (poller automatico)</label>
                </div>

                <div class="ep-field ep-col2">
                    <label>Etiqueta de "procesado" (opcional)</label>
                    <div class="ep-field-row">
                        <input class="ep-inp" list="ep-labels" @bind="_form.ProcessedLabel"
                               placeholder="ej. Procesado / PQR-Procesado (etiqueta EXISTENTE de la cuenta)" />
                        <button type="button" class="ep-btn ep-btn-sm" disabled="@(_loadingLabels || _form.Id is null)"
                                @onclick="CargarEtiquetasAsync">@(_loadingLabels ? "Cargando..." : "Cargar etiquetas")</button>
                    </div>
                    <datalist id="ep-labels">
                        @foreach (var l in _labels)
                        {
                            <option value="@l"></option>
                        }
                    </datalist>
                    @if (_labels.Count > 0)
                    {
                        <div class="ep-chips">
                            @foreach (var l in _labels)
                            {
                                <button type="button"
                                        class="ep-chip @(string.Equals(l, _form!.ProcessedLabel, StringComparison.OrdinalIgnoreCase) ? "ep-chip-on" : "")"
                                        @onclick="() => _form!.ProcessedLabel = l">@l</button>
                            }
                        </div>
                    }
                    <div class="ep-hint">
                        Marca VISIBLE de "ya procesado" para el operador: a cada correo procesado se le aplica esta etiqueta
                        de Gmail. Debe ser una etiqueta que YA EXISTA en la cuenta. Deja vacio para no etiquetar.
                        @if (_form!.Id is null) { <span>Guarda el buzon primero para poder cargar sus etiquetas.</span> }
                        else if (_labels.Count == 0) { <span>Pulsa "Cargar etiquetas" para ver las etiquetas disponibles del buzon.</span> }
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="ep-form-err">@_formError</div>
            }
        </div>
        <div class="ep-modal-foot">
            <button class="ep-btn" @onclick="() => _form = null">Cancelar</button>
            <button class="ep-btn ep-btn-primary" disabled="@_saving" @onclick="GuardarAsync">Guardar</button>
        </div>
    </div>
}

@if (_logsDe is not null)
{
    <div class="ep-modal-back" @onclick="() => _logsDe = null"></div>
    <div class="ep-modal ep-modal-wide">
        <div class="ep-modal-head">
            <h3>Correos procesados — @_logsDe.Nombre</h3>
            <button class="ep-close" @onclick="() => _logsDe = null">×</button>
        </div>
        <div class="ep-modal-body">
            @if (!string.IsNullOrWhiteSpace(_logsDe.LastError))
            {
                <div class="ep-last ep-err" style="margin-bottom:.6rem;">⚠ Ultima corrida con problema al leer/procesar: @_logsDe.LastError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_logsDe.LastResultSummary))
            {
                <div class="ep-last" style="margin-bottom:.6rem;">Ultima corrida: @_logsDe.LastResultSummary</div>
            }
            @if (_logs.Count == 0)
            {
                <div class="ep-empty">Todavia no se ha procesado ningun correo.</div>
            }
            else
            {
                <div class="ep-tablewrap">
                    <table class="ep-table">
                        <thead><tr><th>Fecha</th><th>De</th><th>Asunto</th><th>Resultado</th><th>Tipo</th><th title="Tokens de entrada + salida">Tokens</th><th title="Adjuntos copiados a la tarjeta">Adj.</th><th>Detalle</th></tr></thead>
                        <tbody>
                            @foreach (var l in _logs)
                            {
                                <tr>
                                    <td>@l.ProcessedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@l.FromAddress</td>
                                    <td class="ep-td-clip">@l.Subject</td>
                                    <td><span class="ep-res ep-res-@l.Resultado">@ResTexto(l.Resultado)</span></td>
                                    <td>@l.TipoPqrs</td>
                                    <td class="ep-num">@(l.InputTokens + l.OutputTokens > 0 ? (l.InputTokens + l.OutputTokens).ToString("N0") : "—")</td>
                                    <td class="ep-num">@(l.AttachmentCount > 0 ? l.AttachmentCount.ToString() : "—")</td>
                                    <td class="ep-td-clip">@(l.ErrorMessage ?? (l.TaskCardId is null ? "" : $"tarjeta creada{(l.AttachmentCount > 0 ? $" (+{l.AttachmentCount} adj.)" : "")}"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="ep-modal-foot">
            <button class="ep-btn" @onclick="() => _logsDe = null">Cerrar</button>
        </div>
    </div>
}

