            __b.AddMarkupContent(16, "<option value=\"7\">Ultimos 7 dias</option><option value=\"15\">Ultimos 15 dias</option><option value=\"30\">Ultimos 30 dias</option><option value=\"0\">Todas</option>");
            __b.CloseElement();
            __b.CloseElement();
        }
        __b.OpenElement(20, "div"); __b.AddAttribute(21, "class", "seg-col-body");
        foreach (var it in filas)
        {
            __b.OpenElement(22, "div");
            __b.AddAttribute(23, "class", "seg-card");
            __b.AddAttribute(24, "draggable", "true");
            __b.AddAttribute(25, "ondragstart", EventCallback.Factory.Create(this, () => OnDragStart(it.Id)));
            __b.AddAttribute(26, "ondragend", EventCallback.Factory.Create(this, OnDragEnd));
            __b.AddAttribute(27, "onclick", EventCallback.Factory.Create(this, () => Abrir(it.Id)));
            __b.AddMarkupContent(28, $"<b>{System.Net.WebUtility.HtmlEncode(it.PacienteNombre)}</b><small>{it.PacienteTipoDoc} {it.PacienteDocumento}</small>");
            var metaFecha = it.FechaLlamada?.ToString("dd/MM/yyyy HH:mm") ?? "sin llamar";
            var metaResp = string.IsNullOrWhiteSpace(it.ResponsableLlamadaNombre) ? "" : $" · {System.Net.WebUtility.HtmlEncode(it.ResponsableLlamadaNombre)}";
            __b.AddMarkupContent(29, $"<div class=\"seg-card-meta\">{metaFecha}{metaResp}</div>");
