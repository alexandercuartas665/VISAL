@page "/config/menu-lateral"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Visal.Application.Tenancy.Menu
@using Visal.SuperAdmin.Menu
@inject INavMenuConfigService Svc

<PageTitle>Menu lateral - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Configuracion de la Entidad</div>
        <h1 class="ase-title">Menu lateral</h1>
    </div>
    <div class="ml-actions">
        <button class="btn btn-outline-secondary btn-sm" @onclick="Recargar" disabled="@_busy">Descartar cambios</button>
        <button class="btn btn-outline-danger btn-sm" @onclick="Restaurar" disabled="@_busy">Restaurar por defecto</button>
        <button class="btn btn-primary btn-sm" @onclick="Guardar" disabled="@_busy">Guardar cambios</button>
    </div>
</div>

<div class="ase-card">
    <div class="ase-card-h">Organiza el menu de esta agencia</div>
    <div class="ase-card-body">
        <p class="text-muted small">
            Reordena y agrupa las opciones del menu lateral <b>para todos los usuarios de esta agencia</b>.
            Puedes crear grupos nuevos, mover opciones de un grupo a otro, ocultarlas, cambiar su
            icono/nombre y agregar enlaces externos propios. Los cambios se aplican al recargar la pagina.
            Las opciones nuevas del sistema aparecen solas en su grupo por defecto.
        </p>

        @if (_msg is not null) { <div class="ase-ok">@_msg</div> }
        @if (_error is not null) { <div class="ase-alert">@_error</div> }

        @if (_tree is null)
        {
            <div class="text-muted small">Cargando...</div>
        }
        else
        {
            @for (var gi = 0; gi < _tree.Groups.Count; gi++)
            {
                var g = _tree.Groups[gi];
                var gIndex = gi;
                <div class="ml-group">
                    <div class="ml-group-h">
                        <span class="ml-ico" title="Icono del grupo">@((MarkupString)MenuIcons.Svg(g.IconKey))</span>
                        <input class="form-control form-control-sm ml-group-name" @bind="g.Label" @bind:event="oninput"
                               placeholder="Nombre del grupo" />
                        <select class="form-select form-select-sm ml-ico-sel" value="@g.IconKey"
                                @onchange="e => g.IconKey = (string?)e.Value ?? g.IconKey">
                            @foreach (var k in _iconKeys)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                        <span class="ml-count">@g.Items.Count opc.</span>
                        <span class="ml-spacer"></span>
                        <button class="btn btn-light btn-xs" title="Subir grupo"
                                @onclick="() => MoverGrupo(gIndex, -1)" disabled="@(gIndex == 0)">&uarr;</button>
                        <button class="btn btn-light btn-xs" title="Bajar grupo"
                                @onclick="() => MoverGrupo(gIndex, 1)" disabled="@(gIndex == _tree.Groups.Count - 1)">&darr;</button>
                        <button class="btn btn-light btn-xs text-danger" title="Eliminar grupo (debe estar vacio)"
                                @onclick="() => EliminarGrupo(g)" disabled="@(g.Items.Count > 0)">&times;</button>
                    </div>

                    @if (g.Items.Count == 0)
                    {
                        <div class="ml-empty">Grupo vacio. Mueve opciones aqui desde otro grupo o elimina el grupo.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle ml-tabla">
                                <tbody>
                                    @for (var ii = 0; ii < g.Items.Count; ii++)
                                    {
                                        var it = g.Items[ii];
                                        var iIndex = ii;
                                        <tr class="@(it.Hidden ? "ml-hidden" : "")">
                                            <td class="ml-move">
                                                <button class="btn btn-light btn-xs" title="Subir"
                                                        @onclick="() => MoverItem(g, iIndex, -1)" disabled="@(iIndex == 0)">&uarr;</button>
                                                <button class="btn btn-light btn-xs" title="Bajar"
                                                        @onclick="() => MoverItem(g, iIndex, 1)" disabled="@(iIndex == g.Items.Count - 1)">&darr;</button>
                                            </td>
                                            <td class="ml-ico-cell">
                                                <span class="ml-ico">@((MarkupString)MenuIcons.Svg(it.IconKey))</span>
                                            </td>
                                            <td class="ml-name-cell">
                                                <input class="form-control form-control-sm" @bind="it.Label" @bind:event="oninput"
                                                       placeholder="Nombre" />
                                                <div class="ml-href">
                                                    @if (it.External)
                                                    {
                                                        <span class="ml-badge ml-badge-ext">Enlace externo</span>
                                                        <input class="form-control form-control-sm ml-url" @bind="it.Href" @bind:event="oninput"
                                                               placeholder="https://..." />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">/@it.Href</span>
                                                        @if (it.Gate != NavGate.Permission)
                                                        {
                                                            <span class="ml-badge ml-badge-gate" title="Esta opcion tiene una regla de visibilidad adicional (rol/permiso)">@GateLabel(it.Gate)</span>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td class="ml-ico-sel-cell">
                                                <select class="form-select form-select-sm" value="@it.IconKey"
                                                        @onchange="e => it.IconKey = (string?)e.Value ?? it.IconKey">
                                                    @foreach (var k in _iconKeys)
                                                    {
                                                        <option value="@k">@k</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="ml-group-sel-cell">
                                                <select class="form-select form-select-sm" value="@GrupoActualId(g)"
                                                        @onchange="e => MoverItemAGrupo(g, it, (string?)e.Value)">
                                                    @foreach (var og in _tree.Groups)
                                                    {
                                                        <option value="@og.Id">@(string.IsNullOrWhiteSpace(og.Label) ? "(sin nombre)" : og.Label)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="ml-vis-cell text-center">
                                                <label class="ml-vis" title="Visible en el menu">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@(!it.Hidden)"
                                                           @onchange="e => it.Hidden = !(bool)e.Value!" />
                                                    <span>@(it.Hidden ? "Oculta" : "Visible")</span>
                                                </label>
                                            </td>
                                            <td class="ml-del-cell text-center">
                                                @if (it.External)
                                                {
                                                    <button class="btn btn-light btn-xs text-danger" title="Eliminar enlace"
                                                            @onclick="() => EliminarItem(g, it)">&times;</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

            <div class="ml-add">
                <button class="btn btn-outline-secondary btn-sm" @onclick="NuevoGrupo">+ Nuevo grupo</button>

                <div class="ml-add-link">
                    <span class="ml-add-title">Nuevo enlace externo:</span>
                    <input class="form-control form-control-sm" style="max-width:200px" placeholder="Nombre"
                           @bind="_nuevoLinkNombre" />
                    <input class="form-control form-control-sm" style="max-width:280px" placeholder="https://..."
                           @bind="_nuevoLinkUrl" />
                    <select class="form-select form-select-sm" style="max-width:200px" @bind="_nuevoLinkGrupoId">
                        @foreach (var og in _tree.Groups)
                        {
                            <option value="@og.Id">@(string.IsNullOrWhiteSpace(og.Label) ? "(sin nombre)" : og.Label)</option>
                        }
                    </select>
                    <button class="btn btn-outline-primary btn-sm" @onclick="NuevoEnlace">Agregar</button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .ml-actions { display:flex; gap:8px; align-items:center; }
    .ml-group { border:1px solid #e2e8f0; border-radius:10px; margin-bottom:14px; overflow:hidden; }
    .ml-group-h { display:flex; align-items:center; gap:8px; padding:8px 10px; background:#f8fafc; border-bottom:1px solid #eef2f7; }
    .ml-group-name { max-width:260px; font-weight:600; }
    .ml-ico-sel { max-width:150px; }
    .ml-ico { display:inline-flex; width:20px; height:20px; color:#334155; }
    .ml-ico svg { width:20px; height:20px; }
    .ml-count { font-size:11px; color:#64748b; }
    .ml-spacer { flex:1 1 auto; }
    .ml-empty { padding:14px; color:#94a3b8; font-size:13px; }
    .ml-tabla td { vertical-align:middle; }
    .ml-move { white-space:nowrap; width:74px; }
    .ml-ico-cell { width:30px; }
    .ml-name-cell { min-width:220px; }
    .ml-href { font-size:11px; color:#64748b; margin-top:2px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .ml-url { max-width:280px; font-size:11px; }
    .ml-ico-sel-cell { width:150px; }
    .ml-group-sel-cell { width:190px; }
    .ml-vis-cell { width:110px; }
    .ml-del-cell { width:44px; }
    .ml-vis { display:inline-flex; align-items:center; gap:4px; font-size:12px; cursor:pointer; }
    .ml-hidden { opacity:0.55; }
    .ml-badge { display:inline-block; padding:1px 6px; border-radius:8px; font-size:10px; font-weight:600; }
    .ml-badge-ext { background:#ecfeff; color:#0e7490; border:1px solid #a5f3fc; }
    .ml-badge-gate { background:#fef9c3; color:#854d0e; border:1px solid #fde68a; }
    .btn-xs { padding:1px 7px; font-size:12px; line-height:1.3; }
    .ml-add { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:6px; }
    .ml-add-link { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .ml-add-title { font-size:12px; color:#475569; font-weight:600; }
    .ml-tabla th { text-transform:uppercase; font-size:11px; color:#475569; }
</style>

@code {
    private NavMenuTreeDto? _tree;
    private string? _msg;
    private string? _error;
    private bool _busy;
    private readonly List<string> _iconKeys = MenuIcons.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList();

    private string _nuevoLinkNombre = "";
    private string _nuevoLinkUrl = "";
    private string? _nuevoLinkGrupoId;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _error = null;
        try
        {
            _tree = await Svc.GetForEditAsync();
            _nuevoLinkGrupoId = _tree.Groups.FirstOrDefault()?.Id;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Recargar()
    {
        _msg = null;
        await CargarAsync();
        _msg = "Cambios sin guardar descartados.";
    }

    private async Task Guardar()
    {
        if (_tree is null) { return; }
        _busy = true; _msg = _error = null;
        try
        {
            await Svc.SaveAsync(_tree);
            await CargarAsync(); // releer el arbol normalizado
            _msg = "Menu guardado. Recarga la pagina para ver el nuevo menu lateral.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Restaurar()
    {
        _busy = true; _msg = _error = null;
        try
        {
            await Svc.ResetAsync();
            await CargarAsync();
            _msg = "Menu restablecido al default del sistema.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void MoverGrupo(int index, int dir)
    {
        if (_tree is null) { return; }
        var target = index + dir;
        if (target < 0 || target >= _tree.Groups.Count) { return; }
        (_tree.Groups[index], _tree.Groups[target]) = (_tree.Groups[target], _tree.Groups[index]);
    }

    private void MoverItem(NavMenuGroupDto g, int index, int dir)
    {
        var target = index + dir;
        if (target < 0 || target >= g.Items.Count) { return; }
        (g.Items[index], g.Items[target]) = (g.Items[target], g.Items[index]);
    }

    private void MoverItemAGrupo(NavMenuGroupDto origen, NavMenuItemDto it, string? destinoId)
    {
        if (_tree is null || string.IsNullOrWhiteSpace(destinoId)) { return; }
        var destino = _tree.Groups.FirstOrDefault(x => x.Id == destinoId);
        if (destino is null || ReferenceEquals(destino, origen)) { return; }
        origen.Items.Remove(it);
        destino.Items.Add(it);
    }

    private void EliminarItem(NavMenuGroupDto g, NavMenuItemDto it) => g.Items.Remove(it);

    private void EliminarGrupo(NavMenuGroupDto g)
    {
        if (_tree is null || g.Items.Count > 0) { return; }
        _tree.Groups.Remove(g);
    }

    private void NuevoGrupo()
    {
        if (_tree is null) { return; }
        _tree.Groups.Add(new NavMenuGroupDto
        {
            Id = "grupo-" + Guid.NewGuid().ToString("N")[..8],
            Label = "Nuevo grupo",
            IconKey = "carpeta",
        });
    }

    private void NuevoEnlace()
    {
        if (_tree is null) { return; }
        _msg = _error = null;
        var nombre = _nuevoLinkNombre.Trim();
        var url = _nuevoLinkUrl.Trim();
        if (string.IsNullOrWhiteSpace(nombre) || string.IsNullOrWhiteSpace(url))
        {
            _error = "El enlace externo necesita nombre y URL.";
            return;
        }
        var destino = _tree.Groups.FirstOrDefault(x => x.Id == _nuevoLinkGrupoId) ?? _tree.Groups.FirstOrDefault();
        if (destino is null) { _error = "Crea primero un grupo."; return; }
        destino.Items.Add(new NavMenuItemDto
        {
            Key = "link:" + Guid.NewGuid().ToString("N")[..8],
            Label = nombre,
            Href = url,
            IconKey = "enlace",
            External = true,
        });
        _nuevoLinkNombre = "";
        _nuevoLinkUrl = "";
        _msg = $"Enlace '{nombre}' agregado a '{destino.Label}'. Recuerda Guardar cambios.";
    }

    private static string GrupoActualId(NavMenuGroupDto g) => g.Id;

    private static string GateLabel(NavGate gate) => gate switch
    {
        NavGate.Atencion => "Profesional",
        NavGate.AdminAgency => "Solo admin",
        NavGate.Platform => "Super admin",
        _ => "",
    };
}
