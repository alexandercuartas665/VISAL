@page "/interoperabilidad/rda"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Visal.Application.Tenancy
@using Visal.Domain.Enums
@inject IRdaConsoleService Svc
@inject IRdaBuilderService Builder
@inject IRdaConsultaBuilderService BuilderConsulta
@inject IIhceSenderService Sender
@inject AuthenticationStateProvider AuthState
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Consola RDA - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Interoperabilidad</div>
        <h1 class="ase-title">Consola RDA</h1>
        <p class="ase-sub" style="margin:4px 0 0;color:var(--muted);font-size:13px;">
            Registro de Bundles FHIR R4 enviados a la plataforma IHCE del MinSalud
            (Resolucion 1888 de 2025). Cada fila es un evento inmutable de auditoria.
        </p>
    </div>
    <div style="display:flex;gap:8px;">
        <button class="btn btn-outline-secondary btn-sm" @onclick="CargarLista" disabled="@_cargando">
            @if (_cargando) { <span>...</span> } else { <span>Refrescar</span> }
        </button>
        <button class="btn btn-primary btn-sm" @onclick="AbrirGenerar">+ Generar RDA</button>
    </div>
</div>

@if (_error is not null) { <div class="ase-alert">@_error</div> }
@if (_ok is not null) { <div class="ase-ok">@_ok</div> }

<div style="background:#f0f9ff;border:1px solid #7dd3fc;padding:10px 14px;border-radius:8px;margin-bottom:12px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
    <b style="font-size:13px;">IP publica de salida:</b>
    <button class="btn btn-outline-primary btn-sm" @onclick="ConsultarIpAsync" disabled="@_ipBusy">
        @(_ipBusy ? "Consultando..." : (_ipResult is null ? "Consultar" : "Reconsultar"))
    </button>
    @if (_ipResult is not null)
    {
        <code style="font-size:14px;font-family:monospace;background:#0d1117;color:#e6edf3;padding:4px 10px;border-radius:6px;user-select:all;">
            @(_ipResult.Consensus ?? "sin respuesta")
        </code>
        <small style="color:#666;">
            (ipify: <code>@(_ipResult.Ipify ?? "-")</code>,
            ifconfig: <code>@(_ipResult.Ifconfig ?? "-")</code>,
            amazon: <code>@(_ipResult.Amazon ?? "-")</code>)
        </small>
        @if (_ipResult.Errores.Count > 0)
        {
            <small style="color:#c0392b;">Errores: @string.Join(" | ", _ipResult.Errores)</small>
        }
    }
    else
    {
        <small style="color:#666;">
            Sirve para verificar la IP que MinSalud ve al recibir los envios.
            Requerido para whitelist del APIM sandbox.
        </small>
    }
</div>

@{
    var sedesSinCred = _rows
        .Where(r => !r.TieneCredencialSede
            && r.Estado is EstadoRdaEvento.Borrador or EstadoRdaEvento.Error or EstadoRdaEvento.Rechazado)
        .Select(r => new { Sede = r.SucursalNombre, r.Ambiente })
        .Distinct()
        .ToList();
}
@if (sedesSinCred.Count > 0)
{
    <div class="ase-alert" style="background:#fff7e6;border-color:#ffd591;color:#7a4f01;margin-bottom:14px;">
        <b>Faltan credenciales IHCE para @sedesSinCred.Count sede@(sedesSinCred.Count == 1 ? "" : "s"):</b>
        <ul style="margin:6px 0 0 18px;font-size:13px;">
            @foreach (var g in sedesSinCred)
            {
                <li>@g.Sede — ambiente <b>@g.Ambiente</b></li>
            }
        </ul>
        <div style="margin-top:8px;font-size:13px;">
            Configuralas en <a href="/cfg-interoperabilidad">Configuracion de Interoperabilidad</a>
            antes de intentar enviar. Los eventos afectados quedan con el boton "Enviar al IHCE" bloqueado.
        </div>
    </div>
}

@* ===================== Probador de servicios IHCE ===================== *@
<details class="ase-card" style="margin-bottom:14px;">
    <summary style="cursor:pointer;font-weight:600;padding:6px 0;">
        🔧 Probar servicios IHCE (paciente / profesional / IPS / EAPB)
    </summary>
    @{
        var esOrg = _probadorServicio == "organizacion";
        var esEapb = _probadorServicio == "eapb";
        var esPersona = _probadorServicio == "paciente" || _probadorServicio == "profesional";
        string LabelBusqueda() => _probadorServicio switch
        {
            "paciente" => "Número de documento",
            "profesional" => "Número de documento",
            "organizacion" => "REPS (código de habilitación)",
            "eapb" => "Nombre de la EAPB",
            _ => "Valor"
        };
        string PlaceholderBusqueda() => _probadorServicio switch
        {
            "paciente" => "ej. 80189301",
            "profesional" => "ej. 1143131723",
            "organizacion" => "ej. 7600112543",
            "eapb" => "ej. Famisanar",
            _ => ""
        };
    }
    <div class="ase-form" style="display:grid;grid-template-columns:@(esPersona ? "120px 1fr 240px 140px" : "1fr 240px 140px");gap:10px;align-items:end;padding-top:10px;">
        @if (esPersona)
        {
            <div class="ase-f">
                <label>Tipo doc</label>
                <select class="form-select form-select-sm" @bind="_probadorTipoDoc">
                    <option value="CC">CC</option>
                    <option value="TI">TI</option>
                    <option value="CE">CE</option>
                    <option value="PA">PA</option>
                    <option value="RC">RC</option>
                </select>
            </div>
        }
        <div class="ase-f">
            <label>@LabelBusqueda()</label>
            <input class="form-control form-control-sm mono" @bind="_probadorNumDoc"
                   placeholder="@PlaceholderBusqueda()" />
        </div>
        <div class="ase-f">
            <label>Servicio</label>
            <select class="form-select form-select-sm" @bind="_probadorServicio">
                <option value="paciente">Consultar paciente</option>
                <option value="profesional">Consultar profesional</option>
                <option value="organizacion">Consultar IPS (REPS)</option>
                <option value="eapb">Consultar EAPB (nombre)</option>
            </select>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="EjecutarProbador" disabled="@_probadorBusy">
            @if (_probadorBusy) { <span>Ejecutando…</span> } else { <span>Ejecutar</span> }
        </button>
    </div>
    @if (_probadorResult is not null)
    {
        <div style="margin-top:12px;padding:12px;background:#0d1117;color:#e6edf3;border-radius:8px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;">
            <div style="margin-bottom:6px;">
                <b style="color:@(_probadorResult.Exito ? "#7ee787" : "#ff8585");">
                    HTTP @_probadorResult.HttpStatus
                </b>
                <span style="color:#8b949e;"> · @_probadorResult.ElapsedMs ms · @_probadorResult.ResponseContentType</span>
            </div>
            <pre style="margin:0;white-space:pre-wrap;max-height:300px;overflow:auto;"><code>@_probadorResult.ResponseBody</code></pre>
        </div>
    }
</details>

@* ===================== Filtros ===================== *@
<div class="ase-card" style="margin-bottom:14px;">
    <div class="ase-form" style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr 80px;gap:10px;align-items:end;">
        <div class="ase-f">
            <label>Documento paciente</label>
            <input class="form-control form-control-sm mono" @bind="_filtroDoc" placeholder="ej. 1010101010" />
        </div>
        <div class="ase-f">
            <label>Estado</label>
            <select class="form-select form-select-sm" @bind="_filtroEstado">
                <option value="">(Todos)</option>
                @foreach (var e in Enum.GetValues<EstadoRdaEvento>())
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
        <div class="ase-f">
            <label>Ambiente</label>
            <select class="form-select form-select-sm" @bind="_filtroAmb">
                <option value="">(Todos)</option>
                <option value="Sandbox">Sandbox</option>
                <option value="Produccion">Produccion</option>
            </select>
        </div>
        <div class="ase-f">
            <label>Desde</label>
            <input type="date" class="form-control form-control-sm" @bind="_filtroDesde" />
        </div>
        <div class="ase-f">
            <label>Hasta</label>
            <input type="date" class="form-control form-control-sm" @bind="_filtroHasta" />
        </div>
        <button class="btn btn-primary btn-sm" @onclick="CargarLista">Aplicar</button>
    </div>
</div>

@* ===================== Grid ===================== *@
<div class="ase-card">
    <div class="ase-card-h">Eventos RDA <small style="color:var(--muted)">@_rows.Count fila(s)</small></div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Paciente</th>
                    <th>Profesional</th>
                    <th>Sede</th>
                    <th>Modalidad</th>
                    <th>Ambiente</th>
                    <th>Estado</th>
                    <th>Hash</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td class="mono"><small>@r.FechaGeneracion.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small></td>
                        <td>
                            @if (r.TipoRda == TipoRdaIhce.Consulta)
                            {
                                <span class="badge bg-info text-dark">Consulta</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Paciente</span>
                            }
                        </td>
                        <td>
                            <div><b>@r.PacienteNombre</b></div>
                            <small class="mono" style="color:var(--muted)">@r.PacienteDocumento</small>
                        </td>
                        <td><small>@r.ProfesionalNombre</small></td>
                        <td>
                            <small>@r.SucursalNombre</small>
                            @if (!r.TieneCredencialSede)
                            {
                                <div>
                                    <span class="badge bg-warning text-dark" style="font-size:10px;"
                                          title="@r.MotivoBloqueoEnvio">
                                        sin credencial @r.Ambiente
                                    </span>
                                </div>
                            }
                        </td>
                        <td><small>@r.Modalidad</small></td>
                        <td>
                            @if (r.Ambiente == AmbienteIhce.Sandbox)
                            {
                                <span class="badge bg-warning text-dark">Sandbox</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Prod</span>
                            }
                        </td>
                        <td>@RenderEstado(r.Estado)</td>
                        <td class="mono"><small>@r.BundleHash.Substring(0, 12)…</small></td>
                        <td class="ase-row-actions" style="text-align:right;white-space:nowrap;">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => VerJson(r.Id)">Ver JSON</button>
                            @if (r.Estado is EstadoRdaEvento.Error or EstadoRdaEvento.Rechazado)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DescargarZip(r.Id)" title="ZIP con envio + error">Descargar ZIP</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => DescargarJson(r.Id)">Descargar</button>
                            }
                            @if (r.Estado is EstadoRdaEvento.Borrador or EstadoRdaEvento.Error or EstadoRdaEvento.Rechazado)
                            {
                                <button class="btn btn-success btn-sm" @onclick="() => EnviarAlIhce(r.Id)"
                                        disabled="@(_enviandoId == r.Id || !r.TieneCredencialSede)"
                                        title="@(r.TieneCredencialSede ? null : r.MotivoBloqueoEnvio)">
                                    @if (_enviandoId == r.Id) { <span>Enviando…</span> } else { <span>Enviar al IHCE</span> }
                                </button>
                            }
                            @if (r.Estado == EstadoRdaEvento.Borrador)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(r.Id)">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_rows.Count == 0 && !_cargando)
        {
            <div class="ase-empty">
                Sin eventos RDA todavia. Usa el boton <b>+ Generar RDA</b> para construir el primero
                a partir de una Historia Clinica.
            </div>
        }
    </div>
</div>

@* ===================== Modal Generar RDA ===================== *@
@if (_modalGenerar)
{
    <div class="ase-modal-bg" @onclick="CerrarGenerar">
        <div class="ase-modal" @onclick:stopPropagation="true" style="min-width:780px;max-width:980px;">
            <div class="ase-modal-h">Generar RDA desde Historia Clinica</div>
            <div style="padding:16px 18px;">
                <div class="ase-form" style="display:grid;grid-template-columns:1fr 180px 200px;gap:12px;align-items:end;">
                    <div class="ase-f">
                        <label>Buscar paciente (nombre o documento)</label>
                        <input class="form-control form-control-sm" @bind="_buscarHc" @bind:event="oninput"
                               @bind:after="BuscarHc" placeholder="JUAN... / 1010101010" />
                    </div>
                    <div class="ase-f">
                        <label>Tipo RDA</label>
                        <select class="form-select form-select-sm" @bind="_tipoRda">
                            <option value="Paciente">Paciente (antecedentes)</option>
                            <option value="Consulta">Consulta (atención)</option>
                        </select>
                    </div>
                    <div class="ase-f">
                        <label>Modalidad</label>
                        <select class="form-select form-select-sm" @bind="_modalidad">
                            <option value="ConsultaExterna">Consulta Externa (recomendado)</option>
                            <option value="Paciente">Paciente</option>
                            <option value="Hospitalizacion">Hospitalizacion</option>
                            <option value="Urgencias">Urgencias</option>
                        </select>
                    </div>
                </div>
                <div style="max-height:380px;overflow:auto;margin-top:12px;border:1px solid #eee;border-radius:8px;">
                    <table class="table table-sm align-middle" style="margin:0;">
                        <thead style="position:sticky;top:0;background:#f9fafb;z-index:1;">
                            <tr>
                                <th>Paciente</th>
                                <th>HC desde</th>
                                <th>Cerrada</th>
                                <th>Formato</th>
                                <th>Estado HC</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in _hcCandidatas)
                            {
                                <tr>
                                    <td>
                                        <div>@h.PacienteNombre</div>
                                        <small class="mono" style="color:var(--muted)">@h.PacienteDocumento</small>
                                    </td>
                                    <td class="mono"><small>@h.FechaApertura.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    <td class="mono"><small>@(h.FechaCierre?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "-")</small></td>
                                    <td class="mono"><small>@h.FormatoCodigo</small></td>
                                    <td><small>@h.Estado</small></td>
                                    <td class="ase-row-actions" style="text-align:right;">
                                        <button class="btn btn-primary btn-sm" @onclick="() => GenerarParaHc(h.Id)"
                                                disabled="@_generando">
                                            @if (_generando && _generandoHcId == h.Id) { <span>Generando…</span> }
                                            else { <span>Generar</span> }
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_hcCandidatas.Count == 0)
                    {
                        <div class="ase-empty" style="padding:24px;">Sin resultados. Escribe en el buscador.</div>
                    }
                </div>
                @if (_advertenciasUltimo.Count > 0)
                {
                    <div class="ase-alert" style="margin-top:12px;background:#fff7e6;border-color:#ffd591;color:#7a4f01;">
                        <b>Advertencias del ultimo Bundle generado:</b>
                        <ul style="margin:8px 0 0 18px;font-size:13px;">
                            @foreach (var a in _advertenciasUltimo)
                            {
                                <li>@a</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div class="ase-modal-f">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarGenerar">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal resultado envio IHCE ===================== *@
@if (_envioResult is not null)
{
    <div class="ase-modal-bg" @onclick="CerrarEnvio">
        <div class="ase-modal" @onclick:stopPropagation="true" style="min-width:680px;max-width:900px;max-height:80vh;display:flex;flex-direction:column;">
            <div class="ase-modal-h">
                @if (_envioResult.Call.Exito)
                {
                    <span style="color:#0a7d3a">RDA aceptado por MinSalud</span>
                }
                else
                {
                    <span style="color:#c0392b">Envio fallido (@_envioResult.Call.HttpStatus)</span>
                }
            </div>
            <div style="padding:16px 18px;overflow:auto;flex:1;">
                <table class="table table-sm" style="margin-bottom:12px;">
                    <tbody>
                        <tr><td style="width:180px"><b>Estado evento</b></td><td>@_envioResult.NuevoEstado</td></tr>
                        <tr><td><b>HTTP</b></td><td>@_envioResult.Call.HttpStatus @_envioResult.Call.Mensaje</td></tr>
                        <tr><td><b>Tiempo</b></td><td>@_envioResult.Call.ElapsedMs ms</td></tr>
                        @if (!string.IsNullOrWhiteSpace(_envioResult.Call.ResponseContentType))
                        {
                            <tr><td><b>Content-Type</b></td><td class="mono"><small>@_envioResult.Call.ResponseContentType</small></td></tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(_envioResult.ReferenciaMinsalud))
                        {
                            <tr><td><b>Referencia MinSalud</b></td><td class="mono">@_envioResult.ReferenciaMinsalud</td></tr>
                        }
                    </tbody>
                </table>
                @if (!string.IsNullOrWhiteSpace(_envioResult.Call.ResponseBody))
                {
                    <div style="font-weight:600;font-size:12px;color:var(--muted);margin-bottom:6px;text-transform:uppercase;">
                        Respuesta de MinSalud (cuerpo)
                    </div>
                    <pre style="background:#0d1117;color:#e6edf3;padding:14px;border-radius:8px;font-size:12px;max-height:300px;overflow:auto;"><code>@_envioResult.Call.ResponseBody</code></pre>
                }
            </div>
            <div class="ase-modal-f">
                <button class="btn btn-primary btn-sm" @onclick="CerrarEnvio">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ===================== Modal Ver JSON ===================== *@
@if (_detail is not null)
{
    var tieneError = !string.IsNullOrWhiteSpace(_detail.ErroresJson);
    <div class="ase-modal-bg" @onclick="CerrarDetalle">
        <div class="ase-modal" @onclick:stopPropagation="true" style="min-width:880px;max-width:1180px;max-height:85vh;display:flex;flex-direction:column;">
            <div class="ase-modal-h">
                Bundle FHIR — @_detail.Estado
                <span class="badge bg-secondary ms-2 mono"><small>@_detail.BundleHash.Substring(0,16)…</small></span>
            </div>
            <ul class="nav nav-tabs" style="padding:0 18px;margin-top:8px;">
                <li class="nav-item">
                    <button class="nav-link @(_detailTab=="bundle"?"active":"")" @onclick='() => _detailTab="bundle"'>
                        Envio (Bundle FHIR)
                    </button>
                </li>
                @if (tieneError)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_detailTab=="error"?"active":"") text-danger" @onclick='() => _detailTab="error"'>
                            Error recibido
                        </button>
                    </li>
                }
                @if (_cred is not null)
                {
                    <li class="nav-item">
                        <button class="nav-link @(_detailTab=="cred"?"active":"")" @onclick='() => _detailTab="cred"'>
                            Credenciales usadas
                        </button>
                    </li>
                }
            </ul>
            <div style="padding:12px 18px 12px;overflow:auto;flex:1;">
                @if (_detailTab == "cred" && _cred is not null)
                {
                    <div style="font-size:12px;color:#666;margin-bottom:8px;">
                        Estas son las credenciales y parametros que uso (o usaria) este envio.
                        Click en el ojito para revelar los valores sensibles.
                    </div>
                    <table class="table table-sm mb-0" style="font-size:12px;">
                        <tbody>
                            @RenderCredRow("Ambiente", _cred.Ambiente, sensitive: false)
                            @RenderCredRow("Endpoint base", _cred.EndpointBase, sensitive: false)
                            @RenderCredRow("Path envio", _cred.PathEnvio, sensitive: false)
                            @RenderCredRow("Codigo Habilitacion (REPS)", _cred.CodigoHabilitacion, sensitive: false)
                            @RenderCredRow("Azure Tenant ID", _cred.AzureTenantId, sensitive: true)
                            @RenderCredRow("Scope", _cred.Scope, sensitive: true)
                            @RenderCredRow("Client ID", _cred.ClientId, sensitive: true)
                            @RenderCredRow("Client Secret", _cred.ClientSecret, sensitive: true)
                            @RenderCredRow("APIM Subscription Key", _cred.ApimSubskey, sensitive: true)
                        </tbody>
                    </table>
                }
                else if (!tieneError || _detailTab == "bundle")
                {
                    <pre style="background:#0d1117;color:#e6edf3;padding:14px;border-radius:8px;font-size:12px;max-height:60vh;overflow:auto;margin:0;"><code>@_detail.BundleJson</code></pre>
                }
                else
                {
                    var parsed = ParseErrorSummary(_detail.ErroresJson!);
                    <div style="max-height:62vh;overflow:auto;padding-right:4px;">
                        @* Chip row: HTTP + elapsed + contentType *@
                        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;">
                            @if (parsed.HttpStatus is int http)
                            {
                                var httpClass = http >= 400 ? "bg-danger" : (http >= 300 ? "bg-warning text-dark" : "bg-success");
                                <span class="badge @httpClass">HTTP @http</span>
                            }
                            @if (parsed.ElapsedMs is int ms)
                            {
                                <span class="badge bg-secondary">@ms ms</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(parsed.ContentType))
                            {
                                <span class="badge bg-light text-dark mono" style="border:1px solid #ddd;">@parsed.ContentType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(parsed.Categoria))
                            {
                                <span class="badge bg-light text-dark" style="border:1px solid #ddd;">@parsed.Categoria</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(parsed.Preflight))
                            {
                                <span class="badge bg-warning text-dark" title="Fallo en pre-flight, RDA no enviado">preflight: @parsed.Preflight</span>
                            }
                        </div>

                        @* Mensaje *@
                        @if (!string.IsNullOrWhiteSpace(parsed.Mensaje))
                        {
                            <div class="alert alert-danger" style="padding:10px 12px;margin-bottom:10px;font-size:13px;">
                                <strong>Mensaje:</strong> @parsed.Mensaje
                            </div>
                        }

                        @* Response body (OperationOutcome u otro JSON) - pretty *@
                        @if (!string.IsNullOrWhiteSpace(parsed.BodyPretty))
                        {
                            <div style="font-size:12px;color:#666;margin-bottom:4px;">Respuesta del servidor (body):</div>
                            <pre style="background:#2d1414;color:#ffdada;padding:12px;border-radius:6px;font-size:12px;max-height:32vh;overflow:auto;margin:0 0 10px 0;"><code>@parsed.BodyPretty</code></pre>
                        }

                        @* Contexto (sede/REPS/ClientID) - grilla clave:valor *@
                        @if (parsed.Contexto.Count > 0)
                        {
                            <div style="font-size:12px;color:#666;margin-bottom:4px;">Contexto del envio:</div>
                            <table class="table table-sm mb-2" style="font-size:12px;background:#fafafa;">
                                <tbody>
                                @foreach (var kv in parsed.Contexto)
                                {
                                    <tr>
                                        <th style="width:200px;background:#f0f0f0;">@kv.Key</th>
                                        <td class="mono">@kv.Value</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @* Fallback / raw *@
                        <details style="margin-top:8px;">
                            <summary style="cursor:pointer;font-size:11px;color:#888;">Ver JSON crudo</summary>
                            <pre style="background:#f5f5f5;color:#333;padding:8px;border-radius:4px;font-size:11px;max-height:20vh;overflow:auto;margin-top:6px;"><code>@parsed.RawPretty</code></pre>
                        </details>
                    </div>
                }
            </div>
            <div class="ase-modal-f">
                @if (tieneError)
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DescargarZip(_detail.Id)">Descargar ZIP (envio + error)</button>
                }
                else
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => DescargarJson(_detail.Id)">Descargar bundle</button>
                }
                <button class="btn btn-primary btn-sm" @onclick="CerrarDetalle">Cerrar</button>
            </div>
        </div>
    </div>
}

<style>
    .ase-modal-bg { position:fixed;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:1000; }
    .ase-modal { background:#fff;border-radius:12px;box-shadow:0 16px 48px rgba(0,0,0,0.2); }
    .ase-modal-h { padding:14px 18px;font-weight:600;border-bottom:1px solid #eee;font-size:15px; }
    .ase-modal-f { padding:12px 18px;border-top:1px solid #eee;display:flex;justify-content:flex-end;gap:8px; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>

@code {
    private string? _error;
    private string? _ok;
    private bool _cargando;

    private List<RdaEventoRowDto> _rows = new();

    // ----- Filtros -----
    private string? _filtroDoc;
    private string? _filtroEstado;
    private string? _filtroAmb;
    private DateTime? _filtroDesde;
    private DateTime? _filtroHasta;

    // ----- Modal Generar -----
    private bool _modalGenerar;
    private string? _buscarHc;
    private string _modalidad = "ConsultaExterna";
    private string _tipoRda = "Paciente";
    private List<HcCandidataRdaDto> _hcCandidatas = new();
    private bool _generando;
    private Guid? _generandoHcId;
    private List<string> _advertenciasUltimo = new();
    // Serializa TODAS las operaciones sobre el DbContext scoped del circuito
    // Blazor. Sin este lock global, si el usuario abre el probador mientras
    // CargarLista aun corre, o dispara Refrescar antes de que responda la
    // primera consulta, EF Core revienta con "A second operation was started on
    // this context instance". El semaforo cubre CargarLista/BuscarHc/AbrirVerJson/
    // GenerarParaHc/EliminarRdaAsync — todo lo que toque Svc.*.
    private readonly SemaphoreSlim _dbLock = new(1, 1);

    // ----- Modal Ver JSON -----
    private RdaEventoDetailDto? _detail;
    private RdaEventoCredencialesDto? _cred;
    private string _detailTab = "bundle";  // "bundle" | "error" | "cred"
    private readonly HashSet<string> _reveladas = new();

    // ----- Envio al IHCE -----
    private Guid? _enviandoId;
    private EnvioRdaResultado? _envioResult;

    // ----- Diagnostico IP publica -----
    private bool _ipBusy;
    private IpPublicaResult? _ipResult;

    private async Task ConsultarIpAsync()
    {
        _ipBusy = true; _error = null;
        try { _ipResult = await Sender.ConsultarIpPublicaAsync(); }
        catch (Exception ex) { _error = "No se pudo consultar la IP: " + ex.Message; }
        finally { _ipBusy = false; }
    }

    // ----- Probador de servicios IHCE -----
    private string _probadorTipoDoc = "CC";
    private string? _probadorNumDoc;
    private string _probadorServicio = "profesional";
    private bool _probadorBusy;
    private IhceCallResult? _probadorResult;

    protected override async Task OnInitializedAsync() => await CargarLista();

    private async Task CargarLista()
    {
        _error = null;
        _cargando = true;
        await _dbLock.WaitAsync();
        try
        {
            var filtro = new RdaConsoleFiltro(
                _filtroDoc,
                Enum.TryParse<EstadoRdaEvento>(_filtroEstado, out var e) ? e : null,
                Enum.TryParse<AmbienteIhce>(_filtroAmb, out var a) ? a : null,
                _filtroDesde is DateTime fd ? DateOnly.FromDateTime(fd) : null,
                _filtroHasta is DateTime fh ? DateOnly.FromDateTime(fh) : null);
            _rows = (await Svc.ListarAsync(filtro)).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; _dbLock.Release(); }
    }

    private async Task AbrirGenerar()
    {
        _modalGenerar = true;
        _buscarHc = null;
        _hcCandidatas = new();
        _advertenciasUltimo = new();
        await BuscarHc();
    }

    private void CerrarGenerar() => _modalGenerar = false;

    private async Task BuscarHc()
    {
        // Serializado: cada keystroke en el buscador dispara BuscarHc via @bind:after,
        // y todas las llamadas comparten el DbContext scoped del circuito Blazor.
        // Sin este lock el usuario tipea "MARIA" y se lanzan 5 queries en paralelo,
        // reventando con "A second operation was started on this context instance".
        await _dbLock.WaitAsync();
        try
        {
            _hcCandidatas = (await Svc.ListarHcCandidatasAsync(_buscarHc)).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _dbLock.Release(); }
    }

    private async Task GenerarParaHc(Guid hcId)
    {
        _error = null; _ok = null;
        _generando = true; _generandoHcId = hcId;
        await _dbLock.WaitAsync();
        try
        {
            var actor = await ActorAsync();
            var modalidad = Enum.Parse<ModalidadRdaIhce>(_modalidad);
            var res = _tipoRda == "Consulta"
                ? await BuilderConsulta.ConstruirAsync(hcId, actor)
                : await Builder.ConstruirAsync(hcId, modalidad, actor);
            _advertenciasUltimo = res.Advertencias.ToList();
            _ok = res.YaExistia
                ? $"Bundle ya existia (hash {res.BundleHash[..12]}…). No se duplico."
                : $"RDA generado: {res.RecursosCount} recursos, hash {res.BundleHash[..12]}…";
            // Ojo: CargarLista tambien pide _dbLock; para no deadlockear liberamos primero.
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _generando = false; _generandoHcId = null; _dbLock.Release(); }
        await CargarLista();
    }

    private async Task VerJson(Guid id)
    {
        _detailTab = "bundle";
        _reveladas.Clear();
        _cred = null;
        await _dbLock.WaitAsync();
        try
        {
            _detail = await Svc.ObtenerAsync(id);
            if (_detail is not null)
            {
                // Descifra credenciales para mostrar en el tab "Credenciales
                // usadas". El servidor devuelve valores planos, la UI decide
                // enmascarar o revelar via el toggle 👁.
                _cred = await Svc.ObtenerCredencialesUsadasAsync(id);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _dbLock.Release(); }
    }

    private void CerrarDetalle() { _detail = null; _cred = null; _reveladas.Clear(); }

    private void ToggleRevelar(string campo)
    {
        if (!_reveladas.Add(campo)) { _reveladas.Remove(campo); }
    }

    // ----- Parseo de ErroresJson para render bonito en el tab "Error recibido" -----
    // El JSON puede venir en 2 formas: (a) fallo en el envio POST del bundle
    // (SerializeError -> {body, mensaje, elapsedMs, httpStatus, contentType}), o
    // (b) fallo en pre-flight (extendido con contexto, categoria, preflight).
    // El campo "body" suele ser a su vez un JSON string (FHIR OperationOutcome);
    // lo re-parseamos para pretty-print anidado.
    private sealed class ErrorSummary
    {
        public string? Mensaje { get; set; }
        public int? HttpStatus { get; set; }
        public int? ElapsedMs { get; set; }
        public string? ContentType { get; set; }
        public string? BodyPretty { get; set; }
        public string? Categoria { get; set; }
        public string? Preflight { get; set; }
        public List<KeyValuePair<string, string>> Contexto { get; } = new();
        public string RawPretty { get; set; } = "";
    }

    private static readonly System.Text.Json.JsonSerializerOptions _pretty =
        new() { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private static ErrorSummary ParseErrorSummary(string json)
    {
        var r = new ErrorSummary();
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            r.RawPretty = System.Text.Json.JsonSerializer.Serialize(doc.RootElement, _pretty);
            var root = doc.RootElement;

            static string? Str(System.Text.Json.JsonElement el, string name)
                => el.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
            static int? Int(System.Text.Json.JsonElement el, string name)
                => el.TryGetProperty(name, out var v) && v.TryGetInt32(out var i) ? i : (int?)null;

            r.Mensaje = Str(root, "mensaje");
            r.Categoria = Str(root, "categoria");
            r.Preflight = Str(root, "preflight");

            // Rama (a): campos al nivel raiz.
            r.HttpStatus = Int(root, "httpStatus");
            r.ElapsedMs = Int(root, "elapsedMs");
            r.ContentType = Str(root, "contentType");
            var bodyStr = Str(root, "body");

            // Rama (b): sub-objeto "consulta" tiene body/elapsed/httpStatus.
            if (root.TryGetProperty("consulta", out var consulta) && consulta.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                r.HttpStatus ??= Int(consulta, "httpStatus");
                r.ElapsedMs ??= Int(consulta, "elapsedMs");
                r.ContentType ??= Str(consulta, "contentType");
                bodyStr ??= Str(consulta, "body");
            }

            if (!string.IsNullOrWhiteSpace(bodyStr))
            {
                r.BodyPretty = TryPrettyJson(bodyStr) ?? bodyStr.Trim();
            }

            if (root.TryGetProperty("contexto", out var ctx) && ctx.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var p in ctx.EnumerateObject())
                {
                    var val = p.Value.ValueKind switch
                    {
                        System.Text.Json.JsonValueKind.String => p.Value.GetString() ?? "",
                        System.Text.Json.JsonValueKind.Number => p.Value.GetRawText(),
                        System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False => p.Value.GetRawText(),
                        System.Text.Json.JsonValueKind.Null => "(null)",
                        _ => p.Value.GetRawText()
                    };
                    r.Contexto.Add(new(p.Name, val));
                }
            }
        }
        catch
        {
            // Si el JSON no parsea, mostramos el texto tal cual como fallback en RawPretty.
            r.RawPretty = json;
        }
        return r;
    }

    private static string? TryPrettyJson(string s)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(s);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, _pretty);
        }
        catch { return null; }
    }

    // Fila de credencial en la tabla del tab. Enmascarada por defecto para los
    // campos sensitive; el toggle 👁 muestra el valor real. Los valores nunca
    // salen del server sin auth (el endpoint que los descifra es RequireAuth).
    private RenderFragment RenderCredRow(string label, string? value, bool sensitive) => __builder =>
    {
        var revelado = !sensitive || _reveladas.Contains(label);
        var display = string.IsNullOrEmpty(value)
            ? "(sin cargar)"
            : (revelado ? value : new string('*', Math.Min(value.Length, 24)));
        <tr>
            <th style="width:220px;background:#f5f5f5;font-weight:500;">@label</th>
            <td class="mono" style="word-break:break-all;">
                <span style="user-select:@(revelado ? "text" : "none");">@display</span>
            </td>
            <td style="width:80px;white-space:nowrap;text-align:right;">
                @if (sensitive && !string.IsNullOrEmpty(value))
                {
                    <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => ToggleRevelar(label)"
                            title="@(revelado ? "Ocultar" : "Mostrar")"
                            style="font-size:14px;text-decoration:none;">
                        @(revelado ? "🙈" : "👁")
                    </button>
                }
                @if (revelado && !string.IsNullOrEmpty(value))
                {
                    <button class="btn btn-link btn-sm p-0" @onclick="@(() => JS.InvokeVoidAsync("navigator.clipboard.writeText", value))"
                            title="Copiar" style="font-size:12px;text-decoration:none;">📋</button>
                }
            </td>
        </tr>
    };

    // Descarga en 2 sabores: bundle plano (JSON) o paquete completo (ZIP con
    // envio/ + error/ + README) cuando el evento tiene errores reportados.
    // Ambas usan el endpoint /interoperabilidad/rda/{id}/download.
    private void DescargarJson(Guid id)
    {
        Nav.NavigateTo($"/interoperabilidad/rda/{id}/download?format=json", forceLoad: true);
    }

    private void DescargarZip(Guid id)
    {
        Nav.NavigateTo($"/interoperabilidad/rda/{id}/download?format=zip", forceLoad: true);
    }

    private async Task EnviarAlIhce(Guid id)
    {
        _error = null; _ok = null; _envioResult = null;
        _enviandoId = id;
        await _dbLock.WaitAsync();
        try
        {
            var actor = await ActorAsync();
            _envioResult = await Sender.EnviarRdaAsync(id, actor);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _enviandoId = null; _dbLock.Release(); }
        await CargarLista();
    }

    private void CerrarEnvio() => _envioResult = null;

    private async Task EjecutarProbador()
    {
        _error = null; _ok = null; _probadorResult = null;
        if (string.IsNullOrWhiteSpace(_probadorNumDoc))
        {
            _error = _probadorServicio switch
            {
                "organizacion" => "Ingresa el REPS (codigo de habilitacion) a consultar.",
                "eapb" => "Ingresa el nombre de la EAPB a consultar.",
                _ => "Ingresa un numero de documento."
            };
            return;
        }
        _probadorBusy = true;
        try
        {
            var valor = _probadorNumDoc.Trim();
            _probadorResult = _probadorServicio switch
            {
                "profesional" => await Sender.ConsultarProfesionalAsync(new ConsultaPacienteRequest(_probadorTipoDoc, valor)),
                "organizacion" => await Sender.ConsultarOrganizacionAsync(new ConsultaOrganizacionRequest(
                    TaxIdentifier: null,
                    HealthcareProviderIdentifier: valor,
                    Name: null)),
                "eapb" => await Sender.ConsultarEapbAsync(new ConsultaEapbRequest(valor)),
                _ => await Sender.ConsultarPacienteAsync(new ConsultaPacienteRequest(_probadorTipoDoc, valor))
            };
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _probadorBusy = false; }
    }

    private async Task Eliminar(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Eliminar este Borrador? La accion no se puede deshacer.")) { return; }
        await _dbLock.WaitAsync();
        try
        {
            var actor = await ActorAsync();
            await Svc.EliminarAsync(id, actor);
            _ok = "Evento eliminado.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _dbLock.Release(); }
        await CargarLista();
    }

    private static RenderFragment RenderEstado(EstadoRdaEvento e) => __builder =>
    {
        var (color, text) = e switch
        {
            EstadoRdaEvento.Borrador => ("secondary", "Borrador"),
            EstadoRdaEvento.Validado => ("info", "Validado"),
            EstadoRdaEvento.Enviado => ("primary", "Enviado"),
            EstadoRdaEvento.Aceptado => ("success", "Aceptado"),
            EstadoRdaEvento.Rechazado => ("danger", "Rechazado"),
            EstadoRdaEvento.Error => ("warning text-dark", "Error"),
            _ => ("secondary", e.ToString())
        };
        __builder.AddMarkupContent(0, $"<span class=\"badge bg-{color}\">{text}</span>");
    };

    private async Task<Guid> ActorAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var sub = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        return Guid.TryParse(sub, out var g) ? g : Guid.Empty;
    }
}
