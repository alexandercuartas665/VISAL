@page "/imprimir-ordenes-filtradas"
@layout Visal.SuperAdmin.Components.Layout.EmptyLayout
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using Visal.Application.Tenancy
@using Visal.Application.Tenancy.Forms
@using Visal.SuperAdmin.Components.Forms
@inject IOrdenesClinicasService OcSvc
@inject IHistoriaClinicaService HcSvc
@inject IJSRuntime JS
@inject NavigationManager Nav

@*
   HCs-Print (listado) — Impresion masiva de TODAS las HCs que aparecen en
   /ordenes con los filtros actuales (multi-paciente). Se llega aqui via el
   boton "Imprimir listado" de Ordenes.razor. Recibe los MISMOS filtros que
   Ordenes.razor pasa por query string y reusa OcSvc.BuscarAsync para traer
   exactamente las mismas filas que el usuario ve en la tabla, respetando el
   flag HideIfEmpty al renderizar cada HC con <FormViewer ReadOnly>.

   Query string (todos opcionales):
     paciente     - texto libre (nombre o documento)
     desde/hasta  - rango de fechas (yyyy-MM-dd)
     especialista - nombre exacto
     estado       - "Cerrada" / "Abierta" / "" (todos)
     aseguradoraId, sucursalId - GUID
     formatoCodigo - codigo o codigo secundario del FormDefinition

   Tope de seguridad: MAX_HCS evita cuelgues por listados de miles de HCs.
   Si el listado excede, mostramos aviso al usuario para que refine filtros.
*@

<PageTitle>Impresion masiva - Visal</PageTitle>

<style>
    /* Estilos propios de esta pagina (acciones + resumen + aviso). El renderer
       de cada HC (.pack-doc, .pack-header, .pack-grid, etc.) lo aporta el
       propio DocumentoImprimible.razor y su .pack-doc trae page-break-after
       para separar los documentos al imprimir. */
    .doc-actions { display:flex; gap:8px; align-items:center; margin:14px auto; max-width:920px; }
    .doc-actions .dbtn { padding:8px 14px; border:1px solid var(--border); border-radius:8px; background:var(--card); font-size:13px; font-weight:600; cursor:pointer; color:var(--foreground); text-decoration:none; }
    .doc-actions .dbtn.primary { background:var(--primary); border-color:var(--primary); color:#fff; }
    .doc-actions .spacer { flex:1; }
    .doc-actions .meta { font-size:12px; color:var(--muted-foreground); }

    .hcs-summary { max-width:920px; margin:0 auto 12px; padding:10px 14px; background:#f3f6fb; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; }
    .hcs-summary b { color:#1565c0; }
    .hcs-empty { max-width:920px; margin:40px auto; padding:32px; background:#fff; border:1px dashed #cbd5e1; border-radius:8px; text-align:center; color:#64748b; }
    .hcs-warn { max-width:920px; margin:14px auto; padding:12px 16px; background:#fff8e1; border:1px solid #ffc107; border-radius:6px; font-size:13px; color:#5c4a00; }

    .pack { max-width:920px; margin: 0 auto; }

    /* Estilos del renderer .pack-* — mismos que ImprimirPaquete.razor para
       lograr look-and-feel identico. El componente DocumentoImprimible los
       consume por clase; los definimos aqui a nivel de pagina para que
       apliquen a TODAS las instancias del componente en un solo lugar. */
    .pack-doc { background:#fff; color:#000; font-family:'Segoe UI', Arial, sans-serif; font-size:12px; line-height:1.35; border:1px solid #000; margin-bottom: 22px; }
    .pack-header { border-bottom:1px solid #000; padding:8px 10px; }
    .pack-hdr-top { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
    .pack-hdr-brand { display:flex; align-items:center; gap:8px; }
    .pack-hdr-brand svg { width:30px; height:30px; color:#1565c0; }
    .pack-hdr-logo { max-height:48px; max-width:180px; object-fit:contain; }
    .pack-hdr-inst { font-size:16px; font-weight:800; color:#1565c0; }
    .pack-hdr-tag { font-size:10px; font-style:italic; color:#555; }
    .pack-hdr-nohist { font-size:11px; white-space:nowrap; text-align:right; }
    .pack-hdr-nohist b { font-size:12px; color:#1565c0; }
    .pack-hdr-title { text-align:center; font-size:15px; font-weight:800; text-transform:uppercase; margin:6px 0; }
    .pack-hdr-meta { display:flex; gap:28px; font-size:11px; flex-wrap:wrap; }
    .pack-hdr-meta b { color:#1565c0; }

    .pack-band { background:#dde7f3; font-weight:800; font-size:11px; padding:4px 8px; text-transform:uppercase; border-bottom:1px solid #000; letter-spacing:.04em; }
    .pack-sub { font-weight:700; font-size:11px; padding:4px 8px; background:#f3f6fb; border-bottom:1px solid #000; }
    .pack-para { padding:4px 8px; border-bottom:1px solid #000; color:#222; white-space:pre-wrap; }
    .pack-grid { display:grid; grid-template-columns: repeat(12, 1fr); }
    .pack-cell { border-right:1px solid #000; border-bottom:1px solid #000; padding:2px 6px 4px; min-height:34px; }
    .pack-label { font-size:9px; font-weight:700; text-transform:uppercase; color:#333; }
    .pack-value { min-height:14px; border-bottom:1px dotted #999; margin-top:4px; padding:1px 2px; font-size:12px; color:#000; white-space:pre-wrap; word-break:break-word; }

    .pack-table { width:100%; border-collapse:collapse; }
    .pack-table th { border:1px solid #000; background:#dde7f3; font-size:10px; padding:4px 6px; text-align:left; font-weight:700; text-transform:uppercase; }
    .pack-table td { border:1px solid #000; padding:4px 6px; font-size:11px; vertical-align:top; }
    .pack-firma-img { max-width:100%; max-height:70px; display:block; margin:2px 0; object-fit:contain; background:#fff; }

    /* Un documento por pagina al imprimir. */
    .pack-doc { page-break-after: always; break-after: page; }
    .pack-doc:last-child { page-break-after: auto; break-after: auto; }

    @@media print {
        .visal-sidebar, .visal-topbar, .doc-actions, .hcs-summary, .hcs-warn { display:none !important; }
        .visal-main, .visal-shell { margin:0 !important; padding:0 !important; }
        .pack { max-width:none; }
        .pack-doc { margin-bottom:0; border:1px solid #000; }
        body { background:#fff !important; }
        @@page { size: A4; margin: 12mm; }
    }
</style>

@if (_loading)
{
    <p class="doc-actions">Cargando HCs del listado filtrado...</p>
}
else
{
    <div class="doc-actions">
        <a class="dbtn" href="javascript:window.close()">&times; Cerrar</a>
        <button class="dbtn primary" @onclick="PrintAsync">&#128424; Imprimir todo / Guardar PDF</button>
        <span class="spacer"></span>
        <span class="meta">@_hcs.Count HC(s) · @_pacientesUnicos paciente(s)</span>
    </div>

    <div class="hcs-summary">
        <b>Listado filtrado</b>
        @if (!string.IsNullOrWhiteSpace(_pacienteFiltro))
        {
            <text> &nbsp;·&nbsp; <b>Paciente contiene:</b> @_pacienteFiltro</text>
        }
        @if (!string.IsNullOrWhiteSpace(_formatoCodigoFiltro))
        {
            <text> &nbsp;·&nbsp; <b>Formato HC:</b> @_formatoCodigoFiltro</text>
        }
        @if (!string.IsNullOrWhiteSpace(_estadoFiltro))
        {
            <text> &nbsp;·&nbsp; <b>Estado:</b> @_estadoFiltro</text>
        }
        @if (_desdeFiltro is DateOnly dd)
        {
            <text> &nbsp;·&nbsp; <b>Desde:</b> @dd.ToString("yyyy-MM-dd")</text>
        }
        @if (_hastaFiltro is DateOnly dh)
        {
            <text> &nbsp;·&nbsp; <b>Hasta:</b> @dh.ToString("yyyy-MM-dd")</text>
        }
        @if (!string.IsNullOrWhiteSpace(_especialistaFiltro))
        {
            <text> &nbsp;·&nbsp; <b>Especialista:</b> @_especialistaFiltro</text>
        }
    </div>

    @if (_excedeTope)
    {
        <div class="hcs-warn">
            <b>Aviso:</b> el listado tiene @_totalEncontrado HCs. Por rendimiento solo se imprimieron las primeras @MaxHcs.
            Refina los filtros (rango de fechas, paciente, formato) para imprimir el resto.
        </div>
    }

    @if (_hcs.Count == 0)
    {
        <div class="hcs-empty">
            No hay HCs que coincidan con los filtros aplicados.
        </div>
    }
    else
    {
        <div class="pack">
            @foreach (var item in _hcs)
            {
                if (item.Schema is null)
                {
                    <div class="pack-doc" style="padding:14px;">
                        <p><em>No se pudo cargar el schema del formato para @item.PacienteNombre (@item.Detail.FormatoCodigo).</em></p>
                    </div>
                    continue;
                }
                var fechaLinea = item.Detail.FechaCierre is DateTimeOffset fc
                    ? $"Cerrada: {fc.ToLocalTime():dd/MM/yyyy HH:mm}"
                    : $"Apertura: {item.Detail.FechaApertura.ToLocalTime():dd/MM/yyyy HH:mm}";
                <DocumentoImprimible Schema="item.Schema"
                                     Values="item.Values"
                                     PacienteNombre="item.PacienteNombre"
                                     PacienteTipoDoc="item.PacienteTipoDoc"
                                     PacienteDoc="item.PacienteDoc"
                                     EspecialistaNombre="item.Detail.EspecialistaNombre"
                                     OrdenNum="@item.Detail.Id.ToString().Substring(0,8).ToUpperInvariant()"
                                     FechaLinea="@fechaLinea"
                                     TipoCortoHeader="HC"
                                     TituloFallback="@item.Detail.FormatoNombre" />
            }
        </div>
    }
}

@code {
    // REV-18 — Tope duro para no colgar el navegador. Subido a 2000: el usuario
    // reporto que 100 dejaba fuera muchas HCs del filtro (170+ en pruebas). Con
    // 2000 se cubren la mayoria de casos operativos (auditoria mensual completa
    // por sede/formato). Con schema real cada HC pesa ~150-300KB de DOM asi
    // que 2000 = ~300-600MB — pesado pero manejable en un equipo moderno con
    // la advertencia visible. Si el usuario necesita mas, que refine filtros.
    private const int MaxHcs = 2000;

    private bool _loading = true;
    private List<HcRender> _hcs = new();
    private int _pacientesUnicos;
    private int _totalEncontrado;
    private bool _excedeTope;

    private string? _pacienteFiltro;
    private string? _formatoCodigoFiltro;
    private string? _estadoFiltro;
    private string? _especialistaFiltro;
    private DateOnly? _desdeFiltro;
    private DateOnly? _hastaFiltro;

    private sealed record HcRender(
        HistoriaClinicaDetailDto Detail,
        FormSchema? Schema,
        Dictionary<string, string?> Values,
        string PacienteNombre,
        string PacienteTipoDoc,
        string PacienteDoc);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var q = QueryHelpers.ParseQuery(uri.Query);

            _pacienteFiltro = Get(q, "paciente");
            _formatoCodigoFiltro = Get(q, "formatoCodigo");
            _estadoFiltro = Get(q, "estado");
            _especialistaFiltro = Get(q, "especialista");
            if (q.TryGetValue("desde", out var dd) && DateOnly.TryParse(dd.ToString(), out var d1)) { _desdeFiltro = d1; }
            if (q.TryGetValue("hasta", out var dh) && DateOnly.TryParse(dh.ToString(), out var d2)) { _hastaFiltro = d2; }
            Guid? aseguradoraId = null;
            Guid? sucursalId = null;
            if (q.TryGetValue("aseguradoraId", out var av) && Guid.TryParse(av.ToString(), out var aid)) { aseguradoraId = aid; }
            if (q.TryGetValue("sucursalId", out var sv) && Guid.TryParse(sv.ToString(), out var sid)) { sucursalId = sid; }

            var filtro = new OrdenesClinicasFiltro(
                PacienteTexto: _pacienteFiltro,
                Desde: _desdeFiltro,
                Hasta: _hastaFiltro,
                Especialista: _especialistaFiltro,
                SoloCerradas: string.Equals(_estadoFiltro, "Cerrada", StringComparison.OrdinalIgnoreCase),
                AseguradoraId: aseguradoraId,
                SucursalId: sucursalId,
                FormatoCodigo: _formatoCodigoFiltro);

            var todas = (await OcSvc.BuscarAsync(filtro)).ToList();
            // Post-filtro "Solo Abiertas" (mismo criterio que Ordenes.razor: SoloCerradas
            // se maneja en el service; para "Abiertas" filtramos en memoria).
            if (string.Equals(_estadoFiltro, "Abierta", StringComparison.OrdinalIgnoreCase))
            {
                todas = todas.Where(x => string.Equals(x.Estado, "Abierta", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            _totalEncontrado = todas.Count;
            _pacientesUnicos = todas.Select(x => x.PacienteId).Distinct().Count();
            if (todas.Count > MaxHcs)
            {
                _excedeTope = true;
                todas = todas.Take(MaxHcs).ToList();
            }

            // Cargar detail+schema+values por cada HC. Loop secuencial simple:
            // <=100 HCs, cada GetAsync es un roundtrip. Suficiente para el
            // caso de uso; si escalamos, se puede paralelizar con SemaphoreSlim.
            foreach (var r in todas)
            {
                var detail = await HcSvc.GetAsync(r.HistoriaClinicaId);
                if (detail is null) { continue; }
                FormSchema? schema = null;
                if (!string.IsNullOrWhiteSpace(detail.SchemaJson))
                {
                    try { schema = JsonSerializer.Deserialize<FormSchema>(detail.SchemaJson); }
                    catch { schema = null; }
                }
                Dictionary<string, string?> values = new();
                if (!string.IsNullOrWhiteSpace(detail.ValoresJson))
                {
                    try { values = JsonSerializer.Deserialize<Dictionary<string, string?>>(detail.ValoresJson) ?? new(); }
                    catch { values = new(); }
                }
                _hcs.Add(new HcRender(detail, schema, values, r.PacienteNombre, r.PacienteTipoDoc, r.PacienteDoc));
            }
        }
        finally { _loading = false; }
    }

    private static string? Get(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key)
    {
        if (!q.TryGetValue(key, out var v)) { return null; }
        var s = v.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : s;
    }

    private async Task PrintAsync() { await JS.InvokeVoidAsync("print"); }
}
