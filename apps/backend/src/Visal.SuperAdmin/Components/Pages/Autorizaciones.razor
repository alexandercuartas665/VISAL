@page "/autorizaciones"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Visal.Application.Tenancy
@using Visal.Domain.Entities
@inject IAutorizacionTokenService Svc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Autorizaciones - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Operacion Clinica</div>
        <h1 class="ase-title">Autorizaciones</h1>
        <small class="text-muted">
            Aprueba las solicitudes de los profesionales para cerrar historias fuera del patron de
            cierre del tipo de servicio, o genera tokens de 6 caracteres (vencen en 30 minutos, un
            solo uso). Todo queda trazado (quien autorizo, quien lo uso, HC/asignacion y motivo).
        </small>
    </div>
    @if (_puede)
    {
        <div style="display:flex; gap:8px;">
            <button class="btn btn-outline-secondary" @onclick="AbrirConceptos" disabled="@_busy">Conceptos</button>
            <button class="btn btn-primary" @onclick="AbrirGenerar" disabled="@_busy">+ Generar nuevo token</button>
        </div>
    }
</div>

@if (!_puede)
{
    <div class="ase-alert">No tienes permiso para este modulo. Pide el permiso "Autorizaciones" a un administrador.</div>
}
else
{
    @if (_error is not null) { <div class="ase-alert">@_error</div> }
    @if (_tokenGenerado is not null)
    {
        <div class="ase-ok">
            Token generado: <code class="tok-big">@_tokenGenerado</code>
            — vence @(_tokenGeneradoVence?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")).
            Comunicaselo al operador; es de un solo uso.
        </div>
    }

    <div class="az-tabs">
        <button class="az-tab @(_tab == "sol" ? "az-tab-on" : "")" @onclick="@(() => CambiarTabAsync("sol"))">
            Solicitudes @if (_pendientes > 0) { <span class="az-badge">@_pendientes</span> }
        </button>
        <button class="az-tab @(_tab == "tok" ? "az-tab-on" : "")" @onclick="@(() => CambiarTabAsync("tok"))">Tokens</button>
    </div>

    @if (_tab == "sol")
    {
        <div class="ase-card">
            <div class="az-sol-bar">
                <label class="az-chk"><input type="checkbox" @bind="_soloPendientes" @bind:after="CargarSolicitudesAsync" /> Solo pendientes</label>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CargarSolicitudesAsync" disabled="@_busy">&#8635; Actualizar</button>
                <small class="text-muted">Se actualiza solo cada 30 segundos.</small>
            </div>
            @if (_solError is not null) { <div class="ase-alert">@_solError</div> }
            @if (_sols.Count == 0)
            {
                <div class="ase-empty" style="padding:30px;">@(_soloPendientes ? "No hay solicitudes pendientes." : "Aun no hay solicitudes.")</div>
            }
            else
            {
                <div class="med-tbl-wrap">
                    <table class="table table-sm med-tbl">
                        <thead>
                            <tr>
                                <th style="width:130px">Solicitada</th>
                                <th>Profesional</th>
                                <th>Paciente</th>
                                <th>Servicio</th>
                                <th style="width:110px">F. atencion</th>
                                <th>Motivo</th>
                                <th style="width:180px" class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _sols)
                            {
                                <tr class="@(r.Estado == AutorizacionSolicitudEstado.Pendiente ? "" : "tok-usado")">
                                    <td>@r.SolicitadoEn.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(r.SolicitadoPorNombre ?? "—")</td>
                                    <td>
                                        <div>@(r.PacienteNombre ?? "—")</div>
                                        <small class="text-muted">@r.PacienteDocumento</small>
                                        <div>
                                            @if (r.HistoriaClinicaConsecutivo is long hc) { <span class="badge bg-light text-dark">HC-@hc.ToString("D6")</span> }
                                            @if (r.AsignacionConsecutivo is long asg) { <span class="badge bg-light text-dark">AS-@asg.ToString("D6")</span> }
                                        </div>
                                    </td>
                                    <td>
                                        <div>@(r.ServicioNombre ?? "—")</div>
                                        @if (!string.IsNullOrWhiteSpace(r.TipoServicio)) { <small class="text-muted">@r.TipoServicio</small> }
                                    </td>
                                    <td>@r.FechaAtencion.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (r.Tipo == AutorizacionSolicitudTipo.CierreAuditoriaIa)
                                        {
                                            <div><span class="badge" style="background:#fde68a;color:#78350f;">Cierre pese a rechazo del auditor IA</span></div>
                                        }
                                        else
                                        {
                                            <div><span class="badge" style="background:#e0f2fe;color:#075985;">Fecha de atenci&oacute;n fuera del patr&oacute;n</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.ConceptoNombre)) { <div><b>@r.ConceptoNombre</b></div> }
                                        <div>@r.Motivo</div>
                                        @if (!string.IsNullOrWhiteSpace(r.Detalle)) { <small class="text-muted">@r.Detalle</small> }
                                    </td>
                                    <td class="text-center">
                                        @if (r.Estado == AutorizacionSolicitudEstado.Pendiente)
                                        {
                                            <div style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap;">
                                                <button class="btn btn-success btn-sm" @onclick="() => AbrirResolver(r, true)" disabled="@_busy">&#10003; Aprobar</button>
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => AbrirResolver(r, false)" disabled="@_busy">Rechazar</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge @(r.Estado == AutorizacionSolicitudEstado.Aprobada ? "bg-success" : "bg-danger")">@(r.Estado == AutorizacionSolicitudEstado.Aprobada ? "Aprobada" : "Rechazada")</span>
                                            <div><small class="text-muted">@r.ResueltoPorNombre @(r.ResueltoEn?.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM HH:mm"))</small></div>
                                            @if (!string.IsNullOrWhiteSpace(r.Respuesta)) { <div class="az-obs-corta"><small class="text-muted">@r.Respuesta</small></div> }
                                            @if (r.RespuestaRica)
                                            {
                                                <button class="btn btn-link btn-sm p-0" @onclick="() => VerObservacionAsync(r.Id, false, r.Respuesta)">&#128065; Ver observaci&oacute;n</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
    <div class="ase-card">
        @if (_loading)
        {
            <div class="ase-empty">Cargando...</div>
        }
        else if (_rows.Count == 0)
        {
            <div class="ase-empty" style="padding:30px;">Aun no se han generado tokens.</div>
        }
        else
        {
            <div class="med-tbl-wrap">
                <table class="table table-sm med-tbl">
                    <thead>
                        <tr>
                            <th style="width:90px">Codigo</th>
                            <th style="width:110px" class="text-center">Estado</th>
                            <th style="width:180px">Concepto</th>
                            <th>Observacion</th>
                            <th style="width:150px">Generado</th>
                            <th style="width:150px">Vence</th>
                            <th>Uso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rows)
                        {
                            <tr class="@(r.Estado == AutorizacionTokenEstado.Usado ? "tok-usado" : (r.Vencido ? "tok-venc" : ""))">
                                <td><code class="mono">@r.Codigo</code></td>
                                <td class="text-center">
                                    @if (r.Estado == AutorizacionTokenEstado.Usado)
                                    { <span class="badge bg-secondary">Usado</span> }
                                    else if (r.Vencido)
                                    { <span class="badge bg-warning text-dark">Vencido</span> }
                                    else
                                    { <span class="badge bg-success">Activo</span> }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(r.ConceptoNombre) ? (MarkupString)"<span class='text-muted'>—</span>" : (MarkupString)System.Net.WebUtility.HtmlEncode(r.ConceptoNombre))</td>
                                <td>
                                    <div class="az-obs-corta">@r.Observacion</div>
                                    @if (r.ObservacionRica)
                                    {
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => VerObservacionAsync(r.Id, true, r.Observacion)">&#128065; Ver observaci&oacute;n</button>
                                    }
                                </td>
                                <td>
                                    <div>@r.GeneradoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (!string.IsNullOrWhiteSpace(r.GeneradoPorNombre))
                                    { <small class="text-muted">@r.GeneradoPorNombre</small> }
                                </td>
                                <td>@r.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (r.UsadoEn is DateTimeOffset u)
                                    {
                                        <div><small class="text-muted">@u.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                            @if (!string.IsNullOrWhiteSpace(r.UsadoPorNombre)) { <text> · @r.UsadoPorNombre</text> }
                                        </div>
                                        <div>
                                            @if (r.HistoriaClinicaConsecutivo is long hc) { <span class="badge bg-light text-dark">HC-@hc.ToString("D6")</span> }
                                            @if (r.AsignacionConsecutivo is long asg) { <span class="badge bg-light text-dark">AS-@asg.ToString("D6")</span> }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(r.MotivoUso)) { <small class="text-muted">@r.MotivoUso</small> }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    }
}

@* ============= MODAL RESOLVER (aprobar / rechazar) - IMP-71 ============= *@
@if (_resolver is not null)
{
    <div class="cie-backdrop"></div>
    <div class="cie-modal" style="width:720px; max-width:95vw;">
        <div class="cie-modal-h">
            <h3>@(_resolverAprobar ? "Aprobar solicitud" : "Rechazar solicitud")</h3>
            <button class="cie-modal-close" @onclick="CerrarResolverAsync" disabled="@_busy">&times;</button>
        </div>
        <div class="cie-modal-body">
            <div class="az-res-sum">
                <div><b>@(_resolver.SolicitadoPorNombre ?? "Profesional")</b> &middot; @(_resolver.PacienteNombre ?? "")
                    @if (_resolver.HistoriaClinicaConsecutivo is long rhc) { <span class="badge bg-light text-dark">HC-@rhc.ToString("D6")</span> }
                </div>
                @if (!string.IsNullOrWhiteSpace(_resolver.ConceptoNombre)) { <div><b>@_resolver.ConceptoNombre</b></div> }
                <div class="text-muted">@_resolver.Motivo</div>
            </div>
            <div class="az-field">
                @if (_resolverAprobar)
                {
                    <label>Observaci&oacute;n para el profesional <small class="text-muted">(opcional; texto, listas, enlaces e im&aacute;genes - la ver&aacute; en la historia cl&iacute;nica)</small></label>
                }
                else
                {
                    <label>Motivo del rechazo * <small class="text-muted">(lo ver&aacute; el profesional en la historia cl&iacute;nica; puedes pegar im&aacute;genes)</small></label>
                }
                <div class="az-ed"><textarea id="@EditorId"></textarea></div>
                <small class="text-muted">Pega capturas con Ctrl+V o usa el bot&oacute;n de imagen. M&aacute;ximo 2 MB por observaci&oacute;n.</small>
            </div>
            @if (_resError is not null) { <div class="text-danger small">@_resError</div> }
        </div>
        <div class="cie-modal-foot" style="justify-content:flex-end;gap:8px;">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarResolverAsync" disabled="@_busy">Cancelar</button>
            @if (_resolverAprobar)
            {
                <button class="btn btn-success btn-sm" @onclick="ConfirmarResolverAsync" disabled="@_busy">&#10003; Aprobar</button>
            }
            else
            {
                <button class="btn btn-danger btn-sm" @onclick="ConfirmarResolverAsync" disabled="@_busy">Rechazar</button>
            }
        </div>
    </div>
}

@* ============= MODAL VER OBSERVACION - IMP-71 ============= *@
@if (_verObsAbierto)
{
    <div class="cie-backdrop" @onclick="() => _verObsAbierto = false"></div>
    <div class="cie-modal" style="width:720px; max-width:95vw;">
        <div class="cie-modal-h">
            <h3>Observaci&oacute;n</h3>
            <button class="cie-modal-close" @onclick="() => _verObsAbierto = false">&times;</button>
        </div>
        <div class="cie-modal-body">
            @if (!string.IsNullOrWhiteSpace(_verObsHtml))
            {
                <div class="obs-rica">@((MarkupString)_verObsHtml)</div>
            }
            else
            {
                <div style="white-space:pre-wrap;">@_verObsTexto</div>
            }
        </div>
        <div class="cie-modal-foot" style="justify-content:flex-end;">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _verObsAbierto = false">Cerrar</button>
        </div>
    </div>
}

@* ============= MODAL GENERAR ============= *@
@if (_modalOpen)
{
    <div class="cie-backdrop"></div>
    <div class="cie-modal" style="width:720px; max-width:95vw;">
        <div class="cie-modal-h">
            <h3>Generar nuevo token</h3>
            <button class="cie-modal-close" @onclick="Cerrar">&times;</button>
        </div>
        <div class="cie-modal-body">
            <div class="az-field">
                <label>Concepto <small class="text-muted">(categoria)</small></label>
                <select class="form-select form-select-sm" @bind="_fConcepto" style="width:100%;">
                    <option value="">-- Selecciona un concepto --</option>
                    @foreach (var c in _conceptos)
                    {
                        <option value="@c.Nombre">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="az-field">
                <label>Observacion de uso * <small class="text-muted">(por que se autoriza; la vera quien use el token, en la historia clinica)</small></label>
                <div class="az-ed"><textarea id="@EditorId"></textarea></div>
            </div>
            <small class="text-muted">Puedes pegar capturas (Ctrl+V) - maximo 2 MB. El token tendra 6 caracteres y vence en 30 minutos. Un solo uso.</small>
            @if (_modalError is not null) { <div class="text-danger small mt-2">@_modalError</div> }
        </div>
        <div class="cie-modal-foot" style="justify-content:flex-end;gap:8px;">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Cerrar">Cancelar</button>
            <button class="btn btn-primary btn-sm" @onclick="GenerarAsync" disabled="@_busy">Generar</button>
        </div>
    </div>
}

@* ============= MODAL CONCEPTOS (configurar) ============= *@
@if (_conceptosModalOpen)
{
    <div class="cie-backdrop" @onclick="CerrarConceptos"></div>
    <div class="cie-modal" style="width:520px; max-width:95vw;">
        <div class="cie-modal-h">
            <h3>Conceptos de autorizacion</h3>
            <button class="cie-modal-close" @onclick="CerrarConceptos">&times;</button>
        </div>
        <div class="cie-modal-body">
            <small class="text-muted">Lista de conceptos seleccionables al generar un token. Puedes agregar o quitar.</small>
            <div class="az-field" style="margin-top:10px; display:flex; gap:8px;">
                <input class="form-control form-control-sm" @bind="_fNuevoConcepto" style="flex:1;"
                       placeholder="Nuevo concepto..." />
                <button class="btn btn-primary btn-sm" @onclick="AgregarConceptoAsync" disabled="@_busy">Agregar</button>
            </div>
            @if (_conceptosError is not null) { <div class="text-danger small mt-1">@_conceptosError</div> }
            <div class="med-tbl-wrap" style="margin-top:10px;">
                <table class="table table-sm med-tbl">
                    <thead><tr><th>Concepto</th><th style="width:70px"></th></tr></thead>
                    <tbody>
                        @if (_conceptosAll.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted">Aun no hay conceptos.</td></tr>
                        }
                        else
                        {
                            @foreach (var c in _conceptosAll)
                            {
                                <tr>
                                    <td>@c.Nombre</td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm text-danger" title="Eliminar"
                                                @onclick="() => EliminarConceptoAsync(c)">&#128465;</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="cie-modal-foot" style="justify-content:flex-end;">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarConceptos">Cerrar</button>
        </div>
    </div>
}

<style>
    .az-field { margin-bottom: 12px; }
    .az-ed { min-height: 200px; }
    .az-res-sum { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 10px; margin-bottom: 12px; font-size: 13px; }
    .az-obs-corta { max-width: 360px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; white-space: pre-line; }
    .obs-rica { font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; }
    .obs-rica img { max-width: 100%; height: auto; border-radius: 6px; border: 1px solid #e2e8f0; margin: 4px 0; }
    .obs-rica p { margin: 0 0 6px; }
    .az-field label { display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 3px; }
    .tok-big { font-size: 20px; letter-spacing: 3px; font-weight: 700; }
    .mono { font-family: ui-monospace, Menlo, Consolas, monospace; letter-spacing: 2px; font-weight: 700; }
    .tok-usado { opacity: 0.7; }
    .tok-venc { background: #fffbeb; }
    .az-tabs { display: flex; gap: 4px; margin: 6px 0 10px; border-bottom: 1px solid #e2e8f0; }
    .az-tab { background: none; border: none; border-bottom: 2px solid transparent; padding: 6px 14px; font-weight: 600; color: #64748b; }
    .az-tab-on { color: #0f172a; border-bottom-color: #2563eb; }
    .az-badge { background: #dc2626; color: #fff; border-radius: 999px; padding: 0 7px; font-size: 11px; margin-left: 4px; }
    .az-sol-bar { display: flex; gap: 12px; align-items: center; padding: 8px 4px 10px; flex-wrap: wrap; }
    .az-chk { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; }

    .cie-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 1050; }
    .cie-modal {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
        max-width: 95vw; max-height: 90vh; background: #fff;
        border-radius: 12px; box-shadow: 0 20px 60px rgba(15,23,42,.25);
        z-index: 1051; display: flex; flex-direction: column;
    }
    .cie-modal-h { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid #e2e8f0; }
