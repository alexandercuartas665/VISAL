@page "/seguimiento"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Visal.Application.Tenancy
@inject ISeguimientoService SegSvc
@inject Visal.Application.Voz.IVozLlamadaService VozSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Seguimiento SIAU - Visal</PageTitle>

<div class="seg-page">
    <div class="seg-head">
        <div>
            <div class="seg-eyebrow">Encuestas de satisfaccion (SIAU)</div>
            <h1 class="seg-title">Seguimiento <span>mensual</span></h1>
        </div>
        <div class="seg-filters">
            <label>Desde</label>
            <input type="date" @bind="_desde" />
            <label>Hasta</label>
            <input type="date" @bind="_hasta" />
            <button class="btn-primary" @onclick="TraerAsync" disabled="@_traerBusy" title="Trae a la bandeja los pacientes con historia CERRADA en el rango">
                @(_traerBusy ? "Trayendo..." : "Traer pacientes")
            </button>
            <button class="btn-outline" @onclick="RecargarAsync">Recargar</button>
        </div>
    </div>

    <div class="seg-tabs">
        <button class="seg-tab @(_tab == "kanban" ? "sel" : "")" @onclick='() => _tab = "kanban"'>Kanban</button>
        <button class="seg-tab @(_tab == "historial" ? "sel" : "")" @onclick='() => _tab = "historial"'>Historial</button>
    </div>

    @if (_traerMsg is not null) { <div class="seg-msg" style="margin:.4rem 0;">@_traerMsg</div> }

    @if (_loading)
    {
        <div class="seg-loading">Cargando encuestas del mes...</div>
    }
    else if (_tab == "kanban")
    {
        <div class="seg-kpis">
            <div class="seg-kpi seg-kpi-pend"><b>@Count("Pendiente")</b> Pendientes</div>
            <div class="seg-kpi seg-kpi-noc"><b>@Count("NoContactado")</b> No contactados</div>
            <div class="seg-kpi seg-kpi-ok"><b>@Count("Realizada")</b> Realizadas</div>
            <div class="seg-kpi seg-kpi-total"><b>@_items.Count</b> Total</div>
        </div>

        <div class="seg-voz-tools">
            <span class="seg-voz-lbl">&#128222; Encuesta por llamada IA:</span>
            <button class="btn-outline" @onclick="() => LlamarPendientes(true)" disabled="@_vozBusy" title="Valida cuantas se llamarian, sin llamar">Simular</button>
            <button class="btn-primary" @onclick="() => LlamarPendientes(false)" disabled="@_vozBusy">
                @(_vozBusy ? "Procesando..." : "Llamar a pendientes (IA)")
            </button>
            @if (_vozMsg is not null) { <span class="seg-voz-msg">@_vozMsg</span> }
        </div>

        <div class="seg-kanban">
            @RenderColumna("Pendiente", "Bandeja - por llamar", "seg-col-pend")
            @RenderColumna("NoContactado", "No contactados", "seg-col-noc")
            @RenderColumna("Realizada", "Encuesta realizada", "seg-col-ok")
        </div>
    }
    else
    {
        @* Tab Historial: tabla con TODAS las realizadas de todos los meses *@
        <div class="seg-hist-tools">
            <label>Buscar</label>
            <input type="text" placeholder="Paciente, documento, observaciones..." value="@_histFiltro" @oninput="OnHistFiltroInput" />
            <button class="btn-outline" @onclick="RecargarHistorialAsync">Recargar</button>
        </div>

        @if (_histLoading)
        {
            <div class="seg-loading">Cargando historial...</div>
        }
        else
        {
            <div class="seg-hist-meta">Realizadas: <b>@FiltrarHistorial().Count()</b></div>
            <div class="seg-hist-wrap">
                <table class="seg-hist-tabla">
                    <thead>
                        <tr>
                            <th>Fecha llamada</th>
                            <th>Mes</th>
                            <th>Paciente</th>
                            <th>Documento</th>
                            <th>Responsable</th>
                            <th>Persona atiende</th>
                            <th>P1</th><th>P2</th><th>P3</th><th>P4</th><th>P5</th>
                            <th>Observaciones</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in FiltrarHistorial())
                        {
                            <tr>
                                <td>@(h.FechaLlamada?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td>@FormatoMes(h.Mes)</td>
                                <td>@h.PacienteNombre</td>
                                <td class="mono">@h.PacienteTipoDoc @h.PacienteDocumento</td>
                                <td>@(h.ResponsableLlamadaNombre ?? "-")</td>
                                <td>@(h.PersonaAtiende ?? "-")</td>
                                <td class="txt-c">@(h.Pregunta1?.ToString() ?? "-")</td>
                                <td class="txt-c">@(h.Pregunta2?.ToString() ?? "-")</td>
                                <td class="txt-c">@(h.Pregunta3?.ToString() ?? "-")</td>
                                <td class="txt-c">@(h.Pregunta4?.ToString() ?? "-")</td>
                                <td class="txt-c">@(h.Pregunta5?.ToString() ?? "-")</td>
                                <td class="seg-hist-obs">@(h.Observaciones ?? "-")</td>
                                <td><button class="btn-mini" @onclick="() => VerHistorialItem(h)">Ver</button></td>
                            </tr>
                        }
                        @if (!FiltrarHistorial().Any())
                        {
                            <tr><td colspan="13" class="seg-hist-vacio">Sin encuestas realizadas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (_openId is Guid id && _items.FirstOrDefault(x => x.Id == id) is SeguimientoEncuestaDto seleccionado)
{
    <div class="seg-modal-back" @onclick="Cerrar"></div>
    <div class="seg-modal">
        <div class="seg-modal-head">
            @{
                var nav = NavContext(seleccionado);
            }
            <div class="seg-nav-left">
                <button class="seg-nav-btn" title="Anterior" disabled="@(!nav.HasPrev)" @onclick="() => NavAsync(-1)">&lsaquo;</button>
                <span class="seg-nav-pos">@(nav.Pos + 1) / @nav.Total</span>
                <button class="seg-nav-btn" title="Siguiente" disabled="@(!nav.HasNext)" @onclick="() => NavAsync(1)">&rsaquo;</button>
            </div>
            <div class="seg-modal-title-wrap">
                <div class="seg-modal-eyebrow">Encuesta SIAU · @FormatoMes(seleccionado.Mes)</div>
                <h3 class="seg-modal-title">@seleccionado.PacienteNombre</h3>
                <div class="seg-modal-sub">@seleccionado.PacienteTipoDoc @seleccionado.PacienteDocumento</div>
            </div>
            <div class="seg-modal-actions">
                <label class="seg-move-lbl">Mover a:</label>
                <select class="seg-move-sel" value="@seleccionado.Estado" @onchange="OnMoverEstadoAsync">
                    <option value="Pendiente">Pendiente</option>
                    <option value="NoContactado">No contactado</option>
                    <option value="Realizada">Realizada</option>
                </select>
                <button class="seg-modal-close" @onclick="Cerrar">×</button>
            </div>
        </div>

        <div class="seg-modal-body">
            <div class="seg-form-row">
                <label>Fecha y hora de llamada</label>
                <input type="datetime-local" @bind="_edit.FechaLlamada" />
            </div>

            <div class="seg-form-row">
                <label>Responsable de la llamada (SIAU)</label>
                <input type="text" value="@(seleccionado.ResponsableLlamadaNombre ?? _actorNombre)" readonly />
                <small>Se toma automaticamente del usuario logueado al guardar.</small>
            </div>

            <div class="seg-form-row">
                <label>Persona que atiende</label>
                <input type="text" @bind="_edit.PersonaAtiende" placeholder="Nombre de quien contesta" />
            </div>

            <div class="seg-preguntas">
                @foreach (var (idx, texto) in Preguntas)
                {
                    <div class="seg-pregunta">
                        <div class="seg-pregunta-label">@idx. @texto</div>
                        <div class="seg-escala">
                            @for (var n = 1; n <= 5; n++)
                            {
                                var val = n;
                                var actual = GetPregunta(idx);
                                var sel = actual == val ? "seg-esc-sel" : "";
                                <button type="button" class="seg-esc-btn @sel" @onclick="() => SetPregunta(idx, val)">@val</button>
                            }
                            @if (GetPregunta(idx).HasValue)
                            {
                                <button type="button" class="seg-esc-clr" title="Limpiar" @onclick="() => SetPregunta(idx, null)">×</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="seg-form-row">
                <label>Observaciones</label>
                <textarea rows="3" @bind="_edit.Observaciones" placeholder="Comentarios adicionales, motivos, quejas..."></textarea>
            </div>

            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="seg-msg">@_msg</div>
            }
        </div>

        <div class="seg-modal-foot">
            <button class="btn-danger" @onclick="MarcarNoContactado">No pude contactar</button>
            <button class="btn-outline" @onclick="Cerrar">Cancelar</button>
            <button class="btn-primary" @onclick="Guardar">Guardar encuesta</button>
        </div>
    </div>
}

