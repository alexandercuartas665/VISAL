@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<AlertaReglaDto> _reglas = new();
    private List<AlertaUsuarioDto> _usuarios = new();
    private List<AlertaLineaDto> _lineas = new();
    private List<AlertaServicioDto> _servicios = new();
    private string _busqSvc = "";
    private string _modalTab = "config";
    private DateOnly _simFecha = DateOnly.FromDateTime(DateTime.Now);
    private string _simTelefono = "";
    private bool _simForzar;
    private bool _simBusy;
    private AlertaSimulacionResult? _sim;
    private string? _simError;
    // Asignaciones marcadas en la tabla de simulacion: el Paso 2 (emitir real) solo
    // envia a estas. Se pre-marca con todas las emitibles tras el Paso 1.
    private readonly HashSet<Guid> _seleccion = new();
    private List<GupshupTemplateInfo> _plantillas = new();
    private Form? _form;
    private bool _busy;
    private bool _cargandoPlantillas;
    private string? _msg;
    private string? _error;
    private string _tab = "reglas";
    private List<AlertaEnvioDto> _envios = new();

    // --- Control de lectura ---
    private string _controlPeriodo = DateTime.Now.ToString("yyyy-MM");
    private ControlLecturaResult? _control;
    private bool _controlBusy;
    private string? _controlError;
    // Valores derivados del donut/barras (se calculan al cargar para no meter codigo en el markup).
    private string _dashCons = "0 0", _dashNo = "0 0", _offNo = "0";
    private int _pctCons, _maxAp = 1, _maxEn = 1;

    private async Task AbrirBandeja()
    {
        _tab = "bandeja";
        _error = null;
        try { _envios = (await Svc.ListEnviosRecientesAsync()).ToList(); }
        catch (Exception ex) { _error = "No se pudo cargar la bandeja: " + ex.Message; }
    }

    private async Task AbrirControl()
    {
        _tab = "control";
        _error = null;
        await LoadControl();
    }

    private async Task LoadControl()
    {
        _controlBusy = true; _controlError = null;
        try
        {
            _control = await Svc.ObtenerControlLecturaAsync(_controlPeriodo);
            CalcularGrafico();
        }
        catch (Exception ex) { _controlError = "No se pudo cargar el control: " + ex.Message; }
        finally { _controlBusy = false; }
    }

    private void CalcularGrafico()
    {
        if (_control is null || _control.TotalDoctores == 0)
        {
            _dashCons = _dashNo = "0 0"; _offNo = "0"; _pctCons = 0; _maxAp = _maxEn = 1;
            return;
        }
        var circ = 2 * Math.PI * 54;
        var consLen = (double)_control.Consumieron / _control.TotalDoctores * circ;
        _dashCons = $"{Inv(consLen)} {Inv(circ)}";
        _dashNo = $"{Inv(circ - consLen)} {Inv(circ)}";
        _offNo = Inv(-consLen);
        _pctCons = (int)Math.Round(100.0 * _control.Consumieron / _control.TotalDoctores);
        _maxAp = _control.ListaConsumieron.Count > 0 ? Math.Max(1, _control.ListaConsumieron.Max(d => d.Aperturas)) : 1;
        _maxEn = _control.ListaNoLeyeron.Count > 0 ? Math.Max(1, _control.ListaNoLeyeron.Max(d => d.Enviados)) : 1;
    }

    // Formato invariante para atributos SVG (evita coma decimal de es-CO).
    private static string Inv(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static int Pct(int part, int max) => max <= 0 ? 0 : (int)Math.Round(100.0 * part / max);
    private static string Corto(string s) => string.IsNullOrEmpty(s) ? "" : (s.Length <= 18 ? s : s.Substring(0, 17) + "…");

    private async Task Gestionar(AlertaEnvioDto e, AlertaGestion estado)
    {
        await Svc.MarcarGestionAsync(e.Id, estado, await Actor());
        _envios = (await Svc.ListEnviosRecientesAsync()).ToList();
    }

    private static string GestionTxt(AlertaGestion g) => g switch
    {
        AlertaGestion.Nueva => "Nueva",
        AlertaGestion.Atendida => "Atendida",
        AlertaGestion.Descartada => "Descartada",
        _ => g.ToString(),
    };

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        _reglas = (await Svc.ListAsync()).ToList();
    }

    private async Task NuevaRegla()
    {
        await AsegurarCatalogos();
        _plantillas = new();
        _busqSvc = "";
        ResetSim();
        _form = new Form();
        _msg = _error = null;
    }

    private async Task Editar(AlertaReglaDto r)
    {
        await AsegurarCatalogos();
        _plantillas = new();
        _busqSvc = "";
        ResetSim();
        _form = new Form
        {
            Id = r.Id,
            Nombre = r.Nombre,
            Activa = r.Activa,
            Orden = r.Orden,
            Condicion = r.Condicion,
            FiltroModulos = string.IsNullOrWhiteSpace(r.FiltroModulo)
                ? new()
                : r.FiltroModulo.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
            DisparoTipo = r.DisparoTipo,
            DiasDelMes = r.DiasDelMes ?? "15,16,17",
            MesesDespues = r.MesesDespues ?? 3,
            Ancla = r.AnclaRelativa ?? AlertaAnclaRelativa.UltimaAtencion,
            Destinatario = r.Destinatario,
            UsuarioSel = r.UsuarioSistemaId?.ToString() ?? "",
            Canal = r.Canal,
            Asunto = r.Asunto ?? "",
            Cuerpo = r.Cuerpo ?? "",
            LineaSel = r.HsmLineId?.ToString() ?? "",
            HsmTemplateId = r.HsmTemplateId,
            HsmTemplateName = r.HsmTemplateName,
            TemplateSel = r.HsmTemplateId ?? "",
            HsmParameterCount = r.HsmParameterCount,
            HsmParametros = r.HsmParametros.ToList(),
            HsmHeaderUrl = r.HsmHeaderUrl ?? "",
        };
        _msg = _error = null;
    }

    private async Task AsegurarCatalogos()
    {
        if (_usuarios.Count == 0) { _usuarios = (await Svc.ListUsuariosAsync()).ToList(); }
        if (_lineas.Count == 0) { _lineas = (await Svc.ListLineasGupshupAsync()).ToList(); }
        if (_servicios.Count == 0) { _servicios = (await Svc.ListServiciosContratoAsync()).ToList(); }
    }

    private void AgregarServicio(string codigo)
    {
        if (_form is null) { return; }
        if (!_form.FiltroModulos.Contains(codigo)) { _form.FiltroModulos.Add(codigo); }
        _busqSvc = ""; // limpia el buscador para agregar el siguiente
    }

    private void QuitarServicio(string codigo)
    {
        _form?.FiltroModulos.Remove(codigo);
    }

    /// <summary>Sugerencias del autocompletar: hasta 8 servicios que matchean la busqueda y
    /// no estan ya seleccionados.</summary>
    private List<AlertaServicioDto> Sugerencias()
    {
        const int Tope = 8;
        var q = (_busqSvc ?? "").Trim();
        if (string.IsNullOrEmpty(q)) { return new(); }
        var seleccionados = _form?.FiltroModulos ?? new();
        return _servicios
            .Where(s => !seleccionados.Contains(s.Codigo))
            .Where(s => s.Codigo.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || (s.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(Tope)
            .ToList();
    }

    private string DescServicio(string codigo)
        => _servicios.FirstOrDefault(s => s.Codigo == codigo)?.Descripcion ?? "";

    private string SeleccionTxt()
    {
        if (_form is null || _form.FiltroModulos.Count == 0) { return "Aplica a todos los servicios."; }
        return $"Seleccionados: {_form.FiltroModulos.Count} servicio(s).";
    }

    private async Task CargarPlantillas()
    {
        if (_form is null || !Guid.TryParse(_form.LineaSel, out var lineId)) { return; }
        _cargandoPlantillas = true;
        _error = null;
        try
        {
            var r = await HsmSvc.ListByLineAsync(lineId);
            if (!r.Ok) { _error = r.Error ?? "No se pudieron cargar las plantillas."; _plantillas = new(); }
            else { _plantillas = r.Templates.ToList(); }
        }
        catch (Exception ex) { _error = "Error cargando plantillas: " + ex.Message; }
        finally { _cargandoPlantillas = false; }
    }

    private void OnCondicionChanged()
    {
        if (_form is null) { return; }
        // El control a gerencia es agregado: siempre correo a un usuario del sistema y
        // disparo por dias del mes. Forzamos esos valores para que la config sea coherente.
        if (_form.Condicion == AlertaCondicion.InformeNoLeido)
        {
            _form.Destinatario = AlertaDestinatario.UsuarioSistema;
            _form.Canal = AlertaCanal.Correo;
            _form.DisparoTipo = AlertaDisparoTipo.DiasDelMes;
        }
    }

    private void OnTemplateChanged()
    {
        if (_form is null) { return; }
        var t = _plantillas.FirstOrDefault(x => x.Id == _form.TemplateSel);
        if (t is null) { return; }
        _form.HsmTemplateId = t.Id;
        _form.HsmTemplateName = t.ElementName;
        _form.HsmParameterCount = t.ParameterCount;
        // Autollenar la URL del header con la detectada de la plantilla (si Gupshup la
        // expone). Si no se detecta, se respeta lo que el usuario haya escrito.
        if (!string.IsNullOrWhiteSpace(t.HeaderMediaUrl)) { _form.HsmHeaderUrl = t.HeaderMediaUrl!; }
        // Ajustar la lista de tokens al numero de parametros.
        while (_form.HsmParametros.Count < t.ParameterCount) { _form.HsmParametros.Add(""); }
        while (_form.HsmParametros.Count > t.ParameterCount) { _form.HsmParametros.RemoveAt(_form.HsmParametros.Count - 1); }
    }

    private AlertaReglaUpsertRequest BuildRequest()
    {
        Guid? usuarioId = Guid.TryParse(_form!.UsuarioSel, out var uid) ? uid : null;
        Guid? lineId = Guid.TryParse(_form.LineaSel, out var lid) ? lid : null;
        var filtroModulo = _form.FiltroModulos.Count == 0 ? null : string.Join(",", _form.FiltroModulos);
        return new AlertaReglaUpsertRequest(
            _form.Id, _form.Nombre, _form.Activa, _form.Orden,
            _form.Condicion, filtroModulo,
            _form.DisparoTipo, _form.DiasDelMes, _form.MesesDespues, _form.Ancla,
            _form.Destinatario, usuarioId,
            _form.Canal, _form.Asunto, _form.Cuerpo,
            lineId, _form.HsmTemplateId, _form.HsmTemplateName, _form.HsmParameterCount,
            _form.HsmParametros,
            string.IsNullOrWhiteSpace(_form.HsmHeaderUrl) ? null : _form.HsmHeaderUrl.Trim());
    }

    private async Task Guardar()
    {
        if (_form is null) { return; }
        _busy = true; _error = _msg = null;
        try
        {
            await Svc.UpsertAsync(BuildRequest(), await Actor());
            _msg = "Regla guardada.";
            _form = null;
            await Cargar();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "Error tecnico: " + ex.Message; }
        finally { _busy = false; }
    }

    // ----------------- Simulacion -----------------

    private void ResetSim() { _modalTab = "config"; _sim = null; _simError = null; _simBusy = false; _simTelefono = ""; _simForzar = false; _seleccion.Clear(); }

    private void AbrirSimulacion() { _modalTab = "sim"; }

    private Task SimularVer() => SimularAsync(emitir: false);

    private async Task SimularEmitir()
    {
        if (_form?.Id is null) { return; }
        if (_seleccion.Count == 0)
        {
            _simError = "Marca al menos un doctor en la tabla (columna izquierda) para emitir. Usa \"1. Ver a quien emitiria\" primero.";
            return;
        }
        var destinoTxt = string.IsNullOrWhiteSpace(_simTelefono)
            ? $"a {_seleccion.Count} destinatario(s) marcado(s)"
            : $"al telefono de prueba {_simTelefono.Trim()} (override WhatsApp)";
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Esto EMITIRA de verdad las alertas para el {_simFecha:dd/MM/yyyy} {destinoTxt} (respetando lo ya enviado). Continuar?");
        if (!ok) { return; }
        await SimularAsync(emitir: true);
    }

    private async Task SimularAsync(bool emitir)
    {
        if (_form is null) { return; }
        _simBusy = true; _simError = null;
        try
        {
            IReadOnlyCollection<Guid>? solo = emitir ? _seleccion.ToList() : null;
            _sim = await Svc.SimularReglaAsync(BuildRequest(), _simFecha, emitir, _simTelefono, _simForzar, await Actor(),
                baseUri: Nav.BaseUri, soloAsignaciones: solo);
            if (!emitir)
            {
                // Paso 1: pre-marcar todas las filas emitibles para que "Emitir" por defecto
                // vaya a todas; el usuario desmarca las que no quiera.
                _seleccion.Clear();
                foreach (var f in _sim.Filas)
                {
                    if (f.Emitible && f.AsignacionId != Guid.Empty) { _seleccion.Add(f.AsignacionId); }
                }
            }
            if (emitir) { await Cargar(); }
        }
        catch (InvalidOperationException ex) { _simError = ex.Message; }
        catch (Exception ex) { _simError = "Error tecnico: " + ex.Message; }
        finally { _simBusy = false; }
    }

    // ---- Seleccion de filas (checkboxes) ----
    private void ToggleFila(Guid asignacionId, bool on)
    {
        if (asignacionId == Guid.Empty) { return; }
        if (on) { _seleccion.Add(asignacionId); } else { _seleccion.Remove(asignacionId); }
    }

    private IEnumerable<Guid> FilasSeleccionables()
        => _sim?.Filas.Where(f => f.Emitible && f.AsignacionId != Guid.Empty).Select(f => f.AsignacionId) ?? Enumerable.Empty<Guid>();

    private bool TodosSeleccionados()
    {
        var ids = FilasSeleccionables().ToList();
        return ids.Count > 0 && ids.All(_seleccion.Contains);
    }

    private void ToggleSeleccionarTodos(ChangeEventArgs e)
    {
        var on = (bool)(e.Value ?? false);
        _seleccion.Clear();
        if (on) { foreach (var id in FilasSeleccionables()) { _seleccion.Add(id); } }
    }

    private static string SimEstadoClass(AlertaSimulacionFila f)
    {
        if (f.EnvioOk == true) { return "sim-sent"; }
        if (f.EnvioOk == false) { return "sim-err"; }
        if (f.Estado.StartsWith("Ya", StringComparison.OrdinalIgnoreCase)) { return "sim-skip"; }
        if (f.Estado.StartsWith("Sin", StringComparison.OrdinalIgnoreCase)) { return "sim-err"; }
        return "sim-ok";
    }

    private async Task ToggleActiva(AlertaReglaDto r, bool activa)
    {
        await Svc.ToggleActivaAsync(r.Id, activa, await Actor());
        await Cargar();
    }

    private async Task Eliminar(AlertaReglaDto r)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminar la regla \"{r.Nombre}\"?");
        if (!ok) { return; }
        await Svc.DeleteAsync(r.Id, await Actor());
        if (_form?.Id == r.Id) { _form = null; }
        await Cargar();
    }

    private string EnlaceInforme() => InformeSvc.GenerarEnlace(Nav.BaseUri);

    private async Task AbrirInformeTerapias()
    {
        _error = _msg = null;
        try { await JS.InvokeVoidAsync("open", EnlaceInforme(), "_blank"); }
        catch (Exception ex) { _error = "No se pudo abrir el informe: " + ex.Message; }
    }

    private async Task CopiarInformeTerapias()
    {
        _error = _msg = null;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", EnlaceInforme());
            _msg = "Enlace del informe copiado. Pegalo en el mensaje de la alerta.";
        }
        catch (Exception ex) { _error = "No se pudo copiar: " + ex.Message; }
    }

    private async Task EjecutarAhora()
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            "Esto evaluara las reglas activas AHORA e ira enviando alertas reales a los destinatarios (respetando lo ya enviado este periodo). Continuar?");
        if (!ok) { return; }
        _busy = true; _error = _msg = null;
        try
        {
            var hoy = DateOnly.FromDateTime(DateTime.Now);
            var r = await Svc.EvaluarYDispararAsync(hoy, forzar: true, await Actor());
            _msg = $"Listo: {r.Enviadas} enviada(s), {r.Saltadas} ya enviada(s), {r.Errores} con error.";
            if (r.Mensajes.Count > 0) { _error = string.Join(" | ", r.Mensajes.Take(8)); }
        }
        catch (Exception ex) { _error = "Error tecnico: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task<Guid> Actor()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private static string CondicionTxt(AlertaCondicion c) => c switch
    {
        AlertaCondicion.SesionPendiente => "Sesion pendiente",
        AlertaCondicion.AtencionesTerminadas => "Atenciones terminadas",
        AlertaCondicion.InformeNoLeido => "Control informe (gerencia)",
        _ => c.ToString(),
    };

    private static string DisparoTxt(AlertaReglaDto r) => r.DisparoTipo == AlertaDisparoTipo.DiasDelMes
        ? $"Dias {r.DiasDelMes}"
        : $"{r.MesesDespues} mes(es) tras {(r.AnclaRelativa == AlertaAnclaRelativa.UltimaAtencion ? "ultima atencion" : "fin asignacion")}";

    private static string DestinatarioTxt(AlertaReglaDto r) => r.Destinatario switch
    {
        AlertaDestinatario.Paciente => "Paciente",
        AlertaDestinatario.DoctorAtendio => "Doctor que atendio",
        AlertaDestinatario.UsuarioSistema => "Usuario: " + (r.UsuarioSistemaNombre ?? "?"),
        _ => r.Destinatario.ToString(),
    };

