# VISAL.travels - imagen de produccion de la consola web unificada (SuperAdmin:
# sirve al super admin de plataforma Y a los clientes/agencias). .NET 9.
# Contexto de build esperado: raiz del repo (Railway Root Directory = /).

# --- build ---
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
# GIT_SHA lo pasa el workflow via --build-arg. MSBuild lo lee de la env var
# VISAL_GIT_SHA y lo emite como AssemblyMetadata (chip de version en el sidebar).
# Aca no hay .git (el COPY solo trae apps/backend/), asi que git rev-parse falla
# y el fallback via ARG es la fuente confiable en CI.
ARG GIT_SHA=nogit
ENV VISAL_GIT_SHA=$GIT_SHA
WORKDIR /src
COPY apps/backend/ ./
RUN dotnet publish src/Visal.SuperAdmin/Visal.SuperAdmin.csproj \
    -c Release -o /app/publish /p:UseAppHost=false

# --- runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime

# Render de PDF de cotizaciones (modulo Plantillas) con PuppeteerSharp.
# IMPORTANTE: NO se usa el Chromium del sistema como navegador, porque su version no coincide con
# la que espera PuppeteerSharp 20.x y el protocolo CDP falla ("Invalid referrerPolicy"). En su lugar,
# PuppeteerSharp DESCARGA el Chromium que le corresponde (BrowserFetcher) al primer uso. Aun asi se
# instala el paquete chromium por sus LIBRERIAS del sistema (libnss3, libgbm, etc.), que el Chromium
# descargado necesita para arrancar, mas las fuentes. Se deja antes del COPY para cachear la capa.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       chromium fonts-liberation fonts-noto-color-emoji ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
# tzdata: garantiza que /usr/share/zoneinfo/America/Bogota existe para que .NET
# TimeZoneInfo.Local resuelva la env var TZ (seteada por docker-compose) en
# lugar de quedarse en UTC.
# (Sin VISAL_CHROME_PATH a proposito: que PuppeteerSharp use el Chromium que descarga, compatible.)

WORKDIR /app
COPY --from=build /app/publish ./

# Horneamos el Chromium que ESTA version de PuppeteerSharp espera (BrowserFetcher),
# en tiempo de build (CI tiene internet confiable). Asi NO se usa el chromium del
# sistema (version distinta -> CDP "Invalid referrerPolicy") NI se descarga en runtime
# (se perderia en cada recreate y depende de la red del server). El binario queda
# enlazado en /usr/local/bin/visal-chrome y VISAL_CHROME_PATH lo selecciona.
# Nota: el env del docker-compose NO debe fijar VISAL_CHROME_PATH (dejar que gane este).
RUN dotnet Visal.SuperAdmin.dll --download-chromium /opt/visal-chromium \
    && CHROME_BIN="$(find /opt/visal-chromium -type f -name chrome | head -n1)" \
    && test -n "$CHROME_BIN" \
    && ln -sf "$CHROME_BIN" /usr/local/bin/visal-chrome \
    && echo "Chromium horneado en: $CHROME_BIN"
ENV VISAL_CHROME_PATH=/usr/local/bin/visal-chrome

# Railway inyecta PORT; definir en Railway ASPNETCORE_HTTP_PORTS=${{PORT}}.
# Este valor es solo fallback local.
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Visal.SuperAdmin.dll"]
