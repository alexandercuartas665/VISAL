             background:#fff; border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.25); z-index:1401;
             display:flex; flex-direction:column; overflow:hidden; }
.seg-modal-head { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:.85rem 1.15rem; border-bottom:1px solid #e5e7eb; }
