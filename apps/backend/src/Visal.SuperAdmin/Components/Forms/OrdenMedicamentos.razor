</style>

@code {
    /// <summary>Id de la HC actualmente abierta. Cuando cambia, recargamos los items.</summary>
    [Parameter] public Guid? HistoriaClinicaId { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    /// <summary>
    /// Se dispara cada vez que la lista de medicamentos cambia (agregar,
    /// actualizar posologia/observacion, eliminar). Sirve para que el padre
    /// (HistoriasClinicasModulo) recargue ValoresJson y refresque el
    /// FormViewer del tab Historial en vivo: sin esto, el usuario tenia que
    /// salir y volver a la HC para ver la observacion actualizada.
    /// </summary>
    [Parameter] public EventCallback OnItemsChanged { get; set; }

    private async Task NotifyItemsChanged()
    {
        if (OnItemsChanged.HasDelegate) { await OnItemsChanged.InvokeAsync(); }
    }

    private Guid? _ultimoIdCargado;
    /// <summary>Orden (grupo) actualmente en edicion. Una HC puede tener 1..N ordenes de medicamentos.</summary>
    private int _ordenActual = 1;
    private string _terminoBusqueda = "";
    private List<MedicamentoSugerenciaDto> _sugerencias = new();
    private List<OrdenMedicamentoItemDto> _items = new();
    private bool _buscando;
    private bool _agregando;

    /// <summary>Tope de sugerencias por consulta. Empieza en 50 y sube en +50
    /// cada vez que el usuario pulsa "Cargar mas resultados". Se reinicia al
    /// cambiar el termino de busqueda para no acumular tope infinito.</summary>
    private const int _pageStep = 50;
    private int _pageSize = _pageStep;

    private BorradorMed _borrador = new();

    /// <summary>Config del tenant: permite cargar el medicamento como texto libre
    /// (suelto) aunque no este en el catalogo CUM. Ver Configuracion de Empresa.</summary>
    private bool _permitirManuales;
    /// <summary>Prefijo del codigo auto-consecutivo para items manuales sin codigo
    /// (MDO-001, MDO-002, ...). El profesional puede escribir su propio codigo.</summary>
    private const string PrefijoConsecutivo = "MDO-";

    protected override async Task OnParametersSetAsync()
    {
        if (HistoriaClinicaId != _ultimoIdCargado)
        {
            _ultimoIdCargado = HistoriaClinicaId;
            _borrador = new();
            _terminoBusqueda = "";
            _sugerencias.Clear();
            _pageSize = _pageStep;
            _permitirManuales = await ConfigSvc.GetPermitirOrdenesManualesAsync();
            await CargarItemsAsync();
        }
    }

    /// <summary>Carga manual (suelto): usa el texto escrito como nombre del
    /// medicamento sin exigir catalogo. El codigo queda vacio y al Agregar se le
    /// pone el CUP por defecto. Solo disponible con el flag del tenant activo.</summary>
    private void UsarManual()
    {
        var t = _terminoBusqueda?.Trim();
        if (string.IsNullOrWhiteSpace(t)) { return; }
        _borrador.MedicamentoId = null;
        _borrador.Codigo = null;
        _borrador.NombreMedicamento = t;
        _sugerencias.Clear();
    }

    private async Task CargarItemsAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { _items = new(); return; }
        _items = (await OrdSvc.ListarPorHistoriaAsync(hid)).ToList();
        // Al abrir, posicionarse en la primera orden existente (o la 1 si esta vacia).
        _ordenActual = _items.Select(x => x.NumeroOrden).DefaultIfEmpty(1).Min();
        await NotifyCount();
    }

    /// <summary>Numeros de orden a mostrar: los que ya tienen items + la orden actual (aunque este vacia).</summary>
    private List<int> OrdenesPresentes()
    {
        var set = _items.Select(x => x.NumeroOrden).ToHashSet();
        set.Add(_ordenActual);
        return set.OrderBy(x => x).ToList();
    }

    /// <summary>Crea una nueva orden vacia (siguiente numero libre) y se posiciona en ella.</summary>
    private void NuevaOrden()
    {
        _ordenActual = OrdenesPresentes().Max() + 1;
    }

    /// <summary>Elimina la orden actual con todos sus medicamentos (revoca su QR). Vuelve a la 1a orden.</summary>
    private async Task EliminarOrdenActualAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        var n = _ordenActual;
        if (!_items.Any(x => x.NumeroOrden == n)) { return; }
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminar toda la Orden {n} y sus medicamentos?");
        if (!ok) { return; }
        await OrdSvc.EliminarOrdenAsync(hid, n, Guid.Empty);
        _items.RemoveAll(x => x.NumeroOrden == n);
        _ordenActual = _items.Select(x => x.NumeroOrden).DefaultIfEmpty(1).Min();
        await NotifyCount();
        await NotifyItemsChanged();
    }

    private async Task NotifyCount()
    {
        if (OnCountChanged.HasDelegate) { await OnCountChanged.InvokeAsync(_items.Count); }
    }

    // Serializa las queries al DbContext scoped: en Blazor Server dos busquedas
    // concurrentes (o una cancelada + una nueva) rompen EF Core con "second
    // operation started on this context". No se cancela la query en vuelo; se
    // descarta el resultado por secuencia. Mismo patron que OrdenInsumos.
    private readonly System.Threading.SemaphoreSlim _busquedaLock = new(1, 1);
    private int _busquedaSeq;

    /// <summary>Lanza busqueda al catalogo con debounce de ~200ms. Reinicia _pageSize
    /// al step base y serializa contra el DbContext con semaforo + secuencia.</summary>
    private async Task OnTerminoChanged(ChangeEventArgs e)
    {
        _terminoBusqueda = e.Value?.ToString() ?? "";
        _pageSize = _pageStep;
        var t = _terminoBusqueda;
        if (string.IsNullOrWhiteSpace(t) || t.Trim().Length < 2)
        {
            _sugerencias.Clear();
            return;
        }
        var mySeq = ++_busquedaSeq;
        try
        {
            await Task.Delay(200);
            if (mySeq != _busquedaSeq) { return; }
            _buscando = true;
            await _busquedaLock.WaitAsync();
            try
            {
                if (mySeq != _busquedaSeq) { return; }
                _sugerencias = (await OrdSvc.BuscarSugerenciasAsync(t, _pageSize)).ToList();
                _buscando = false;
                StateHasChanged();
            }
            finally { _busquedaLock.Release(); }
        }
        catch (Exception) { /* la proxima tecla reintenta */ }
    }

    /// <summary>Sube el tope en +_pageStep y re-consulta. Aparece cuando
    /// _sugerencias.Count == _pageSize (la BD probablemente tiene mas).</summary>
    private async Task CargarMasSugerenciasAsync()
    {
        if (string.IsNullOrWhiteSpace(_terminoBusqueda) || _buscando) { return; }
        _pageSize += _pageStep;
        _buscando = true;
        await _busquedaLock.WaitAsync();
        try
        {
            _sugerencias = (await OrdSvc.BuscarSugerenciasAsync(_terminoBusqueda, _pageSize)).ToList();
        }
        finally { _buscando = false; _busquedaLock.Release(); }
    }

    private void SeleccionarSugerencia(MedicamentoSugerenciaDto s)
    {
        _borrador.MedicamentoId = s.Id;
        // El "codigo" mostrado al doctor es el RegistroSanitario INVIMA (lo
        // que ya se ve como tag en la lista de sugerencias). Cae al IUM si no
        // hay registro sanitario.
        _borrador.Codigo = !string.IsNullOrWhiteSpace(s.RegistroSanitario) ? s.RegistroSanitario : s.Ium;
        _borrador.NombreMedicamento = ArmarNombreCompleto(s);
        _sugerencias.Clear();
        _terminoBusqueda = "";
    }

    private static string ArmarNombreCompleto(MedicamentoSugerenciaDto s)
    {
        var partes = new List<string> { s.Producto };
        if (!string.IsNullOrWhiteSpace(s.Concentracion)) { partes.Add(s.Concentracion!); }
        if (!string.IsNullOrWhiteSpace(s.FormaFarmaceutica)) { partes.Add(s.FormaFarmaceutica!); }
        return string.Join(" - ", partes);
    }

    private string PosologiaPreview()
    {
        var c = _borrador.Cantidad?.Trim();
        var f = _borrador.Frecuencia?.Trim();
        var d = _borrador.Dias?.Trim();
        if (string.IsNullOrWhiteSpace(c) && string.IsNullOrWhiteSpace(f) && string.IsNullOrWhiteSpace(d))
        {
            return "Define cantidad, frecuencia y dias para armar la posologia.";
        }
        // Reconstruye la frase clinica:
        //   "1 cada 6 horas durante 30 dias - Total: 120."
        // - La frecuencia es el INTERVALO EN HORAS entre dosis (lo que el medico
        //   pone directo). Asi:
        //     N=24 -> "cada 24 horas" (1 dosis/dia) -> total = c * 1 * d
        //     N=12 -> "cada 12 horas" (2 dosis/dia) -> total = c * 2 * d
        //     N=8  -> "cada 8 horas"  (3 dosis/dia) -> total = c * 3 * d
        //     N=6  -> "cada 6 horas"  (4 dosis/dia) -> total = c * 4 * d
        //     N=1  -> "cada hora"    (24 dosis/dia) -> total = c * 24 * d
        // - Si frecuencia trae texto custom (ej. "PRN", "cada 8h") se respeta.
        var sb = new System.Text.StringBuilder();
        if (!string.IsNullOrWhiteSpace(c)) { sb.Append(c); }
        if (!string.IsNullOrWhiteSpace(f))
        {
            if (sb.Length > 0) { sb.Append(' '); }
            sb.Append(FrecuenciaTexto(f!));
        }
        if (!string.IsNullOrWhiteSpace(d))
        {
            if (sb.Length > 0) { sb.Append(' '); }
            sb.Append(int.TryParse(d, out _) ? $"durante {d} dias" : d!);
        }
        var preview = sb.ToString();
        var total = CalcularTotal(c, f, d);
        if (total is not null) { preview += $" - Total: {total}"; }
        return preview + ".";
    }

    private static string FrecuenciaTexto(string f)
    {
        if (!int.TryParse(f, out var fn) || fn <= 0) { return f; }
        if (fn == 1) { return "cada hora"; }
        return $"cada {fn} horas";
    }

    /// <summary>Cantidad total.
    /// - Con frecuencia por horas: cantidad_por_toma * (24/intervalo_horas) * dias
    ///   (la "frecuencia" es el INTERVALO en horas, cada N horas).
    /// - SIN frecuencia por horas (campo "Cada (h)" vacio o no numerico): la cantidad
    ///   se queda FIRME y es el total para esos dias, sin multiplicar. Esto cubre
    ///   medicamentos que no se distribuyen por horas (se pide una cantidad total).
    /// Devuelve null si la cantidad no es un numero positivo, o si hay frecuencia
    /// valida pero faltan los dias (no se puede calcular el total por horas).</summary>
    private static string? CalcularTotal(string? cantidad, string? frecuencia, string? dias)
    {
        if (!decimal.TryParse(cantidad?.Trim(), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var c) || c <= 0)
        {
            return null;
        }

        var freqOk = decimal.TryParse(frecuencia?.Trim(), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var f) && f > 0;

        // Sin horas: la cantidad es el total firme (no se multiplica por dosis/dia ni por dias).
        if (!freqOk) { return FormatearTotal(c); }

        // Con horas: se requieren dias para el total por distribucion horaria.
        if (!int.TryParse(dias?.Trim(), out var d) || d <= 0) { return null; }

        var total = c * (24m / f) * d; // dosis por dia = 24 / intervalo
        return FormatearTotal(total);
    }

    private static string FormatearTotal(decimal total)
        => total == Math.Truncate(total)
            ? ((int)total).ToString(System.Globalization.CultureInfo.InvariantCulture)
            : total.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Recalcula el Total del borrador desde cantidad/frecuencia/dias. Se
    /// dispara al editar esos campos; el usuario puede luego sobreescribir el Total.</summary>
    private void SyncTotal()
    {
        _borrador.Total = CalcularTotal(_borrador.Cantidad, _borrador.Frecuencia, _borrador.Dias);
    }

    /// <summary>Siguiente codigo consecutivo con el prefijo dado (MDO-001, MDO-002,
    /// ...), mirando los codigos ya presentes en la HC. Empieza en 001.</summary>
    private string SiguienteConsecutivo(string prefijo)
    {
        var max = 0;
        foreach (var it in _items)
        {
            var c = it.CodigoMedicamento;
            if (string.IsNullOrWhiteSpace(c) || !c.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase)) { continue; }
            if (int.TryParse(c.Substring(prefijo.Length).Trim(), out var n) && n > max) { max = n; }
        }
        return $"{prefijo}{(max + 1):000}";
    }

    /// <summary>Edicion inline del Total en la tabla de items. Persiste el override
    /// (o lo limpia si queda vacio, volviendo al total calculado).</summary>
    private async Task GuardarTotal(OrdenMedicamentoItemDto it, string? nuevoTotal)
    {
        var val = string.IsNullOrWhiteSpace(nuevoTotal) ? null : nuevoTotal.Trim();
        var req = new ActualizarMedicamentoRequest(it.Cantidad, it.Frecuencia, it.Dias, it.Posologia, it.Observacion, CantidadTotal: val);
        await OrdSvc.ActualizarAsync(it.Id, req, Guid.Empty);
        var idx = _items.FindIndex(x => x.Id == it.Id);
        if (idx >= 0) { _items[idx] = it with { CantidadTotal = val }; }
        await NotifyItemsChanged();
    }

    private async Task AgregarAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        if (string.IsNullOrWhiteSpace(_borrador.NombreMedicamento)) { return; }
        _agregando = true;
        try
        {
            var preview = PosologiaPreview();
            // Carga manual (suelto): si el flag esta on y no hay codigo, se autonumera
            // (MDO-001, MDO-002, ...). Si el profesional escribio un codigo, se respeta.
            var codigo = _borrador.Codigo;
            if (_permitirManuales && string.IsNullOrWhiteSpace(codigo)) { codigo = SiguienteConsecutivo(PrefijoConsecutivo); }
            // Total: el editado por el usuario si lo hay; si no, el calculado.
            var totalFinal = string.IsNullOrWhiteSpace(_borrador.Total)
                ? CalcularTotal(_borrador.Cantidad, _borrador.Frecuencia, _borrador.Dias)
                : _borrador.Total.Trim();
            var creado = await OrdSvc.AgregarAsync(hid, new AgregarMedicamentoRequest(
                _borrador.MedicamentoId,
                codigo,
                _borrador.NombreMedicamento!,
                _borrador.Cantidad,
                _borrador.Frecuencia,
                _borrador.Dias,
                preview,
                _borrador.Observacion,
                _borrador.MipresUrl,
                _ordenActual,
                totalFinal), Guid.Empty);
            _items.Add(creado);
            await NotifyCount();
            await NotifyItemsChanged();
            LimpiarBorrador();
        }
        finally { _agregando = false; }
    }

    private void LimpiarBorrador()
    {
        _borrador = new();
        _terminoBusqueda = "";
        _sugerencias.Clear();
    }

    private async Task GuardarPosologia(OrdenMedicamentoItemDto it, string? nuevaPosologia)
    {
        var req = new ActualizarMedicamentoRequest(it.Cantidad, it.Frecuencia, it.Dias, nuevaPosologia, it.Observacion, CantidadTotal: it.CantidadTotal);
        await OrdSvc.ActualizarAsync(it.Id, req, Guid.Empty);
        var idx = _items.FindIndex(x => x.Id == it.Id);
        if (idx >= 0) { _items[idx] = it with { Posologia = nuevaPosologia }; }
        await NotifyItemsChanged();
    }

    private async Task GuardarObservacion(OrdenMedicamentoItemDto it, string? nuevaObs)
    {
        var req = new ActualizarMedicamentoRequest(it.Cantidad, it.Frecuencia, it.Dias, it.Posologia, nuevaObs, CantidadTotal: it.CantidadTotal);
        await OrdSvc.ActualizarAsync(it.Id, req, Guid.Empty);
        var idx = _items.FindIndex(x => x.Id == it.Id);
        if (idx >= 0) { _items[idx] = it with { Observacion = nuevaObs }; }
        await NotifyItemsChanged();
    }

    private async Task EliminarAsync(OrdenMedicamentoItemDto it)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Quitar \"{it.NombreMedicamento}\" de la orden?");
        if (!ok) { return; }
        await OrdSvc.EliminarAsync(it.Id, Guid.Empty);
        _items.RemoveAll(x => x.Id == it.Id);
        await NotifyCount();
        await NotifyItemsChanged();
    }

    /// <summary>Abre la vista imprimible /orden-doc en una nueva pestana del navegador.</summary>
    private async Task ImprimirAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        await JS.InvokeVoidAsync("open", $"/orden-doc/{hid}/ORDEN_MEDICAMENTOS", "_blank");
    }

    private sealed class BorradorMed
    {
        public Guid? MedicamentoId { get; set; }
        public string? Codigo { get; set; }
        public string? NombreMedicamento { get; set; }
        public string? Cantidad { get; set; }
        public string? Frecuencia { get; set; }
        public string? Dias { get; set; }
        /// <summary>Total a entregar. Se auto-calcula al cambiar cantidad/frecuencia/dias
        /// pero el profesional puede editarlo antes de agregar.</summary>
        public string? Total { get; set; }
        public string? Observacion { get; set; }
        public string? MipresUrl { get; set; }
    }
}
