    .cie-modal-body { padding: 18px; overflow: auto; }
    .cie-modal-foot { padding: 12px 18px; border-top: 1px solid #e2e8f0; display: flex; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _puede;
    private string? _error;

    private List<AutorizacionTokenDto> _rows = new();

    private bool _modalOpen;
    private string _fConcepto = "";
    private string? _modalError;
    private string? _tokenGenerado;
    private DateTimeOffset? _tokenGeneradoVence;

    private List<AutorizacionConceptoDto> _conceptos = new();     // activos (para el select)
    private List<AutorizacionConceptoDto> _conceptosAll = new();  // todos (para configurar)
    private bool _conceptosModalOpen;
    private string _fNuevoConcepto = "";
    private string? _conceptosError;

    // ── Solicitudes de autorizacion (de los profesionales) ──────────────────────
    private string _tab = "sol";
    private List<AutorizacionSolicitudDto> _sols = new();
    private bool _soloPendientes = true;
    private int _pendientes;
    private string? _solError;
    // IMP-71: aprobar / rechazar con observacion enriquecida (TinyMCE).
    private const string EditorId = "az-obs-ed";
    private AutorizacionSolicitudDto? _resolver;
    private bool _resolverAprobar;
    private bool _edPendiente;
    private string? _resError;
    private bool _verObsAbierto;
    private string? _verObsHtml;
    private string? _verObsTexto;
    private System.Threading.Timer? _refresco;

    protected override async Task OnInitializedAsync()
    {
        await ResolverPermisoAsync();
        if (_puede)
        {
            await CargarSolicitudesAsync();
            // Refresco automatico de la bandeja de solicitudes (cada 30 s).
            _refresco = new System.Threading.Timer(async _ =>
            {
                try { await InvokeAsync(async () => { await CargarSolicitudesAsync(); StateHasChanged(); }); }
                catch { /* circuito cerrado */ }
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
            await CargarAsync();
            try { _conceptos = (await Svc.ListarConceptosAsync()).ToList(); } catch { }
        }
        _loading = false;
    }

    private async Task ResolverPermisoAsync()
    {
        if (AuthState is null) { _puede = false; return; }
        var st = await AuthState;
        var rol = st.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        var tenantRole = st.User.FindFirst("tenant_role")?.Value ?? "";
        var platformRole = st.User.FindFirst("platform_role")?.Value ?? "";
        var esAdmin = string.Equals(tenantRole, "Owner", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(tenantRole, "Admin", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(rol, "Administrador", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(platformRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
        var perms = st.User.FindFirst("perms")?.Value;
        var tienePermiso = !string.IsNullOrEmpty(perms)
            && perms.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Any(p => string.Equals(p.Trim(), "autorizaciones", StringComparison.OrdinalIgnoreCase));
        _puede = esAdmin || tienePermiso;
    }

    public void Dispose() => _refresco?.Dispose();

    private async Task CambiarTabAsync(string tab)
    {
        _tab = tab;
        if (tab == "sol") { await CargarSolicitudesAsync(); } else { await CargarAsync(); }
    }

    private async Task CargarSolicitudesAsync()
    {
        try
        {
            _sols = (await Svc.ListarSolicitudesAsync(_soloPendientes)).ToList();
            _pendientes = await Svc.ContarSolicitudesPendientesAsync();
        }
        catch (Exception ex) { _solError = ex.Message; }
    }

    // -- IMP-71: editor enriquecido -----------------------------------------------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_edPendiente) { return; }
        _edPendiente = false;
        var ph = _modalOpen
            ? "Ej: Autorizo registro tardio por falla de conectividad del profesional."
            : (_resolverAprobar ? "Observacion opcional para el profesional..." : "Explica por que se rechaza...");
        try { await JS.InvokeVoidAsync("capEditor.initObs", "#" + EditorId, "", ph); }
        catch (Exception ex) { _resError = _modalError = "No se pudo cargar el editor: " + ex.Message; StateHasChanged(); }
    }

    private async Task<string> LeerEditorAsync()
    {
        try { return await JS.InvokeAsync<string>("capEditor.get", "#" + EditorId) ?? ""; }
        catch { return ""; }
    }

    private async Task DestruirEditorAsync()
    {
        try { await JS.InvokeVoidAsync("capEditor.destroy", "#" + EditorId); } catch { /* ya no existe */ }
    }

    private void AbrirResolver(AutorizacionSolicitudDto r, bool aprobar)
    {
        _resError = null;
        _resolver = r;
        _resolverAprobar = aprobar;
        _edPendiente = true;
    }

    private async Task CerrarResolverAsync()
    {
        await DestruirEditorAsync();
        _resolver = null;
        _resError = null;
    }

    private async Task ConfirmarResolverAsync()
    {
        if (_resolver is null) { return; }
        _resError = null;
        var html = await LeerEditorAsync();
        if (!_resolverAprobar && Visal.Application.Common.ObservacionRica.TextoPlano(html) is null && !html.Contains("<img", StringComparison.OrdinalIgnoreCase))
        {
            _resError = "Escribe el motivo del rechazo.";
            return;
        }
        _busy = true;
        try
        {
            var (actor, nombre) = await ActorAsync();
            var obs = string.IsNullOrWhiteSpace(html) ? null : html;
            var res = _resolverAprobar
                ? await Svc.AprobarSolicitudAsync(_resolver.Id, obs, nombre, actor)
                : await Svc.RechazarSolicitudAsync(_resolver.Id, obs ?? "", nombre, actor);
            if (!res.Ok) { _resError = res.Mensaje; return; }
            await DestruirEditorAsync();
            _resolver = null;
            await CargarSolicitudesAsync();
        }
        catch (Exception ex) { _resError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task VerObservacionAsync(Guid id, bool esToken, string? texto)
    {
        _verObsTexto = texto;
        _verObsHtml = null;
        try { _verObsHtml = await Svc.ObtenerObservacionHtmlAsync(id, esToken); }
        catch (Exception ex) { _error = ex.Message; }
        _verObsAbierto = true;
    }

    private async Task CargarAsync()
    {
        try { _rows = (await Svc.ListarAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void AbrirGenerar()
    {
        _modalError = null; _fConcepto = "";
        _modalOpen = true;
        _edPendiente = true;
    }

    private async Task Cerrar()
    {
        await DestruirEditorAsync();
        _modalOpen = false;
    }

    private async Task GenerarAsync()
    {
        _modalError = null;
        var html = await LeerEditorAsync();
        if (Visal.Application.Common.ObservacionRica.TextoPlano(html) is null && !html.Contains("<img", StringComparison.OrdinalIgnoreCase))
        {
            _modalError = "La observacion es obligatoria.";
            return;
        }
        _busy = true; _error = null;
        try
        {
            var (actor, nombre) = await ActorAsync();
            var codigo = await Svc.GenerarAsync(_fConcepto, html, nombre, actor);
            _tokenGenerado = codigo;
            _tokenGeneradoVence = DateTimeOffset.UtcNow.AddMinutes(30);
            await DestruirEditorAsync();
            _modalOpen = false;
            await CargarAsync();
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _busy = false; }
    }

    // ── Conceptos configurables ──────────────────────────────────────────────────
    private async Task AbrirConceptos()
    {
        _conceptosError = null; _fNuevoConcepto = "";
        try { _conceptosAll = (await Svc.ListarConceptosAsync(incluirInactivos: true)).ToList(); }
        catch (Exception ex) { _conceptosError = ex.Message; }
        _conceptosModalOpen = true;
    }

    private void CerrarConceptos() => _conceptosModalOpen = false;

    private async Task AgregarConceptoAsync()
    {
        _conceptosError = null;
        if (string.IsNullOrWhiteSpace(_fNuevoConcepto)) { _conceptosError = "Escribe el concepto."; return; }
        _busy = true;
        try
        {
            var (actor, _) = await ActorAsync();
            var orden = _conceptosAll.Count == 0 ? 1 : _conceptosAll.Max(c => c.Orden) + 1;
            await Svc.GuardarConceptoAsync(null, _fNuevoConcepto, orden, true, actor);
            _fNuevoConcepto = "";
            _conceptosAll = (await Svc.ListarConceptosAsync(incluirInactivos: true)).ToList();
            _conceptos = (await Svc.ListarConceptosAsync()).ToList();
        }
        catch (Exception ex) { _conceptosError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task EliminarConceptoAsync(AutorizacionConceptoDto c)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminar el concepto '{c.Nombre}'?");
        if (!ok) { return; }
        _conceptosError = null; _busy = true;
        try
        {
            var (actor, _) = await ActorAsync();
            await Svc.EliminarConceptoAsync(c.Id, actor);
            _conceptosAll = (await Svc.ListarConceptosAsync(incluirInactivos: true)).ToList();
            _conceptos = (await Svc.ListarConceptosAsync()).ToList();
        }
        catch (Exception ex) { _conceptosError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task<(Guid actor, string? nombre)> ActorAsync()
    {
        if (AuthState is null) { return (Guid.Empty, null); }
        var st = await AuthState;
        var actor = Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : Guid.Empty;
        var nombre = st.User.FindFirst("name")?.Value
                     ?? st.User.FindFirst(ClaimTypes.Name)?.Value
                     ?? st.User.Identity?.Name;
        return (actor, nombre);
    }
}
