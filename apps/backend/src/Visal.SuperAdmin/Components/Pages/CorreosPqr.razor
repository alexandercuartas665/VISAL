.ep-chip:hover { background:#e2e8f0; }
.ep-chip-on { background:#2563eb; color:#fff; border-color:#2563eb; }
.ep-spin { display:inline-block; width:.85rem; height:.85rem; border:2px solid #cbd5e1; border-top-color:#2563eb; border-radius:50%; animation:ep-spin 0.7s linear infinite; vertical-align:-2px; }
@@keyframes ep-spin { to { transform:rotate(360deg); } }
</style>

@code {
    private sealed class AgenteOpt { public Guid Id; public string Name = ""; public AiProvider Provider; }
    private sealed class TableroOpt { public Guid Id; public string Name = ""; }

    private sealed class FormModel
    {
        public Guid? Id { get; set; }
        public bool HasAppPassword { get; set; }
        public string Nombre { get; set; } = "";
        public string EmailAddress { get; set; } = "";
        public string? AppPassword { get; set; }
        public string ImapHost { get; set; } = "imap.gmail.com";
        public int ImapPort { get; set; } = 993;
        public bool ImapUseSsl { get; set; } = true;
        public string Folder { get; set; } = "INBOX";
        public Guid? ClassifierAgentId { get; set; }
        public Guid? TargetBoardId { get; set; }
        public int PollIntervalMinutes { get; set; } = 5;
        public int LookbackDays { get; set; } = 7;
        public int MaxPorCorrida { get; set; } = 25;
        public bool OnlyUnread { get; set; } = true;
        public bool MarkAsRead { get; set; } = true;
        public string? ProcessedLabel { get; set; }
        public bool IsEnabled { get; set; }
    }

    private bool _cargando = true;
    private List<EmailIngestConfigDto> _items = new();
    private List<AgenteOpt> _agentes = new();
    private List<TableroOpt> _tableros = new();
    private FormModel? _form;
    private string? _formError;
    private bool _saving;
    private Guid? _busyId;
    private Guid? _procesandoId;
    private EmailIngestConfigDto? _logsDe;
    private List<EmailIngestLogDto> _logs = new();
    private List<string> _labels = new();
    private bool _loadingLabels;
    private string _msg = "";
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        var db = (DbContext)Db;
        _agentes = await db.Set<Visal.Domain.Entities.AiAgent>().AsNoTracking()
            .OrderByDescending(a => a.IsActive).ThenBy(a => a.SortOrder).ThenBy(a => a.Name)
            .Select(a => new AgenteOpt { Id = a.Id, Name = a.Name, Provider = a.Provider }).ToListAsync();
        _tableros = await db.Set<Visal.Domain.Entities.TaskBoard>().AsNoTracking()
            .OrderBy(t => t.Name).Select(t => new TableroOpt { Id = t.Id, Name = t.Name }).ToListAsync();
        await RecargarAsync();
        _cargando = false;
    }

    private async Task RecargarAsync() => _items = (await Svc.ListAsync()).ToList();

    private void AbrirEditor(EmailIngestConfigDto? b)
    {
        _formError = null;
        _labels = new();
        _loadingLabels = false;
        if (b is null)
        {
            _form = new FormModel
            {
                // Preselecciona el tablero "PQR" si existe.
                TargetBoardId = _tableros.FirstOrDefault(t => t.Name.Equals("PQR", StringComparison.OrdinalIgnoreCase))?.Id
            };
        }
        else
        {
            _form = new FormModel
            {
                Id = b.Id, HasAppPassword = b.HasAppPassword, Nombre = b.Nombre, EmailAddress = b.EmailAddress,
                ImapHost = b.ImapHost, ImapPort = b.ImapPort, ImapUseSsl = b.ImapUseSsl, Folder = b.Folder,
                ClassifierAgentId = b.ClassifierAgentId, TargetBoardId = b.TargetBoardId,
                PollIntervalMinutes = b.PollIntervalMinutes, LookbackDays = b.LookbackDays, MaxPorCorrida = b.MaxPorCorrida,
                OnlyUnread = b.OnlyUnread, MarkAsRead = b.MarkAsRead, ProcessedLabel = b.ProcessedLabel, IsEnabled = b.IsEnabled
            };
            // Pre-siembra el datalist con la etiqueta ya guardada para que se vea sin recargar.
            if (!string.IsNullOrWhiteSpace(b.ProcessedLabel)) { _labels = new() { b.ProcessedLabel! }; }
        }
    }

    private async Task GuardarAsync()
    {
        if (_form is null) { return; }
        _formError = null;
        _saving = true;
        try
        {
            var req = new SaveEmailIngestConfigRequest(
                _form.Id, _form.Nombre, _form.EmailAddress, _form.AppPassword, _form.ImapHost, _form.ImapPort,
                _form.ImapUseSsl, _form.Folder, _form.ClassifierAgentId, _form.TargetBoardId, null,
                _form.PollIntervalMinutes, _form.LookbackDays, _form.MaxPorCorrida, _form.OnlyUnread, _form.MarkAsRead,
                _form.ProcessedLabel, _form.IsEnabled);
            await Svc.SaveAsync(req);
            await RecargarAsync();
            _form = null;
            Toast("Buzon guardado.", false);
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ProbarAsync(EmailIngestConfigDto b)
    {
        _busyId = b.Id;
        try
        {
            var (ok, err, total) = await Svc.TestConnectionAsync(b.Id);
            Toast(ok ? $"Conexion OK. {total} correo(s) en la carpeta." : (err ?? "No se pudo conectar."), !ok);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        finally { _busyId = null; }
    }

    private async Task ProcesarAsync(EmailIngestConfigDto b)
    {
        _busyId = b.Id;
        _procesandoId = b.Id;
        StateHasChanged(); // pinta el spinner "Procesando..." antes de bloquear en la corrida
        try
        {
            var r = await Svc.ProcessNowAsync(b.Id);
            if (r.Ok)
            {
                Toast($"{r.Leidos} leidos · {r.Creados} PQR · {r.Descartados} descartados · {r.Adjuntos} adjuntos · {r.Tokens:N0} tokens · {r.Errores} errores.", r.Errores > 0);
            }
            else { Toast(r.Error ?? "No se pudo procesar.", true); }
            await RecargarAsync();
        }
        catch (Exception ex) { Toast(ex.Message, true); }
        finally { _busyId = null; _procesandoId = null; }
    }

    private async Task AbrirLogsAsync(EmailIngestConfigDto b)
    {
        _logsDe = b;
        _logs = (await Svc.ListLogsAsync(b.Id, 150)).ToList();
    }

    private async Task CargarEtiquetasAsync()
    {
        if (_form?.Id is not { } id) { return; }
        _loadingLabels = true;
        _formError = null;
        try
        {
            var (ok, err, labels) = await Svc.ListarEtiquetasAsync(id);
            if (ok)
            {
                // Conserva la etiqueta ya elegida aunque no venga en la lista (evita perder la seleccion).
                var set = new List<string>(labels);
                if (!string.IsNullOrWhiteSpace(_form.ProcessedLabel) &&
                    !set.Contains(_form.ProcessedLabel!, StringComparer.OrdinalIgnoreCase))
                {
                    set.Insert(0, _form.ProcessedLabel!);
                }
                _labels = set;
                Toast(labels.Count == 0 ? "La cuenta no tiene etiquetas propias (solo carpetas de sistema)." : $"{labels.Count} etiqueta(s) cargada(s).", false);
            }
            else { _formError = err ?? "No se pudieron cargar las etiquetas."; }
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _loadingLabels = false; }
    }

    private async Task EliminarAsync(EmailIngestConfigDto b)
    {
        try
        {
            await Svc.DeleteAsync(b.Id);
            await RecargarAsync();
            Toast("Buzon eliminado.", false);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private static string ResTexto(EmailIngestResultTipo r) => r switch
    {
        EmailIngestResultTipo.CreadaPqr => "PQR creada",
        EmailIngestResultTipo.NoEsPqr => "No es PQR",
        EmailIngestResultTipo.Duplicado => "Duplicado",
        EmailIngestResultTipo.Error => "Error",
        EmailIngestResultTipo.SinConfig => "Sin config",
        _ => r.ToString()
    };

    private void Toast(string m, bool err) { _msg = m; _error = err; }
}
