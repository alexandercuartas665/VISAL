    private async Task CopiarFilaAsync()
    {
        _menuFilaVisible = false;
        if (_verDetalle is null) { return; }
        var fila = _verFilas.FirstOrDefault(f =>
            f.TryGetValue("__filaId", out var idv) && idv is Guid gg && gg == _menuFilaId);
        if (fila is null) { return; }
        // Copia tab-separada en el orden de las columnas visibles (pegable en Excel).
        var texto = string.Join("\t", _verDetalle.Columnas.Select(c =>
            fila.TryGetValue(c, out var v) ? v?.ToString() ?? "" : ""));
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto); _ok = "Fila copiada al portapapeles."; }
        catch { _error = "No se pudo copiar la fila (portapapeles no disponible)."; }
    }

    private async Task SetColorFilaUiAsync(string? color)
    {
        var filaId = _menuFilaId;
        _menuFilaVisible = false;
        if (filaId == Guid.Empty) { return; }
        try
        {
            await Svc.SetColorFilaAsync(_verSnapshotId, filaId, color, _actorId);
            // Refleja el color en memoria sin repaginar toda la tabla.
            for (var i = 0; i < _verFilas.Count; i++)
            {
                if (_verFilas[i].TryGetValue("__filaId", out var idv) && idv is Guid gg && gg == filaId)
                {
                    var d = new Dictionary<string, object?>(_verFilas[i], StringComparer.Ordinal)
                    {
                        ["__color"] = color
                    };
                    _verFilas[i] = d;
                    break;
                }
            }
        }
        catch (Exception ex) { _error = "No se pudo cambiar el color: " + ex.Message; }
    }

