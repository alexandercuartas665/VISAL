@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 50;
    private static readonly TimeSpan Bogota = TimeSpan.FromHours(-5);
    private static readonly string[] TabsCompleta = ["Instrucciones", "Contexto enviado", "HC legible", "Tools", "Respuesta cruda"];

    private bool _puede;
    private bool _esAdmin;
    private Guid _actor;
    private Guid _tenantId;
    private string _tab = "hc";
    private bool _cargando;
    private bool _busy;
    private string? _error;

    private DateTime? _fDesde;
    private DateTime? _fHasta;
    private string _fResultado = "";
    private string _fOrigen = "";
    private string? _fProfesional;
    private string? _fHc;
    private string? _fFormato;
    private bool _fSoloAlertas;
    private bool _fSoloPulgarAbajo;

    private int _page = 1;
    private BitacoraPagina<BitacoraHcFilaDto>? _pagina;
    private BitacoraResumenDto? _resumen;
    private BitacoraHcDetalleDto? _detalle;
    private readonly Dictionary<Guid, BitacoraCorridaCompletaDto> _completa = new();
    private readonly Dictionary<Guid, string> _tabCompleta = new();

    private BitacoraApiConfigDto? _api;
    private bool _verLlave;
    private bool _copiado;

    private int TotalPaginas => _pagina is null ? 1 : Math.Max(1, (int)Math.Ceiling(_pagina.Total / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        await ResolverPermisoAsync();
        if (!_puede) { return; }
        if (Tenant.TenantId is not Guid t) { _puede = false; return; }
        _tenantId = t;
        var hoy = DateTime.UtcNow.Add(Bogota).Date;
        _fDesde = hoy;
        _fHasta = hoy;
        await CargarAsync();
    }

    private async Task ResolverPermisoAsync()
    {
        if (AuthState is null) { return; }
        var st = await AuthState;
        var rol = st.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        var tenantRole = st.User.FindFirst("tenant_role")?.Value ?? "";
        var platformRole = st.User.FindFirst("platform_role")?.Value ?? "";
        _esAdmin = string.Equals(tenantRole, "Owner", StringComparison.OrdinalIgnoreCase)
                || string.Equals(tenantRole, "Admin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(rol, "Administrador", StringComparison.OrdinalIgnoreCase)
                || string.Equals(platformRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
        var perms = st.User.FindFirst("perms")?.Value;
        var tienePermiso = !string.IsNullOrEmpty(perms)
            && perms.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Any(p => string.Equals(p.Trim(), PermisosUsuario.BitacoraIa, StringComparison.OrdinalIgnoreCase));
        _puede = _esAdmin || tienePermiso;
        _actor = Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var g) ? g : Guid.Empty;
    }

    private BitacoraFiltro Filtro() => new(
        _fDesde is { } d ? DateOnly.FromDateTime(d) : null,
        _fHasta is { } h ? DateOnly.FromDateTime(h) : null,
        string.IsNullOrWhiteSpace(_fResultado) ? null : _fResultado,
        string.IsNullOrWhiteSpace(_fOrigen) ? null : _fOrigen,
        _fProfesional, _fHc, _fFormato, _fSoloAlertas, _fSoloPulgarAbajo);

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            // Cada llamada usa su propio contexto (factory): se pueden pedir en paralelo.
            var f = Filtro();
            var tResumen = Svc.ResumenAsync(_tenantId, f);
            var tPagina = Svc.ListarHistoriasAsync(_tenantId, f, _page, PageSize);
            await Task.WhenAll(tResumen, tPagina);
            _resumen = tResumen.Result;
            _pagina = tPagina.Result;
        }
        catch (Exception ex) { _error = "No se pudo cargar la bitacora: " + ex.Message; }
        finally { _cargando = false; }
    }

    private async Task AplicarAsync() { _page = 1; await CargarAsync(); }

    private async Task LimpiarAsync()
    {
        var hoy = DateTime.UtcNow.Add(Bogota).Date;
        _fDesde = hoy; _fHasta = hoy;
        _fResultado = ""; _fOrigen = ""; _fProfesional = null; _fHc = null; _fFormato = null;
        _fSoloAlertas = false; _fSoloPulgarAbajo = false;
        await AplicarAsync();
    }

    private async Task IrPaginaAsync(int p)
    {
        _page = Math.Max(1, p);
        _cargando = true;
        try { _pagina = await Svc.ListarHistoriasAsync(_tenantId, Filtro(), _page, PageSize); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private async Task FiltrarProfesionalAsync(string nombre)
    {
        _fProfesional = nombre == "(sin profesional)" ? null : nombre;
        _tab = "hc";
        await AplicarAsync();
    }

    private async Task AbrirDetalleAsync(Guid hcId)
    {
        _completa.Clear();
        _tabCompleta.Clear();
        try { _detalle = await Svc.DetalleHistoriaAsync(_tenantId, hcId.ToString()); }
        catch (Exception ex) { _error = "No se pudo abrir la historia: " + ex.Message; }
    }

    private void CerrarDetalle() => _detalle = null;

    private async Task CargarCompletaAsync(Guid logId)
    {
        var c = await Svc.CorridaAsync(_tenantId, logId);
        if (c is not null) { _completa[logId] = c; }
    }

    private string TabDe(Guid id) => _tabCompleta.TryGetValue(id, out var t) ? t : TabsCompleta[0];

    private static string? TextoCompleta(BitacoraCorridaCompletaDto c, string tab) => tab switch
    {
        "Instrucciones" => c.SystemPrompt,
        "Contexto enviado" => c.ContextoEnviado,
        "HC legible" => c.CamposLegiblesJson,
        "Tools" => c.ToolsJson,
        _ => c.RespuestaCruda,
    };

    private async Task CopiarAsync(string? texto)
    {
        if (string.IsNullOrEmpty(texto)) { return; }
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto);
            _copiado = true;
        }
        catch { }
    }

    // -- API --
    private async Task AbrirApiAsync()
    {
        _tab = "api";
        _copiado = false;
        _api = await Svc.GetApiAsync(_tenantId);
    }

    private async Task RegenerarAsync()
    {
        if (!_esAdmin) { return; }
        if (_api is { HasKey: true }
            && !await JS.InvokeAsync<bool>("confirm", "La llave actual dejara de funcionar. Generar una nueva?"))
        {
            return;
        }
        _busy = true;
        try { _api = await Svc.RegenerarApiAsync(_tenantId, _actor); _verLlave = true; }
        finally { _busy = false; }
    }

    private async Task ToggleApiAsync()
    {
        if (!_esAdmin || _api is null) { return; }
        _busy = true;
        try { _api = await Svc.SetApiHabilitadaAsync(_tenantId, !_api.IsEnabled, _actor); }
        finally { _busy = false; }
    }

    private string EjemploApi()
    {
        var b = Nav.BaseUri.TrimEnd('/') + "/api/bitacora-ia";
        return $@"Header: X-Api-Key: <llave>

GET {b}/                      indice de la API (endpoints, filtros, alertas)
GET {b}/resumen?desde=2026-11-26&hasta=2026-11-26
GET {b}/historias?desde=2026-11-26&soloAlertas=true&page=1&size=50
GET {b}/historias/HC-033421    intentos de la HC + comparacion entre intentos
GET {b}/corridas?desde=2026-11-26&resultado=Rechazado
GET {b}/corridas/<id>          corrida completa (prompt, contexto, HC legible, tools, respuesta)

Filtros: desde, hasta (dia local), resultado (Aprobado|Rechazado|Neutral|Fallida), origen (Cierre|Revision),
profesional, hc (HC-000123 | documento del paciente), formato, soloAlertas, soloPulgarAbajo

Ejemplo (PowerShell):
Invoke-RestMethod -Uri ""{b}/historias?soloAlertas=true"" -Headers @{{ ""X-Api-Key"" = ""<llave>"" }}";
    }

    private static string Enmascarar(string? k)
        => string.IsNullOrEmpty(k) ? "" : k.Length <= 10 ? new string('*', k.Length) : k[..6] + new string('*', k.Length - 10) + k[^4..];

    // -- formato --
    private static string F(DateTimeOffset d) => d.ToOffset(Bogota).ToString("yyyy-MM-dd HH:mm");
    private static string Pct(decimal? c) => c is decimal v ? (v * 100m).ToString("0") + "%" : "";
    private static string Miles(long n) => n >= 1_000_000 ? (n / 1_000_000d).ToString("0.0") + "M" : n >= 1000 ? (n / 1000d).ToString("0.0") + "K" : n.ToString();
    private static string ClaseRes(string? r) => (r ?? "").ToLowerInvariant();
}
