    // ---- Helpers del tab Tipologias ----
    private string PatronDe(InformeItemDto a) =>
        !string.IsNullOrWhiteSpace(a.PatronNombre) ? a.PatronNombre!
        : !string.IsNullOrWhiteSpace(_tipConfig?.PatronNombreDefault) ? _tipConfig!.PatronNombreDefault!
        : "{sigla}_{cedula}";

    private string ResolverNombre(InformeItemDto a, PacienteSnapshotDto p)
    {
        var patron = PatronDe(a);
        var hoy = DateTimeOffset.Now.ToLocalTime();
        var aut = p.Autorizaciones.Count > 0 ? p.Autorizaciones[0] : "";
        var nombre = (p.Nombre ?? "").Replace(' ', '_');
        var res = patron
            .Replace("{sigla}", a.Alias ?? "")
            .Replace("{cedula}", p.Documento ?? "")
            .Replace("{autorizacion}", aut)
            .Replace("{nombre}", nombre)
            .Replace("{consecutivo}", "")
            .Replace("{codigo_hc}", "")
            .Replace("{tipo_servicio}", "")
            .Replace("{mes}", hoy.ToString("MM"));
        // Token de fecha con formato: {fecha:yyyyMMdd}
        res = System.Text.RegularExpressions.Regex.Replace(res, @"\{fecha:([^}]+)\}", m =>
        {
            try { return hoy.ToString(m.Groups[1].Value); } catch { return ""; }
        });
        res = res.Replace("{fecha}", hoy.ToString("yyyyMMdd"));
        return res + ".pdf";
    }

