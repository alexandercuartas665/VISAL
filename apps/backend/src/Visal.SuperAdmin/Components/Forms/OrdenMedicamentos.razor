@using Visal.Application.Tenancy
@using Visal.Application.Common
@inject IOrdenMedicamentoService OrdSvc
@inject IConfiguracionClinicaService ConfigSvc
@inject IJSRuntime JS

@*
   Pestana "Orden de Medicamentos" de la HC. Buscador con autocompletado
   contra el catalogo CUM (/medicamentos), agregar/editar/eliminar items
   atados a la HistoriaClinicaId, cada item con su observacion. Cambios
   se persisten al instante (no requiere "Guardar" explicito).
*@

<div class="od-bar">
    <div class="od-bar-left">
        <label>Ordenes de Medicamentos</label>
        <span class="od-bar-count">@OrdenesPresentes().Count orden(es) &middot; @_items.Count item(s)</span>
    </div>
    <div class="od-bar-right">
        @* La impresion se hace SIEMPRE desde el boton "Imprimir" general de la historia
           (arriba): ahi cada orden de medicamentos sale como su propio documento con su
           formula (firma + QR). Aqui no hay boton propio para no duplicar puntos de impresion. *@
        <span class="od-print-hint" style="font-size:12px;color:var(--muted-foreground);">
            Para imprimir usa el bot&oacute;n <b>&#128424; Imprimir</b> de la historia (arriba). Cada orden sale por separado.
        </span>
    </div>
</div>

@if (HistoriaClinicaId is null)
{
    <div class="od-card od-empty-hc">
        Selecciona o inicia una historia para registrar medicamentos.
    </div>
}
else
{
    @* ---- Selector de ordenes: N ordenes de medicamentos por HC ---- *@
    <div class="od-orders">
        @foreach (var n in OrdenesPresentes())
        {
            var nn = n;
            <button type="button" class="od-order-chip @(_ordenActual == nn ? "active" : "")"
                    @onclick="() => _ordenActual = nn">
                Orden @nn <span class="od-order-cnt">@_items.Count(x => x.NumeroOrden == nn)</span>
            </button>
        }
        <button type="button" class="od-order-new" @onclick="NuevaOrden" title="Crear otra orden de medicamentos">+ Nueva orden</button>
        @if (_items.Any(x => x.NumeroOrden == _ordenActual))
        {
            <button type="button" class="od-order-del" @onclick="EliminarOrdenActualAsync"
                    title="Eliminar esta orden con todos sus medicamentos">&#128465; Eliminar orden @_ordenActual</button>
        }
    </div>

    <div class="od-card">
        @* ---- Fila de captura: autocompletado + posologia + cantidad ---- *@
        <div class="od-row">
            <div class="od-f od-c-6 od-search-wrap">
                <label>Nombre del Medicamento</label>
                <input class="form-control form-control-sm"
                       placeholder="Buscar medicamento (min 2 caracteres)..."
                       value="@_terminoBusqueda"
                       @oninput="OnTerminoChanged" />
                @if (_sugerencias.Count > 0)
                {
                    <div class="od-suggest">
                        @foreach (var s in _sugerencias)
                        {
                            var sCopy = s;
                            <button class="od-suggest-item" @onclick="() => SeleccionarSugerencia(sCopy)">
                                <div class="od-suggest-nm">@s.Producto</div>
                                <div class="od-suggest-meta">
                                    @if (!string.IsNullOrWhiteSpace(s.PrincipioActivo)) { <span>@s.PrincipioActivo</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.Concentracion)) { <span>&middot; @s.Concentracion</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.FormaFarmaceutica)) { <span>&middot; @s.FormaFarmaceutica</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.RegistroSanitario)) { <span class="od-suggest-reg">@s.RegistroSanitario</span> }
                                </div>
                            </button>
                        }
                        @* "Cargar mas" aparece cuando la ultima consulta trajo el tope
                           actual (_pageSize) — es la senal de que probablemente hay mas
                           registros que la BD podria retornar. Sube el tope y re-consulta. *@
                        @if (_sugerencias.Count >= _pageSize)
                        {
                            <button class="od-suggest-more" @onclick="CargarMasSugerenciasAsync" disabled="@_buscando">
                                @(_buscando ? "Cargando..." : $"+ Cargar mas resultados ({_pageSize} mostrados)")
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_terminoBusqueda) && _terminoBusqueda.Trim().Length >= 2 && !_buscando)
                {
                    <div class="od-suggest od-suggest-empty">Sin resultados para "@_terminoBusqueda"</div>
                }
                @* Carga manual (suelto): solo con el flag del tenant. Permite agregar
                   el medicamento tal como se escribio, sin exigir catalogo. *@
                @if (_permitirManuales && !string.IsNullOrWhiteSpace(_terminoBusqueda) && _terminoBusqueda.Trim().Length >= 2)
                {
                    <button type="button" class="od-manual-btn" @onclick="UsarManual"
                            title="Agregar como texto libre (sin catalogo). Si no escribes un codigo, se numera automatico (@(PrefijoConsecutivo)001).">
                        + Usar "@_terminoBusqueda.Trim()" (manual)
                    </button>
                }
                @if (_permitirManuales && _borrador.MedicamentoId is null && !string.IsNullOrWhiteSpace(_borrador.NombreMedicamento))
                {
                    <div class="od-manual-pend">Manual: <b>@_borrador.NombreMedicamento</b> <span class="od-manual-cup">cod. @(string.IsNullOrWhiteSpace(_borrador.Codigo) ? "auto " + PrefijoConsecutivo + "…" : _borrador.Codigo)</span></div>
                }
            </div>
            <div class="od-f od-c-4">
                <div class="od-posol">
                    <div class="od-posol-grid od-posol-grid-4">
                        <div>
                            <label class="od-mini">Cantidad</label>
                            <input class="form-control form-control-sm text-center"
                                   @bind="_borrador.Cantidad" @bind:event="oninput" @bind:after="SyncTotal" />
                        </div>
                        <div>
                            <label class="od-mini" title="Intervalo entre dosis en horas (8 = cada 8 horas, 24 = una vez al dia)">Cada (h)</label>
                            <input class="form-control form-control-sm text-center"
                                   @bind="_borrador.Frecuencia" @bind:event="oninput" @bind:after="SyncTotal"
                                   placeholder="8" />
                        </div>
                        <div>
                            <label class="od-mini">Dias</label>
                            <input class="form-control form-control-sm text-center"
                                   @bind="_borrador.Dias" @bind:event="oninput" @bind:after="SyncTotal" />
                        </div>
                        <div>
                            <label class="od-mini" title="Cantidad total a entregar. Se calcula sola pero puedes editarla antes de agregar.">Total</label>
                            <input class="form-control form-control-sm text-center od-total-input"
                                   @bind="_borrador.Total" @bind:event="oninput" placeholder="auto" />
                        </div>
                    </div>
                    <div class="od-posol-preview">@PosologiaPreview()</div>
                </div>
            </div>
            <div class="od-f od-c-2">
                <label>Accion</label>
                <button class="btn btn-primary btn-sm od-add"
                        @onclick="AgregarAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_borrador.NombreMedicamento) || _agregando)">
                    @(_agregando ? "Agregando..." : "+ Agregar")
                </button>
            </div>
        </div>

        @* Codigo manual: solo con el flag del tenant. Si se deja vacio, al agregar
           se numera automatico (MDO-001, MDO-002, ...). *@
        @if (_permitirManuales)
        {
            <div class="od-row">
                <div class="od-f od-c-4">
                    <label>Codigo (opcional)</label>
                    <input class="form-control form-control-sm mono"
                           placeholder="Vacio = @(PrefijoConsecutivo)001 (auto)"
                           @bind="_borrador.Codigo" @bind:event="oninput" />
                </div>
            </div>
        }

        @* ---- Fila 2: observacion del medicamento en captura (evita tener que
             agregar el item primero e ir a la tabla a editar la observacion). ---- *@
        <div class="od-row od-row-obs">
            <div class="od-f od-c-12">
                <label>Observacion clinica (opcional)</label>
                <input class="form-control form-control-sm"
                       placeholder="Ej: administrar con alimentos, suspender si aparece rash..."
                       @bind="_borrador.Observacion" @bind:event="oninput" />
            </div>
        </div>

@if (!string.IsNullOrWhiteSpace(_borrador.NombreMedicamento))
        {
            <div class="od-borrador">
                Medicamento seleccionado: <strong>@_borrador.NombreMedicamento</strong>
                <button class="btn btn-link btn-sm od-borrador-x" @onclick="LimpiarBorrador" title="Quitar">&times;</button>
            </div>
        }

        @* ---- Grilla de items agregados ---- *@
        <div class="od-grid-wrap">
            <table class="table table-sm od-tbl">
                <thead>
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="width:130px">Codigo</th>
                        <th>Nombre del Medicamento</th>
                        <th>Posologia</th>
                        <th class="text-center" style="width:80px">Total</th>
                        <th>Observacion</th>
                        <th class="text-center" style="width:50px"></th>
                    </tr>
                </thead>
                <tbody>
                    @{ var itemsOrden = _items.Where(x => x.NumeroOrden == _ordenActual).ToList(); }
                    @if (itemsOrden.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted od-empty-row">Sin medicamentos en la orden @_ordenActual.</td></tr>
                    }
                    else
                    {
                        @foreach (var it in itemsOrden)
                        {
                            var totalCalc = CalcularTotal(it.Cantidad, it.Frecuencia, it.Dias);
                            <tr>
                                <td class="text-center">@it.Orden</td>
                                <td class="od-codigo">@(string.IsNullOrWhiteSpace(it.CodigoMedicamento) ? "—" : it.CodigoMedicamento)</td>
                                <td>
                                    <strong>@it.NombreMedicamento</strong>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm od-inline-input"
                                           value="@it.Posologia"
                                           @onchange="@(e => GuardarPosologia(it, e.Value?.ToString()))" />
                                </td>
                                <td class="text-center od-total">
                                    <input class="form-control form-control-sm text-center od-inline-input od-total-cell"
                                           value="@(it.CantidadTotal ?? totalCalc)"
                                           placeholder="@(totalCalc ?? "—")"
                                           title="Total a entregar. Editable; vacio = total calculado."
                                           @onchange="@(e => GuardarTotal(it, e.Value?.ToString()))" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm od-inline-input"
                                           placeholder="Observacion clinica..."
                                           value="@it.Observacion"
                                           @onchange="@(e => GuardarObservacion(it, e.Value?.ToString()))" />
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-danger"
                                            @onclick="() => EliminarAsync(it)"
                                            title="Quitar de la orden">&#128465;</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
