    // Footer con firma retirado a peticion del cliente: el formulario define sus
    // propias secciones de firma (paciente / acompanantes / profesional) via
    // rutas de prefill. Ver historial: el helper solia agregar un bloque hardcoded
    // "Firma del profesional tratante" + "Recibido por paciente / acudiente"
    // despues de cada documento del paquete. Se dejo el helper como no-op para
    // no tocar los ~13 sitios que lo invocan.
    private RenderFragment RenderFirma(string? nombreProf, string rol) => __builder => { };

    // Render de un nodo del primer nivel del schema.
    // - Si es bloque de texto: una fila completa con el contenido.
    // - Si es seccion: subtitulo (si tiene label) + grid de 12 columnas con sus hijos,
    //   donde cada hijo respeta su WidthColumns (1..12).
    // - Si es campo/tabla suelto en el top-level: lo metemos en su propio grid para
    //   que tambien respete su WidthColumns.
    private RenderFragment RenderTopNode(FormNode n, Dictionary<string, string?> vals) => __builder =>
    {
        // Visibilidad condicional: si el nodo tiene VisibleWhen y no se cumple,
        // no se imprime (equivalente al FormViewer).
        if (!VisibleWhenEvaluator.ShouldShow(n.VisibleWhen, vals)) { return; }

        // No imprimir nunca: gate absoluto — la seccion/campo queda invisible
        // en impresion sin importar visibilidad o valor.
        if (n.NoImprimir) { return; }

        // HideIfEmpty (campos): si el disenador marco el campo con "No imprimir
        // si vacio" y el valor esta en blanco, se omite. Aplica solo a fields;
        // secciones se ignoran (no aplica el flag).
        if (n.HideIfEmpty && VisibleWhenEvaluator.IsFieldEmpty(n, vals)) { return; }

        // Seccion opcional al imprimir: si el disenador la marco como
        // PrintOptional y el usuario NO la selecciono en el modal (?secs=), la
        // omitimos. El default es "no imprimir opcionales" — el usuario debe
        // marcarlas explicitamente.
        if (n.IsSection && n.PrintOptional && !_seccionesOpcionalesIncluidas.Contains(n.Id))
        {
            return;
        }

        if (n.IsText)
        {
            <div class="pack-para">@(n.Content ?? "")</div>
            return;
        }
        if (n.IsSection)
        {
            if (!string.IsNullOrWhiteSpace(n.Label))
            {
                <div class="pack-sub">@n.Label</div>
            }
            <div class="pack-grid">
                @foreach (var ch in n.Children ?? new())
                {
                    if (!VisibleWhenEvaluator.ShouldShow(ch.VisibleWhen, vals)) { continue; }
                    if (ch.NoImprimir) { continue; }
                    if (ch.HideIfEmpty && VisibleWhenEvaluator.IsFieldEmpty(ch, vals)) { continue; }
                    @RenderDocNode(ch, vals)
                }
            </div>
            return;
        }
        // Campo o tabla en top-level: contenedor grid para que respete WidthColumns.
        <div class="pack-grid">
            @RenderDocNode(n, vals)
        </div>
    };

    /// <summary>
    /// Render de un nodo hoja dentro de una grid de 12 columnas. Usa el WidthColumns del
    /// nodo (1..12, clamped) para que el ancho de cada campo coincida con el disenador.
    /// Si no tiene WidthColumns valido, se asume 12 (toda la fila).
    /// </summary>
    private RenderFragment RenderDocNode(FormNode n, Dictionary<string, string?> vals) => __builder =>
    {
        var span = Math.Clamp(n.WidthColumns <= 0 ? 12 : n.WidthColumns, 1, 12);
        if (n.IsText)
        {
            <div class="pack-para" style="grid-column: span @span;">@(n.Content ?? "")</div>
            return;
        }
        if (n.IsTable)
        {
            // Leer filas reales: combina SeedRows (texto fijo) + filas extras
            // controladas por tbl:{id}:_rows. Cada celda viene de vals["tbl:{id}:{idx}:{colId}"].
            // Asi medicamentos / remisiones / etc. mapeados via historiaMedica
            // aparecen en la impresion con su contenido real.
            var tblKey = $"tbl:{n.Id}";
            var seedCount = n.SeedRows?.Count ?? 0;
            int extraRows = 0;
            if (!n.LockRows && vals.TryGetValue($"{tblKey}:_rows", out var rs)
                && int.TryParse(rs, out var parsed) && parsed > 0)
            {
                extraRows = parsed;
            }
            var totalRows = seedCount + extraRows;
            // Fallback: si no hay datos y la tabla es libre, deja 1 fila para
            // que el doctor pueda escribir a mano sobre papel.
            if (totalRows == 0 && !n.LockRows) { totalRows = 1; }
            <div style="grid-column: span @span; border-bottom:1px solid #000;">
                <table class="pack-table">
                    <thead>
                        <tr>
                            @foreach (var col in n.Columns ?? new()) { <th>@col.Label</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var r = 0; r < totalRows; r++)
                        {
                            var idx = r;
                            var isSeed = r < seedCount;
                            var seedRow = isSeed ? n.SeedRows![r] : null;
                            // Fila banner: colapsa columnas con estilo titulo (para impresion).
                            var _pBannerAlign = isSeed && n.SeedRowBanner is not null
                                && n.SeedRowBanner.TryGetValue(r.ToString(), out var _pba) ? _pba : null;
                            if (_pBannerAlign is not null && seedRow is not null)
                            {
                                var _pText = seedRow.Count > 0 ? seedRow[0] ?? "" : "";
                                var _pCols = (n.Columns?.Count ?? 0);
                                var _pAlign = _pBannerAlign == "left" || _pBannerAlign == "right" ? _pBannerAlign : "center";
                                <tr>
                                    <td colspan="@_pCols" style="text-align:@_pAlign; font-weight:700; background:#eff6ff; color:#1e3a8a; padding:6px 10px; letter-spacing:.04em;">
                                        @_pText
                                    </td>
                                </tr>
                                continue;
                            }
                            <tr>
                                @{ var colIdx = 0; }
                                @foreach (var col in n.Columns ?? new())
                                {
                                    var seedVal = (seedRow is not null && colIdx < seedRow.Count) ? seedRow[colIdx] : null;
                                    string? cellVal;
                                    if (!string.IsNullOrEmpty(seedVal)) { cellVal = seedVal; }
                                    else { vals.TryGetValue($"{tblKey}:{idx}:{col.Id}", out cellVal); }
                                    // Columnas date guardan ISO (yyyy-MM-dd) para que el datepicker
                                    // del FormViewer las pueda leer. En impresion las mostramos en
                                    // formato local dd/MM/yyyy para que se lean como en papel.
                                    var displayVal = FormatCellForPrint(cellVal, col.FieldType);
                                    <td>@(string.IsNullOrWhiteSpace(displayVal) ? new MarkupString("&nbsp;") : (MarkupString)System.Net.WebUtility.HtmlEncode(displayVal))</td>
                                    colIdx++;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            return;
        }
        if (n.IsQr)
        {
            var qrKey = string.IsNullOrWhiteSpace(n.QrSource) ? (n.Name ?? "") : n.QrSource!;
            var codigo = (vals.TryGetValue(qrKey, out var qcv) ? qcv : null)?.Trim() ?? "";
            var qrSize = n.QrSize is int qs && qs > 0 ? Math.Clamp(qs, 80, 600) : 200;
            <div class="pack-cell" style="grid-column: span @span; text-align:center;">
                @if (n.Label is { Length: > 0 }) { <div class="pack-label">@n.Label</div> }
                @if (string.IsNullOrEmpty(codigo))
                {
                    <div class="pack-value">(QR pendiente de emision)</div>
                }
                else
                {
                    var qurl = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(codigo)}";
                    <img src="@Qr.GenerarPngDataUri(qurl, qrSize)" alt="QR de verificacion"
                         width="@qrSize" height="@qrSize" style="width:@(qrSize)px;height:@(qrSize)px;display:inline-block;" />
                    @if (n.ShowCode)
                    {
                        <div style="font-family:monospace;font-weight:600;letter-spacing:1px;margin-top:4px;">@codigo</div>
                    }
                }
            </div>
            return;
        }
        var key = n.Name ?? $"fld:{n.Id}";
        var val = vals.TryGetValue(key, out var vv) ? vv : null;
        // Reusamos FormatCellForPrint para date/datetime y dejamos otros tipos
        // (textarea, text, etc.) sin transformar.
        var fieldDisplay = FormatCellForPrint(val, n.FieldType);
        <div class="pack-cell" style="grid-column: span @span;">
            <div class="pack-label">@n.Label</div>
            @if (IsImageUrl(val))
            {
                <img class="pack-firma-img" src="@val" alt="firma" />
            }
            else
            {
                <div class="pack-value">@(fieldDisplay ?? "")</div>
            }
        </div>
    };

    /// <summary>Detecta si el valor de un campo es una firma/imagen ya subida.
    /// Reglas: data URL de imagen, ruta relativa que empieza en /uploads/, o URL
    /// http(s) con extensión de imagen. Se mantiene en línea con la misma logica
    /// de FormViewer para que la impresión coincida con lo que ve el operador.</summary>
    /// <summary>Base URL publica para el QR: config Branding:PublicBaseUrl o el host actual.</summary>
    private string QrBaseUrl()
    {
        var cfg = Config["Branding:PublicBaseUrl"];
        return (string.IsNullOrWhiteSpace(cfg) ? Nav.BaseUri : cfg).TrimEnd('/');
    }

    /// <summary>Emite la orden de medicamentos de esta HC (firma + QR + snapshot
    /// inmutable) reusando el mismo pipeline de prefill que /orden-doc: paciente +
    /// sistema (usuario/registro/firma) + firmas + tabla de medicamentos +
    /// diagnosticos. El firmante es el usuario logueado que imprime. El caller ya
    /// verifico que no hay emision activa.</summary>
    private async Task AutoEmitirMedAsync()
    {
        if (_hc is null || _paciente is null || _fdMed is null || _meds.Count == 0) { return; }

        var valores = new Dictionary<string, string?>();
        var rutas = PrefillRouteSet.FromJson(_fdMed.PrefillRoutesJson);
        PacientePrefillHelper.Aplicar(valores, _paciente, _schMed, rutas);

        // Datos del usuario/profesional logueado (identificacion, registro, firma).
        Guid? profId = null, platformUid = null, tenantId = null;
        string? uName = null, uEmail = null, uSede = null;
        if (AuthState is not null)
        {
            var st = await AuthState;
            uName = st.User.Identity?.Name ?? st.User.FindFirst("display_name")?.Value;
            uEmail = st.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            uSede = st.User.FindFirst("sede_nombre")?.Value;
            if (Guid.TryParse(st.User.FindFirst("profesional_id")?.Value, out var pid)) { profId = pid; }
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var puid)) { platformUid = puid; }
            if (Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out var tid)) { tenantId = tid; }
        }

        // La formula la FIRMA el medico tratante de la HC (especialista), no quien
        // da Imprimir. Resolvemos por el ProfesionalId de la HC; si la HC no tiene
        // profesional vinculado, caemos al usuario logueado (compatibilidad).
        var firmanteProfId = _hc.ProfesionalId ?? profId;

        string? profNombre = _hc.EspecialistaNombre;
        string? profRegistro = null;
        try
        {
            var datosProf = await FirmaResolverSvc.ResolverDatosProfesionalAsync(
                firmanteProfId, firmanteProfId is null ? platformUid : null, tenantId);
            profRegistro = datosProf?.RegistroMedico;
            if (!string.IsNullOrWhiteSpace(datosProf?.Nombre)) { profNombre = datosProf!.Nombre; }
            else if (string.IsNullOrWhiteSpace(profNombre)) { profNombre = uName; }
            SistemaPrefillHelper.Aplicar(valores, new SistemaPrefillHelper.SistemaCtx(
                Ahora: DateTimeOffset.Now,
                AgenciaNombre: null, AgenciaSlogan: null,
                SedeNombre: uSede ?? _paciente.Sede, SedeCiudad: _paciente.Ciudad,
                UsuarioNombre: uName, UsuarioEmail: uEmail,
                UsuarioIdentificacion: datosProf?.Identificacion,
                UsuarioRegistroMedico: datosProf?.RegistroMedico,
                UsuarioFirmaUrl: datosProf?.FirmaUrl), rutas);
        }
        catch { }

        try
        {
            var firmaPac = await FirmaResolverSvc.ResolverFirmaPacienteAsync(_paciente.Id);
            string? firmaProf = null;
            if (firmanteProfId is Guid pid2 && pid2 != Guid.Empty)
            {
                firmaProf = await FirmaResolverSvc.ResolverFirmaPorProfesionalAsync(pid2);
            }
            else if (platformUid is Guid puid2 && tenantId is Guid tid2)
            {
                firmaProf = await FirmaResolverSvc.ResolverFirmaProfesionalPorPlatformUserAsync(puid2, tid2);
            }
            FirmasPrefillHelper.Aplicar(valores, firmaPac, firmaProf, rutas);
        }
        catch { }

        var fuentes = new HistoriaMedicaPrefillHelper.HmFuentes(
            _meds,
            new List<RemisionItemDto>(), new List<IncapacidadItemDto>(), new List<CertificacionItemDto>(),
            new List<OrdenServicioItemDto>(), new List<InsumoItemDto>(),
            new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(),
            new List<SuministroMedicamentoItemDto>(),
            HcDiagnosticosReader.Leer(_hc.SchemaJson, _hc.ValoresJson));
        HistoriaMedicaPrefillHelper.Aplicar(valores, fuentes, rutas, _schMed);

        valores["profesional_nombre"] = profNombre;
        valores["profesional_registro"] = profRegistro;

        var items = _meds.Select(m => new OrdenItemPublicoDto(
            m.NombreMedicamento, m.CodigoMedicamento, m.Cantidad, m.Frecuencia, m.Dias, m.Posologia)).ToList();
        var req = new EmitirOrdenRequest(
            _hc.Id, JsonSerializer.Serialize(valores), DateTimeOffset.Now,
            Iniciales(_paciente.NombreCompleto), profNombre, profRegistro, items);
        await PubSvc.EmitirAsync(req, await ActorIdAsync());
    }

    private async Task<Guid> ActorIdAsync()
    {
        if (AuthState is not null)
        {
            var st = await AuthState;
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id))
            {
                return id;
            }
        }
        return Guid.Empty;
    }

    /// <summary>Iniciales del paciente (privacidad): "MERCEDES PULIDO" -> "M.P.".</summary>
    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) { return "N.N."; }
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini = partes.Where(p => p.Length > 0).Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Join(".", ini) + ".";
    }

    /// <summary>Arma el bag para renderizar la orden de medicamentos con el
    /// formato ORD-MEDI (schema-driven, con pie de formula: firma + QR + recibido
    /// + barra). Si la orden esta emitida usa el snapshot congelado (documento
    /// firmado inmutable); si no, un borrador prellenado con paciente + tabla de
    /// medicamentos desde las rutas del formato.</summary>
    // Fecha de expedicion de la formula medica para el encabezado: la fecha de
    // emision de la orden (documento firmado). Si aun es borrador, la de hoy.
    private string FechaFormulaMed()
    {
        var f = _emisionMed?.EmitidoAt ?? DateTimeOffset.Now;
        return "Fecha: " + f.ToLocalTime().ToString("dd/MM/yyyy");
    }

    private Dictionary<string, string?> ConstruirBagMed()
    {
        // Orden emitida: snapshot inmutable (paciente + meds + firma + prof + codigo).
        if (_emisionMed is not null && !string.IsNullOrWhiteSpace(_emisionMed.BagJson))
        {
            try
            {
                var frozen = JsonSerializer.Deserialize<Dictionary<string, string?>>(_emisionMed.BagJson);
                if (frozen is not null) { return frozen; }
            }
            catch { }
        }
        // Borrador (sin emitir): prellenar paciente + tabla de medicamentos para
        // que el documento use el diseno del formato aunque no haya firma/QR aun.
        var valores = new Dictionary<string, string?>();
        if (_schMed is null || _fdMed is null) { return valores; }
        var rutas = PrefillRouteSet.FromJson(_fdMed.PrefillRoutesJson);
        if (_paciente is not null) { PacientePrefillHelper.Aplicar(valores, _paciente, _schMed, rutas); }
        var fuentes = new HistoriaMedicaPrefillHelper.HmFuentes(
            _meds,
            new List<RemisionItemDto>(), new List<IncapacidadItemDto>(), new List<CertificacionItemDto>(),
            new List<OrdenServicioItemDto>(), new List<InsumoItemDto>(),
            new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(),
            new List<SuministroMedicamentoItemDto>(),
            HcDiagnosticosReader.Leer(_hc?.SchemaJson, _hc?.ValoresJson));
        HistoriaMedicaPrefillHelper.Aplicar(valores, fuentes, rutas, _schMed);
        if (string.IsNullOrWhiteSpace(valores.TryGetValue("profesional_nombre", out var pn) ? pn : null))
        {
            valores["profesional_nombre"] = _hc?.EspecialistaNombre;
        }
        return valores;
    }

    private static bool IsImageUrl(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) { return false; }
        var s = v.Trim();
        if (s.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)) { return true; }
        if (s.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) { return true; }
        if (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || s.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            var lower = s.ToLowerInvariant();
            return lower.EndsWith(".png") || lower.EndsWith(".jpg") || lower.EndsWith(".jpeg")
                || lower.EndsWith(".svg") || lower.EndsWith(".gif") || lower.EndsWith(".webp");
        }
        return false;
    }

    private static FormSchema? TryParseSchema(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return null; }
        try { return JsonSerializer.Deserialize<FormSchema>(json); } catch { return null; }
    }

    /// <summary>
    /// Si la celda pertenece a una columna date y el valor esta en ISO
    /// (yyyy-MM-dd) lo reformatea a dd/MM/yyyy para impresion. Cualquier
    /// otra cosa se devuelve tal cual.
    /// </summary>
    private static string? FormatCellForPrint(string? raw, string? fieldType)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return raw; }
        if (string.Equals(fieldType, "date", StringComparison.OrdinalIgnoreCase))
        {
            if (DateOnly.TryParseExact(raw, "yyyy-MM-dd", out var d))
            {
                return d.ToString("dd/MM/yyyy");
            }
            return raw;
        }
        if (string.Equals(fieldType, "datetime", StringComparison.OrdinalIgnoreCase))
        {
            // <input type="datetime-local"> guarda como "2026-07-09T15:30" (sin
            // zona horaria). Reformateamos a "09/07/2026 15:30" para impresion.
            if (DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeLocal, out var dt))
            {
                return dt.ToString("dd/MM/yyyy HH:mm");
            }
            return raw;
        }
        return raw;
    }

    private static Dictionary<string, string?> TryParseValores(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return new(); }
        try { return JsonSerializer.Deserialize<Dictionary<string, string?>>(json) ?? new(); } catch { return new(); }
    }
}
