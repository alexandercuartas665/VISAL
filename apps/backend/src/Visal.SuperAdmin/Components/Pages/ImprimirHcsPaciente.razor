@page "/imprimir-hcs-paciente/{PacienteId:guid}"
@layout Visal.SuperAdmin.Components.Layout.EmptyLayout
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using Visal.Application.Tenancy
@using Visal.Application.Tenancy.Forms
@using Visal.SuperAdmin.Components.Forms
@inject IHistoriaClinicaService HcSvc
@inject IFormDefinitionService FormsSvc
@inject IPacienteService PacSvc
@inject IJSRuntime JS
@inject NavigationManager Nav

@*
   HCs-Print — Impresion masiva de HCs Cerradas de un paciente.
   Recibe por query:
     - formatoCodigo : opcional, filtra por Codigo o CodigoSecundario del FormDefinition
     - desde / hasta : opcionales, rango de FechaCierre (o FechaApertura si no hay cierre)
   Renderiza cada HC con su propio schema (FormViewer read-only), page-break entre ellas.
*@

<PageTitle>HCs del paciente - Visal</PageTitle>

<style>
    .doc-actions { display:flex; gap:8px; align-items:center; margin:14px auto; max-width:920px; }
    .doc-actions .dbtn { padding:8px 14px; border:1px solid var(--border); border-radius:8px; background:var(--card); font-size:13px; font-weight:600; cursor:pointer; color:var(--foreground); text-decoration:none; }
    .doc-actions .dbtn.primary { background:var(--primary); border-color:var(--primary); color:#fff; }
    .doc-actions .spacer { flex:1; }
    .doc-actions .meta { font-size:12px; color:var(--muted-foreground); }

    .hcs-summary { max-width:920px; margin:0 auto 12px; padding:10px 14px; background:#f3f6fb; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; }
    .hcs-summary b { color:#1565c0; }
    .hcs-empty { max-width:920px; margin:40px auto; padding:32px; background:#fff; border:1px dashed #cbd5e1; border-radius:8px; text-align:center; color:#64748b; }

    .pack { max-width:920px; margin: 0 auto; }

    /* Estilos del renderer .pack-* — mismos que ImprimirPaquete/ImprimirOrdenesFiltradas.
       DocumentoImprimible consume estas clases; se definen aqui para portabilidad. */
    .pack-doc { background:#fff; color:#000; font-family:'Segoe UI', Arial, sans-serif; font-size:12px; line-height:1.35; border:1px solid #000; margin-bottom: 22px; }
    .pack-header { border-bottom:1px solid #000; padding:8px 10px; }
    .pack-hdr-top { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
    .pack-hdr-brand { display:flex; align-items:center; gap:8px; }
    .pack-hdr-brand svg { width:30px; height:30px; color:#1565c0; }
    .pack-hdr-logo { max-height:48px; max-width:180px; object-fit:contain; }
    .pack-hdr-inst { font-size:16px; font-weight:800; color:#1565c0; }
    .pack-hdr-tag { font-size:10px; font-style:italic; color:#555; }
    .pack-hdr-nohist { font-size:11px; white-space:nowrap; text-align:right; }
    .pack-hdr-nohist b { font-size:12px; color:#1565c0; }
    .pack-hdr-title { text-align:center; font-size:15px; font-weight:800; text-transform:uppercase; margin:6px 0; }
    .pack-hdr-meta { display:flex; gap:28px; font-size:11px; flex-wrap:wrap; }
    .pack-hdr-meta b { color:#1565c0; }

    .pack-band { background:#dde7f3; font-weight:800; font-size:11px; padding:4px 8px; text-transform:uppercase; border-bottom:1px solid #000; letter-spacing:.04em; }
    .pack-sub { font-weight:700; font-size:11px; padding:4px 8px; background:#f3f6fb; border-bottom:1px solid #000; }
    .pack-para { padding:4px 8px; border-bottom:1px solid #000; color:#222; white-space:pre-wrap; }
    .pack-grid { display:grid; grid-template-columns: repeat(12, 1fr); }
    .pack-cell { border-right:1px solid #000; border-bottom:1px solid #000; padding:2px 6px 4px; min-height:34px; }
    .pack-label { font-size:9px; font-weight:700; text-transform:uppercase; color:#333; }
    .pack-value { min-height:14px; border-bottom:1px dotted #999; margin-top:4px; padding:1px 2px; font-size:12px; color:#000; white-space:pre-wrap; word-break:break-word; }

    .pack-table { width:100%; border-collapse:collapse; }
    .pack-table th { border:1px solid #000; background:#dde7f3; font-size:10px; padding:4px 6px; text-align:left; font-weight:700; text-transform:uppercase; }
    .pack-table td { border:1px solid #000; padding:4px 6px; font-size:11px; vertical-align:top; }
    .pack-firma-img { max-width:100%; max-height:70px; display:block; margin:2px 0; object-fit:contain; background:#fff; }

    /* Un documento por pagina al imprimir. */
    .pack-doc { page-break-after: always; break-after: page; }
    .pack-doc:last-child { page-break-after: auto; break-after: auto; }

    @@media print {
        .visal-sidebar, .visal-topbar, .doc-actions, .hcs-summary { display:none !important; }
        .visal-main, .visal-shell { margin:0 !important; padding:0 !important; }
        .pack { max-width:none; }
        .pack-doc { margin-bottom:0; border:1px solid #000; }
        body { background:#fff !important; }
        @@page { size: A4; margin: 12mm; }
    }
</style>

@if (_loading)
{
    <p class="doc-actions">Cargando HCs del paciente...</p>
}
else if (_paciente is null)
{
    <p class="doc-actions">Paciente no encontrado.</p>
}
else
{
    <div class="doc-actions">
        <a class="dbtn" href="javascript:window.close()">&times; Cerrar</a>
        <button class="dbtn primary" @onclick="PrintAsync">&#128424; Imprimir todo / Guardar PDF</button>
        <span class="spacer"></span>
        <span class="meta">@_hcs.Count HC(s) cerrada(s)</span>
    </div>

    <div class="hcs-summary">
        <b>Paciente:</b> @_paciente.NombreCompleto
        &nbsp;·&nbsp; <b>Doc:</b> @_paciente.TipoDocumento @_paciente.NumeroDocumento
        @if (!string.IsNullOrWhiteSpace(_formatoCodigoFiltro))
        {
            <text> &nbsp;·&nbsp; <b>Formato HC:</b> @_formatoCodigoFiltro</text>
        }
        @if (_desdeFiltro is DateOnly dd)
        {
            <text> &nbsp;·&nbsp; <b>Desde:</b> @dd.ToString("yyyy-MM-dd")</text>
        }
        @if (_hastaFiltro is DateOnly dh)
        {
            <text> &nbsp;·&nbsp; <b>Hasta:</b> @dh.ToString("yyyy-MM-dd")</text>
        }
    </div>

    @if (_hcs.Count == 0)
    {
        <div class="hcs-empty">
            No hay HCs cerradas para este paciente con los filtros indicados.
        </div>
    }
    else
    {
        <div class="pack">
            @foreach (var item in _hcs)
            {
                if (item.Schema is null)
                {
                    <div class="pack-doc" style="padding:14px;">
                        <p><em>No se pudo cargar el schema del formato (@item.Detail.FormatoCodigo).</em></p>
                    </div>
                    continue;
                }
                var fechaLinea = item.Detail.FechaCierre is DateTimeOffset fc
                    ? $"Cerrada: {fc.ToLocalTime():dd/MM/yyyy HH:mm}"
                    : $"Apertura: {item.Detail.FechaApertura.ToLocalTime():dd/MM/yyyy HH:mm}";
                <DocumentoImprimible Schema="item.Schema"
                                     Values="item.Values"
                                     PacienteNombre="_paciente!.NombreCompleto"
                                     PacienteTipoDoc="_paciente.TipoDocumento"
                                     PacienteDoc="_paciente.NumeroDocumento"
                                     EspecialistaNombre="item.Detail.EspecialistaNombre"
                                     MostrarPieFormula="@DocumentoImprimible.EsFormatoOrdenMedicamentos(item.Detail.FormatoCodigo)"
                                     OrdenNum="@item.Detail.Id.ToString().Substring(0,8).ToUpperInvariant()"
                                     FechaLinea="@fechaLinea"
                                     TipoCortoHeader="HC"
                                     TituloFallback="@item.Detail.FormatoNombre" />
            }
        </div>
    }
}

@code {
    [Parameter] public Guid PacienteId { get; set; }

    private bool _loading = true;
    private PacienteDetailDto? _paciente;
    private List<HcRender> _hcs = new();

    private string? _formatoCodigoFiltro;
    private DateOnly? _desdeFiltro;
    private DateOnly? _hastaFiltro;

    private record HcRender(HistoriaClinicaDetailDto Detail, FormSchema? Schema, Dictionary<string, string?> Values);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var q = QueryHelpers.ParseQuery(uri.Query);
            _formatoCodigoFiltro = q.TryGetValue("formatoCodigo", out var fc) ? fc.ToString() : null;
            if (string.IsNullOrWhiteSpace(_formatoCodigoFiltro)) { _formatoCodigoFiltro = null; }
            if (q.TryGetValue("desde", out var dd) && DateOnly.TryParse(dd.ToString(), out var d1)) { _desdeFiltro = d1; }
            if (q.TryGetValue("hasta", out var dh) && DateOnly.TryParse(dh.ToString(), out var d2)) { _hastaFiltro = d2; }

            _paciente = await PacSvc.GetAsync(PacienteId);
            if (_paciente is null) { return; }

            // Resolver formatoCodigo -> formDefinitionId (si viene) para pasar al service.
            // Match por Codigo o CodigoSecundario, mismo criterio que Ordenes.razor.
            Guid? formDefId = null;
            if (_formatoCodigoFiltro is not null)
            {
                var forms = await FormsSvc.ListAsync();
                var match = forms.FirstOrDefault(f =>
                    string.Equals(f.Codigo, _formatoCodigoFiltro, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(f.CodigoSecundario, _formatoCodigoFiltro, StringComparison.OrdinalIgnoreCase));
                if (match is not null) { formDefId = match.Id; }
            }

            // HCs del paciente, filtro por fechas + formato. Solo Cerradas.
            var resumenes = await HcSvc.ListarPorPacienteAsync(PacienteId, _desdeFiltro, _hastaFiltro, formDefId);
            var cerradas = resumenes
                .Where(h => string.Equals(h.Estado, "Cerrada", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(h => h.FechaCierre ?? h.FechaApertura)
                .ToList();

            // Detail + schema por cada HC. Loop secuencial simple: N getAsync + parse.
            // Para N grande se puede optimizar despues (batch service o cache de schemas).
            foreach (var r in cerradas)
            {
                var detail = await HcSvc.GetAsync(r.Id);
                if (detail is null) { continue; }
                FormSchema? schema = null;
                if (!string.IsNullOrWhiteSpace(detail.SchemaJson))
                {
                    try { schema = JsonSerializer.Deserialize<FormSchema>(detail.SchemaJson); }
                    catch { schema = null; }
                }
                Dictionary<string, string?> values = new();
                if (!string.IsNullOrWhiteSpace(detail.ValoresJson))
                {
                    try { values = JsonSerializer.Deserialize<Dictionary<string, string?>>(detail.ValoresJson) ?? new(); }
                    catch { values = new(); }
                }
                _hcs.Add(new HcRender(detail, schema, values));
            }
        }
        finally { _loading = false; }
    }

    private async Task PrintAsync() { await JS.InvokeVoidAsync("print"); }
}
