@using Visal.Application.Tenancy
@inject IOrdenServicioService OrdSvc
@inject IJSRuntime JS

@*
   Pestana "Ordenes a Servicios" de la HC. Buscador con autocompletado
   contra el catalogo de servicios de los contratos de aseguradoras
   (ServicioContrato): se muestra la DESCRIPCION en la sugerencia, pero a la
   orden viaja el CODIGO DE SERVICIO. Cada item queda atado a la
   HistoriaClinicaId con su cantidad y observaciones. Los cambios se
   persisten al instante (no requiere "Guardar" explicito).
*@

<div class="os-bar">
    <div class="os-bar-left">
        <label>Ordenes a Servicios:</label>
        <span class="os-bar-count">@OrdenesPresentes().Count orden(es) &middot; @_items.Count item(s)</span>
    </div>
    <div class="os-bar-right">
        @* La impresion se hace SIEMPRE desde el boton "Imprimir" general de la historia
           (arriba): ahi cada orden a servicios sale como su propio documento con su QR.
           Aqui no hay boton propio para no duplicar puntos de impresion (igual que
           Ordenes de Medicamentos). *@
        <span class="os-print-hint" style="font-size:12px;color:var(--muted-foreground);">
            Para imprimir usa el bot&oacute;n <b>&#128424; Imprimir</b> de la historia (arriba). Cada orden sale por separado.
        </span>
    </div>
</div>

@if (HistoriaClinicaId is null)
{
    <div class="os-card os-empty-hc">
        Selecciona o inicia una historia para registrar servicios.
    </div>
}
else
{
    @* ---- Selector de ordenes: N ordenes a servicios por HC (igual que medicamentos) ---- *@
    <div class="os-orders">
        @foreach (var n in OrdenesPresentes())
        {
            var nn = n;
            <button type="button" class="os-order-chip @(_ordenActual == nn ? "active" : "")"
                    @onclick="() => _ordenActual = nn">
                Orden @nn <span class="os-order-cnt">@_items.Count(x => x.NumeroOrden == nn)</span>
            </button>
        }
        <button type="button" class="os-order-new" @onclick="NuevaOrden" title="Crear otra orden a servicios">+ Nueva orden</button>
        @if (_items.Any(x => x.NumeroOrden == _ordenActual))
        {
            <button type="button" class="os-order-del" @onclick="EliminarOrdenActualAsync"
                    title="Eliminar esta orden con todos sus servicios">&#128465; Eliminar orden @_ordenActual</button>
        }
    </div>

    <div class="os-card">
        @* ---- Fila de captura: autocompletado + cantidad ---- *@
        <div class="os-row">
            <div class="os-f os-c-10 os-search-wrap">
                <div class="os-search-head">
                    <label>@(_soloPaquetes ? "Nombre del Paquete" : "Nombre del Servicio")</label>
                    <div class="os-search-head-actions">
                        <label class="os-solo-pkg" title="Buscar solo paquetes de los contratos del paciente">
                            <input type="checkbox" checked="@_soloPaquetes"
                                   @onchange="e => OnSoloPaquetesChanged((bool)e.Value!)" />
                            Servicios del paquete
                        </label>
                        <button class="btn btn-outline-success btn-sm os-pkg-btn" title="Agregar un paquete como un solo registro"
                                disabled="@(HistoriaClinicaId is null || PacienteId is null)"
                                @onclick="AbrirPkgModal">&#128230; Agregar paquete</button>
                    </div>
                </div>
                <input class="form-control form-control-sm"
                       placeholder="@(_soloPaquetes ? "Buscar paquete por codigo o nombre..." : "Buscar servicio por descripcion o codigo (min 2 caracteres)...")"
                       value="@_terminoBusqueda"
                       @oninput="OnTerminoChanged" />
                @if (_soloPaquetes)
                {
                    @if (_sugerenciasPkg.Count > 0)
                    {
                        <div class="os-suggest">
                            @foreach (var p in SugerenciasPkgVista())
                            {
                                var asignado = EsPaqueteAsignado(p.Codigo);
                                <button class="os-suggest-item os-suggest-pkg @(asignado ? "os-suggest-pkg-asignado" : "")"
                                        @onclick="() => SeleccionarPaqueteAsync(p)">
                                    <div class="os-suggest-nm">
                                        @p.Nombre
                                        @if (asignado)
                                        {
                                            <span class="os-suggest-asignado-tag" title="Paquete con el que llego el paciente">Asignado</span>
                                        }
                                        <span class="os-suggest-pkg-tag">Paquete</span>
                                    </div>
                                    <div class="os-suggest-meta">
                                        @if (!string.IsNullOrWhiteSpace(p.Codigo)) { <span class="os-suggest-cod">@p.Codigo</span> }
                                        <span>&middot; @p.CantidadServicios servicio(s)</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="os-suggest os-suggest-empty">
                            @(_paquetes.Count == 0
                                ? "Este paciente no tiene paquetes en sus contratos."
                                : $"Sin paquetes para \"{_terminoBusqueda}\"")
                        </div>
                    }
                }
                else if (_sugerencias.Count > 0)
                {
                    <div class="os-suggest">
                        @foreach (var s in _sugerencias)
                        {
                            <button class="os-suggest-item @(s.PaqueteCodigo is null ? "" : "os-suggest-pkg")"
                                    @onclick="() => SeleccionarSugerencia(s)">
                                <div class="os-suggest-nm">
                                    @s.Descripcion
                                    @if (s.PaqueteCodigo is not null)
                                    {
                                        <span class="os-suggest-pkg-tag" title="Servicio del paquete @s.PaqueteCodigo">Del paquete @s.PaqueteCodigo</span>
                                    }
                                </div>
                                <div class="os-suggest-meta">
                                    @if (!string.IsNullOrWhiteSpace(s.CodigoServicio)) { <span class="os-suggest-cod">@s.CodigoServicio</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.Modulo)) { <span>&middot; @s.Modulo</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.Especialidad)) { <span>&middot; @s.Especialidad</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.Aseguradora)) { <span>&middot; @s.Aseguradora</span> }
                                    @if (!string.IsNullOrWhiteSpace(s.Contrato)) { <span>&middot; @s.Contrato</span> }
                                </div>
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_terminoBusqueda) && _terminoBusqueda.Trim().Length >= 2 && !_buscando)
                {
                    <div class="os-suggest os-suggest-empty">Sin resultados para "@_terminoBusqueda"</div>
                }
            </div>
            <div class="os-f os-c-2">
                <label>Cantidad</label>
                <input class="form-control form-control-sm text-center"
                       @bind="_borrador.Cantidad" @bind:event="oninput" />
            </div>
        </div>

        <div class="os-row">
            <div class="os-f os-c-11">
                <label>Observaciones</label>
                <textarea class="form-control form-control-sm" rows="2"
                          placeholder="Observaciones del servicio..."
                          @bind="_borrador.Observaciones" @bind:event="oninput"></textarea>
            </div>
            <div class="os-f os-c-1 os-action-col">
                <button class="btn btn-primary btn-sm os-action-add" title="Agregar"
                        @onclick="AgregarAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_borrador.Descripcion) || _agregando)">
                    @(_agregando ? "..." : "+")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_borrador.Descripcion))
        {
            <div class="os-borrador">
                Servicio seleccionado:
                @if (!string.IsNullOrWhiteSpace(_borrador.CodigoServicio))
                {
                    <span class="os-borrador-cod">@_borrador.CodigoServicio</span>
                }
                <strong>@_borrador.Descripcion</strong>
                <button class="btn btn-link btn-sm os-borrador-x" @onclick="LimpiarBorrador" title="Quitar">&times;</button>
            </div>
        }

        @* ---- Grilla de items agregados ---- *@
        <div class="os-grid-wrap">
            <table class="table table-sm os-tbl">
                <thead>
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="width:78px">Cod. Servicio</th>
                        <th>Nombre del Servicio</th>
                        <th>Observaciones</th>
                        <th class="text-center" style="width:80px">Cant.</th>
                        <th class="text-center" style="width:50px"></th>
                    </tr>
                </thead>
                <tbody>
                    @{ var itemsOrden = _items.Where(x => x.NumeroOrden == _ordenActual).ToList(); }
                    @if (itemsOrden.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted os-empty-row">Sin servicios en la orden @_ordenActual.</td></tr>
                    }
                    else
                    {
                        @foreach (var it in itemsOrden)
                        {
                            <tr>
                                <td class="text-center">@it.Orden</td>
                                <td class="os-cod-cell">@(it.CodigoServicio ?? "-")</td>
                                <td>
                                    <strong>@it.Descripcion</strong>
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm os-inline-obs" rows="2"
                                              placeholder="Observaciones..."
                                              value="@it.Observaciones"
                                              @onchange="@(e => GuardarObservaciones(it, e.Value?.ToString()))"></textarea>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm os-inline-input text-center"
                                           value="@it.Cantidad"
                                           @onchange="@(e => GuardarCantidad(it, e.Value?.ToString()))" />
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-link text-danger"
                                            @onclick="() => EliminarAsync(it)"
                                            title="Quitar de la orden">&#128465;</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ---- Modal "Agregar paquete": el paquete entra como UN solo registro-resumen ---- *@
@if (_showPkgModal)
{
    <div class="os-modal-backdrop" @onclick="CerrarPkgModal">
        <div class="os-modal" @onclick:stopPropagation="true">
            <div class="os-modal-head">
                <span>Agregar paquete a la orden @_ordenActual</span>
                <button type="button" class="os-modal-x" @onclick="CerrarPkgModal" title="Cerrar">&times;</button>
            </div>
            <div class="os-modal-body">
                @if (_paquetes.Count == 0)
                {
                    <div class="os-modal-empty">Este paciente no tiene paquetes en sus contratos.</div>
                }
                else
                {
                    <div class="os-modal-hint">
                        Elige un paquete, marca los servicios que incluye y presiona "Cargar".
                        El paquete se agrega como un unico registro (no se expande en servicios).
                    </div>
                    <input class="form-control form-control-sm os-modal-filtro"
                           placeholder="Buscar paquete por codigo o nombre..."
                           @bind="_pkgFiltro" @bind:event="oninput" />
                    <div class="os-tree">
                        @foreach (var p in PaquetesModalVista())
                        {
                            var pp = p;
                            var abierto = _pkgExpandidos.Contains(pp.PaqueteId);
                            var activo = _pkgSeleccionado == pp.PaqueteId;
                            var asignado = EsPaqueteAsignado(pp.Codigo);
                            <div class="os-tree-node @(activo ? "active" : "")">
                                <button type="button" class="os-tree-head" @onclick="() => TogglePkgExpandAsync(pp)">
                                    <span class="os-tree-caret">@((MarkupString)(abierto ? "&#9660;" : "&#9654;"))</span>
                                    <span class="os-tree-nm">
                                        @pp.Nombre
                                        @if (asignado)
                                        {
                                            <span class="os-suggest-asignado-tag">Asignado</span>
                                        }
                                    </span>
                                    <span class="os-tree-meta">
                                        @if (!string.IsNullOrWhiteSpace(pp.Codigo)) { <span class="os-suggest-cod">@pp.Codigo</span> }
                                        <span>&middot; @pp.CantidadServicios servicio(s)</span>
                                    </span>
                                </button>
                                @if (abierto)
                                {
                                    <div class="os-tree-body">
                                        @if (_pkgCargandoId == pp.PaqueteId)
                                        {
                                            <div class="os-tree-loading">Cargando servicios...</div>
                                        }
                                        else if (_pkgServiciosCache.TryGetValue(pp.PaqueteId, out var servs))
                                        {
                                            @if (servs.Count == 0)
                                            {
                                                <div class="os-tree-loading">Este paquete no tiene servicios en los contratos del paciente.</div>
                                            }
                                            else
                                            {
                                                <div class="os-tree-tools">
                                                    <button type="button" class="os-tree-toolbtn" @onclick="() => PkgSeleccionar(pp.PaqueteId, true)">Seleccionar todos</button>
                                                    <button type="button" class="os-tree-toolbtn" @onclick="() => PkgSeleccionar(pp.PaqueteId, false)">Ninguno</button>
                                                </div>
                                                @foreach (var s in servs)
                                                {
                                                    var ss = s;
                                                    var marcado = _pkgChecks.TryGetValue(pp.PaqueteId, out var set) && set.Contains(ss.ServicioContratoId);
                                                    <label class="os-tree-serv">
                                                        <input type="checkbox" checked="@marcado"
                                                               @onchange="e => TogglePkgServicio(pp.PaqueteId, ss.ServicioContratoId, (bool)e.Value!)" />
                                                        <span class="os-tree-serv-nm">@ss.Descripcion</span>
                                                        @if (!string.IsNullOrWhiteSpace(ss.Codigo)) { <span class="os-suggest-cod">@ss.Codigo</span> }
                                                    </label>
                                                }
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="os-modal-foot">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarPkgModal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm"
                        disabled="@(!PuedeCargarPkg || _pkgCargando)"
                        @onclick="CargarPkgAsync">
                    @(_pkgCargando ? "Cargando..." : "Cargar")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .os-bar { display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; margin-bottom:12px; gap:10px; flex-wrap:wrap; }
    .os-bar-left { display:flex; align-items:center; gap:10px; font-size:13px; font-weight:700; color:#0f172a; }
    .os-bar-right { display:flex; gap:6px; }
    .os-bar-count { background:#1565c0; color:#fff; padding:2px 10px; border-radius:999px; font-size:11px; font-weight:700; }
    .os-orders { display:flex; align-items:center; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
    .os-order-chip { border:1.5px solid #cbd5e1; background:#fff; color:#334155; border-radius:8px; padding:5px 12px; font-size:12.5px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:6px; }
    .os-order-chip:hover { border-color:#93c5fd; }
    .os-order-chip.active { background:#1565c0; border-color:#1565c0; color:#fff; }
    .os-order-cnt { background:rgba(0,0,0,.12); border-radius:999px; padding:0 7px; font-size:11px; }
    .os-order-chip.active .os-order-cnt { background:rgba(255,255,255,.25); }
    .os-order-new { border:1.5px dashed #94a3b8; background:#f8fafc; color:#2563eb; border-radius:8px; padding:5px 12px; font-size:12.5px; font-weight:700; cursor:pointer; }
    .os-order-new:hover { background:#eff6ff; }
    .os-order-del { margin-left:auto; border:1px solid #fecaca; background:#fff; color:#b91c1c; border-radius:8px; padding:5px 12px; font-size:12px; font-weight:600; cursor:pointer; }
    .os-order-del:hover { background:#fef2f2; }
    .os-card { border:1px solid #e2e8f0; border-radius:8px; padding:16px; background:#fff; position:relative; }
    .os-empty-hc { color:#64748b; text-align:center; padding:30px; font-style:italic; }
    .os-row { display:grid; grid-template-columns:repeat(12, 1fr); gap:12px; margin-bottom:12px; align-items:end; }
    .os-f label { font-size:11px; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.3px; margin-bottom:4px; display:block; }
    .os-c-1  { grid-column: span 1; }
    .os-c-2  { grid-column: span 2; }
    .os-c-10 { grid-column: span 10; }
    .os-c-11 { grid-column: span 11; }

    .os-search-wrap { position:relative; }
    .os-suggest { position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid #cbd5e1; border-radius:8px; box-shadow:0 12px 30px rgba(15,23,42,.12); max-height:320px; overflow-y:auto; z-index:50; margin-top:4px; }
    .os-suggest-item { display:block; width:100%; text-align:left; padding:10px 12px; border:0; background:transparent; cursor:pointer; border-bottom:1px solid #f1f5f9; }
    .os-suggest-item:hover { background:#eff6ff; }
    .os-suggest-item:last-child { border-bottom:0; }
    /* PQ7: sugerencias que vienen del paquete van con acento amarillo para que
       el profesional entienda que provienen del catalogo del paquete pactado. */
    .os-suggest-item.os-suggest-pkg { background: #fefce8; border-left: 3px solid #d97706; }
    .os-suggest-item.os-suggest-pkg:hover { background: #fef3c7; }
    .os-suggest-pkg-tag { display: inline-block; margin-left: 8px; padding: 1px 8px;
                          background: #d97706; color: #fff; border-radius: 999px;
                          font-size: 10px; font-weight: 700; letter-spacing: .03em;
                          text-transform: uppercase; vertical-align: middle; }
    .os-suggest-nm { font-size:13px; font-weight:700; color:#0f172a; margin-bottom:2px; }
    .os-suggest-meta { font-size:11px; color:#64748b; display:flex; gap:4px; flex-wrap:wrap; align-items:center; }
    .os-suggest-cod { background:#1565c0; color:#fff; padding:1px 7px; border-radius:4px; font-family:'JetBrains Mono','Consolas',monospace; font-weight:700; }
    .os-suggest-empty { padding:10px 12px; font-size:12px; color:#64748b; font-style:italic; }

    .os-borrador { margin-bottom:12px; padding:8px 12px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px; font-size:12.5px; color:#1e40af; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .os-borrador-cod { background:#1565c0; color:#fff; padding:1px 7px; border-radius:4px; font-family:'JetBrains Mono','Consolas',monospace; font-weight:700; font-size:11px; }
    .os-borrador-x { color:#dc2626; padding:0 4px; }

    .os-action-col { display:flex; align-items:stretch; }
    .os-action-add { width:100%; align-self:stretch; height:100%; min-height:38px; }

    .os-grid-wrap { margin-top:14px; border:1px solid #e2e8f0; border-radius:6px; overflow:auto; }
    .os-tbl { margin:0; font-size:12.5px; }
    .os-tbl thead th { background:#1565c0; color:#fff; padding:8px 10px; font-size:11px; font-weight:700; text-transform:uppercase; }
    .os-tbl td { padding:8px 10px; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
    .os-cod-cell { font-family:'JetBrains Mono','Consolas',monospace; font-size:11.5px; color:#0f172a; font-weight:700; }
    .os-empty-row { padding:30px !important; font-style:italic; }
    .os-inline-input { font-size:12px; }
    /* Observaciones en la grilla: textarea multilinea para ver el texto completo. */
    .os-inline-obs { font-size:12px; line-height:1.3; resize:vertical; min-height:38px; }
    /* Columna de codigo mas angosta: parte codigos largos (paquete) sin ensanchar. */
    .os-cod-cell { font-family:'JetBrains Mono','Consolas',monospace; font-size:11px; word-break:break-all; }

    /* Checkbox "Solo paquetes" en la cabecera del buscador */
    .os-search-head { display:flex; justify-content:space-between; align-items:center; gap:10px; }
    .os-search-head > label { margin-bottom:4px; }
    .os-search-head .os-solo-pkg { display:inline-flex; align-items:center; gap:5px; font-size:11px;
        font-weight:700; color:#0369a1; text-transform:none; letter-spacing:normal; margin-bottom:4px; cursor:pointer; }
    .os-search-head .os-solo-pkg input { margin:0; cursor:pointer; }
    .os-search-head-actions { display:inline-flex; align-items:center; gap:12px; }
    .os-pkg-btn { padding:2px 10px; font-size:11px; font-weight:700; white-space:nowrap; }

    /* Paquete "Asignado": el que trajo el paciente va primero y resaltado en verde. */
    .os-suggest-item.os-suggest-pkg-asignado { background:#ecfdf5; border-left:3px solid #059669; }
    .os-suggest-item.os-suggest-pkg-asignado:hover { background:#d1fae5; }
    .os-suggest-asignado-tag { display:inline-block; margin-left:8px; padding:1px 8px;
                               background:#059669; color:#fff; border-radius:999px;
                               font-size:10px; font-weight:700; letter-spacing:.03em;
                               text-transform:uppercase; vertical-align:middle; }

    /* Modal "Agregar paquete" */
    .os-modal-backdrop { position:fixed; inset:0; background:rgba(15,23,42,.55); z-index:1000;
                         display:flex; align-items:center; justify-content:center; padding:16px; }
    .os-modal { background:#fff; border-radius:12px; width:min(640px, 100%); max-height:85vh;
                display:flex; flex-direction:column; box-shadow:0 24px 60px rgba(15,23,42,.35); overflow:hidden; }
    .os-modal-head { display:flex; align-items:center; justify-content:space-between; gap:10px;
                     padding:14px 18px; background:#1565c0; color:#fff; font-size:14px; font-weight:700; }
    .os-modal-x { border:0; background:transparent; color:#fff; font-size:22px; line-height:1; cursor:pointer; padding:0 4px; }
    .os-modal-body { padding:16px 18px; overflow-y:auto; }
    .os-modal-filtro { margin-bottom:10px; }
    .os-modal-empty { color:#64748b; font-style:italic; text-align:center; padding:24px; }
    .os-modal-hint { font-size:12px; color:#475569; background:#f8fafc; border:1px solid #e2e8f0;
                     border-radius:6px; padding:8px 10px; margin-bottom:12px; }
    .os-tree { display:flex; flex-direction:column; gap:8px; }
    .os-tree-node { border:1px solid #e2e8f0; border-radius:8px; overflow:hidden; }
    .os-tree-node.active { border-color:#1565c0; box-shadow:0 0 0 1px #1565c0 inset; }
    .os-tree-head { display:flex; align-items:center; gap:8px; width:100%; text-align:left;
                    border:0; background:#f8fafc; cursor:pointer; padding:10px 12px; }
    .os-tree-head:hover { background:#eff6ff; }
    .os-tree-caret { font-size:10px; color:#64748b; width:14px; }
    .os-tree-nm { font-size:13px; font-weight:700; color:#0f172a; flex:1; }
    .os-tree-meta { font-size:11px; color:#64748b; display:flex; gap:6px; align-items:center; }
