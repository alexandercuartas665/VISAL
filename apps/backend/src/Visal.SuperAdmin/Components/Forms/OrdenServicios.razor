@code {
    /// <summary>Id de la HC actualmente abierta. Cuando cambia, recargamos los items.</summary>
    [Parameter] public Guid? HistoriaClinicaId { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    /// <summary>Se dispara despues de Agregar/Actualizar/Eliminar para que el
    /// padre (HistoriasClinicasModulo) recargue ValoresJson y el FormViewer del
    /// tab Historial muestre las filas nuevas en vivo. Sin esto la tabla de
    /// servicios en HC-FO-08 no se llena hasta cerrar y reabrir la HC.</summary>
    [Parameter] public EventCallback OnItemsChanged { get; set; }

    private async Task NotifyItemsChanged()
    {
        if (OnItemsChanged.HasDelegate) { await OnItemsChanged.InvokeAsync(); }
    }

    /// <summary>Paciente de la HC. Necesario para acotar servicios y paquetes a
    /// los contratos del paciente. Lo pasa HistoriasClinicasModulo.</summary>
    [Parameter] public Guid? PacienteId { get; set; }

    /// <summary>Codigo del paquete con el que llego el paciente (si aplica). El
    /// buscador de paquetes lo muestra primero y resaltado como "Asignado". Puede
    /// ser null cuando no hay paquete asignado.</summary>
    [Parameter] public string? PaqueteAsignadoCodigo { get; set; }

    /// <summary>True si el codigo corresponde al paquete asignado del paciente
    /// (comparacion insensible a mayusculas). Usado para resaltar y reordenar.</summary>
    private bool EsPaqueteAsignado(string? codigo) =>
        !string.IsNullOrWhiteSpace(PaqueteAsignadoCodigo)
        && string.Equals(codigo?.Trim(), PaqueteAsignadoCodigo.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>Vista del dropdown de paquetes con el asignado primero (OrderBy de
    /// LINQ es estable: el resto conserva su orden). No altera el filtrado por
    /// termino, solo reordena para el render.</summary>
    private List<PaquetePacienteDto> SugerenciasPkgVista()
    {
        if (string.IsNullOrWhiteSpace(PaqueteAsignadoCodigo)) { return _sugerenciasPkg; }
        return _sugerenciasPkg.OrderByDescending(p => EsPaqueteAsignado(p.Codigo)).ToList();
    }

    private Guid? _ultimoIdCargado;
    private Guid? _ultimoPacienteCargado;
    // Orden (grupo) actualmente seleccionada. Igual que medicamentos: N ordenes a
    // servicios por HC; cada una se imprime y emite su QR por separado.
    private int _ordenActual = 1;
    private List<PaquetePacienteDto> _paquetes = new();
    private string _terminoBusqueda = "";
    private List<ServicioSugerenciaDto> _sugerencias = new();
    /// <summary>Modo del buscador: false = busca servicios; true = busca solo paquetes
    /// de los contratos del paciente (checkbox "Solo paquetes"). Al elegir un paquete
    /// en modo paquetes se cargan de una vez todos sus servicios.</summary>
    private bool _soloPaquetes;
    private List<PaquetePacienteDto> _sugerenciasPkg = new();
    private List<OrdenServicioItemDto> _items = new();
    private bool _buscando;
    private bool _agregando;
    private System.Threading.CancellationTokenSource? _debounceCts;

    private BorradorServ _borrador = new();

    protected override async Task OnParametersSetAsync()
    {
        if (HistoriaClinicaId != _ultimoIdCargado)
        {
            _ultimoIdCargado = HistoriaClinicaId;
            _borrador = new();
            _terminoBusqueda = "";
            _sugerencias.Clear();
            await CargarItemsAsync();
        }
        if (PacienteId != _ultimoPacienteCargado)
        {
            _ultimoPacienteCargado = PacienteId;
            _sugerenciasPkg.Clear();
            _paquetes = PacienteId is Guid pid
                ? (await OrdSvc.ListarPaquetesDelPacienteAsync(pid)).ToList()
                : new();
        }
    }

    /// <summary>Toggle del checkbox "Solo paquetes": cambia el modo del buscador.
    /// Al activarlo precarga los paquetes del paciente para que el dropdown ya
    /// muestre opciones sin teclear; al desactivarlo vuelve al buscador de servicios.</summary>
    private void OnSoloPaquetesChanged(bool valor)
    {
        _soloPaquetes = valor;
        _terminoBusqueda = "";
        _sugerencias.Clear();
        _sugerenciasPkg = valor ? _paquetes.Take(20).ToList() : new();
        StateHasChanged();
    }

    /// <summary>Elegir un paquete en el buscador (modo "Solo paquetes"): carga de
    /// una vez todos sus servicios, igual que el boton del selector.</summary>
    private async Task SeleccionarPaqueteAsync(PaquetePacienteDto p)
    {
        _sugerenciasPkg.Clear();
        _terminoBusqueda = "";
        await AgregarPaquetePorIdAsync(p.PaqueteId);
    }

    /// <summary>Agrega a la orden TODOS los servicios del paquete indicado que existan
    /// en los contratos del paciente. Omite duplicados (backend). Lo usa el buscador
    /// en modo "Solo paquetes".</summary>
    private async Task AgregarPaquetePorIdAsync(Guid paqId)
    {
        if (HistoriaClinicaId is not Guid hid || PacienteId is not Guid pid) { return; }
        var nuevos = await OrdSvc.AgregarPaqueteAsync(hid, pid, paqId, Guid.Empty, _ordenActual);
        if (nuevos.Count > 0)
        {
            _items.AddRange(nuevos);
            await NotifyCount();
            await NotifyItemsChanged();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Ese paquete no agrego servicios: ya estan en la orden o el contrato del paciente no los tiene.");
        }
    }

    private async Task CargarItemsAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { _items = new(); return; }
        _items = (await OrdSvc.ListarPorHistoriaAsync(hid)).ToList();
        // Posicionar en la primera orden existente (o la 1 si no hay items).
        _ordenActual = _items.Select(x => x.NumeroOrden).DefaultIfEmpty(1).Min();
        await NotifyCount();
    }

    /// <summary>Numeros de orden presentes (union de los que tienen items + la
    /// orden activa), ordenados. Igual que medicamentos.</summary>
    private List<int> OrdenesPresentes()
    {
        var set = new HashSet<int>(_items.Select(x => x.NumeroOrden)) { _ordenActual };
        return set.OrderBy(n => n).ToList();
    }

    /// <summary>Crea otra orden a servicios: solo mueve la seleccion al siguiente
    /// numero libre. La orden "existe" cuando se le agrega el primer servicio.</summary>
    private void NuevaOrden() => _ordenActual = OrdenesPresentes().Max() + 1;

    /// <summary>Elimina la orden activa con todos sus servicios (y revoca su QR).</summary>
    private async Task EliminarOrdenActualAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        if (!_items.Any(x => x.NumeroOrden == _ordenActual)) { return; }
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Eliminar la orden {_ordenActual} con todos sus servicios? Esta accion no se puede deshacer.");
        if (!ok) { return; }
        var n = _ordenActual;
        await OrdSvc.EliminarOrdenAsync(hid, n, Guid.Empty);
        _items.RemoveAll(x => x.NumeroOrden == n);
        _ordenActual = _items.Select(x => x.NumeroOrden).DefaultIfEmpty(1).Min();
        await NotifyCount();
        await NotifyItemsChanged();
    }

    private async Task NotifyCount()
    {
        if (OnCountChanged.HasDelegate) { await OnCountChanged.InvokeAsync(_items.Count); }
    }

    /// <summary>Lanza busqueda al catalogo con debounce de ~200ms para no saturar.</summary>
    private async Task OnTerminoChanged(ChangeEventArgs e)
    {
        _terminoBusqueda = e.Value?.ToString() ?? "";

        // Modo "Solo paquetes": filtro local sobre los paquetes ya cargados del
        // paciente (por codigo o nombre). No pega al backend ni usa debounce.
        if (_soloPaquetes)
        {
            var t = _terminoBusqueda.Trim();
            _sugerenciasPkg = (string.IsNullOrEmpty(t)
                ? _paquetes
                : _paquetes.Where(p =>
                    (p.Codigo?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Nombre?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)))
                .Take(20).ToList();
            _sugerencias.Clear();
            StateHasChanged();
            return;
        }

        _debounceCts?.Cancel();
        _debounceCts = new();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(200, token);
            _buscando = true;
            var t = _terminoBusqueda;
            _sugerencias = (await OrdSvc.BuscarSugerenciasAsync(t, 12, PacienteId, token)).ToList();
            _buscando = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* siguiente tecleo cancelo */ }
    }

    private void SeleccionarSugerencia(ServicioSugerenciaDto s)
    {
        _borrador.ServicioContratoId = s.Id;
        _borrador.CodigoServicio = s.CodigoServicio;
        _borrador.Descripcion = s.Descripcion;
        _sugerencias.Clear();
        _terminoBusqueda = "";
    }

    private async Task AgregarAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        if (string.IsNullOrWhiteSpace(_borrador.Descripcion)) { return; }
        _agregando = true;
        try
        {
            var creado = await OrdSvc.AgregarAsync(hid, new AgregarServicioRequest(
                _borrador.ServicioContratoId,
                _borrador.CodigoServicio,
                _borrador.Descripcion!,
                _borrador.Cantidad,
                _borrador.Observaciones,
                _ordenActual), Guid.Empty);
            _items.Add(creado);
            await NotifyCount();
            await NotifyItemsChanged();
            LimpiarBorrador();
        }
        finally { _agregando = false; }
    }

    private void LimpiarBorrador()
    {
        _borrador = new();
        _terminoBusqueda = "";
        _sugerencias.Clear();
    }

    private async Task GuardarCantidad(OrdenServicioItemDto it, string? nueva)
    {
        var req = new ActualizarServicioRequest(nueva, it.Observaciones);
        await OrdSvc.ActualizarAsync(it.Id, req, Guid.Empty);
        var idx = _items.FindIndex(x => x.Id == it.Id);
        if (idx >= 0) { _items[idx] = it with { Cantidad = nueva }; }
        await NotifyItemsChanged();
    }

    private async Task GuardarObservaciones(OrdenServicioItemDto it, string? nuevas)
    {
        var req = new ActualizarServicioRequest(it.Cantidad, nuevas);
        await OrdSvc.ActualizarAsync(it.Id, req, Guid.Empty);
        var idx = _items.FindIndex(x => x.Id == it.Id);
        if (idx >= 0) { _items[idx] = it with { Observaciones = nuevas }; }
        await NotifyItemsChanged();
    }

    private async Task EliminarAsync(OrdenServicioItemDto it)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Quitar \"{it.Descripcion}\" de la orden?");
        if (!ok) { return; }
        await OrdSvc.EliminarAsync(it.Id, Guid.Empty);
        _items.RemoveAll(x => x.Id == it.Id);
        await NotifyCount();
        await NotifyItemsChanged();
    }

    /// <summary>Abre la vista imprimible /orden-doc en una nueva pestana del navegador.</summary>
    private async Task ImprimirAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        await JS.InvokeVoidAsync("open", $"/orden-doc/{hid}/ORDEN_SERVICIOS", "_blank");
    }

    // ---- Modal "Agregar paquete" (facet 2): el paquete entra como UN registro-resumen ----
    /// <summary>Visible/oculto del modal.</summary>
    private bool _showPkgModal;
    /// <summary>Paquete activo (el que se cargara). Solo uno a la vez.</summary>
    private Guid? _pkgSeleccionado;
    /// <summary>Paquetes con el arbol expandido.</summary>
    private readonly HashSet<Guid> _pkgExpandidos = new();
    /// <summary>Cache de servicios por paquete para no recargar al re-expandir.</summary>
    private readonly Dictionary<Guid, List<ServicioDePaqueteDto>> _pkgServiciosCache = new();
    /// <summary>Servicios marcados por paquete (ServicioContratoId).</summary>
    private readonly Dictionary<Guid, HashSet<Guid>> _pkgChecks = new();
    /// <summary>Paquete cuyo detalle se esta cargando en este momento (spinner).</summary>
    private Guid? _pkgCargandoId;
    /// <summary>En curso el "Cargar" (crea el registro).</summary>
    private bool _pkgCargando;

    /// <summary>Habilita "Cargar": hay un paquete activo con al menos un servicio marcado.</summary>
    private bool PuedeCargarPkg =>
        _pkgSeleccionado is Guid pid
        && _pkgChecks.TryGetValue(pid, out var set) && set.Count > 0;

    /// <summary>Lista de paquetes del modal con el asignado primero (orden estable).</summary>
    private string _pkgFiltro = "";

    private List<PaquetePacienteDto> PaquetesModalVista()
    {
        IEnumerable<PaquetePacienteDto> q = _paquetes;
        var f = _pkgFiltro?.Trim();
        if (!string.IsNullOrWhiteSpace(f))
        {
            q = q.Where(p => (p.Nombre?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (p.Codigo?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (!string.IsNullOrWhiteSpace(PaqueteAsignadoCodigo))
        {
            q = q.OrderByDescending(p => EsPaqueteAsignado(p.Codigo));
        }
        return q.ToList();
    }

    private void AbrirPkgModal()
    {
        if (HistoriaClinicaId is null || PacienteId is null) { return; }
        _pkgSeleccionado = null;
        _pkgFiltro = "";
        _pkgExpandidos.Clear();
        _pkgChecks.Clear();
        _pkgServiciosCache.Clear();
        _pkgCargandoId = null;
        _showPkgModal = true;
    }

    private void CerrarPkgModal()
    {
        _showPkgModal = false;
        _pkgSeleccionado = null;
        _pkgExpandidos.Clear();
        _pkgChecks.Clear();
        _pkgServiciosCache.Clear();
        _pkgCargandoId = null;
    }

    /// <summary>Expande/colapsa un paquete. Al expandir lo marca como activo y
    /// carga sus servicios (lazy, con cache).</summary>
    private async Task TogglePkgExpandAsync(PaquetePacienteDto p)
    {
        if (_pkgExpandidos.Contains(p.PaqueteId))
        {
            _pkgExpandidos.Remove(p.PaqueteId);
            if (_pkgSeleccionado == p.PaqueteId) { _pkgSeleccionado = null; }
            return;
        }
        _pkgExpandidos.Add(p.PaqueteId);
        _pkgSeleccionado = p.PaqueteId;
        await CargarServiciosPkgAsync(p.PaqueteId);
    }

    /// <summary>Carga (una vez) los servicios de un paquete y los deja todos marcados
    /// por defecto.</summary>
    private async Task CargarServiciosPkgAsync(Guid paqId)
    {
        if (PacienteId is not Guid pid) { return; }
        if (_pkgServiciosCache.ContainsKey(paqId)) { return; }
        _pkgCargandoId = paqId;
        StateHasChanged();
        var servs = (await OrdSvc.ListarServiciosDePaqueteAsync(pid, paqId)).ToList();
        _pkgServiciosCache[paqId] = servs;
        _pkgChecks[paqId] = new HashSet<Guid>(servs.Select(s => s.ServicioContratoId));
        _pkgCargandoId = null;
    }

    private void TogglePkgServicio(Guid paqId, Guid servId, bool marcar)
    {
        if (!_pkgChecks.TryGetValue(paqId, out var set)) { set = new(); _pkgChecks[paqId] = set; }
        if (marcar) { set.Add(servId); } else { set.Remove(servId); }
        _pkgSeleccionado = paqId;
    }

    /// <summary>Marca todos / ninguno de los servicios de un paquete.</summary>
    private void PkgSeleccionar(Guid paqId, bool todos)
    {
        if (!_pkgServiciosCache.TryGetValue(paqId, out var servs)) { return; }
        _pkgChecks[paqId] = todos
            ? new HashSet<Guid>(servs.Select(s => s.ServicioContratoId))
            : new HashSet<Guid>();
        _pkgSeleccionado = paqId;
    }

    /// <summary>"Cargar": crea UN solo registro (no facturable) que representa el
    /// paquete completo: codigo = codigo del paquete, descripcion = nombre del
    /// paquete, observaciones = "Incluye: ..." con los servicios marcados. No se
    /// expande en servicios individuales (eso lo hace el buscador de paquetes).</summary>
    private async Task CargarPkgAsync()
    {
        if (HistoriaClinicaId is not Guid hid) { return; }
        if (_pkgSeleccionado is not Guid paqId) { return; }
        if (!_pkgChecks.TryGetValue(paqId, out var checks) || checks.Count == 0) { return; }
        var pkg = _paquetes.FirstOrDefault(x => x.PaqueteId == paqId);
        if (pkg is null) { return; }

        _pkgCargando = true;
        try
        {
            var servs = _pkgServiciosCache.TryGetValue(paqId, out var list) ? list : new();
            var incluye = servs.Where(s => checks.Contains(s.ServicioContratoId))
                               .Select(s => s.Descripcion)
                               .ToList();
            var obs = "Incluye: " + string.Join(", ", incluye);
            var creado = await OrdSvc.AgregarAsync(hid, new AgregarServicioRequest(
                null, pkg.Codigo, pkg.Nombre, _borrador.Cantidad, obs, _ordenActual), Guid.Empty);
            _items.Add(creado);
            await NotifyCount();
            await NotifyItemsChanged();
            CerrarPkgModal();
        }
        finally { _pkgCargando = false; }
    }

    private sealed class BorradorServ
    {
        public Guid? ServicioContratoId { get; set; }
        public string? CodigoServicio { get; set; }
        public string? Descripcion { get; set; }
        public string? Cantidad { get; set; }
        public string? Observaciones { get; set; }
    }
}
