.ep-modal-foot { padding:.75rem 1.15rem; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end; gap:.5rem; }
.ep-grid { display:grid; grid-template-columns:1fr 1fr; gap:.75rem 1rem; }
.ep-field { display:flex; flex-direction:column; gap:.25rem; }
.ep-col2 { grid-column:1 / -1; }
.ep-field label { font-size:.8rem; color:#334155; }
.ep-inp { padding:.5rem .6rem; border:1px solid #cbd5e1; border-radius:8px; font:inherit; width:100%; }
.ep-hint { font-size:.72rem; color:#94a3b8; }
.ep-field-row { flex-direction:row; align-items:flex-end; gap:.75rem; }
.ep-field-row > div { flex:1; }
.ep-check { display:flex; align-items:center; gap:.4rem; font-size:.85rem; color:#334155; }
