    private async Task AplicarFacturaAlLote()
    {
        if (_verDetalle is null || _bulkAplicando) { return; }
        var valor = (_bulkFactura ?? "").Trim();
        if (string.IsNullOrWhiteSpace(valor)) { return; }
        if (_verDetalle.Metadata.Estado != EstadoSnapshot.Vigente)
        {
            _error = "Solo se puede aplicar en snapshots Vigentes.";
            return;
        }

        _bulkAplicando = true;
        _error = null;
        try
        {
            var n = await Svc.ActualizarColumnaEnLoteAsync(
                _verDetalle.Metadata.Id,
                "Consecutivo Factura",
                valor,
                _actorId,
                motivo: $"Bulk-fill N° factura del lote a '{valor}'");
            _ok = $"N° factura aplicado a {n} fila(s).";
            await CargarPaginaVer();
        }
        catch (Exception ex)
        {
            _error = "No se pudo aplicar el N° factura: " + ex.Message;
        }
        finally
        {
            _bulkAplicando = false;
        }
    }

    private async Task IrPagina(int p)
    {
        if (p < 1 || p > _verTotalPaginas) { return; }
        _verPagina = p;
        await CargarPaginaVer();
    }

