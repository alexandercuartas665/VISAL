@page "/facturacion-clinica/snapshots"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using System.Text.Json
@using Visal.Application.Facturacion
@using Visal.Application.Tenancy
@using Visal.Domain.Enums
@inject IFacturacionSnapshotService Svc
@inject ISnapshotColumnaConfigService ColSvc
@inject IEnumerable<ISnapshotBuilder> Builders
@inject IAseguradoraService AseSvc
@inject ICuentaMedicaConfigService CuentaSvc
@inject Visal.SuperAdmin.Facturacion.ITipologiaZipService ZipSvc
@inject Visal.SuperAdmin.Facturacion.ITipologiaZipJobService ZipJobSvc
@inject ISucursalService SucSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@implements IDisposable

@*
   Modulo generico de snapshots de facturacion (Capa 07).
   Ruta: /facturacion-clinica/snapshots  (la ruta /facturacion ya la ocupa el
   modulo SaaS de la plataforma).

   Filosofia (ver doc "1. Motor de Snapshots"):
   - Snapshot = instantanea inmutable, no reporte.
   - Nunca DELETE. Solo Archivar con motivo obligatorio (min 10 chars).
   - El motor sirve a N tipos; cada tipo trae su ISnapshotBuilder + sus filtros.
     En Fase 2 el motor solo lista tipos con builder registrado.
*@

<PageTitle>Snapshots Transaccionales - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Facturacion</div>
        <h1 class="ase-title">Snapshots Transaccionales</h1>
        <p class="ase-sub" style="margin:4px 0 0;color:#475569;font-size:13px;">
            Instantaneas de datos para radicar facturas a la EPS. Se archivan con
            motivo pero nunca se eliminan.
        </p>
    </div>
    <div style="display:flex;gap:8px;">
        <button class="btn btn-outline-secondary btn-sm" @onclick="CargarLista" disabled="@_cargando">
            @(_cargando ? "..." : "Refrescar")
        </button>
        <button class="btn btn-outline-primary btn-sm" @onclick="AbrirConfigColumnas" disabled="@(_tiposDisponibles.Count == 0)">
            Configurar columnas
        </button>
        <button class="btn btn-primary btn-sm" @onclick="AbrirNuevo" disabled="@(_tiposDisponibles.Count == 0)">
            + Nuevo snapshot
        </button>
    </div>
</div>

@if (_error is not null) { <div class="ase-alert">@_error</div> }
@if (_ok is not null) { <div class="ase-ok">@_ok</div> }

@if (_tiposDisponibles.Count == 0)
{
    <div class="ase-alert" style="background:#fff7e6;border-color:#ffd591;color:#7a4f01;">
        <b>Aun no hay ningun tipo de snapshot habilitado.</b>
        Los tipos aparecen a medida que se registran sus builders (Fase 5+).
        Puedes ver el listado historico pero no puedes generar nuevos hasta entonces.
    </div>
}

<div class="ase-card sn-card">
    <div class="sn-tabs">
        <button class="sn-tab @(_tab == Tab.Vigentes ? "sel" : "")" @onclick="() => CambiarTab(Tab.Vigentes)">
            Vigentes @if (_conteoVigentes >= 0) { <span class="sn-tab-count">(@_conteoVigentes)</span> }
        </button>
        <button class="sn-tab @(_tab == Tab.Archivados ? "sel" : "")" @onclick="() => CambiarTab(Tab.Archivados)">
            Archivados @if (_conteoArchivados >= 0) { <span class="sn-tab-count">(@_conteoArchivados)</span> }
        </button>
    </div>

    <div class="sn-filtros">
        <div class="sn-f">
            <label>Tipo</label>
            <select class="form-select form-select-sm" @bind="_filtroTipo" @bind:after="CargarLista">
                <option value="">(Todos)</option>
                @foreach (var t in Enum.GetValues<TipoSnapshot>())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="sn-f">
            <label>Aseguradora</label>
            <select class="form-select form-select-sm" @bind="_filtroAseguradora" @bind:after="CargarLista">
                <option value="">(Todas)</option>
                @foreach (var a in _relAseguradoras)
                {
                    <option value="@a.Id">@a.Nombre</option>
                }
            </select>
        </div>
        <div class="sn-f">
            <label>Fecha desde</label>
            <input type="date" class="form-control form-control-sm" @bind="_filtroDesde" @bind:after="CargarLista" />
        </div>
        <div class="sn-f">
            <label>Fecha hasta</label>
            <input type="date" class="form-control form-control-sm" @bind="_filtroHasta" @bind:after="CargarLista" />
        </div>
    </div>

    @if (_cargando)
    {
        <div class="sn-empty">Cargando...</div>
    }
    else if (_lista.Count == 0)
    {
        <div class="sn-empty">
            @if (_tab == Tab.Vigentes) { <span>No hay snapshots vigentes.</span> }
            else { <span>No hay snapshots archivados.</span> }
        </div>
    }
    else
    {
        <div class="sn-tabla-wrap">
            <table class="table table-sm sn-tabla">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Aseguradora</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Inicio</th>
                        <th>Tardo</th>
                        <th>Versión</th>
                        <th class="sn-th-num">Filas</th>
                        @if (_tab == Tab.Archivados)
                        {
                            <th>Motivo archivado</th>
                            <th>Fecha archivo</th>
                        }
                        <th class="sn-th-acc">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _lista)
                    {
                        <tr>
                            <td>
                                <strong>@s.Nombre</strong>
                                @if (s.Estado == EstadoSnapshot.Fallido && s.ErrorMensaje is not null)
                                {
                                    <div class="sn-error-inline" title="@s.ErrorMensaje">Error: @Truncar(s.ErrorMensaje, 80)</div>
                                }
                            </td>
                            <td>@(s.AseguradoraNombre ?? "-")</td>
                            <td><span class="sn-tag">@s.Tipo</span></td>
                            <td>
                                <span class="sn-estado sn-estado-@(s.Estado.ToString().ToLower())">@s.Estado</span>
                            </td>
                            <td class="sn-mono">@s.FechaEjecucionInicio.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="sn-mono">@FormatearDuracion(s.DuracionMs)</td>
                            <td class="sn-mono">@(string.IsNullOrWhiteSpace(s.VersionApp) ? "-" : "v" + s.VersionApp)</td>
                            <td class="sn-td-num">@s.TotalFilas</td>
                            @if (_tab == Tab.Archivados)
                            {
                                <td class="sn-truncate" title="@s.MotivoArchivado">@Truncar(s.MotivoArchivado, 60)</td>
                                <td class="sn-mono">@(s.FechaArchivado?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            }
                            <td class="sn-td-acc">
                                <button class="btn btn-outline-primary btn-sm"
                                        disabled="@(s.Estado != EstadoSnapshot.Vigente && s.Estado != EstadoSnapshot.Archivado)"
                                        @onclick="() => AbrirVer(s.Id)" title="Ver contenido del snapshot">Ver</button>
                                @if (s.Estado == EstadoSnapshot.Vigente || s.Estado == EstadoSnapshot.Archivado)
                                {
                                    <a class="btn btn-outline-success btn-sm ms-1"
                                       href="@($"/facturacion-clinica/snapshots/{s.Id}/download?formato=xlsx")"
                                       target="_blank" rel="noopener"
                                       title="Descargar Excel">xlsx</a>
                                    <a class="btn btn-outline-secondary btn-sm ms-1"
                                       href="@($"/facturacion-clinica/snapshots/{s.Id}/download?formato=csv")"
                                       target="_blank" rel="noopener"
                                       title="Descargar CSV">csv</a>
                                }
                                @if (_tab == Tab.Vigentes && s.Estado == EstadoSnapshot.Vigente)
                                {
                                    <button class="btn btn-outline-info btn-sm ms-1"
                                            disabled="@(_completandoId == s.Id)"
                                            @onclick="() => CompletarCodigos(s.Id)"
                                            title="Completa las columnas HC N° y Cod. Asignacion en snapshots generados antes de que existieran (reconstruye con los mismos filtros y verifica fila por fila).">
                                        @(_completandoId == s.Id ? "Completando..." : "Completar códigos")
                                    </button>
                                }
                                @if (_tab == Tab.Vigentes && s.Estado == EstadoSnapshot.Vigente && _puedeArchivar)
                                {
                                    <button class="btn btn-outline-danger btn-sm ms-1"
                                            @onclick="() => AbrirArchivar(s.Id, s.Nombre)"
                                            title="Archivar con motivo">Archivar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ============ Modal + Nuevo snapshot ============ *@
@if (_showNuevo)
{
    <div class="sn-modal-back" @onclick="CerrarNuevo">
        <div class="sn-modal sn-modal-nuevo" @onclick:stopPropagation>
            <div class="sn-modal-h">
                <div>
                    <div class="sn-modal-eyebrow">Facturacion</div>
                    <h3>Nuevo Snapshot</h3>
                </div>
                <button class="sn-modal-x" @onclick="CerrarNuevo">&times;</button>
            </div>
            <div class="sn-modal-b">
                @if (_nuevoErr is not null) { <div class="ase-alert">@_nuevoErr</div> }
                <div class="snf-form">
                    <div class="snf-row-2">
                        <div class="snf-f">
                            <label>Tipo *</label>
                            <select class="form-select form-select-sm" @bind="_nuevoTipo">
                                @foreach (var t in _tiposDisponibles)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="snf-f">
                            <label>
                                Nombre *
                                <small class="text-muted">
                                    @(_nuevoTipo == TipoSnapshot.RelacionFacturas && _relAseguradoraIds.Count > 1
                                        ? "(se sufija con el nombre de cada EPS)"
                                        : "(para identificarlo en el listado)")
                                </small>
                            </label>
                            <input class="form-control form-control-sm" @bind="_nuevoNombre" placeholder="Facturacion Julio 2026" />
                        </div>
                    </div>
                    @if (_nuevoTipo == TipoSnapshot.RelacionFacturas)
                    {
                        <div class="snf-row-2">
                            <div class="snf-f">
                                <label>Fecha inicio *</label>
                                <input type="date" class="form-control form-control-sm" @bind="_relFechaInicio" />
                            </div>
                            <div class="snf-f">
                                <label>Fecha fin *</label>
                                <input type="date" class="form-control form-control-sm" @bind="_relFechaFin" />
                            </div>
                        </div>
                        <div class="snf-f">
                            <label>
                                Filtro paciente <small class="text-muted">(opcional — para pruebas del sistema)</small>
                            </label>
                            <input class="form-control form-control-sm"
                                   @bind="_relPacienteQuery"
                                   placeholder="Nombre o identificacion del paciente" />
                            <small class="text-muted d-block mt-1">
                                Solo se incluiran en el snapshot las HC de pacientes cuyo nombre o documento contenga este texto (case y tildes insensibles). Vacio = todos.
                            </small>
                        </div>
                        <div class="snf-f">
                            <label>
                                Aseguradoras *
                                <small class="text-muted">
                                    (@_relAseguradoraIds.Count seleccionada@(_relAseguradoraIds.Count == 1 ? "" : "s"))
                                </small>
                            </label>
                            <div style="display:flex;gap:8px;margin-bottom:6px;">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="MarcarTodasAseguradoras">
                                    Marcar todas
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="QuitarTodasAseguradoras">
                                    Quitar todas
                                </button>
                            </div>
                            <div class="sn-multi" style="max-height:220px;overflow-y:auto;">
                                @foreach (var a in _relAseguradoras)
                                {
                                    <label class="sn-multi-chip">
                                        <input type="checkbox"
                                               checked="@_relAseguradoraIds.Contains(a.Id)"
                                               @onchange="e => ToggleAseguradora(a.Id, (bool)(e.Value ?? false))" />
                                        <span>@a.Nombre @(string.IsNullOrEmpty(a.Nit) ? "" : $"({a.Nit})")</span>
                                    </label>
                                }
                                @if (_relAseguradoras.Count == 0)
                                {
                                    <span class="text-muted">Sin aseguradoras activas.</span>
                                }
                            </div>
                            <small class="text-muted d-block mt-1">
                                Se genera un snapshot independiente por cada aseguradora marcada.
                            </small>
                        </div>
                        <div class="snf-f">
                            <label>Sucursales <small class="text-muted">(opcional — vacio = todas las del tenant)</small></label>
                            <div class="sn-multi">
                                @foreach (var s in _relSucursales)
                                {
                                    <label class="sn-multi-chip">
                                        <input type="checkbox"
                                               checked="@_relSucursalIds.Contains(s.Id)"
                                               @onchange="e => ToggleSucursal(s.Id, (bool)(e.Value ?? false))" />
                                        <span>@s.Nombre</span>
                                    </label>
                                }
                                @if (_relSucursales.Count == 0)
                                {
                                    <span class="text-muted">Sin sucursales activas.</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="snf-f">
                            <label>Filtros del snapshot (JSON)</label>
                            <textarea class="form-control form-control-sm" rows="4"
                                      style="font-family:'JetBrains Mono','Consolas',monospace;font-size:12px;"
                                      @bind="_nuevoFiltrosJson"
                                      placeholder='{"fechaInicio":"2026-06-01","fechaFin":"2026-06-30"}'></textarea>
                            <small class="text-muted d-block mt-1">
                                Este tipo aun no tiene formulario visual — captura el JSON de filtros a mano.
                            </small>
                        </div>
                    }
                </div>
            </div>
            <div class="sn-modal-f">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarNuevo">Cancelar</button>
                <button class="btn btn-primary btn-sm" @onclick="ConfirmarNuevo" disabled="@_generando">
                    @(_generando ? "Generando..." : "Generar")
                </button>
            </div>
        </div>
    </div>
}

@* ============ Modal Ver snapshot ============ *@
@if (_showVer && _verDetalle is not null)
{
    <div class="sn-modal-back" @onclick="CerrarVer">
        <div class="sn-modal sn-modal-xl" @onclick:stopPropagation>
            <div class="sn-modal-h">
                <div>
                    <div class="sn-modal-eyebrow">@_verDetalle.Metadata.Tipo</div>
                    <h3>@_verDetalle.Metadata.Nombre <small class="text-muted">(@_verDetalle.Metadata.TotalFilas filas)</small></h3>
                    <div style="font-size:12px;color:var(--muted);margin-top:4px;">
                        Estado: <b>@_verDetalle.Metadata.Estado</b>
                        &middot; Generado @_verDetalle.Metadata.FechaEjecucionInicio.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        @if (_verDetalle.Metadata.DuracionMs is int d) { <span> &middot; Tardo @FormatearDuracion(d)</span> }
                        @if (!string.IsNullOrWhiteSpace(_verDetalle.Metadata.VersionApp)) { <span> &middot; v@_verDetalle.Metadata.VersionApp</span> }
                    </div>
                </div>
                <button class="sn-modal-x" @onclick="CerrarVer">&times;</button>
            </div>
            <div class="sn-tabs sn-tabs-modal">
                <button class="sn-tab @(_verTab == VerTab.Datos ? "sel" : "")" @onclick="() => CambiarVerTab(VerTab.Datos)">
                    Datos <span class="sn-tab-count">(@_verDetalle.Metadata.TotalFilas)</span>
                </button>
                <button class="sn-tab @(_verTab == VerTab.Tipologias ? "sel" : "")" @onclick="() => CambiarVerTab(VerTab.Tipologias)">
                    Tipologias / Archivos
                </button>
            </div>
            @if (_verTab == VerTab.Datos)
            {
            <div class="sn-modal-controls">
                <div class="sn-modal-controls-l">
                    <span class="sn-modal-hint">Usa el <b>pin</b> del encabezado de una columna para fijarla (y las anteriores) al hacer scroll horizontal. Para filtrar, usa <b>Filtrar por columna</b> abajo.</span>
                </div>
                <div class="sn-modal-controls-r">
                    <span class="sn-page-info">Pagina @_verPagina / @_verTotalPaginas &middot; @_verTotal filas</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => IrPagina(_verPagina - 1)" disabled="@(_verPagina <= 1)">&lt;</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => IrPagina(_verPagina + 1)" disabled="@(_verPagina >= _verTotalPaginas)">&gt;</button>
                </div>
            </div>

            @* Filtros por columna apilables (cascada). Se combinan con AND entre si y con
               el "Buscar" de texto libre. Cada chip se puede quitar; "Limpiar" los borra todos. *@
            <div style="display:flex;flex-direction:column;gap:6px;margin:4px 0 8px;padding:8px 10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                    <label style="font-size:11px;font-weight:600;color:#334155;margin:0;">Filtrar por columna</label>
                    <select class="form-select form-select-sm" style="width:210px;" @bind="_nfCol">
                        <option value="">(elige columna)</option>
                        @foreach (var c in _verDetalle.Columnas)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <input class="form-control form-control-sm" style="width:180px;" placeholder="contiene..."
                           @bind="_nfVal" @bind:event="oninput" @onkeyup="OnNuevoFiltroKey" />
                    <button class="btn btn-outline-primary btn-sm" @onclick="AgregarFiltro"
                            disabled="@(string.IsNullOrWhiteSpace(_nfCol) || string.IsNullOrWhiteSpace(_nfVal))">+ Agregar filtro</button>
                    @if (_verFiltros.Count > 0)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltros">Limpiar filtros (@_verFiltros.Count)</button>
                    }
                </div>
                @if (_verFiltros.Count > 0)
                {
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        @for (int i = 0; i < _verFiltros.Count; i++)
                        {
                            var idx = i;
                            var f = _verFiltros[i];
                            <span style="display:inline-flex;align-items:center;gap:6px;background:#e0f2fe;color:#075985;border:1px solid #bae6fd;border-radius:12px;padding:2px 8px;font-size:12px;">
                                <span><b>@f.Columna</b>: @f.Valor</span>
                                <button type="button" title="Quitar filtro" @onclick="() => QuitarFiltro(idx)"
                                        style="border:none;background:transparent;color:#0369a1;cursor:pointer;font-size:14px;line-height:1;padding:0;">&times;</button>
                            </span>
                        }
                    </div>
                }
                @* Filtro por color de resaltado de la fila. *@
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                    <label style="font-size:11px;font-weight:600;color:#334155;margin:0;">Filtrar por color</label>
                    <button type="button" class="sn-cf-btn @(_verColorFiltro is null ? "on" : "")"
                            @onclick="() => SetColorFiltroAsync(null)">Todos</button>
                    @foreach (var c in _coloresFila)
                    {
                        <button type="button" class="sn-cf-swatch @(_verColorFiltro == c ? "on" : "")"
                                style="@($"background:{c};")" title="Solo filas con este color"
                                @onclick="() => SetColorFiltroAsync(c)"></button>
                    }
                    <button type="button" class="sn-cf-btn @(_verColorFiltro == "__sin__" ? "on" : "")"
                            @onclick="@(() => SetColorFiltroAsync("__sin__"))">Sin color</button>
                </div>
            </div>
            @* Toolbar bulk-fill: aplicar el mismo valor de "Consecutivo Factura" a
               TODAS las filas del snapshot. Pensado para cuando la EPS asigna un
               unico numero de factura al lote. Solo se muestra en snapshots Vigentes. *@
            @if (_verDetalle.Metadata.Estado == EstadoSnapshot.Vigente
                 && _verDetalle.Columnas.Contains("Consecutivo Factura"))
            {
                <div class="sn-bulk-bar">
                    <label>N° factura del lote</label>
                    <input class="form-control form-control-sm" style="width:220px;"
                           placeholder="Ej: FE-2026-1023"
                           @bind="_bulkFactura" />
                    <button class="btn btn-primary btn-sm"
                            @onclick="AplicarFacturaAlLote"
                            disabled="@(_bulkAplicando || string.IsNullOrWhiteSpace(_bulkFactura))">
                        @(_bulkAplicando ? "Aplicando..." : "Aplicar a todas")
                    </button>
                    <small class="text-muted">Reemplaza la columna <b>Consecutivo Factura</b> en las @_verTotal filas del snapshot.</small>
                </div>
            }
            <div class="sn-modal-b sn-modal-b-tabla">
                @if (_verCargando)
                {
                    <div class="sn-empty">Cargando...</div>
                }
                else if (_verFilas.Count == 0)
                {
                    <div class="sn-empty">No hay filas para mostrar.</div>
                }
                else
                {
                    <div id="snVerTop" class="sn-vertabla-toptrack">
                        <div class="sn-vertabla-topspacer"></div>
                    </div>
                    <div id="snVerWrap" class="sn-vertabla-wrap">
                        <table class="sn-vertabla">
                            <thead>
                                <tr>
                                    <th class="sn-vt-freeze sn-vt-counter" style="left:0;min-width:@(CounterW)px;max-width:@(CounterW)px;width:@(CounterW)px;">Nº</th>
                                    @for (var i = 0; i < _verDetalle.Columnas.Count; i++)
                                    {
                                        var col = _verDetalle.Columnas[i];
                                        var idx = i;
                                        <th class="@(idx < _verFijar ? (idx == _verFijar - 1 ? "sn-vt-freeze sn-vt-freeze-last" : "sn-vt-freeze") : "")"
                                            style="@(idx < _verFijar ? $"left:{CounterW + idx * FreezeColW}px;min-width:{FreezeColW}px;max-width:{FreezeColW}px;width:{FreezeColW}px;" : "")"
                                            @onclick="() => Ordenar(col)">
                                            <span class="sn-th-inner">
                                                <button type="button"
                                                        class="sn-pin @(idx < _verFijar ? "on" : "")"
                                                        title="@(idx < _verFijar ? "Quitar fijado" : "Fijar hasta esta columna")"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => ToggleFijar(idx)">
                                                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M9.828.722a.5.5 0 0 1 .354.146l4.95 4.95a.5.5 0 0 1 0 .707c-.48.48-1.072.588-1.503.588-.177 0-.335-.018-.46-.039l-3.134 3.134a5.9 5.9 0 0 1 .16 1.013c.046.702-.032 1.687-.72 2.375a.5.5 0 0 1-.707 0l-2.829-2.828-3.182 3.182c-.195.195-1.219.902-1.414.707s.512-1.22.707-1.414l3.182-3.182-2.828-2.829a.5.5 0 0 1 0-.707c.688-.688 1.673-.767 2.375-.72a5.9 5.9 0 0 1 1.013.16l3.134-3.133a3 3 0 0 1-.04-.461c0-.43.108-1.022.589-1.503a.5.5 0 0 1 .353-.146"/></svg>
                                                </button>
                                                <span>@col</span>
                                                @if (_verOrden == col) { <span>@(_verOrdenDesc ? " v" : " ^")</span> }
                                            </span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fila in _verFilas)
                                {
                                    var filaIdObj = fila.TryGetValue("__filaId", out var fv) ? fv : null;
                                    var filaIdParsed = filaIdObj is Guid g ? g : (Guid.TryParse(filaIdObj?.ToString(), out var gg) ? gg : Guid.Empty);
                                    var rowColor = fila.TryGetValue("__color", out var cvv) ? cvv?.ToString() : null;
                                    var bgStyle = string.IsNullOrWhiteSpace(rowColor) ? "" : $"background:{rowColor} !important;";
                                    var numFila = fila.TryGetValue("__numeroFila", out var nfv) ? nfv?.ToString() ?? "" : "";
                                    <tr @oncontextmenu:preventDefault="true"
                                        @oncontextmenu="@((MouseEventArgs e) => AbrirMenuFila(e, filaIdParsed))">
                                        <td class="sn-vt-freeze sn-vt-counter" style="@($"left:0;min-width:{CounterW}px;max-width:{CounterW}px;width:{CounterW}px;" + bgStyle)">@numFila</td>
                                        @for (var i = 0; i < _verDetalle.Columnas.Count; i++)
                                        {
                                            var col = _verDetalle.Columnas[i];
                                            var idx = i;
                                            var val = fila.TryGetValue(col, out var v) ? v?.ToString() ?? "" : "";
                                            var editable = _esColumnaEditable(col);
                                            var esVigente = _verDetalle.Metadata.Estado == EstadoSnapshot.Vigente;
                                            var cellClass = (idx < _verFijar ? (idx == _verFijar - 1 ? "sn-vt-freeze sn-vt-freeze-last" : "sn-vt-freeze") : "") + (editable && esVigente ? " sn-cell-editable" : "");
                                            <td class="@cellClass"
                                                style="@((idx < _verFijar ? $"left:{CounterW + idx * FreezeColW}px;min-width:{FreezeColW}px;max-width:{FreezeColW}px;width:{FreezeColW}px;" : "") + bgStyle)"
                                                title="@val">
                                                @if (editable && esVigente && filaIdParsed != Guid.Empty)
                                                {
                                                    <select class="form-select form-select-sm sn-cell-select"
                                                            value="@val"
                                                            @onchange="@(async (ChangeEventArgs e) => await EditarCeldaAsync(filaIdParsed, col, e.Value?.ToString()))">
                                                        <option value="">(vacio)</option>
                                                        <option value="AC">AC</option>
                                                        <option value="AP">AP</option>
                                                        <option value="AT">AT</option>
                                                        <option value="AM">AM</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    @val
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* ===== Menu contextual de fila (click derecho): copiar / color ===== *@
                @if (_menuFilaVisible)
                {
                    <div class="sn-rowmenu-back" @onclick="CerrarMenuFila"
                         @oncontextmenu:preventDefault="true" @oncontextmenu="CerrarMenuFila"></div>
                    <div class="sn-rowmenu" style="@($"top:{_menuFilaY}px;left:{_menuFilaX}px;")">
                        <button type="button" class="sn-rowmenu-item" @onclick="CopiarFilaAsync">Copiar fila</button>
                        <div class="sn-rowmenu-sep"></div>
                        <div class="sn-rowmenu-colors">
                            @foreach (var c in _coloresFila)
                            {
                                <button type="button" class="sn-rowmenu-swatch" style="@($"background:{c};")"
                                        title="Poner este color a toda la fila" @onclick="() => SetColorFilaUiAsync(c)"></button>
                            }
                        </div>
                        <button type="button" class="sn-rowmenu-item" @onclick="() => SetColorFilaUiAsync(null)">Quitar color</button>
                    </div>
                }
            </div>
            }
            else
            {
                @* ============ Tab Tipologias / Archivos ============ *@
                <div class="sn-modal-b sn-tip-body">
                    @if (_tipCargando)
                    {
                        <div class="sn-empty">Cargando resumen de tipologias...</div>
                    }
                    else
                    {
                        <div class="sn-tip-head">
                            <div>
                                <div><strong>Aseguradora:</strong> @(_verDetalle.Metadata.AseguradoraNombre ?? "(sin aseguradora en el snapshot)")</div>
                                <div class="sn-tip-gen">
                                    Generado @_verDetalle.Metadata.FechaEjecucionInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(_verDetalle.CreadoPorNombre))
                                    {
                                        <text>&middot; por <b>@_verDetalle.CreadoPorNombre</b></text>
                                    }
                                </div>
                            </div>
                            <div class="sn-tip-kpis">
                                <span class="sn-tip-kpi">@_tipArchivos.Count archivo(s)</span>
                                <span class="sn-tip-kpi">@_tipPacientes.Count paciente(s)</span>
                                <button type="button" class="btn btn-outline-primary btn-sm sn-tip-relanzar"
                                        @onclick="RelanzarArchivosAsync" disabled="@_tipCargando"
                                        title="Vuelve a consultar los archivos configurados y los pacientes contenidos en este snapshot">
                                    &#8635; Relanzar archivos
                                </button>
                            </div>
                        </div>

                        @if (_verDetalle.Metadata.AseguradoraId is null)
                        {
                            <div class="sn-empty">
                                Este snapshot no esta asociado a una aseguradora, no se pueden resolver las
                                tipologias de archivo.
                            </div>
                        }
                        else if (_tipArchivos.Count == 0)
                        {
                            <div class="sn-empty">
                                La aseguradora <b>@_verDetalle.Metadata.AseguradoraNombre</b> aun no tiene archivos
                                (tipologias) configurados. Configuralos en <b>Aseguradoras &rarr; Cuenta medica</b>.
                            </div>
                        }
                        else
                        {
                            @* Configuracion aplicable: los archivos que se generaran por paciente. *@
                            <div class="sn-tip-section-t">Archivos configurados</div>
                            <div class="text-muted" style="font-size:11.5px;margin-top:-4px;">Se genera un PDF <b>solo</b> para los pacientes que tienen el contenido del archivo. El numero indica cuantos, de los @_tipPacientes.Count del snapshot.</div>
                            <div class="sn-tip-archivos">
                                @foreach (var a in _tipArchivos)
                                {
                                    var con = _tipConteos.TryGetValue(a.Id, out var cc) ? cc : 0;
                                    var total = _tipPacientes.Count;
                                    var nombre = string.IsNullOrWhiteSpace(a.Descripcion) ? a.Alias : a.Descripcion;
                                    <div class="sn-tip-arch @(con == 0 ? "vacio" : "")">
                                        <button type="button" class="sn-tip-arch-h" @onclick="() => AbrirArchivoModal(a)" title="Ver el detalle por paciente">
                                            <span class="sn-tip-arch-ico">
                                                <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0zM9 1v3a1 1 0 0 0 1 1h3v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM5 8h6v1H5zm0 3h6v1H5z"/></svg>
                                            </span>
                                            <span class="sn-tip-arch-main">
                                                <span class="sn-tip-arch-name">@nombre</span>
                                                <span class="sn-tip-arch-sub">
                                                    <span class="sn-tip-arch-code mono">@a.Alias</span>
                                                    @if (a.Obligatorio) { <span class="sn-tip-badge">OBL</span> }
                                                </span>
                                            </span>
                                            <span class="sn-tip-arch-count @(con == 0 ? "cero" : "")"
                                                  title="Pacientes con contenido para este archivo, de los del snapshot">
                                                <b>@con</b><span class="den">/@total</span>
                                                <span class="lbl">con contenido</span>
                                            </span>
                                        </button>
                                        <div class="sn-tip-arch-foot">
                                            @{
                                                _zipUi.TryGetValue(a.Id, out var zu);
                                            }
                                            @if (zu is { Corriendo: true })
                                            {
                                                <button type="button" class="btn btn-sm sn-tip-dl" disabled>
                                                    <span class="sn-zip-spin"></span>
                                                    @if (zu.Total > 0) { <text>@zu.Fase @zu.Hechos/@zu.Total</text> }
                                                    else { <text>@zu.Fase...</text> }
                                                </button>
                                            }
                                            else if (zu is { Error: not null })
                                            {
                                                <button type="button" class="btn btn-sm sn-tip-dl" @onclick="() => IniciarZip(a)"
                                                        title="@zu.Error">
                                                    &#8635; Reintentar ZIP
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm sn-tip-dl @(con == 0 ? "off" : "")"
                                                        disabled="@(con == 0)"
                                                        @onclick="() => IniciarZip(a)"
                                                        title="@(con == 0 ? "Ningun paciente tiene contenido para este archivo" : "Generar y descargar ZIP: un PDF por paciente con contenido, nombrado con el patron")">
                                                    &#11015; Descargar ZIP@(con > 0 ? $" ({con})" : "")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="sn-tip-scope">
                                &#9432; Cada archivo se genera <b>solo</b> para los pacientes de este snapshot
                                (<b>@_verDetalle.Metadata.Nombre</b>, @_tipPacientes.Count paciente(s)) que tienen su contenido.
                                Los pacientes sin contenido se omiten. Click en un archivo para ver el detalle por paciente.
                            </div>
                        }
                    }
                </div>
            }

            @* ===== Modal de contenido de un archivo (tipologia) ===== *@
            @if (_archModal is not null)
            {
                <div class="sn-arch-modal-back" @onclick="CerrarArchivoModal">
                    <div class="sn-arch-modal" @onclick:stopPropagation>
                        <div class="sn-arch-modal-h">
                            <div>
                                <div class="sn-modal-eyebrow">Archivo / tipologia</div>
                                <h3 class="mb-0">
                                    @(string.IsNullOrWhiteSpace(_archModal.Descripcion) ? _archModal.Alias : _archModal.Descripcion)
                                    <span class="sn-tip-arch-code mono">@_archModal.Alias</span>
                                    @if (_archModal.Obligatorio) { <span class="sn-tip-badge">OBL</span> }
                                </h3>
                            </div>
                            <button class="sn-modal-x" @onclick="CerrarArchivoModal">&times;</button>
                        </div>
                        <div class="sn-arch-modal-b">
                            <div class="sn-arch-field">
                                <div class="sn-arch-label">Contenido (se fusiona en un PDF, en orden)</div>
                                @if (_archModal.Contenidos.Count == 0)
                                {
                                    <div class="text-muted small">Sin contenidos configurados.</div>
                                }
                                else
                                {
                                    <ol class="sn-arch-cont-list">
                                        @foreach (var c in _archModal.Contenidos)
                                        {
                                            <li>
                                                @LabelOrigenTip(c.Origen)
                                                @if (!string.IsNullOrEmpty(c.TipologiaNombre)) { <span class="text-muted">· @c.TipologiaNombre</span> }
                                                @if (c.SoloUltimo) { <span class="sn-tip-chip">solo el mas reciente</span> }
                                                @if (!OrigenSoportado(c.Origen)) { <span class="sn-arch-pend">pendiente (ola 2)</span> }
                                            </li>
                                        }
                                    </ol>
                                }
                            </div>
                            <div class="sn-arch-field">
                                <div class="sn-arch-label">Patron de nombre</div>
                                <div class="sn-tip-arch-pat mono">&#128193; @PatronDe(_archModal)</div>
                            </div>
                            @if (_archModal.Contenidos.Any(c => !OrigenSoportado(c.Origen)))
                            {
                                <div class="sn-arch-warn">
                                    Este archivo incluye contenidos de formularios de HC que aun no se generan
                                    (ola 2). En el ZIP esos pacientes reciben una pagina-nota para esos origenes.
                                </div>
                            }

                            @* Detalle por paciente: un registro por paciente del snapshot, con el
                               nombre de archivo que se generara para ESTE archivo. Vive dentro del
                               modal (antes se derramaba en la pestana). *@
                            <div class="sn-arch-field">
                                <div class="sn-arch-label">Registros por paciente (@_tipPacientes.Count)</div>
                                @if (_tipPacientes.Count == 0)
                                {
                                    <div class="text-muted small">El snapshot no tiene filas para resumir.</div>
                                }
                                else
                                {
                                    <div class="sn-tip-pacwrap sn-arch-pacwrap">
                                        <table class="sn-tip-pactbl">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Paciente</th>
                                                    <th>Documento</th>
                                                    <th class="text-end">Servicios</th>
                                                    <th>Archivo que se generara</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{ var _n = 0; }
                                                @foreach (var p in _tipPacientes)
                                                {
                                                    _n++;
                                                    <tr>
                                                        <td class="mono">@_n</td>
                                                        <td>@(string.IsNullOrWhiteSpace(p.Nombre) ? "-" : p.Nombre)</td>
                                                        <td class="mono">@p.TipoDocumento @p.Documento</td>
                                                        <td class="text-end">@p.Servicios</td>
                                                        <td><span class="sn-tip-file mono" title="@_archModal.Alias">@ResolverNombre(_archModal, p)</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="sn-tip-note">
                                        Los nombres se arman con el patron del archivo y los datos de cada paciente.
                                        El ZIP entrega un PDF por paciente con ese nombre.
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="sn-arch-modal-f">
                            @{
                                var cm = _tipConteos.TryGetValue(_archModal.Id, out var cmv) ? cmv : 0;
                                _zipUi.TryGetValue(_archModal.Id, out var zm);
                            }
                            @if (zm is { Corriendo: true })
                            {
                                <button class="btn btn-success btn-sm" disabled>
                                    <span class="sn-zip-spin"></span>
                                    @if (zm.Total > 0) { <text>@zm.Fase @zm.Hechos/@zm.Total</text> }
                                    else { <text>@zm.Fase...</text> }
                                </button>
                            }
                            else if (zm is { Error: not null })
                            {
                                <button class="btn btn-success btn-sm" @onclick="() => IniciarZip(_archModal!)" title="@zm.Error">
                                    &#8635; Reintentar ZIP
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success btn-sm" disabled="@(cm == 0)" @onclick="() => IniciarZip(_archModal!)">
                                    &#11015; Descargar ZIP (@cm con contenido)
                                </button>
                            }
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarArchivoModal">Cerrar</button>
                        </div>
                    </div>
                </div>
            }
            <div class="sn-modal-f">
                <div class="d-flex gap-2">
                    <a class="btn btn-success btn-sm"
                       href="@($"/facturacion-clinica/snapshots/{_verDetalle.Metadata.Id}/download?formato=xlsx")"
                       target="_blank" rel="noopener">Descargar Excel</a>
                    <a class="btn btn-outline-success btn-sm"
                       href="@($"/facturacion-clinica/snapshots/{_verDetalle.Metadata.Id}/download?formato=csv")"
                       target="_blank" rel="noopener">Descargar CSV</a>
                    <a class="btn btn-outline-info btn-sm"
                       href="@($"/facturacion-clinica/snapshots/{_verDetalle.Metadata.Id}/download?formato=json&ignorarValidacion={(_ripsIgnorarValidacion ? "true" : "false")}")"
                       target="_blank" rel="noopener"
                       title="JSON RIPS Resolucion 2275/2023">
                        Generar JSON RIPS
                    </a>
                    <label class="d-flex align-items-center gap-1 mb-0" style="font-size:12px;color:#475569;"
                           title="Genera el archivo aunque falle la validacion (para probar contra el validador MinSalud).">
                        <input type="checkbox" @bind="_ripsIgnorarValidacion" />
                        Generar aunque falle validacion
                    </label>
                    <button class="btn btn-outline-primary btn-sm" @onclick="AbrirHistorial">Historial cambios</button>
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarVer">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ============ Modal Archivar ============ *@
@if (_showArchivar)
{
    <div class="sn-modal-back" @onclick="CerrarArchivar">
        <div class="sn-modal sn-modal-sm" @onclick:stopPropagation>
            <div class="sn-modal-h">
                <div>
                    <div class="sn-modal-eyebrow">Archivar</div>
                    <h3>@_archivarNombre</h3>
                </div>
                <button class="sn-modal-x" @onclick="CerrarArchivar">&times;</button>
            </div>
            <div class="sn-modal-b">
                @if (_archivarErr is not null) { <div class="ase-alert">@_archivarErr</div> }
                <p style="font-size:13px;">
                    El snapshot queda archivado pero <b>no se elimina</b>. Sigue consultable
                    en la tab Archivados con el motivo capturado.
                </p>
                <div class="ase-f">
                    <label>Motivo del archivado * <small class="text-muted">(min 10 caracteres)</small></label>
                    <textarea class="form-control form-control-sm" rows="4"
                              @bind="_archivarMotivo"
                              placeholder="Ej: Se regenero con filtros corregidos y este quedo obsoleto..."></textarea>
                </div>
            </div>
            <div class="sn-modal-f">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarArchivar">Cancelar</button>
                <button class="btn btn-danger btn-sm" @onclick="ConfirmarArchivar" disabled="@_archivando">
                    @(_archivando ? "Archivando..." : "Archivar")
                </button>
            </div>
        </div>
    </div>
}

@* ============ Modal Historial de cambios ============ *@
@if (_showHistorial)
{
    <div class="sn-modal-back" @onclick="CerrarHistorial">
        <div class="sn-modal sn-modal-lg" @onclick:stopPropagation="true">
            <div class="sn-modal-h">
                <div>
                    <div class="sn-modal-eyebrow">Auditoria</div>
                    <h3>Historial de cambios manuales</h3>
                </div>
                <button class="sn-modal-x" @onclick="CerrarHistorial">&times;</button>
            </div>
            <div class="sn-modal-b">
                @if (_historial.Count == 0)
                {
                    <div class="sn-empty">Sin cambios manuales en este snapshot.</div>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Fila</th>
                                <th>Columna</th>
                                <th>Antes</th>
                                <th>Despues</th>
                                <th>Motivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _historial)
                            {
                                <tr>
                                    <td class="sn-mono">@c.Fecha.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="sn-td-num">@c.NumeroFila</td>
                                    <td>@c.ColumnaOriginal</td>
                                    <td><em>@(string.IsNullOrEmpty(c.ValorAntes) ? "(vacio)" : c.ValorAntes)</em></td>
                                    <td><strong>@(string.IsNullOrEmpty(c.ValorDespues) ? "(vacio)" : c.ValorDespues)</strong></td>
                                    <td>@(c.Motivo ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="sn-modal-f">
                <span></span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarHistorial">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ============ Modal Configurar columnas ============ *@
@if (_showColConfig)
{
    <div class="sn-modal-back" @onclick="CerrarColConfig">
    <div class="sn-modal sn-modal-fcc" @onclick:stopPropagation="true">
        <div class="sn-modal-h">
            <b>Configurar columnas del archivo</b>
            <button class="sn-close" @onclick="CerrarColConfig">x</button>
        </div>
        <div class="sn-modal-b">
            <p style="margin:0 0 10px;color:#475569;font-size:13px;">
                Reordena arrastrando con las flechas, apaga el visto para ocultar la columna
                en el archivo, o escribe un alias para cambiar el titulo del encabezado. Aplica
                a TODOS los snapshots nuevos y descargas del tipo seleccionado.
            </p>
            <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;">
                <label style="font-size:12px;color:#475569;">Tipo:</label>
                <select class="form-control form-control-sm" style="max-width:280px;" value="@_colConfigTipo" @onchange="OnCambiarTipoColConfig" disabled="@_colConfigCargando">
                    @foreach (var t in _tiposDisponibles)
                    {
                        <option value="@t.ToString()">@NombreTipoSnapshot(t)</option>
                    }
                </select>
                @if (_colConfigCargando)
                {
                    <span style="color:#94a3b8;font-size:12px;">Cargando...</span>
                }
            </div>

            @if (_colConfigErr is not null) { <div class="ase-alert">@_colConfigErr</div> }

            <div class="fcc-tablewrap">
                <table class="fcc-table">
                    <thead>
                        <tr>
                            <th class="fcc-c-move">Orden</th>
                            <th class="fcc-c-vis">Visible</th>
                            <th class="fcc-c-err">Error</th>
                            <th class="fcc-c-name">Columna original</th>
                            <th class="fcc-c-alias">Alias (header en archivo)</th>
                            <th class="fcc-c-desc">Descripcion</th>
                            <th class="fcc-c-ruta">Ruta origen</th>
                            <th class="fcc-c-fmt">Formato de salida</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _colConfigItems.Count; i++)
                        {
                            var idx = i;
                            var it = _colConfigItems[idx];
                            <tr class="@(it.Visible ? "" : "fcc-off") @(it.EnError ? "fcc-err" : "")">
                                <td class="fcc-c-move">
                                    <div class="fcc-move">
                                        <button class="fcc-arr" title="Subir" disabled="@(idx == 0)" @onclick="() => SubirColConfig(idx)">^</button>
                                        <button class="fcc-arr" title="Bajar" disabled="@(idx == _colConfigItems.Count - 1)" @onclick="() => BajarColConfig(idx)">v</button>
                                    </div>
                                </td>
                                <td class="fcc-c-vis">
                                    <input type="checkbox" checked="@it.Visible" @onchange="e => ToggleColConfig(idx, (bool)e.Value!)" />
                                </td>
                                <td class="fcc-c-err">
                                    <input type="checkbox" title="Marcar esta columna como en error" checked="@it.EnError" @onchange="e => SetErrorColConfig(idx, (bool)e.Value!)" />
                                </td>
                                <td class="fcc-c-name" title="@it.ColumnaOriginal">@it.ColumnaOriginal</td>
                                <td class="fcc-c-alias">
                                    <input class="form-control form-control-sm" placeholder="@it.ColumnaOriginal"
                                           value="@(it.Alias ?? "")" @oninput="e => SetAliasColConfig(idx, e.Value?.ToString())" />
                                </td>
                                <td class="fcc-c-desc">
                                    <textarea class="form-control form-control-sm fcc-desc-ta" rows="2" placeholder="Que significa este campo..."
                                              @oninput="e => SetDescripcionColConfig(idx, e.Value?.ToString())">@(it.Descripcion ?? "")</textarea>
                                </td>
                                <td class="fcc-c-ruta">
                                    <input class="form-control form-control-sm" placeholder="Paciente.NumeroDocumento"
                                           value="@(it.RutaOrigen ?? "")" @oninput="e => SetRutaOrigenColConfig(idx, e.Value?.ToString())" />
                                </td>
                                <td class="fcc-c-fmt">
                                    <select class="form-control form-control-sm" value="@it.FormatoTipo.ToString()"
                                            @onchange="e => SetFormatoColConfig(idx, e.Value?.ToString())">
                                        <option value="General">General (sin formato)</option>
                                        <option value="Texto">Texto</option>
                                        <option value="NumeroEntero">Numero entero (1.234)</option>
                                        <option value="NumeroDecimal">Numero con decimales (1.234,56)</option>
                                        <option value="Moneda">Moneda ($ 1.234,56)</option>
                                        <option value="Porcentaje">Porcentaje (12,00%)</option>
                                        <option value="Fecha">Fecha (dd/mm/aaaa)</option>
                                        <option value="FechaHora">Fecha y hora (dd/mm/aaaa hh:mm)</option>
                                        <option value="FechaIso">Fecha ano adelante (aaaa/mm/dd)</option>
                                        <option value="FechaHoraIso">Fecha y hora ano adelante (aaaa/mm/dd hh:mm)</option>
                                        <option value="Personalizado">Personalizado...</option>
                                    </select>
                                    @if (it.FormatoTipo == Visal.Domain.Enums.SnapshotColumnaFormato.Personalizado)
                                    {
                                        <input class="form-control form-control-sm" style="margin-top:4px;" placeholder="Patron Excel, ej. dd/mm/yyyy o #,##0.00"
                                               value="@(it.FormatoPatron ?? "")" @oninput="e => SetFormatoPatronColConfig(idx, e.Value?.ToString())" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_colConfigItems.Count == 0)
                {
                    <div class="ase-empty">Este tipo no expone columnas todavia.</div>
                }
            </div>
        </div>
        <div class="sn-modal-f" style="justify-content:space-between;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button class="btn btn-outline-danger btn-sm" @onclick="ResetColConfig" disabled="@_colConfigGuardando">Restaurar defaults</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ExportarColConfigJsonAsync" disabled="@(_colConfigGuardando || _colConfigItems.Count == 0)"
                        title="Descarga un JSON con alias, descripcion, ruta origen, formato y marca de error de cada columna. NO incluye orden ni visible.">&#128190; Exportar JSON</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ImportarColConfigJsonClickAsync" disabled="@_colConfigGuardando"
                        title="Aplica un JSON exportado: actualiza alias / descripcion / ruta / formato / marca de error de las columnas que coincidan por nombre. NO crea ni elimina columnas. Revisa y pulsa Guardar.">&#128228; Importar JSON</button>
                <InputFile id="fccImportJsonInput" OnChange="OnImportColConfigJsonFileAsync" accept=".json,application/json" style="display:none" />
            </div>
            <div style="display:flex;gap:8px;">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarColConfig">Cancelar</button>
                <button class="btn btn-primary btn-sm" @onclick="GuardarColConfig" disabled="@(_colConfigGuardando || _colConfigItems.Count == 0)">
                    @(_colConfigGuardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
    </div>
}

<style>
    .sn-card { padding:0; overflow:hidden; }
    .sn-tabs { display:flex; border-bottom:1px solid var(--border); }
    .sn-tab { background:transparent; border:0; padding:12px 20px; font-size:13px; color:#475569; cursor:pointer; border-bottom:2px solid transparent; font-weight:500; }
    .sn-tab:hover { color:var(--primary); }
    .sn-tab.sel { color:var(--primary); border-bottom-color:var(--primary); font-weight:600; }
    .sn-tab-count { color:#64748b; font-weight:400; }

    .sn-filtros { display:flex; gap:12px; padding:14px 18px; border-bottom:1px solid var(--border); flex-wrap:wrap; }
    .sn-f { display:flex; flex-direction:column; gap:4px; min-width:160px; }
    .sn-f label { font-size:11px; color:#334155; text-transform:uppercase; letter-spacing:0.5px; font-weight:600; }

    .sn-empty { padding:40px; text-align:center; color:var(--muted); font-size:14px; }
    .sn-tabla-wrap { overflow:auto; }
    .sn-tabla { margin:0; }
    .sn-tabla th { background:#f8fafc; font-size:12px; text-transform:uppercase; letter-spacing:0.4px; color:#334155; padding:10px 12px; border-bottom:1px solid var(--border); }
    .sn-tabla td { padding:10px 12px; vertical-align:middle; font-size:13px; }
    .sn-th-num, .sn-td-num { text-align:right; }
    .sn-th-acc, .sn-td-acc { white-space:nowrap; }
    .sn-mono { font-family:'JetBrains Mono','Consolas',monospace; font-size:12px; color:#475569; }
    .sn-truncate { max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .sn-error-inline { color:#c0392b; font-size:12px; margin-top:2px; }

    .sn-tag { background:#eff6ff; color:#1e40af; padding:2px 8px; border-radius:12px; font-size:11px; font-weight:600; }
    .sn-estado { padding:3px 10px; border-radius:12px; font-size:11px; font-weight:600; }
    .sn-estado-ejecutando { background:#fef3c7; color:#92400e; }
    .sn-estado-vigente { background:#dcfce7; color:#166534; }
    .sn-estado-archivado { background:#e2e8f0; color:#475569; }
    .sn-estado-fallido { background:#fee2e2; color:#991b1b; }

    /* Modal */
    .sn-modal-back { position:fixed; inset:0; background:rgba(15,23,42,0.55); z-index:1050; display:flex; align-items:center; justify-content:center; padding:16px; }
    .sn-modal { background:white; border-radius:10px; box-shadow:0 20px 60px rgba(0,0,0,0.3); display:flex; flex-direction:column; width:100%; overflow:hidden; }
    .sn-modal-sm { max-width:520px; }
    .sn-modal-md { max-width:720px; }
    /* Modal Nuevo Snapshot: layout limpio en columna con filas 2-col
       para campos cortos. El grid propio evita heredar el 4-col de
       .ase-form (definido en CfgAseguradoras.razor.css) que apretaba
       los campos en 4 columnas del ancho del modal. */
    .sn-modal-nuevo { max-width:640px; }
    .snf-form { display:grid; grid-template-columns:1fr; gap:14px; }
    .snf-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .snf-f { display:flex; flex-direction:column; gap:4px; min-width:0; }
    .snf-f > label { font-size:12px; font-weight:600; color:#334155; }
    .snf-f > label small { font-weight:400; color:#64748b; margin-left:4px; }
    .sn-modal-xl { max-width:96vw; max-height:92vh; }
    .sn-modal-h { padding:16px 20px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:flex-start; background:#ffffff; }
    .sn-modal-h h3 { margin:0; font-size:18px; font-weight:700; color:#0f172a; }
    .sn-modal-h h3 small { color:#475569; font-weight:500; }
    .sn-modal-h > div > div[style] { color:#475569 !important; }
    .sn-modal-h > div > div[style] b { color:#0f172a; }
    .sn-modal-eyebrow { font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#64748b; font-weight:600; margin-bottom:4px; }
    .sn-modal-x { background:transparent; border:0; font-size:24px; color:var(--muted); cursor:pointer; padding:0 4px; }
    .sn-modal-b { padding:18px 20px; overflow:auto; flex:1; }
    .sn-modal-b-tabla { padding:0; }
    /* Sub-tabs dentro del modal de detalle */
    .sn-tabs-modal { padding:0 20px; border-bottom:1px solid var(--border); background:#fff; }
    .sn-tip-body { display:flex; flex-direction:column; gap:12px; }
    .sn-tip-head { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; padding:10px 12px; background:#f8fafc; border:1px solid var(--border); border-radius:8px; font-size:13px; }
    .sn-tip-kpis { display:flex; gap:6px; align-items:center; }
    .sn-tip-relanzar { margin-left:6px; }
    .sn-tip-kpi { background:#eef2ff; color:#4338ca; border-radius:999px; padding:2px 10px; font-size:12px; font-weight:600; }
    .sn-tip-section-t { font-weight:700; color:#0f172a; font-size:13px; margin-top:4px; }
    .sn-tip-gen { font-size:11.5px; color:#64748b; margin-top:3px; }
    .sn-tip-archivos { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:12px; }
    .sn-tip-arch { border:1px solid var(--border); border-radius:10px; background:#fff; overflow:hidden; box-shadow:0 1px 2px rgba(15,23,42,.04); transition:box-shadow .12s, border-color .12s; }
    .sn-tip-arch:hover { box-shadow:0 6px 18px rgba(99,102,241,.14); border-color:#c7d2fe; }
    .sn-tip-arch.abierto { box-shadow:0 6px 18px rgba(99,102,241,.16); border-color:#a5b4fc; }
    .sn-tip-arch.vacio { background:#fcfcfd; }
    .sn-tip-arch-h { display:flex; align-items:center; gap:12px; width:100%; min-height:78px; text-align:left; background:none; border:none; padding:16px 14px; cursor:pointer; font:inherit; }
    .sn-tip-arch-h:hover { background:#f8fafc; }
    .sn-tip-arch-ico { flex:0 0 auto; width:42px; height:42px; border-radius:10px; display:inline-flex; align-items:center; justify-content:center; background:#eef2ff; color:#4f46e5; }
    .sn-tip-arch.vacio .sn-tip-arch-ico { background:#f1f5f9; color:#94a3b8; }
    .sn-tip-arch-main { display:flex; flex-direction:column; gap:3px; min-width:0; flex:1 1 auto; }
    .sn-tip-arch-sub { display:flex; align-items:center; gap:6px; }
    .sn-tip-arch-caret { color:#6366f1; font-size:11px; width:12px; flex:0 0 auto; }
    .sn-tip-arch-count { flex:0 0 auto; display:flex; flex-direction:column; align-items:center; line-height:1.05; background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; border-radius:8px; padding:4px 9px; min-width:56px; }
    .sn-tip-arch-count b { font-size:15px; }
    .sn-tip-arch-count .den { font-size:10px; color:#059669; opacity:.85; }
    .sn-tip-arch-count .lbl { font-size:8.5px; text-transform:uppercase; letter-spacing:.02em; margin-top:1px; }
    .sn-tip-arch-count.cero { background:#fef2f2; color:#b91c1c; border-color:#fecaca; }
    .sn-tip-arch-count.cero .den { color:#dc2626; }
    .sn-tip-arch-body { padding:0 10px 10px 28px; display:flex; flex-direction:column; gap:6px; }
    .sn-tip-arch-name { font-weight:700; color:#0f172a; font-size:13.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sn-tip-arch-code { background:#f1f5f9; color:#475569; border-radius:4px; padding:1px 6px; font-size:11px; }
    .sn-tip-badge { background:#dbeafe; color:#1e40af; border-radius:4px; padding:1px 6px; font-size:10px; font-weight:700; }
    .sn-tip-arch-cont { display:flex; flex-wrap:wrap; gap:4px; }
    .sn-tip-chip { background:#eef2ff; color:#4338ca; border-radius:4px; padding:2px 7px; font-size:11px; font-weight:600; }
    .sn-tip-arch-pat { font-size:11px; color:#64748b; background:#f8fafc; border-radius:4px; padding:3px 6px; word-break:break-all; }
    .sn-tip-pacwrap { border:1px solid var(--border); border-radius:8px; overflow:auto; }
    .sn-tip-pactbl { width:100%; border-collapse:collapse; font-size:12.5px; }
    .sn-tip-pactbl th { text-align:left; background:#f8fafc; padding:8px 10px; border-bottom:1px solid var(--border); position:sticky; top:0; }
    .sn-tip-pactbl td { padding:8px 10px; border-bottom:1px solid #eef2f7; vertical-align:top; }
    .sn-tip-files { display:flex; flex-direction:column; gap:3px; }
    .sn-tip-file { background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; border-radius:4px; padding:2px 6px; font-size:11px; width:fit-content; }
    .sn-tip-note { font-size:11.5px; color:#64748b; font-style:italic; }
    .sn-tip-scope { font-size:12px; color:#1e3a8a; background:#eff6ff; border-left:3px solid #2563eb; border-radius:4px; padding:6px 10px; margin-top:-2px; }
    .sn-tip-body .mono, .sn-tip-arch .mono, .sn-tip-file.mono, .sn-tip-arch-code.mono, .sn-arch-modal .mono { font-family: ui-monospace, "Cascadia Mono", "Fira Code", Menlo, monospace; }
    .sn-tip-arch-foot { padding:8px 10px; border-top:1px solid #eef2f7; background:#fafcff; }
    .sn-tip-dl { width:100%; display:inline-flex; align-items:center; justify-content:center; gap:6px; background:#059669; border:1px solid #059669; color:#fff; font-weight:600; }
    .sn-tip-dl:hover { background:#047857; border-color:#047857; color:#fff; }
    .sn-tip-dl.off { background:#f1f5f9; border-color:#e2e8f0; color:#94a3b8; }
    .sn-tip-dl.off:hover { background:#e2e8f0; color:#64748b; }
    .sn-tip-dl { width:100%; }
    .sn-tip-dl:disabled { opacity:.85; cursor:progress; }
    .sn-zip-spin { width:12px; height:12px; border:2px solid rgba(255,255,255,.45); border-top-color:#fff; border-radius:50%; display:inline-block; animation:snZipSpin .7s linear infinite; }
    @@keyframes snZipSpin { to { transform:rotate(360deg); } }
    /* Modal de contenido del archivo (por encima del modal Ver) */
    .sn-arch-modal-back { position:fixed; inset:0; background:rgba(15,23,42,.55); z-index:1200; display:flex; align-items:center; justify-content:center; padding:20px; }
    .sn-arch-modal { background:#fff; border-radius:10px; max-width:780px; width:100%; box-shadow:0 24px 64px rgba(0,0,0,.35); display:flex; flex-direction:column; max-height:88vh; overflow:hidden; }
    .sn-arch-pacwrap { max-height:42vh; }
    .sn-arch-modal-h { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; padding:14px 18px; border-bottom:1px solid var(--border); }
    .sn-arch-modal-h h3 { font-size:16px; }
    .sn-arch-modal-b { padding:16px 18px; overflow:auto; display:flex; flex-direction:column; gap:14px; }
    .sn-arch-modal-f { padding:12px 18px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; gap:8px; background:#f8fafc; }
    .sn-arch-field { display:flex; flex-direction:column; gap:6px; }
    .sn-arch-label { font-size:12px; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:.03em; }
    .sn-arch-cont-list { margin:0; padding-left:18px; display:flex; flex-direction:column; gap:6px; font-size:13px; color:#0f172a; }
    .sn-arch-pend { margin-left:6px; background:#fef3c7; color:#92400e; border-radius:4px; padding:1px 6px; font-size:11px; font-weight:600; }
    .sn-arch-warn { font-size:12px; color:#8a6d3b; background:#fff8e1; border:1px solid #f0d47a; border-radius:6px; padding:8px 10px; }
    .sn-modal-f { padding:12px 20px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; align-items:center; gap:8px; }
    .sn-modal-controls { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:12px 20px; border-bottom:1px solid var(--border); background:#f8fafc; flex-wrap:wrap; }
    .sn-modal-controls-l, .sn-modal-controls-r { display:flex; align-items:center; gap:8px; }
    /* Barra bulk-fill del N° factura. Estilo tenue para no competir con la tabla. */
    .sn-bulk-bar { display:flex; align-items:center; gap:8px; padding:8px 20px; background:#f0f9ff; border-bottom:1px solid #bae6fd; flex-wrap:wrap; }
    .sn-bulk-bar > label { font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#0369a1; font-weight:600; margin:0; }
    .sn-bulk-bar small { font-size:11px; color:#64748b; }
    .sn-modal-controls label { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; }
    .sn-page-info { font-size:12px; color:var(--muted); margin-right:8px; }

    /* Tabla del modal grande: sticky header + freeze cols */
    .sn-vertabla-toptrack { overflow-x:auto; overflow-y:hidden; border-bottom:1px solid #e2e8f0; }
    .sn-vertabla-topspacer { height:1px; }
    .sn-vertabla-wrap { overflow:auto; max-height:calc(92vh - 240px); }
    .sn-vertabla { border-collapse:separate; border-spacing:0; font-size:12px; width:auto; min-width:100%; }
    .sn-vertabla th, .sn-vertabla td { padding:6px 10px; border-right:1px solid #e2e8f0; border-bottom:1px solid #e2e8f0; min-width:140px; max-width:280px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sn-vertabla th { position:sticky; top:0; z-index:2; background:#eff6ff; font-weight:600; color:#1e3a8a; text-transform:none; letter-spacing:0; cursor:pointer; user-select:none; }
    .sn-vertabla th:hover { background:#dbeafe; }
    .sn-vt-freeze { position:sticky; background:white; z-index:1; box-sizing:border-box; }
    /* Columna contador "Nº": fija a la izquierda, centrada, tenue. */
    .sn-vt-counter { text-align:center; color:#64748b; font-variant-numeric:tabular-nums; background:#f8fafc; box-sizing:border-box; border-right:2px solid #e2e8f0; }
    .sn-vertabla thead .sn-vt-counter { z-index:3; background:#eff6ff; color:#1e3a8a; }
    .sn-vertabla thead .sn-vt-freeze { z-index:3; background:#eff6ff; }
    /* Ultima columna fijada: divisor claro para separar del area que se desplaza. */
    .sn-vt-freeze.sn-vt-freeze-last { border-right:2px solid #93c5fd; }
    /* Menu contextual de fila (click derecho). */
    .sn-rowmenu-back { position:fixed; inset:0; z-index:3000; }
    .sn-rowmenu { position:fixed; z-index:3001; background:#fff; border:1px solid var(--border); border-radius:8px; box-shadow:0 8px 28px rgba(0,0,0,.20); padding:6px; min-width:180px; display:flex; flex-direction:column; gap:2px; }
    .sn-rowmenu-item { width:100%; text-align:left; border:none; background:transparent; padding:8px 10px; border-radius:6px; font-size:13px; color:#0f172a; cursor:pointer; }
    .sn-rowmenu-item:hover { background:#eff6ff; }
    .sn-rowmenu-sep { height:1px; background:var(--border); margin:4px 2px; }
    .sn-rowmenu-colors { display:flex; gap:6px; padding:4px 8px 6px; }
    .sn-rowmenu-swatch { width:22px; height:22px; border-radius:50%; border:1px solid rgba(0,0,0,.15); cursor:pointer; padding:0; transition:transform .08s; }
    .sn-rowmenu-swatch:hover { transform:scale(1.15); box-shadow:0 0 0 2px #dbeafe; }
    /* Filtro por color. */
    .sn-cf-btn { border:1px solid #cbd5e1; background:#fff; color:#334155; border-radius:6px; padding:2px 10px; font-size:12px; cursor:pointer; }
    .sn-cf-btn:hover { background:#f1f5f9; }
    .sn-cf-btn.on { border-color:#2563eb; background:#dbeafe; color:#1e3a8a; font-weight:600; }
    .sn-cf-swatch { width:20px; height:20px; border-radius:50%; border:1px solid rgba(0,0,0,.15); cursor:pointer; padding:0; }
    .sn-cf-swatch:hover { transform:scale(1.12); }
    .sn-cf-swatch.on { outline:2px solid #2563eb; outline-offset:1px; }
    .sn-vertabla tbody tr:nth-child(even) td:not(.sn-vt-freeze) { background:#fafbfc; }
    .sn-vertabla tbody tr:nth-child(even) td.sn-vt-freeze { background:#fafbfc; }
    /* Encabezado: contenido en fila (pin + titulo + indicador de orden). */
    .sn-th-inner { display:inline-flex; align-items:center; gap:5px; }
    /* Chincheta de fijado por columna. Tenue por defecto; resaltada cuando la columna esta fijada. */
    .sn-pin { border:none; background:transparent; padding:2px; margin:0; line-height:0; cursor:pointer; border-radius:4px; color:#94a3b8; display:inline-flex; }
    .sn-pin:hover { background:#dbeafe; color:#1d4ed8; }
    .sn-pin.on { color:#1d4ed8; }
    .sn-pin.on svg { transform:rotate(-2deg); }
    .sn-modal-hint { font-size:11.5px; color:#64748b; }

    /* F4b: multi-check de sucursales en el modal Nuevo. */
    .sn-multi { display:flex; flex-wrap:wrap; gap:6px; padding:8px; border:1px solid var(--border); border-radius:6px; background:#fafbfc; max-height:120px; overflow-y:auto; }
    .sn-multi-chip { display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:14px; background:white; border:1px solid var(--border); font-size:12px; cursor:pointer; user-select:none; margin:0; }
    .sn-multi-chip:hover { background:#eff6ff; border-color:#93c5fd; }
    .sn-multi-chip input { margin:0; cursor:pointer; }

    /* Modal grande para el editor de columnas. */
    .sn-modal-lg { max-width:960px; width:96%; }

    /* Editor columnas del snapshot: filas apiladas verticales con handle, toggle, alias. */
