    private async Task Descargar(string fileName, string mime, byte[] bytes)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $@"
            (function(){{
                try {{
                    var bin = atob('{base64}');
                    var len = bin.length;
                    var arr = new Uint8Array(len);
                    for (var i = 0; i < len; i++) {{ arr[i] = bin.charCodeAt(i); }}
                    var blob = new Blob([arr], {{ type: '{mime}' }});
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url; a.download = '{fileName}';
                    document.body.appendChild(a); a.click(); a.remove();
                    setTimeout(function(){{ URL.revokeObjectURL(url); }}, 1500);
                }} catch (e) {{ console.error('descarga reporte', e); }}
            }})();");
    }

    // ===== view models del editor =====

    private sealed class HojaEdit
    {
        public string Nombre { get; set; } = "";
        public string EntidadKey { get; set; } = "";
        public string Modo { get; set; } = "Detalle";
        public List<ColSel> Columnas { get; set; } = new();
        public List<ColSel> GroupBy { get; set; } = new();
        public List<AggEdit> Agregados { get; set; } = new();
        public List<FiltroEdit> Filtros { get; set; } = new();
        public string? OrdenRef { get; set; } = "";
        public bool OrdenDesc { get; set; }
        public bool PivotOn { get; set; }
        public string? PivotFila { get; set; } = "";
        public string? PivotColumna { get; set; } = "";

        public static HojaEdit Desde(ReporteHojaDef d)
        {
            var h = new HojaEdit
            {
                Nombre = d.Nombre,
                EntidadKey = d.EntidadKey,
                Modo = d.Modo.ToString(),
                Columnas = d.Columnas.Select(c => new ColSel { Ref = c.CampoRef, Titulo = c.Titulo ?? "", Formato = c.Formato }).ToList(),
                GroupBy = d.GroupBy.Select(c => new ColSel { Ref = c.CampoRef }).ToList(),
                Agregados = d.Agregados.Select(a => new AggEdit { Func = a.Func, CampoRef = a.CampoRef ?? "", Titulo = a.Titulo ?? "" }).ToList(),
                Filtros = d.Filtros.Select(f => new FiltroEdit { CampoRef = f.CampoRef, Op = f.Op, Valor = f.Valores is null ? "" : string.Join(", ", f.Valores), ParamClave = f.ParamClave ?? "" }).ToList(),
            };
            var o = d.Orden.FirstOrDefault();
            if (o is not null) { h.OrdenRef = o.CampoRef; h.OrdenDesc = o.Desc; }
            if (d.Pivote is not null)
            {
                h.PivotOn = true;
                h.PivotFila = d.Pivote.FilaCampoRef;
                h.PivotColumna = d.Pivote.ColumnaCampoRef;
            }
            return h;
        }
    }

    private sealed class ColSel { public string Ref { get; set; } = ""; public string Titulo { get; set; } = ""; public ReporteColumnaFormato Formato { get; set; } = ReporteColumnaFormato.Auto; }
    private sealed class FiltroEdit { public string CampoRef { get; set; } = ""; public ReporteFiltroOp Op { get; set; } = ReporteFiltroOp.Eq; public string? Valor { get; set; } = ""; public string ParamClave { get; set; } = ""; }
    private sealed class AggEdit { public ReporteAgregadoFunc Func { get; set; } = ReporteAgregadoFunc.Count; public string CampoRef { get; set; } = ""; public string Titulo { get; set; } = ""; }

    // Parametro de ejecucion en el editor (global del reporte). La Clave es estable (se genera
    // al crearlo) para que el enlace desde los filtros no se rompa aunque cambien la Etiqueta.
    private sealed class ParamEdit
    {
        public string Clave { get; set; } = "";
        public string Etiqueta { get; set; } = "";
        public ReporteParametroTipo Tipo { get; set; } = ReporteParametroTipo.RangoFecha;
        public ReporteParametroFuente Fuente { get; set; } = ReporteParametroFuente.Ninguna;
    }

    // Parametro que se captura en el dialogo de descarga.
    private sealed class RunParam
    {
        public string Clave { get; set; } = "";
        public string Etiqueta { get; set; } = "";
        public ReporteParametroTipo Tipo { get; set; }
        public ReporteParametroFuente Fuente { get; set; }
        public string? Valor1 { get; set; }
        public string? Valor2 { get; set; }

        // Valores a enviar (vacio = no filtrar por este parametro en esta corrida).
        public IReadOnlyList<string> Valores()
        {
            if (Tipo == ReporteParametroTipo.RangoFecha)
            {
                return (!string.IsNullOrWhiteSpace(Valor1) && !string.IsNullOrWhiteSpace(Valor2))
                    ? new[] { Valor1!, Valor2! } : Array.Empty<string>();
            }
            if (Tipo == ReporteParametroTipo.Lista && Fuente == ReporteParametroFuente.Ninguna)
            {
                return (Valor1 ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            }
            return string.IsNullOrWhiteSpace(Valor1) ? Array.Empty<string>() : new[] { Valor1! };
        }
    }
