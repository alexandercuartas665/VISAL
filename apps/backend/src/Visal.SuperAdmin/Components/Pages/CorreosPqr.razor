.ep-card-foot { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.25rem; padding-top:.55rem; border-top:1px solid #f1f5f9; }
.ep-btn { background:#fff; color:#334155; border:1px solid #cbd5e1; padding:.4rem .75rem; border-radius:6px; cursor:pointer; font:inherit; }
.ep-btn:disabled { opacity:.5; cursor:not-allowed; }
.ep-btn-sm { padding:.25rem .55rem; font-size:.78rem; }
