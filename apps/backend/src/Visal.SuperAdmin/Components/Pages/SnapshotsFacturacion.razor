    // ---------- Export / Import JSON de la config de columnas ----------
    // Update-only: exporta e importa SOLO de "alias en adelante" (alias, descripcion,
    // ruta origen, formato) + la marca de error. NO incluye orden ni visible, y NO crea
    // ni elimina columnas: es una actualizacion por nombre de columna original.

    private sealed record ColConfigJson(
        string ColumnaOriginal,
        string? Alias,
        string? Descripcion,
        string? RutaOrigen,
        string FormatoTipo,
        string? FormatoPatron,
        bool EnError);

    private async Task ExportarColConfigJsonAsync()
    {
        if (_colConfigItems.Count == 0) { return; }
        try
        {
            var payload = _colConfigItems.Select(it => new ColConfigJson(
                it.ColumnaOriginal, it.Alias, it.Descripcion, it.RutaOrigen,
                it.FormatoTipo.ToString(), it.FormatoPatron, it.EnError)).ToList();
            var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
            var name = $"config-columnas-{_colConfigTipo}.json";
            await JS.InvokeVoidAsync("snapFccDescargarJson", name, json);
            _ok = $"Config de columnas exportada ({payload.Count} columnas).";
        }
        catch (Exception ex) { _colConfigErr = "No se pudo exportar: " + ex.Message; }
    }

