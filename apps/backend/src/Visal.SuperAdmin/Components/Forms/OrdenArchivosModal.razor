@using Microsoft.AspNetCore.Components.Forms
@using Visal.Application.Tenancy
@inject INotaMedicaService NotaSvc
@inject ITipologiaArchivoService TipSvc
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

@*
   Modal de archivos del paciente lanzado desde el menu de acciones de /ordenes.
   - Sube archivos por DRAG & DROP (o click) y los tipifica con el catalogo
     Tipologia Archivos. Cada archivo queda ligado a la HC actual + al paciente
     (via NotaSvc.AdjuntarDocumentoHcAsync), asi tambien se ven en Admision.
   - Vista GALERIA o TABLA de "Archivos de esta HC" y "Documentos del paciente".
   - Visor embebido de imagenes (<img>) y PDF (<iframe>) sin salir del sistema.
   Editar (tipologia/subcategoria/fecha/observacion) y eliminar se ofrecen en AMBOS
   tabs para los documentos editables (NotaMedicaId null: adjuntos directos, externos
   de la HC y firmas del paciente). Los anexos de una nota medica no se editan aqui
   (el backend lo protege igual).
*@

<div class="oa-back" @onclick="Cerrar"></div>
<div class="oa-modal" @onclick:stopPropagation="true">
    <div class="oa-head">
        <div class="oa-head-t">
            <div class="oa-eyebrow">Archivos del paciente</div>
            <h3 class="oa-title">@PacienteNombre</h3>
            <div class="oa-sub">Se adjuntan a esta historia clinica y se ven tambien en Admision.</div>
        </div>
        <button type="button" class="oa-close" @onclick="Cerrar" title="Cerrar">&times;</button>
    </div>

    <div class="oa-body">
        <div class="oa-uprow">
            <div class="oa-drop @(_dragOver ? "over" : "") @(_subiendo ? "busy" : "")"
                 @ondragenter="() => _dragOver = true"
                 @ondragleave="() => _dragOver = false"
                 @ondragover:preventDefault="true"
                 @ondrop:preventDefault="true"
                 @ondrop="() => _dragOver = false">
                <InputFile OnChange="OnFilesSelected" multiple class="oa-drop-input"
                           accept=".pdf,.png,.jpg,.jpeg,.webp,.gif,.docx,.xlsx,.pptx" />
                <div class="oa-drop-inner">
                    <span class="oa-drop-ic">&#128228;</span>
                    <div class="oa-drop-txt"><b>Arrastra archivos aqui</b> o haz click para elegir</div>
                    <small class="oa-drop-hint">Imagenes, PDF y Office &middot; hasta 20 MB c/u &middot; varios a la vez</small>
                    @if (_subiendo) { <div class="oa-drop-busy">Subiendo @(_subiendoN)&hellip;</div> }
                </div>
            </div>
            <div class="oa-upmeta">
                <label class="oa-lbl">Tipologia</label>
                <select class="form-select form-select-sm" value="@_categoria" @onchange="OnCategoriaChanged" title="Se aplica a los archivos que subas ahora">
                    <option value="">&mdash; Sin tipologia &mdash;</option>
                    @foreach (var t in _tipologias) { <option value="@t.Nombre">@t.Nombre</option> }
                </select>
                @if (_tipologias.Count == 0)
                {
                    <small class="text-muted">Configura tipologias en <em>Tipologia Archivos</em>.</small>
                }
                @if (SubcatsDe(_categoria).Count > 0)
                {
                    <label class="oa-lbl">Subcategoria</label>
                    <select class="form-select form-select-sm" @bind="_subcategoria" title="Subcategoria del proximo archivo">
                        <option value="">&mdash; Sin subcategoria &mdash;</option>
                        @foreach (var s in SubcatsDe(_categoria)) { <option value="@s.Nombre">@s.Nombre</option> }
                    </select>
                }
                <label class="oa-lbl">Anotaciones</label>
                <input type="text" class="form-control form-control-sm" placeholder="opcional"
                       @bind="_anotaciones" @bind:event="oninput" />
                <small class="text-muted">Aplican a los archivos que sueltes ahora. La fecha del documento se toma de la fecha de atencion de la HC (editable despues).</small>
            </div>
        </div>

        @if (_msg is not null) { <div class="oa-msg">@_msg</div> }
        @if (_error is not null) { <div class="oa-err">@_error</div> }

        <div class="oa-toolbar">
            <div class="oa-tabs">
                <button type="button" class="oa-tab @(_grupo == "hc" ? "sel" : "")" @onclick='() => _grupo = "hc"'>
                    Archivos de esta HC <span class="oa-badge">@_docsHc.Count</span>
                </button>
                <button type="button" class="oa-tab @(_grupo == "pac" ? "sel" : "")" @onclick='() => _grupo = "pac"'>
                    Documentos del paciente <span class="oa-badge">@_docsPaciente.Count</span>
                </button>
            </div>
            <div class="oa-vtoggle">
                <button type="button" class="oa-vbtn @(_vista == "galeria" ? "sel" : "")" title="Galeria" @onclick='() => _vista = "galeria"'>&#9638;</button>
                <button type="button" class="oa-vbtn @(_vista == "tabla" ? "sel" : "")" title="Tabla" @onclick='() => _vista = "tabla"'>&#8803;</button>
            </div>
        </div>

        @{
            var esHcGrupo = _grupo == "hc";
            var lista = esHcGrupo ? _docsHc : _docsPaciente.Select(Proxy).ToList();
        }
        @if (lista.Count == 0)
        {
            <div class="oa-empty">
                @(esHcGrupo ? "Aun no hay archivos en esta HC. Arrastra el primero en la zona de arriba." : "El paciente no tiene documentos previos.")
            </div>
        }
        else if (_vista == "galeria")
        {
            <div class="oa-grid">
                @foreach (var d in lista) { @RenderCard(d) }
            </div>
        }
        else
        {
            <div class="oa-tblwrap">
                <table class="oa-table">
                    <thead>
                        <tr><th></th><th>Nombre</th><th>Tipologia</th><th>Fecha doc</th><th>Subido por</th><th>Tamano</th><th>Cargado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in lista)
                        {
                            <tr>
                                <td class="oa-tcell-ic">
                                    @if (EsImagen(d.TipoMime, d.NombreOriginal))
                                    {
                                        <img class="oa-tthumb" src="@d.RutaArchivo" alt="@d.NombreOriginal" @onclick="() => AbrirVisor(d)" />
                                    }
                                    else
                                    {
                                        <span class="oa-ticon" @onclick="() => AbrirVisor(d)">@IconoPara(d.NombreOriginal)</span>
                                    }
                                </td>
                                <td><span class="oa-tname" title="@d.NombreOriginal" @onclick="() => AbrirVisor(d)">@d.NombreOriginal</span></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(d.Categoria)) { <span class="oa-cat">@d.Categoria</span> }
                                    else { <span class="oa-cat oa-cat-empty">(sin tipologia)</span> }
                                    @if (!string.IsNullOrWhiteSpace(d.Subcategoria)) { <span class="oa-cat oa-subcat">@d.Subcategoria</span> }
                                </td>
                                <td class="oa-tmono">@(d.FechaDocumento is DateTimeOffset fd ? fd.ToOffset(Bog).ToString("dd/MM/yyyy") : "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(d.SubidoPor) ? "-" : d.SubidoPor)</td>
                                <td class="oa-tmono">@FormatoTamano(d.Tamano)</td>
                                <td class="oa-tmono">@d.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="oa-tacts">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => AbrirVisor(d)">Ver</button>
                                    @if (Editable(d))
                                    {
                                        <button class="btn btn-link btn-sm" title="Editar tipologia / subcategoria / fecha / observacion" @onclick="() => AbrirEditInline(d)">&#9998;</button>
                                        <button class="btn btn-link btn-sm text-danger" title="Eliminar" @onclick="() => EliminarAsync(d.Id, d.NombreOriginal)">&#128465;</button>
                                    }
                                </td>
                            </tr>
                            @if (_editDocId == d.Id)
                            {
                                <tr class="oa-editrow">
                                    <td colspan="8">@RenderEditForm(d)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ===== Visor embebido de imagen / PDF ===== *@
@if (_visorDoc is NotaDocumentoDto vd)
{
    <div class="oa-vis-back" @onclick="CerrarVisor"></div>
    <div class="oa-vis" @onclick:stopPropagation="true">
        <div class="oa-vis-head">
            <span class="oa-vis-name" title="@vd.NombreOriginal">@vd.NombreOriginal</span>
            <div class="oa-vis-acts">
                <a class="btn btn-sm btn-outline-secondary" href="@vd.RutaArchivo" target="_blank" rel="noopener">Descargar</a>
                <button type="button" class="oa-close" @onclick="CerrarVisor" title="Cerrar">&times;</button>
            </div>
        </div>
        <div class="oa-vis-body">
            @if (EsImagen(vd.TipoMime, vd.NombreOriginal))
            {
                <img class="oa-vis-img" src="@vd.RutaArchivo" alt="@vd.NombreOriginal" />
            }
            else if (EsPdf(vd.TipoMime, vd.NombreOriginal))
            {
                <iframe class="oa-vis-frame" src="@vd.RutaArchivo" title="@vd.NombreOriginal"></iframe>
            }
            else
            {
                <div class="oa-vis-otro">
                    <span class="oa-vis-otro-ic">@IconoPara(vd.NombreOriginal)</span>
                    <div>Este tipo de archivo no se previsualiza en el sistema.</div>
                    <a class="btn btn-primary btn-sm" href="@vd.RutaArchivo" target="_blank" rel="noopener">Abrir en pestana nueva</a>
                </div>
            }
        </div>
    </div>
}

