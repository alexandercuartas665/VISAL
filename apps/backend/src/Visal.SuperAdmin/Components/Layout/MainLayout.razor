@inherits LayoutComponentBase

<div class="visal-shell">
    <!-- Toggles solo-CSS. Funcionan en cualquier render mode. -->
    <!--   visal-nav-toggle:    abre/cierra el menu en movil (off-canvas). -->
    <!--   visal-nav-collapse:  colapsa el menu en escritorio (deja la pagina full width). -->
    <input type="checkbox" id="visal-nav-toggle" class="visal-nav-toggle" autocomplete="off" />
    <input type="checkbox" id="visal-nav-collapse" class="visal-nav-collapse" autocomplete="off" />

    <aside class="visal-sidebar">
        <!-- Boton para colapsar desde dentro del sidebar (anclado a la esquina sup. der.). -->
        <label for="visal-nav-collapse" class="visal-nav-collapse-btn" aria-label="Ocultar menu" title="Ocultar menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </label>
        <NavMenu />
    </aside>

    <!-- Capa oscura: al tocarla se cierra el menu (es un label del checkbox). -->
    <label for="visal-nav-toggle" class="visal-nav-overlay" aria-hidden="true"></label>

    <div class="visal-main">
        <div class="visal-topbar">
            <!-- Hamburguesa: en movil abre el menu off-canvas; en escritorio reaparece el menu colapsado. -->
            <label for="visal-nav-toggle" class="visal-hamburger visal-hamburger-mobile" aria-label="Abrir menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
            </label>
            <label for="visal-nav-collapse" class="visal-hamburger visal-hamburger-desktop" aria-label="Mostrar menu" title="Mostrar menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
            </label>
            <span class="visal-topbar-brand">Visal</span>

            <AuthorizeView>
                <Authorized>
                    <span class="visal-user-chip">@(context.User.FindFirst("platform_role") is not null ? "Operador" : "Agencia") · <strong>@context.User.Identity?.Name</strong></span>
                    <form method="post" action="/auth/logout" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Salir</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <AiQuotaBanner />

        <div class="visal-content">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

<script>
    // Cierra el menu movil al tocar un enlace de navegacion (complementa el cierre por overlay
    // y el reseteo en navegaciones de pagina completa).
    document.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('.visal-nav-link')) {
            var t = document.getElementById('visal-nav-toggle');
            if (t) t.checked = false;
        }
    });
</script>

<script>
    // Menu lateral: colapsar/expandir agrupadores (nativo <details>, estado en
    // localStorage) + buscador que filtra opciones por texto. Todo en JS puro
    // porque el sidebar se renderiza estatico (SSR): no hay circuito Blazor aca.
    (function () {
        var KEY = 'visal.menu.collapsed';
        function load() { try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch (e) { return new Set(); } }
        function save(s) { try { localStorage.setItem(KEY, JSON.stringify(Array.from(s))); } catch (e) { } }

        function restore(g) {
            var closed = load();
            g.open = !closed.has(g.getAttribute('data-group'));
        }

        function filter(term) {
            term = (term || '').trim().toLowerCase();
            var groups = document.querySelectorAll('.visal-nav-group[data-group]');
            var anyGlobal = false;
            groups.forEach(function (g) {
                var anyLocal = false;
                g.querySelectorAll('.visal-nav-link').forEach(function (a) {
                    var show = !term || (a.textContent || '').toLowerCase().indexOf(term) !== -1;
                    a.style.display = show ? '' : 'none';
                    if (show) { anyLocal = true; }
                });
                g.style.display = anyLocal ? '' : 'none';
                if (anyLocal) { anyGlobal = true; }
                if (term) { g.open = true; } else { restore(g); }
            });
            var empty = document.querySelector('[data-nav-empty]');
            if (empty) { empty.hidden = !(term && !anyGlobal); }
        }

        function init() {
            document.querySelectorAll('.visal-nav-group[data-group]').forEach(function (g) {
                restore(g);
                if (!g.__navWired) {
                    g.__navWired = true;
                    g.addEventListener('toggle', function () {
                        var s = load(); var k = g.getAttribute('data-group');
                        if (g.open) { s.delete(k); } else { s.add(k); }
                        save(s);
                    });
                }
            });
            var input = document.querySelector('[data-nav-search]');
            if (input && !input.__navWired) {
                input.__navWired = true;
                // Arranca readonly (anti-autofill del navegador); se libera al enfocar.
                var liberar = function () { input.removeAttribute('readonly'); };
                input.addEventListener('focus', liberar);
                input.addEventListener('pointerdown', liberar);
                input.addEventListener('input', function (e) { filter(e.target.value); });
            }
        }

        if (document.readyState !== 'loading') { init(); }
        else { document.addEventListener('DOMContentLoaded', init); }
        // Re-init tras navegacion mejorada de Blazor (el sidebar puede re-renderizarse).
        try { if (window.Blazor && Blazor.addEventListener) { Blazor.addEventListener('enhancedload', init); } } catch (e) { }
        // Respaldo: reintentar poco despues por si el DOM del menu llega tarde.
        setTimeout(init, 400);
    })();
</script>
