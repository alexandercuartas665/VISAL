@* Componente reutilizable: renderiza el PAQUETE completo de UNA historia clinica
   (formato principal + evoluciones ligadas de terapia + medicamentos + servicios +
   remisiones + insumos + externos + incapacidades + certificaciones + escalas +
   evoluciones/consentimientos), cada documento en su propia pagina. Lo usan tanto
   /imprimir-paquete (una HC) como /imprimir-ordenes-filtradas (listado, en bucle).
   No trae @page/@layout/@rendermode (hereda el render mode de la pagina host) ni el
   <style> (lo aporta la pagina host, igual que para DocumentoImprimible). *@
@using System.Text.Json
@using System.Threading
@using Microsoft.AspNetCore.WebUtilities
@using Visal.Application.Tenancy
@using Visal.Application.Tenancy.Forms
@using Visal.SuperAdmin.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@inject IHistoriaClinicaService HcSvc
@inject IAsignacionService AsigSvc
@inject IFormDefinitionService FormsSvc
@inject IOrdenMedicamentoService MedSvc
@inject IOrdenMedicamentoPublicaService PubSvc
@inject IOrdenServicioService SrvSvc
@inject Visal.Application.Common.IQrCodeGenerator Qr
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IIncapacidadService IncSvc
@inject ICertificacionService CertSvc
@inject IRemisionService RemSvc
@inject IInsumoService InsumoSvc
@inject ISuministroMedicamentoService SumMedSvc
@inject IOrdenExternaService OrdExtSvc
@inject IEscalaService EscSvc
@inject IDocumentoHcService DocSvc
@inject IFirmaResolverService FirmaResolverSvc
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_loading)
{
    @* La pagina host muestra su propio indicador de carga global. *@
}
else if (_hc is null)
{
    <div class="pack-doc" style="padding:14px;">
        <p><em>Historia clinica no encontrada.</em></p>
    </div>
}
else
{
    <div class="pack">
        @* ============ DOCUMENTO 1: HISTORIA CLINICA ============ *@
        @if (_incluirHc && _hcSchema is not null)
        {
            <div class="pack-doc">
                @RenderHeader(HdrHc, _hc.FormatoNombre, "HC", ConsecutivoHc(),
                    FechaLineaHc())

                @foreach (var node in _hcSchema.Children)
                {
                    @RenderTopNode(node, _valores)
                }

                @RenderFirma(_hc.EspecialistaNombre, "Firma del profesional tratante")
            </div>
        }

        @* ==== EVOLUCIONES (unificadas: sesiones de terapia ligadas + documentos de
           evolucion), justo debajo de la HC base. Se mezclan ambas fuentes, se
           ordenan por fecha y se numeran consecutivamente "Evolucion - Sesion N"
           para que salgan en orden y sin importar como se hayan capturado. Cada una
           en su propia pagina. *@
        @if (_evolucionesUnificadas.Count > 0)
        {
            var _evoN = 0;
            @foreach (var evo in _evolucionesUnificadas)
            {
                _evoN++;
                var schEvo = TryParseSchema(evo.SchemaJson);
                var valEvo = TryParseValores(evo.ValoresJson);
                var hdrEvo = schEvo?.Header ?? FormHeader.Default();
                <div class="pack-doc">
                    @RenderHeader(hdrEvo, evo.FormatoNombre, "EVO",
                        evo.Id.ToString().Substring(0, 8).ToUpperInvariant(),
                        $"Fecha: {evo.FechaApertura.ToLocalTime():dd/MM/yyyy HH:mm}",
                        $"Evolucion - Sesion {_evoN}")
                    @if (schEvo is not null)
                    {
                        @foreach (var node in schEvo.Children) { @RenderTopNode(node, valEvo) }
                    }
                    @RenderFirma(evo.EspecialistaNombre ?? _hc.EspecialistaNombre, "Firma del profesional tratante")
                </div>
            }
        }

        @* ============ ORDENES DE MEDICAMENTOS ============ *@
        @* Cada orden (grupo NumeroOrden) se imprime como un DOCUMENTO SEPARADO con su
           propia firma/QR. No se agregan varias ordenes en un solo formulario. *@
        @if (_incluirMed && _ordenesMed.Count > 0)
        {
            @foreach (var om in _ordenesMed)
            {
                var _suf = OrdSufijo(om.NumeroOrden, _ordenesMed.Count);
                @if (_schMed is not null)
                {
                    @* Formato ORD-MEDI schema-driven, con su propio encabezado y el pie
                       de formula medica (firma + QR/codigo + recibido + barra). Emitida:
                       snapshot congelado; borrador: prellenado. DocumentoImprimible ya
                       aporta su .pack-doc, por eso no lo envolvemos aparte. *@
                    <DocumentoImprimible Schema="_schMed" Values="om.Bag"
                                         PacienteNombre="@(_paciente?.NombreCompleto)"
                                         PacienteTipoDoc="@(_paciente?.TipoDocumento)"
                                         PacienteDoc="@(_paciente?.NumeroDocumento)"
                                         EspecialistaNombre="@_hc.EspecialistaNombre"
                                         MostrarPieFormula="true"
                                         FechaLinea="@FechaLineaHc()"
                                         HcConsecutivo="@ConsecutivoHc()"
                                         OrdenNum="@($"{ConsecutivoHc()}-MED{(_ordenesMed.Count > 1 ? "-" + om.NumeroOrden : "")}")"
                                         TipoCortoHeader="ORD"
                                         Subtitulo="@(_ordenesMed.Count > 1 ? $"Orden {om.NumeroOrden} de {_ordenesMed.Count}" : null)"
                                         TituloFallback="@($"Orden de Medicamentos{_suf}")" />
                }
                else
                {
                    @* Fallback: sin formato ORD-MEDI configurado, tabla simple. *@
                    <div class="pack-doc">
                        @RenderHeader(BestHdr(HdrMed, "Orden de Medicamentos" + _suf), "Orden de Medicamentos" + _suf, "MED",
                            ConsecutivoHc() + "-MED" + (_ordenesMed.Count > 1 ? "-" + om.NumeroOrden : ""),
                            FechaLineaHc())
                        <div class="pack-band">Detalle de la orden</div>
                        <table class="pack-table">
                            <thead>
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>Medicamento</th>
                                    <th style="width:140px">Posologia</th>
                                    <th style="width:80px">Cantidad</th>
                                    <th>Observacion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in om.Meds)
                                {
                                    <tr>
                                        <td class="num">@m.Orden</td>
                                        <td><b>@m.NombreMedicamento</b></td>
                                        <td>@(string.IsNullOrWhiteSpace(m.Posologia) ? "-" : m.Posologia)</td>
                                        <td class="num">@(string.IsNullOrWhiteSpace(m.Cantidad) ? "-" : m.Cantidad)</td>
                                        <td>@(m.Observacion ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }

        @* ============ ORDEN A SERVICIOS ============ *@
        @* Cada orden (grupo NumeroOrden) es un documento separado con su propio QR. *@
        @if (_incluirSrv && _ordenesSrv.Count > 0)
        {
            @foreach (var os in _ordenesSrv)
            {
                var _subSrv = _ordenesSrv.Count > 1 ? $"Orden {os.NumeroOrden} de {_ordenesSrv.Count}" : null;
                var _tipoSrv = _ordenesSrv.Count > 1 ? $"SRV#{os.NumeroOrden}" : "SRV";
                <div class="pack-doc">
                    @RenderHeader(BestHdr(HdrSrv, "Orden a Servicios"), "Orden a Servicios", "SRV",
                        ConsecutivoHc() + "-SRV" + (_ordenesSrv.Count > 1 ? "-" + os.NumeroOrden : ""),
                        FechaLineaHc(), _subSrv)
                    <div class="pack-band">Detalle de la orden</div>
                    <table class="pack-table">
                        <thead>
                            <tr>
                                <th style="width:40px">#</th>
                                <th style="width:110px">Cod. Servicio</th>
                                <th>Descripcion</th>
                                <th style="width:80px">Cantidad</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in os.Items)
                            {
                                <tr>
                                    <td class="num">@s.Orden</td>
                                    <td class="mono">@(string.IsNullOrWhiteSpace(s.CodigoServicio) ? "-" : ServicioCodigo.Base(s.CodigoServicio))</td>
                                    <td><b>@s.Descripcion</b></td>
                                    <td class="num">@(string.IsNullOrWhiteSpace(s.Cantidad) ? "-" : s.Cantidad)</td>
                                    <td>@(s.Observaciones ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_tipoSrv)" Codigo="@PieCod(_tipoSrv)" />
                </div>
            }
        }

        @* ============ REMISIONES ============ *@
        @if (_incluirRem && _rem.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(BestHdr(HdrRem, "Ordenes de Remision"), "Ordenes de Remision", "REM",
                    ConsecutivoHc() + "-REM",
                    FechaLineaHc())
                @{ _pieTipo = "REM"; }
                <div class="pack-band">Detalle de las remisiones</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:100px">Codigo</th>
                            <th>Descripcion</th>
                            <th style="width:100px">Cantidad</th>
                            <th>Motivo / Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rem)
                        {
                            <tr>
                                <td class="num">@r.Orden</td>
                                <td class="mono">@(r.EspecialidadCodigo ?? "-")</td>
                                <td><b>@r.EspecialidadNombre</b></td>
                                <td>@(r.Cantidad ?? "-")</td>
                                <td>@(r.Motivo ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ ORDENES DE INSUMOS (internos, texto libre) ============ *@
        @* Cada orden (grupo NumeroOrden) es un documento separado con su propio QR. *@
        @if (_incluirIns && _ordenesIns.Count > 0)
        {
            @foreach (var oi in _ordenesIns)
            {
                var _subIns = _ordenesIns.Count > 1 ? $"Orden {oi.NumeroOrden} de {_ordenesIns.Count}" : null;
                var _tipoIns = _ordenesIns.Count > 1 ? $"INS#{oi.NumeroOrden}" : "INS";
                <div class="pack-doc">
                    @RenderHeader(HdrTenant("Orden de Insumos"), "Orden de Insumos", "INS",
                        ConsecutivoHc() + "-INS" + (_ordenesIns.Count > 1 ? "-" + oi.NumeroOrden : ""),
                        FechaLineaHc(), _subIns)
                    <div class="pack-band">Detalle de la orden</div>
                    <table class="pack-table">
                        <thead>
                            <tr>
                                <th style="width:40px">#</th>
                                <th style="width:120px">Codigo</th>
                                <th>Descripcion</th>
                                <th style="width:80px">Cantidad</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in oi.Items)
                            {
                                <tr>
                                    <td class="num">@i.Orden</td>
                                    <td class="mono">@(i.Codigo ?? "-")</td>
                                    <td><b>@i.Descripcion</b></td>
                                    <td class="num">@(string.IsNullOrWhiteSpace(i.Cantidad) ? "-" : i.Cantidad)</td>
                                    <td>@(i.Observaciones ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_tipoIns)" Codigo="@PieCod(_tipoIns)" />
                </div>
            }
        }

        @* ============ REGISTRO DE MEDICAMENTOS SUMINISTRADOS ============ *@
        @* Bitacora de administracion: fecha/hora + presentacion + dosis + via +
           usuario. Sin firma (es un registro operativo, no una prescripcion). *@
        @if (_incluirRegMed && _regMed.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(HdrTenant("Medicamentos"), "Medicamentos", "REGMED",
                    ConsecutivoHc() + "-REGMED",
                    FechaLineaHc())
                <div class="pack-band">Registro de medicamentos suministrados</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:120px">Fecha y Hora</th>
                            <th>Presentacion</th>
                            <th style="width:90px">Dosis</th>
                            <th style="width:130px">Via</th>
                            <th style="width:180px">Usuario Creacion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _regMed)
                        {
                            <tr>
                                <td class="mono">@s.FechaHora.LocalDateTime.ToString("dd/MM/yy HH:mm")</td>
                                <td><b>@s.Presentacion</b></td>
                                <td>@(string.IsNullOrWhiteSpace(s.Dosis) ? "-" : s.Dosis)</td>
                                <td>@(string.IsNullOrWhiteSpace(s.Via) ? "-" : s.Via)</td>
                                <td>@(string.IsNullOrWhiteSpace(s.UsuarioCreacionNombre) ? "-" : s.UsuarioCreacionNombre)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ============ RX IMAGENOLOGIA (catalogo externo) ============ *@
        @if (_incluirRxExt && _rxExt.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(HdrTenant("Orden RX Imagenologia"), "Orden RX Imagenologia", "RXEXT",
                    ConsecutivoHc() + "-RX",
                    FechaLineaHc())
                @{ _pieTipo = "RXEXT"; }
                <div class="pack-band">Detalle de la orden</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:120px">Codigo CUPS</th>
                            <th>Descripcion</th>
                            <th style="width:80px">Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rxExt)
                        {
                            <tr>
                                <td class="num">@r.Orden</td>
                                <td class="mono">@(r.Codigo ?? "-")</td>
                                <td><b>@r.Descripcion</b></td>
                                <td class="num">@(string.IsNullOrWhiteSpace(r.Cantidad) ? "-" : r.Cantidad)</td>
                                <td>@(r.Observaciones ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ LABORATORIOS (catalogo externo) ============ *@
        @if (_incluirLabExt && _labExt.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(HdrTenant("Orden de Laboratorios"), "Orden de Laboratorios", "LABEXT",
                    ConsecutivoHc() + "-LAB",
                    FechaLineaHc())
                @{ _pieTipo = "LABEXT"; }
                <div class="pack-band">Detalle de la orden</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:120px">Codigo CUPS</th>
                            <th>Descripcion</th>
                            <th style="width:80px">Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _labExt)
                        {
                            <tr>
                                <td class="num">@l.Orden</td>
                                <td class="mono">@(l.Codigo ?? "-")</td>
                                <td><b>@l.Descripcion</b></td>
                                <td class="num">@(string.IsNullOrWhiteSpace(l.Cantidad) ? "-" : l.Cantidad)</td>
                                <td>@(l.Observaciones ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ SERVICIOS EXTERNOS (catalogo externo) ============ *@
        @if (_incluirSrvExt && _srvExt.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(HdrTenant("Orden de Servicios Externos"), "Orden de Servicios Externos", "SRVEXT",
                    ConsecutivoHc() + "-SRVX",
                    FechaLineaHc())
                @{ _pieTipo = "SRVEXT"; }
                <div class="pack-band">Detalle de la orden</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:120px">Codigo</th>
                            <th>Descripcion</th>
                            <th style="width:80px">Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _srvExt)
                        {
                            <tr>
                                <td class="num">@s.Orden</td>
                                <td class="mono">@(s.Codigo ?? "-")</td>
                                <td><b>@s.Descripcion</b></td>
                                <td class="num">@(string.IsNullOrWhiteSpace(s.Cantidad) ? "-" : s.Cantidad)</td>
                                <td>@(s.Observaciones ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ INSUMOS EXTERNOS (catalogo externo) ============ *@
        @if (_incluirInsExt && _insExt.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(HdrTenant("Orden de Insumos Externos"), "Orden de Insumos Externos", "INSEXT",
                    ConsecutivoHc() + "-INSX",
                    FechaLineaHc())
                @{ _pieTipo = "INSEXT"; }
                <div class="pack-band">Detalle de la orden</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:120px">Codigo</th>
                            <th>Descripcion</th>
                            <th style="width:80px">Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in _insExt)
                        {
                            <tr>
                                <td class="num">@x.Orden</td>
                                <td class="mono">@(x.Codigo ?? "-")</td>
                                <td><b>@x.Descripcion</b></td>
                                <td class="num">@(string.IsNullOrWhiteSpace(x.Cantidad) ? "-" : x.Cantidad)</td>
                                <td>@(x.Observaciones ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ INCAPACIDADES ============ *@
        @if (_incluirInc && _inc.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(BestHdr(HdrInc, "Orden de Incapacidad"), "Orden de Incapacidad", "INC",
                    ConsecutivoHc() + "-INC",
                    FechaLineaHc())
                @{ _pieTipo = "INC"; }
                <div class="pack-band">Detalle de la orden</div>
                <table class="pack-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th>Motivo</th>
                            <th style="width:90px">Desde</th>
                            <th style="width:90px">Hasta</th>
                            <th style="width:50px">Dias</th>
                            <th style="width:160px">Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in _inc)
                        {
                            <tr>
                                <td class="num">@i.Orden</td>
                                <td>@i.Motivo</td>
                                <td class="num">@(i.FechaDesde?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="num">@(i.FechaHasta?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="num">@(i.Dias?.ToString() ?? "-")</td>
                                <td>@(i.Tipo ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ CERTIFICACIONES ============ *@
        @if (_incluirCert && _cert.Count > 0)
        {
            <div class="pack-doc">
                @RenderHeader(BestHdr(HdrCert, "Certificacion Medica"), "Certificacion Medica", "CERT",
                    ConsecutivoHc() + "-CERT",
                    FechaLineaHc())
                @{ _pieTipo = "CERT"; }
                <div class="pack-band">Detalle</div>
                @foreach (var c in _cert)
                {
                    <div class="pack-section">
                        <h4>#@c.Orden &middot; @c.Titulo</h4>
                        @c.Contenido
                    </div>
                }
                <PieOrdenImprimible Diagnostico="@_pieDiagnostico" FirmaUrl="@_pieFirmaUrl" ProfNombre="@_pieProfNombre" ProfRegistro="@_pieProfRegistro" FechaImpresion="@_pieFecha" ProgramaUrl="@_pieUrl" QrImg="@PieQr(_pieTipo)" Codigo="@PieCod(_pieTipo)" />
            </div>
        }

        @* ============ ESCALAS DILIGENCIADAS ============ *@
        @if (_incluirEsc && _escalasDetails.Count > 0)
        {
            @foreach (var esc in _escalasDetails)
            {
                var schEsc = TryParseSchema(esc.SchemaJson);
                var valEsc = TryParseValores(esc.ValoresJson);
                // Usar el Header del schema de la escala — asi sale el logo
                // del tenant y el Titulo configurado (ej. "ESCALA BARTHEL")
                // en vez del Codigo+Nombre del FormDefinition.
                var hdrEsc = schEsc?.Header ?? FormHeader.Default();
                <div class="pack-doc">
                    @RenderHeader(hdrEsc, esc.FormatoNombre, "ESC",
                        esc.Id.ToString().Substring(0,8).ToUpperInvariant(),
                        $"Aplicada: {esc.FechaApertura.ToLocalTime():dd/MM/yyyy HH:mm}")
                    <div class="pack-band">Resultado</div>
                    @if (schEsc is not null)
                    {
                        @foreach (var node in schEsc.Children) { @RenderTopNode(node, valEsc) }
                    }
                    @RenderFirma(esc.EspecialistaNombre ?? _hc.EspecialistaNombre, "Firma del profesional tratante")
                </div>
            }
        }

        @* Las evoluciones diligenciadas (documentos EVOLUCION) ya se renderizan
           arriba, unificadas con las evoluciones de terapia ligadas y numeradas
           "Evolucion - Sesion N". Ver el bloque EVOLUCIONES bajo la HC base. *@

        @* ============ CONSENTIMIENTOS DILIGENCIADOS ============ *@
        @if (_incluirCon && _conDetails.Count > 0)
        {
            @foreach (var doc in _conDetails)
            {
                var schDoc = TryParseSchema(doc.SchemaJson);
                var valDoc = TryParseValores(doc.ValoresJson);
                var hdrCon = schDoc?.Header ?? FormHeader.Default();
                <div class="pack-doc">
                    @RenderHeader(hdrCon, doc.FormatoNombre, "CON",
                        doc.Id.ToString().Substring(0,8).ToUpperInvariant(),
                        $"Fecha: {doc.FechaApertura.ToLocalTime():dd/MM/yyyy HH:mm}")
                    <div class="pack-band">Consentimiento informado</div>
                    @if (schDoc is not null)
                    {
                        @foreach (var node in schDoc.Children) { @RenderTopNode(node, valDoc) }
                    }
                    @RenderFirma(doc.EspecialistaNombre ?? _hc.EspecialistaNombre, "Firma del profesional tratante")
                </div>
            }
        }
    </div>
}

@code {
    /// <summary>HC a imprimir.</summary>
    [Parameter] public Guid HcId { get; set; }

    /// <summary>Tipos de documento a incluir (CSV: "HC,MED,SRV,..."). Vacio/null o
    /// "ALL" = incluir TODOS los tipos que tengan datos (usado por el listado).</summary>
    [Parameter] public string? Docs { get; set; }

    /// <summary>Ids de secciones opcionales (PrintOptional) a incluir (CSV). Vacio = ninguna.</summary>
    [Parameter] public string? Secs { get; set; }

    /// <summary>Si true, emite (firma + QR) las ordenes que aun no lo estan al imprimir.
    /// El listado y el "Consultar" pasan false; solo el boton general de la HC pasa true.</summary>
    [Parameter] public bool AutoEmitir { get; set; }

    /// <summary>Si true, dispara window.print() una vez cargado el paquete.</summary>
    [Parameter] public bool AutoPrint { get; set; }

    /// <summary>Gate opcional para serializar la carga entre instancias hermanas
    /// (listado): todas comparten el DbContext scoped del circuito, que NO admite
    /// operaciones concurrentes. Con el gate, cada componente carga su paquete de a
    /// uno. El print por-fila (instancia unica) lo deja null y carga sin contencion.</summary>
    [Parameter] public SemaphoreSlim? LoadGate { get; set; }

    private bool _loading = true;
    private Guid _loadedHcId;  // guarda contra recargas repetidas en el mismo HcId
    private HistoriaClinicaDetailDto? _hc;
    private PacienteAsignacionDto? _paciente;

    // Que docs incluir, calculados desde el parametro Docs
    private List<string> _docs = new();
    private bool _incluirHc, _incluirMed, _incluirSrv, _incluirInc, _incluirCert, _incluirRem, _incluirEsc, _incluirEvo, _incluirCon;
    private bool _incluirIns, _incluirRxExt, _incluirLabExt, _incluirInsExt, _incluirSrvExt, _incluirRegMed;
    private bool _autoEmitir;  // ?emitir=1 -> emite la orden de medicamentos al imprimir

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Ids de secciones opcionales que el usuario decidio INCLUIR en la
    /// impresion (?secs=id1,id2). Default vacio: no incluir ninguna opcional.
    /// El filtro solo aplica a nodos con Type="section" y PrintOptional=true; el
    /// resto (secciones no opcionales, campos, tablas, textos) se muestra siempre.</summary>
    private HashSet<string> _seccionesOpcionalesIncluidas = new(StringComparer.OrdinalIgnoreCase);
    private List<EscalaDetailDto> _escalasDetails = new();
    private List<DocumentoHcDetailDto> _evoDetails = new();
    private List<DocumentoHcDetailDto> _conDetails = new();
    // Modo terapia: evoluciones (sesiones 2..N) ligadas a la HC de la 1ra sesion.
    // Se cargan solo cuando la HC impresa es la primera sesion de una terapia.
    private List<HistoriaEvolucionLigadaDto> _evolucionesTerapia = new();

    // Evoluciones UNIFICADAS: mezcla de las evoluciones de terapia ligadas (HC) y
    // los documentos de evolucion (EVOLUCION), ordenadas por fecha y numeradas
    // consecutivamente al renderizar. Evita numeracion/orden inconsistente cuando la
    // evolucion se capturo de formas distintas.
    private sealed record EvoImprimible(
        Guid Id, string? SchemaJson, string? ValoresJson,
        string FormatoNombre, DateTimeOffset FechaApertura, string? EspecialistaNombre);
    private List<EvoImprimible> _evolucionesUnificadas = new();

    // HC: schema + valores
    private FormSchema? _hcSchema;
    private Dictionary<string, string?> _valores = new();

    // Forms para encabezado de cada orden (institucion, logo, etc.)
    private FormDefinitionDetailDto? _fdHc, _fdMed, _fdSrv, _fdInc, _fdCert, _fdRem;
    private FormSchema _schHc = new(), _schMed = new(), _schSrv = new(), _schInc = new(), _schCert = new(), _schRem = new();
    private FormHeader HdrHc => _schHc.Header ?? FormHeader.Default();
    private FormHeader HdrMed => _schMed.Header ?? FormHeader.Default();
    private FormHeader HdrSrv => _schSrv.Header ?? FormHeader.Default();
    private FormHeader HdrInc => _schInc.Header ?? FormHeader.Default();
    private FormHeader HdrCert => _schCert.Header ?? FormHeader.Default();
    private FormHeader HdrRem => _schRem.Header ?? FormHeader.Default();

    // Items
    private List<OrdenMedicamentoItemDto> _meds = new();
    private OrdenPublicaResumenDto? _emisionMed;   // emision publica activa (QR) de la primera orden (compat FechaFormulaMed)
    private Dictionary<string, string?> _bagMed = new();  // bag de la primera orden (compat)

    // Una entrada por cada orden (grupo) de medicamentos de la HC. Cada orden se
    // imprime como un DOCUMENTO SEPARADO con su propio bag y su propia emision/QR:
    // NO se suman los items de varias ordenes en un solo formulario.
    private sealed class OrdenMedRender
    {
        public int NumeroOrden { get; set; } = 1;
        public List<OrdenMedicamentoItemDto> Meds { get; set; } = new();
        public OrdenPublicaResumenDto? Emision { get; set; }
        public Dictionary<string, string?> Bag { get; set; } = new();
    }
    private List<OrdenMedRender> _ordenesMed = new();
    // Una entrada por cada orden (grupo) de insumos, para imprimirlas por separado.
    private List<(int NumeroOrden, List<InsumoItemDto> Items)> _ordenesIns = new();
    // Idem para las ordenes a servicios (grupo NumeroOrden) — cada una su QR.
    private List<(int NumeroOrden, List<OrdenServicioItemDto> Items)> _ordenesSrv = new();
    // Sufijo " — Orden N" solo cuando hay mas de una orden del tipo (evita ruido cuando hay una sola).
    private static string OrdSufijo(int numeroOrden, int totalOrdenes)
        => totalOrdenes > 1 ? $" - Orden {numeroOrden}" : "";

    // Datos del pie clinico que comparten las ordenes impresas (servicios, remisiones,
    // insumos, incapacidades, certificaciones y externas): diagnostico(s) + firma del
    // medico tratante + footer. Se resuelven una sola vez en OnParametersSet.
    private string? _pieDiagnostico;
    private string? _pieFirmaUrl;
    private string? _pieProfNombre;
    private string? _pieProfRegistro;
    private string _pieFecha = "";
    private string _pieUrl = "";
    // Emisiones publicas (QR) por tipo de orden no-medicamento: tipo -> (codigo, PNG data URI).
    // Se llenan al imprimir para estampar el QR de verificacion en el pie de cada orden.
    private readonly Dictionary<string, (string Codigo, string QrImg)> _emisionesOrden = new(StringComparer.OrdinalIgnoreCase);
    private string? PieCod(string tipo) => _emisionesOrden.TryGetValue(tipo, out var e) ? e.Codigo : null;
    private string? PieQr(string tipo) => _emisionesOrden.TryGetValue(tipo, out var e) ? e.QrImg : null;
    // Tipo de la orden que se esta renderizando; se fija antes de cada bloque de orden
    // (render secuencial) para que su PieOrdenImprimible resuelva el QR correcto.
    private string _pieTipo = "";
    private List<OrdenServicioItemDto> _srv = new();
    private List<IncapacidadItemDto> _inc = new();
    private List<CertificacionItemDto> _cert = new();
    private List<RemisionItemDto> _rem = new();
    private List<InsumoItemDto> _insumos = new();
    private List<OrdenExternaItemDto> _rxExt = new(), _labExt = new(), _insExt = new(), _srvExt = new();
    private List<SuministroMedicamentoItemDto> _regMed = new();

    protected override async Task OnParametersSetAsync()
    {
        // Cargar una sola vez por HcId: en el listado el componente recibe params
        // fijos, y evitamos recargas (y reemisiones) en re-renders del padre —
        // incluso si el padre re-renderiza mientras la carga async esta en curso.
        if (HcId == Guid.Empty || _loadedHcId == HcId) { return; }
        _loadedHcId = HcId;
        _loading = true;

        // Serializa la carga entre instancias hermanas (listado): comparten el
        // DbContext scoped del circuito, que NO admite operaciones concurrentes
        // (EF lanza "second operation started on this context"). Con el gate, cada
        // componente consulta de a uno. El print por-fila no pasa gate.
        if (LoadGate is not null) { await LoadGate.WaitAsync(); }
        try
        {
            await CargarPaqueteAsync();
        }
        catch
        {
            // Si la carga de UNA HC falla, no rompe el resto del listado.
        }
        finally
        {
            _loading = false;
            if (LoadGate is not null) { LoadGate.Release(); }
        }
    }

    private async Task CargarPaqueteAsync()
    {
        // Tipos a incluir: si Docs viene vacio o "ALL", se incluyen TODOS (el
        // listado quiere el paquete completo); cada bloque igual solo se pinta si
        // tiene datos (guardas `&& _coleccion.Count > 0` en el markup).
        var incluirTodo = string.IsNullOrWhiteSpace(Docs)
            || Docs.Equals("ALL", StringComparison.OrdinalIgnoreCase);
        _docs = incluirTodo
            ? new List<string> { "HC","MED","SRV","INC","CERT","REM","ESC","EVO","CON","INS","RXEXT","LABEXT","INSEXT","SRVEXT","REGMED" }
            : Docs!.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                   .Select(s => s.ToUpperInvariant())
                   .ToList();
        _incluirHc   = _docs.Contains("HC");
        _incluirMed  = _docs.Contains("MED");
        _incluirSrv  = _docs.Contains("SRV");
        _incluirInc  = _docs.Contains("INC");
        _incluirCert = _docs.Contains("CERT");
        _incluirRem  = _docs.Contains("REM");
        _incluirEsc  = _docs.Contains("ESC");
        _incluirEvo  = _docs.Contains("EVO");
        _incluirCon  = _docs.Contains("CON");
        _incluirIns    = _docs.Contains("INS");
        _incluirRxExt  = _docs.Contains("RXEXT");
        _incluirLabExt = _docs.Contains("LABEXT");
        _incluirInsExt = _docs.Contains("INSEXT");
        _incluirSrvExt = _docs.Contains("SRVEXT");
        _incluirRegMed = _docs.Contains("REGMED");
        // AutoEmitir: emite la orden de medicamentos (firma + QR) si aun no lo
        // estaba. El "Consultar" de /ordenes y el listado pasan false -> solo lectura.
        _autoEmitir = AutoEmitir;

        // Secciones opcionales (PrintOptional) a incluir. Vacio = ninguna.
        _seccionesOpcionalesIncluidas = new HashSet<string>(
            (Secs ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            StringComparer.OrdinalIgnoreCase);

        _hc = await HcSvc.GetAsync(HcId);
        if (_hc is null) { return; }
        _paciente = await AsigSvc.GetPacienteAsync(_hc.PacienteId);

        // Si va a salir HC, cargar su schema + valores.
        if (_incluirHc)
        {
            _fdHc = await FormsSvc.GetAsync(_hc.FormDefinitionId);
            if (_fdHc is not null)
            {
                try { _schHc = JsonSerializer.Deserialize<FormSchema>(_fdHc.SchemaJson) ?? new(); }
                catch { _schHc = new(); }
                _hcSchema = _schHc;
            }
            if (!string.IsNullOrWhiteSpace(_hc.ValoresJson))
            {
                try { _valores = JsonSerializer.Deserialize<Dictionary<string, string?>>(_hc.ValoresJson) ?? new(); }
                catch { _valores = new(); }
            }

            // Modo terapia: si la HC impresa es la primera sesion de una terapia,
            // anexamos las evoluciones (sesiones consecuentes) cerradas. Devuelve
            // vacio en cualquier otro caso (HC normal, no-primera-sesion, sin evos).
            try { _evolucionesTerapia = (await HcSvc.GetEvolucionesLigadasAsync(HcId)).ToList(); }
            catch { _evolucionesTerapia = new(); }
        }

        // Cada orden clasica se ubica en form_definitions por su "Codigo formulario"
        // (CodigoSecundario), NO por Tipo — asi los 5 formatos semilla pueden
        // seguir con Tipo="FORMATO" para agruparse en el listado, y el usuario
        // los distingue por CodigoSecundario ("ORDEN_MEDICAMENTOS", etc.).
        if (_incluirMed)
        {
            _fdMed = await FormsSvc.GetActivoByCodigoSecundarioAsync("ORDEN_MEDICAMENTOS");
            if (_fdMed is not null) { try { _schMed = JsonSerializer.Deserialize<FormSchema>(_fdMed.SchemaJson) ?? new(); } catch { } }
            _meds = (await MedSvc.ListarPorHistoriaAsync(HcId)).ToList();
            // Una entrada por CADA orden (grupo NumeroOrden): cada una emite/lee su
            // propio QR y arma su propio bag, para imprimirse como documento aparte.
            _ordenesMed = new();
            foreach (var grp in _meds.GroupBy(m => m.NumeroOrden).OrderBy(g => g.Key))
            {
                var om = new OrdenMedRender { NumeroOrden = grp.Key, Meds = grp.OrderBy(m => m.Orden).ToList() };
                // Emision activa (QR) de ESTA orden en concreto.
                try { om.Emision = await PubSvc.ObtenerEmisionActivaAsync(HcId, "MED", grp.Key); } catch { om.Emision = null; }
                // Auto-emision por orden: si viene del boton general (emitir=1) y esta
                // orden aun no esta emitida, se emite ahora (firma + QR + snapshot
                // inmutable de SUS medicamentos). Idempotente por (HC, MED, orden).
                if (_autoEmitir && om.Emision is null && om.Meds.Count > 0
                    && _fdMed is not null && _paciente is not null && _hc is not null)
                {
                    try
                    {
                        await AutoEmitirMedAsync(grp.Key, om.Meds);
                        om.Emision = await PubSvc.ObtenerEmisionActivaAsync(HcId, "MED", grp.Key);
                    }
                    catch { /* si la emision falla, esa orden sigue como borrador (sin QR) */ }
                }
                // Bag para renderizar el formato ORD-MEDI: emitida -> snapshot congelado
                // (con su codigo/QR ya inyectado); borrador -> prellenado con SUS meds.
                om.Bag = ConstruirBagMed(om.Meds, om.Emision);
                _ordenesMed.Add(om);
            }
            // Compat: FechaFormulaMed/_bagMed apuntan a la primera orden.
            _emisionMed = _ordenesMed.FirstOrDefault()?.Emision;
            _bagMed = _ordenesMed.FirstOrDefault()?.Bag ?? new();
        }
        if (_incluirSrv)
        {
            _fdSrv = await FormsSvc.GetActivoByCodigoSecundarioAsync("ORDEN_SERVICIOS");
            if (_fdSrv is not null) { try { _schSrv = JsonSerializer.Deserialize<FormSchema>(_fdSrv.SchemaJson) ?? new(); } catch { } }
            _srv = (await SrvSvc.ListarPorHistoriaAsync(HcId)).ToList();
            // Una entrada por CADA orden (grupo NumeroOrden) de servicios.
            _ordenesSrv = _srv
                .GroupBy(s => s.NumeroOrden)
                .OrderBy(g => g.Key)
                .Select(g => (g.Key, g.OrderBy(s => s.Orden).ToList()))
                .ToList();
        }
        if (_incluirInc)
        {
            _fdInc = await FormsSvc.GetActivoByCodigoSecundarioAsync("INCAPACIDADES");
            if (_fdInc is not null) { try { _schInc = JsonSerializer.Deserialize<FormSchema>(_fdInc.SchemaJson) ?? new(); } catch { } }
            _inc = (await IncSvc.ListarPorHistoriaAsync(HcId)).ToList();
        }
        if (_incluirCert)
        {
            _fdCert = await FormsSvc.GetActivoByCodigoSecundarioAsync("CERTIFICADOS");
            if (_fdCert is not null) { try { _schCert = JsonSerializer.Deserialize<FormSchema>(_fdCert.SchemaJson) ?? new(); } catch { } }
            _cert = (await CertSvc.ListarPorHistoriaAsync(HcId)).ToList();
        }
        if (_incluirRem)
        {
            _fdRem = await FormsSvc.GetActivoByCodigoSecundarioAsync("REMISIONES");
            if (_fdRem is not null) { try { _schRem = JsonSerializer.Deserialize<FormSchema>(_fdRem.SchemaJson) ?? new(); } catch { } }
            _rem = (await RemSvc.ListarPorHistoriaAsync(HcId)).ToList();
        }
        if (_incluirIns)
        {
            _insumos = (await InsumoSvc.ListarPorHistoriaAsync(HcId)).ToList();
            // Una entrada por CADA orden (grupo NumeroOrden) de insumos.
            _ordenesIns = _insumos
                .GroupBy(i => i.NumeroOrden)
                .OrderBy(g => g.Key)
                .Select(g => (g.Key, g.OrderBy(i => i.Orden).ToList()))
                .ToList();
        }
        if (_incluirRegMed)
        {
            _regMed = (await SumMedSvc.ListarPorHistoriaAsync(HcId)).ToList();
        }
        if (_incluirRxExt)
        {
            _rxExt = (await OrdExtSvc.ListarPorHistoriaAsync(HcId, Visal.Domain.Enums.TipoCatalogoServicio.RxImagenologia)).ToList();
        }
        if (_incluirLabExt)
        {
            _labExt = (await OrdExtSvc.ListarPorHistoriaAsync(HcId, Visal.Domain.Enums.TipoCatalogoServicio.Laboratorio)).ToList();
        }
        if (_incluirInsExt)
        {
            _insExt = (await OrdExtSvc.ListarPorHistoriaAsync(HcId, Visal.Domain.Enums.TipoCatalogoServicio.Insumo)).ToList();
        }
        if (_incluirSrvExt)
        {
            _srvExt = (await OrdExtSvc.ListarPorHistoriaAsync(HcId, Visal.Domain.Enums.TipoCatalogoServicio.ServicioGeneral)).ToList();
        }
        if (_incluirEsc)
        {
            // Cada escala usa su propio FormDefinition; cargamos solo las definitivas
            // (estado "Cerrada"). Si quieres incluir las abiertas, quita el filtro.
            var items = await EscSvc.ListarPorHistoriaAsync(HcId);
            foreach (var it in items.Where(x => x.Estado == "Cerrada"))
            {
                var d = await EscSvc.GetAsync(it.Id);
                if (d is not null) { _escalasDetails.Add(d); }
            }
        }
        if (_incluirEvo)
        {
            // Solo los documentos cerrados se incluyen en el paquete impreso.
            var items = await DocSvc.ListarPorHistoriaAsync(HcId, "EVOLUCION");
            foreach (var it in items.Where(x => x.Estado == "Cerrada"))
            {
                var d = await DocSvc.GetAsync(it.Id);
                if (d is not null) { _evoDetails.Add(d); }
            }
        }
        if (_incluirCon)
        {
            var items = await DocSvc.ListarPorHistoriaAsync(HcId, "CONSENTIMIENTO");
            // La firma del paciente puede haber llegado DESPUES de haberse cerrado el
            // consentimiento (via link de firma remota por WhatsApp). Como el
            // ValoresJson del documento se congela al cerrar, aqui refrescamos los
            // campos de firma (paciente / profesional / acompanantes) con lo mas
            // reciente antes de renderizar la impresion.
            string? firmaPacActual = null;
            if (_paciente is not null)
            {
                try { firmaPacActual = await FirmaResolverSvc.ResolverFirmaPacienteAsync(_paciente.Id); }
                catch { /* firmas opcionales */ }
            }
            foreach (var it in items.Where(x => x.Estado == "Cerrada"))
            {
                var d = await DocSvc.GetAsync(it.Id);
                if (d is null) { continue; }

                // Aplicamos el prefill actualizado sobre una copia mutable del JSON.
                // Solo re-aplicamos firma paciente (que puede haber llegado tarde por
                // WhatsApp) y acompanantes; la firma profesional ya quedo en el JSON
                // al cerrar el documento y no es esperable que cambie despues.
                try
                {
                    if (!string.IsNullOrWhiteSpace(d.PrefillRoutesJson))
                    {
                        var rutas = PrefillRouteSet.FromJson(d.PrefillRoutesJson);
                        var valores = TryParseValores(d.ValoresJson);
                        FirmasPrefillHelper.Aplicar(valores, firmaPacActual, firmaProfesionalUrl: null, rutas);
                        if (_paciente is not null)
                        {
                            for (int i = 1; i <= 4; i++)
                            {
                                try
                                {
                                    var (aUrl, aNombre, aParent) = await FirmaResolverSvc.ResolverAcompananteAsync(_paciente.Id, i);
                                    if (aUrl is null && aNombre is null && aParent is null) { break; }
                                    FirmasPrefillHelper.AplicarAcompanante(valores, i, aUrl, aNombre, aParent, rutas);
                                }
                                catch { break; }
                            }
                        }
                        d = d with { ValoresJson = JsonSerializer.Serialize(valores) };
                    }
                }
                catch { /* si falla, mostramos el JSON tal cual estaba */ }
                _conDetails.Add(d);
            }
        }

        // Pie clinico compartido por las ordenes (diagnostico + firma tratante + footer).
        // Solo se resuelve si el paquete incluye alguna orden que lo lleva.
        if (_incluirSrv || _incluirRem || _incluirIns || _incluirInc || _incluirCert
            || _incluirRxExt || _incluirLabExt || _incluirSrvExt || _incluirInsExt)
        {
            await CargarPieOrdenesAsync();
            // Emite/reusa la verificacion publica por tipo y arma el QR del pie.
            await PrepararQrOrdenesAsync();
        }

        // Evoluciones unificadas: mezcla las evoluciones de terapia ligadas (HC) con
        // los documentos de evolucion (EVOLUCION), ordenadas por fecha. Se numeran al
        // renderizar (1..N) para que salgan en orden y con "Evolucion - Sesion N"
        // sin importar como se hayan capturado.
        var evosMerge = new List<EvoImprimible>();
        foreach (var evo in _evolucionesTerapia)
        {
            evosMerge.Add(new EvoImprimible(
                evo.Historia.Id, evo.Historia.SchemaJson, evo.Historia.ValoresJson,
                evo.Historia.FormatoNombre, evo.Historia.FechaApertura, evo.Historia.EspecialistaNombre));
        }
        foreach (var doc in _evoDetails)
        {
            evosMerge.Add(new EvoImprimible(
                doc.Id, doc.SchemaJson, doc.ValoresJson,
                doc.FormatoNombre, doc.FechaApertura, doc.EspecialistaNombre));
        }
        _evolucionesUnificadas = evosMerge.OrderBy(e => e.FechaApertura).ToList();

        // Auto-print: cuando la pagina host lo pide (boton "Imprimir" del listado
        // por-fila, que antes usaba #print=1). El listado masivo pasa AutoPrint=false
        // y deja que el usuario dispare la impresion desde su boton global.
        if (AutoPrint)
        {
            _ = Task.Delay(400).ContinueWith(async _ =>
            {
                try { await JS.InvokeVoidAsync("print"); } catch { }
            });
        }
    }

    // Resuelve los datos del pie clinico de las ordenes: diagnostico(s) de la HC + firma
    // del medico tratante (el "Atiende:", NO quien imprime) + fecha/URL del footer. Igual
    // que la formula medica, pero sin QR (ese es exclusivo de la orden de medicamentos).
    private async Task CargarPieOrdenesAsync()
    {
        if (_hc is null) { return; }

        _pieFecha = PieFechaImpresion();
        var url = Config["Branding:ProgramUrl"];
        _pieUrl = string.IsNullOrWhiteSpace(url) ? "https://axon.ipsvisalrt.com/" : url!;

        // Diagnostico(s) capturados en la HC (mismos que viajan a la formula medica).
        try
        {
            var dxs = HcDiagnosticosReader.Leer(_hc.SchemaJson, _hc.ValoresJson);
            _pieDiagnostico = string.Join("; ",
                dxs.Select(d => (d.Diagnostico ?? "").Trim()).Where(s => s.Length > 0));
        }
        catch { }

        // Firma + datos del medico tratante de la HC. Fallback al usuario logueado si la
        // HC no tiene profesional vinculado (compatibilidad con el fix de la formula).
        _pieProfNombre = _hc.EspecialistaNombre;
        var profId = _hc.ProfesionalId;
        Guid? platformUid = null, tenantId = null;
        if (AuthState is not null)
        {
            var st = await AuthState;
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var puid)) { platformUid = puid; }
            if (Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out var tid)) { tenantId = tid; }
        }
        try
        {
            var datos = await FirmaResolverSvc.ResolverDatosProfesionalAsync(
                profId, profId is null ? platformUid : null, tenantId);
            if (datos is not null)
            {
                if (!string.IsNullOrWhiteSpace(datos.Nombre)) { _pieProfNombre = datos.Nombre; }
                _pieProfRegistro = datos.RegistroMedico;
            }
        }
        catch { }
        try
        {
            if (profId is Guid pid && pid != Guid.Empty)
            {
                _pieFirmaUrl = await FirmaResolverSvc.ResolverFirmaPorProfesionalAsync(pid);
            }
            else if (platformUid is Guid puid2 && tenantId is Guid tid2)
            {
                _pieFirmaUrl = await FirmaResolverSvc.ResolverFirmaProfesionalPorPlatformUserAsync(puid2, tid2);
            }
        }
        catch { }
    }

    private static string PieFechaImpresion()
    {
        var n = DateTime.Now;
        return n.ToString("dd/MM/yyyy - h:mm") + " " + (n.Hour < 12 ? "a.m." : "p.m.");
    }

    // Estampa el QR de verificacion en las ordenes no-medicamento incluidas. Para cada
    // tipo con items, reusa la emision publica activa (si ya existe) o la emite ahora
    // cuando la impresion viene del boton general de la HC (emitir=1). Congela un
    // snapshot con iniciales del paciente + profesional tratante + items, minteando el
    // codigo del QR. Igual contrato que la orden de medicamentos, generalizado por tipo.
    // Se llama DESPUES de CargarPieOrdenesAsync (usa _pieProfNombre / _pieProfRegistro).
    private async Task PrepararQrOrdenesAsync()
    {
        if (_hc is null || _paciente is null) { return; }

        var tipos = new List<(string Tipo, List<OrdenItemPublicoDto> Items)>();
        // SRV se maneja aparte (abajo) porque cada orden (NumeroOrden) emite/lee su propio QR.
        if (_incluirRem && _rem.Count > 0)
        {
            tipos.Add(("REM", _rem.Select(r => new OrdenItemPublicoDto(
                r.EspecialidadNombre ?? "", r.EspecialidadCodigo, r.Cantidad, null, null, r.Motivo)).ToList()));
        }
        // INS se maneja aparte (abajo) porque cada orden emite/lee su propio QR.
        if (_incluirRxExt && _rxExt.Count > 0)
        {
            tipos.Add(("RXEXT", _rxExt.Select(r => new OrdenItemPublicoDto(
                r.Descripcion ?? "", r.Codigo, r.Cantidad, null, null, r.Observaciones)).ToList()));
        }
        if (_incluirLabExt && _labExt.Count > 0)
        {
            tipos.Add(("LABEXT", _labExt.Select(l => new OrdenItemPublicoDto(
                l.Descripcion ?? "", l.Codigo, l.Cantidad, null, null, l.Observaciones)).ToList()));
        }
        if (_incluirSrvExt && _srvExt.Count > 0)
        {
            tipos.Add(("SRVEXT", _srvExt.Select(s => new OrdenItemPublicoDto(
                s.Descripcion ?? "", s.Codigo, s.Cantidad, null, null, s.Observaciones)).ToList()));
        }
        if (_incluirInsExt && _insExt.Count > 0)
        {
            tipos.Add(("INSEXT", _insExt.Select(x => new OrdenItemPublicoDto(
                x.Descripcion ?? "", x.Codigo, x.Cantidad, null, null, x.Observaciones)).ToList()));
        }
        if (_incluirInc && _inc.Count > 0)
        {
            tipos.Add(("INC", _inc.Select(i => new OrdenItemPublicoDto(
                i.Motivo ?? "", i.Tipo, i.Dias?.ToString(), null, i.Dias?.ToString(), null)).ToList()));
        }
        if (_incluirCert && _cert.Count > 0)
        {
            tipos.Add(("CERT", _cert.Select(c => new OrdenItemPublicoDto(
                c.Titulo ?? "", null, null, null, null, null)).ToList()));
        }

        foreach (var (tipo, items) in tipos)
        {
            try
            {
                var em = await PubSvc.ObtenerEmisionActivaAsync(HcId, tipo);
                if (em is null && _autoEmitir && items.Count > 0)
                {
                    await EmitirOrdenTipoAsync(tipo, items);
                    em = await PubSvc.ObtenerEmisionActivaAsync(HcId, tipo);
                }
                if (em is not null)
                {
                    var qurl = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(em.Codigo)}";
                    _emisionesOrden[tipo] = (em.Codigo, Qr.GenerarPngDataUri(qurl, 150));
                }
            }
            catch { /* si un tipo falla, el resto del paquete se imprime igual (sin su QR) */ }
        }

        // Insumos: una emision/QR por CADA orden (grupo NumeroOrden). La clave del
        // diccionario coincide con la que usa el render: "INS" si hay una sola orden,
        // "INS#{n}" si hay varias.
        if (_incluirIns)
        {
            foreach (var (numeroOrden, insItems) in _ordenesIns)
            {
                if (insItems.Count == 0) { continue; }
                var key = _ordenesIns.Count > 1 ? $"INS#{numeroOrden}" : "INS";
                var items = insItems.Select(i => new OrdenItemPublicoDto(
                    i.Descripcion ?? "", i.Codigo, i.Cantidad, null, null, i.Observaciones)).ToList();
                try
                {
                    var em = await PubSvc.ObtenerEmisionActivaAsync(HcId, "INS", numeroOrden);
                    if (em is null && _autoEmitir && items.Count > 0)
                    {
                        await EmitirOrdenTipoAsync("INS", items, numeroOrden);
                        em = await PubSvc.ObtenerEmisionActivaAsync(HcId, "INS", numeroOrden);
                    }
                    if (em is not null)
                    {
                        var qurl = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(em.Codigo)}";
                        _emisionesOrden[key] = (em.Codigo, Qr.GenerarPngDataUri(qurl, 150));
                    }
                }
                catch { /* si una orden de insumos falla, las demas se imprimen igual */ }
            }
        }

        // Servicios: una emision/QR por CADA orden (grupo NumeroOrden). La clave del
        // diccionario coincide con la del render: "SRV" si hay una sola orden,
        // "SRV#{n}" si hay varias.
        if (_incluirSrv)
        {
            foreach (var (numeroOrden, srvItems) in _ordenesSrv)
            {
                if (srvItems.Count == 0) { continue; }
                var key = _ordenesSrv.Count > 1 ? $"SRV#{numeroOrden}" : "SRV";
                var items = srvItems.Select(s => new OrdenItemPublicoDto(
                    s.Descripcion ?? "", s.CodigoServicio, s.Cantidad, null, null, s.Observaciones)).ToList();
                try
                {
                    var em = await PubSvc.ObtenerEmisionActivaAsync(HcId, "SRV", numeroOrden);
                    if (em is null && _autoEmitir && items.Count > 0)
                    {
                        await EmitirOrdenTipoAsync("SRV", items, numeroOrden);
                        em = await PubSvc.ObtenerEmisionActivaAsync(HcId, "SRV", numeroOrden);
                    }
                    if (em is not null)
                    {
                        var qurl = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(em.Codigo)}";
                        _emisionesOrden[key] = (em.Codigo, Qr.GenerarPngDataUri(qurl, 150));
                    }
                }
                catch { /* si una orden de servicios falla, las demas se imprimen igual */ }
            }
        }
    }

    // Emite una orden publica de un tipo dado (SRV/REM/INS/...): congela iniciales del
    // paciente + profesional tratante + items y mintea el codigo del QR. El BagJson va
    // vacio porque estas ordenes no se renderizan schema-driven (usan tabla + pie).
    private async Task EmitirOrdenTipoAsync(string tipo, List<OrdenItemPublicoDto> items, int numeroOrden = 1)
    {
        if (_hc is null || _paciente is null || items.Count == 0) { return; }
        var req = new EmitirOrdenRequest(
            _hc.Id, "{}", DateTimeOffset.Now,
            Iniciales(_paciente.NombreCompleto), _pieProfNombre, _pieProfRegistro, items, tipo, numeroOrden);
        await PubSvc.EmitirAsync(req, await ActorIdAsync());
    }

    // ---- helpers de render ----

    // Header para las nuevas secciones (INS, RxExt, LabExt, InsExt) que no tienen
    // FormDefinition propio: heredamos institucion / tagline / logo del schema del
    // HC pero forzamos el Titulo del documento al parametro para que no salga
    // "Formato HC Fisioterapia" en la orden de insumos.
    private FormHeader HdrTenant(string titulo) => new()
    {
        Institucion = HdrHc.Institucion,
        Tagline = HdrHc.Tagline,
        LogoUrl = HdrHc.LogoUrl,
        Titulo = titulo
    };

    // Para las ordenes clasicas (Med / Srv / Rem / Inc / Cert) el paquete usa el
    // FormDefinition especifico de cada orden si esta configurado. Si el formulario
    // aun no tiene logo del tenant (headers recien seedeados o el usuario no lo
    // configuro), heredamos del HC para no caer al placeholder generico.
    private FormHeader BestHdr(FormHeader specific, string tituloFallback)
    {
        // Si el form-specific ya trae logo del tenant, respetarlo tal cual — el
        // usuario lo configuro a proposito.
        if (!string.IsNullOrWhiteSpace(specific.LogoUrl)) { return specific; }
        // Sin logo propio: usar el del HC pero conservar el Titulo si lo puso el
        // disenador; si tampoco esta, usar el fallback pasado por parametro.
        return new FormHeader
        {
            Institucion = !string.IsNullOrWhiteSpace(HdrHc.Institucion) ? HdrHc.Institucion : specific.Institucion,
            Tagline = !string.IsNullOrWhiteSpace(HdrHc.Tagline) ? HdrHc.Tagline : specific.Tagline,
            LogoUrl = HdrHc.LogoUrl,
            Titulo = !string.IsNullOrWhiteSpace(specific.Titulo) ? specific.Titulo : tituloFallback
        };
    }

    /// <summary>
    /// Consecutivo legible de la HC = ultimos 8 del ID (mismo criterio que el
    /// encabezado editable de la HC via HeaderAutoFillHelper). Se usa como "HC N°"
    /// en la HC y en todas las ordenes derivadas para que coincida con lo que el
    /// usuario ve en pantalla.
    /// </summary>
    private string ConsecutivoHc() => _hc is null ? "" : _hc.Id.ToString("N")[^8..].ToUpperInvariant();

    /// <summary>
    /// Fecha/hora canonica de la HC para impresion: la que el medico dejo en el
    /// campo de FECHA del encabezado (editable, "dd/MM/yyyy HH:mm"). Si no hay, cae
    /// a la fecha de apertura. Todas las ordenes derivadas imprimen esta misma fecha.
    /// </summary>
    private string FechaCanonicaHc()
    {
        var campos = _schHc?.Header?.Campos;
        if (campos is not null && _hc is not null)
        {
            foreach (var f in campos)
            {
                var label = (f.Label ?? "").ToLowerInvariant();
                if (label.Contains("fecha")
                    && _valores.TryGetValue("hdr:" + f.Id, out var v) && !string.IsNullOrWhiteSpace(v))
                {
                    return v!.Trim();
                }
            }
        }
        return _hc is null ? "" : _hc.FechaApertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private string FechaLineaHc() => "Fecha: " + FechaCanonicaHc();

    private RenderFragment RenderHeader(FormHeader hd, string titulo, string tipoCorto, string ordenNum, string fechaLinea, string? subtitulo = null) => __builder =>
    {
        // El titulo del documento es el del HEADER del schema (lo que el
        // disenador escribio en "Titulo" del editor de formularios, ej.
        // "HISTORIA CLINICA GENERAL"). Si esta vacio se cae a `titulo`, que
        // tipicamente es el Codigo + Nombre del FormDefinition (ej.
        // "HC-FO-08 FORMATO HC GENERAL") — mejor algo que nada en papel.
        var tituloFinal = !string.IsNullOrWhiteSpace(hd.Titulo) ? hd.Titulo! : titulo;
        <div class="pack-header">
            <div class="pack-hdr-top">
                <div class="pack-hdr-brand">
                    @if (!string.IsNullOrWhiteSpace(hd.LogoUrl))
                    {
                        <img class="pack-hdr-logo" src="@hd.LogoUrl" alt="logo" />
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    }
                    <div>
                        <div class="pack-hdr-inst">@hd.Institucion</div>
                        <div class="pack-hdr-tag">@hd.Tagline</div>
                    </div>
                </div>
                @* Ver DocumentoImprimible.razor — HC N° / Apertura. WYSIWYG:
                   el flag por-formato ImprimirCodigoFecha decide si el bloque
                   se renderiza (pantalla + PDF). Apagado = no aparece en ningun
                   lado (antes se ocultaba solo en el PDF via d-print-none). *@
                @if (hd.ImprimirCodigoFecha)
                {
                    <div class="pack-hdr-nohist">
                        @tipoCorto N°: <b>@ordenNum</b><br />
                        @fechaLinea<br />
                        HC: <b>@ConsecutivoHc()</b>
                    </div>
                }
            </div>
            <div class="pack-hdr-title">@tituloFinal</div>
            @if (!string.IsNullOrWhiteSpace(subtitulo))
            {
                <div style="text-align:center;font-weight:700;font-size:12px;letter-spacing:.5px;margin-top:1px;">@subtitulo</div>
            }
            <div class="pack-hdr-meta">
                <span><b>Paciente:</b> @(_paciente?.NombreCompleto ?? "-")</span>
                <span><b>Doc:</b> @(_paciente?.TipoDocumento) @(_paciente?.NumeroDocumento)</span>
                @if (!string.IsNullOrWhiteSpace(_hc.EspecialistaNombre))
                {
                    <span><b>Atiende:</b> @_hc.EspecialistaNombre</span>
                }
            </div>
        </div>
    };

    // Footer con firma retirado a peticion del cliente: el formulario define sus
    // propias secciones de firma (paciente / acompanantes / profesional) via
    // rutas de prefill. Ver historial: el helper solia agregar un bloque hardcoded
    // "Firma del profesional tratante" + "Recibido por paciente / acudiente"
    // despues de cada documento del paquete. Se dejo el helper como no-op para
    // no tocar los ~13 sitios que lo invocan.
    private RenderFragment RenderFirma(string? nombreProf, string rol) => __builder => { };

    // Render de un nodo del primer nivel del schema.
    // - Si es bloque de texto: una fila completa con el contenido.
    // - Si es seccion: subtitulo (si tiene label) + grid de 12 columnas con sus hijos,
    //   donde cada hijo respeta su WidthColumns (1..12).
    // - Si es campo/tabla suelto en el top-level: lo metemos en su propio grid para
    //   que tambien respete su WidthColumns.
    private RenderFragment RenderTopNode(FormNode n, Dictionary<string, string?> vals) => __builder =>
    {
        // Visibilidad condicional: si el nodo tiene VisibleWhen y no se cumple,
        // no se imprime (equivalente al FormViewer).
        if (!VisibleWhenEvaluator.ShouldShow(n.VisibleWhen, vals)) { return; }

        // No imprimir nunca: gate absoluto — la seccion/campo queda invisible
        // en impresion sin importar visibilidad o valor.
        if (n.NoImprimir) { return; }

        // HideIfEmpty (campos): si el disenador marco el campo con "No imprimir
        // si vacio" y el valor esta en blanco, se omite. Aplica solo a fields;
        // secciones se ignoran (no aplica el flag).
        if (n.HideIfEmpty && VisibleWhenEvaluator.IsFieldEmpty(n, vals)) { return; }

        // Seccion opcional al imprimir: si el disenador la marco como
        // PrintOptional y el usuario NO la selecciono en el modal (?secs=), la
        // omitimos. El default es "no imprimir opcionales" — el usuario debe
        // marcarlas explicitamente.
        if (n.IsSection && n.PrintOptional && !_seccionesOpcionalesIncluidas.Contains(n.Id))
        {
            return;
        }

        if (n.IsText)
        {
            <div class="pack-para">@(n.Content ?? "")</div>
            return;
        }
        if (n.IsSection)
        {
            if (!string.IsNullOrWhiteSpace(n.Label))
            {
                <div class="pack-sub">@n.Label</div>
            }
            <div class="pack-grid">
                @foreach (var ch in n.Children ?? new())
                {
                    if (!VisibleWhenEvaluator.ShouldShow(ch.VisibleWhen, vals)) { continue; }
                    if (ch.NoImprimir) { continue; }
                    if (ch.HideIfEmpty && VisibleWhenEvaluator.IsFieldEmpty(ch, vals)) { continue; }
                    @RenderDocNode(ch, vals)
                }
            </div>
            return;
        }
        // Campo o tabla en top-level: contenedor grid para que respete WidthColumns.
        <div class="pack-grid">
            @RenderDocNode(n, vals)
        </div>
    };

    /// <summary>
    /// Render de un nodo hoja dentro de una grid de 12 columnas. Usa el WidthColumns del
    /// nodo (1..12, clamped) para que el ancho de cada campo coincida con el disenador.
    /// Si no tiene WidthColumns valido, se asume 12 (toda la fila).
    /// </summary>
    private RenderFragment RenderDocNode(FormNode n, Dictionary<string, string?> vals) => __builder =>
    {
        var span = Math.Clamp(n.WidthColumns <= 0 ? 12 : n.WidthColumns, 1, 12);
        if (n.IsText)
        {
            <div class="pack-para" style="grid-column: span @span;">@(n.Content ?? "")</div>
            return;
        }
        if (n.IsTable)
        {
            // Leer filas reales: combina SeedRows (texto fijo) + filas extras
            // controladas por tbl:{id}:_rows. Cada celda viene de vals["tbl:{id}:{idx}:{colId}"].
            // Asi medicamentos / remisiones / etc. mapeados via historiaMedica
            // aparecen en la impresion con su contenido real.
            var tblKey = $"tbl:{n.Id}";
            var seedCount = n.SeedRows?.Count ?? 0;
            int extraRows = 0;
            if (!n.LockRows && vals.TryGetValue($"{tblKey}:_rows", out var rs)
                && int.TryParse(rs, out var parsed) && parsed > 0)
            {
                extraRows = parsed;
            }
            var totalRows = seedCount + extraRows;
            // Fallback: si no hay datos y la tabla es libre, deja 1 fila para
            // que el doctor pueda escribir a mano sobre papel.
            if (totalRows == 0 && !n.LockRows) { totalRows = 1; }
            <div style="grid-column: span @span; border-bottom:1px solid #000;">
                <table class="pack-table">
                    <thead>
                        <tr>
                            @foreach (var col in n.Columns ?? new()) { <th>@col.Label</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var r = 0; r < totalRows; r++)
                        {
                            var idx = r;
                            var isSeed = r < seedCount;
                            var seedRow = isSeed ? n.SeedRows![r] : null;
                            // Fila banner: colapsa columnas con estilo titulo (para impresion).
                            var _pBannerAlign = isSeed && n.SeedRowBanner is not null
                                && n.SeedRowBanner.TryGetValue(r.ToString(), out var _pba) ? _pba : null;
                            if (_pBannerAlign is not null && seedRow is not null)
                            {
                                var _pText = seedRow.Count > 0 ? seedRow[0] ?? "" : "";
                                var _pCols = (n.Columns?.Count ?? 0);
                                var _pAlign = _pBannerAlign == "left" || _pBannerAlign == "right" ? _pBannerAlign : "center";
                                <tr>
                                    <td colspan="@_pCols" style="text-align:@_pAlign; font-weight:700; background:#eff6ff; color:#1e3a8a; padding:6px 10px; letter-spacing:.04em;">
                                        @_pText
                                    </td>
                                </tr>
                                continue;
                            }
                            <tr>
                                @{ var colIdx = 0; }
                                @foreach (var col in n.Columns ?? new())
                                {
                                    var seedVal = (seedRow is not null && colIdx < seedRow.Count) ? seedRow[colIdx] : null;
                                    string? cellVal;
                                    // Columna calculada (ej. IMC en antropometria): se calcula a
                                    // partir de las celdas hermanas de la MISMA fila (no se persiste),
                                    // igual que en el FormViewer. Si algun operando falta, sale "".
                                    if (string.Equals(col.FieldType, "calculated", StringComparison.OrdinalIgnoreCase)
                                        && !string.IsNullOrWhiteSpace(col.Formula))
                                    {
                                        cellVal = ComputeRowFormula(n, col, idx, seedRow, vals);
                                    }
                                    else if (!string.IsNullOrEmpty(seedVal)) { cellVal = seedVal; }
                                    else { vals.TryGetValue($"{tblKey}:{idx}:{col.Id}", out cellVal); }
                                    // Columnas date guardan ISO (yyyy-MM-dd) para que el datepicker
                                    // del FormViewer las pueda leer. En impresion las mostramos en
                                    // formato local dd/MM/yyyy para que se lean como en papel.
                                    var displayVal = FormatCellForPrint(cellVal, col.FieldType);
                                    <td>@(string.IsNullOrWhiteSpace(displayVal) ? new MarkupString("&nbsp;") : (MarkupString)System.Net.WebUtility.HtmlEncode(displayVal))</td>
                                    colIdx++;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            return;
        }
        if (n.IsQr)
        {
            var qrKey = string.IsNullOrWhiteSpace(n.QrSource) ? (n.Name ?? "") : n.QrSource!;
            var codigo = (vals.TryGetValue(qrKey, out var qcv) ? qcv : null)?.Trim() ?? "";
            var qrSize = n.QrSize is int qs && qs > 0 ? Math.Clamp(qs, 80, 600) : 200;
            <div class="pack-cell" style="grid-column: span @span; text-align:center;">
                @if (n.Label is { Length: > 0 }) { <div class="pack-label">@n.Label</div> }
                @if (string.IsNullOrEmpty(codigo))
                {
                    <div class="pack-value">(QR pendiente de emision)</div>
                }
                else
                {
                    var qurl = $"{QrBaseUrl()}/verificar-orden/{Uri.EscapeDataString(codigo)}";
                    <img src="@Qr.GenerarPngDataUri(qurl, qrSize)" alt="QR de verificacion"
                         width="@qrSize" height="@qrSize" style="width:@(qrSize)px;height:@(qrSize)px;display:inline-block;" />
                    @if (n.ShowCode)
                    {
                        <div style="font-family:monospace;font-weight:600;letter-spacing:1px;margin-top:4px;">@codigo</div>
                    }
                }
            </div>
            return;
        }
        var key = n.Name ?? $"fld:{n.Id}";
        var val = vals.TryGetValue(key, out var vv) ? vv : null;
        // Reusamos FormatCellForPrint para date/datetime y dejamos otros tipos
        // (textarea, text, etc.) sin transformar.
        var fieldDisplay = FormatCellForPrint(val, n.FieldType);
        <div class="pack-cell" style="grid-column: span @span;">
            <div class="pack-label">@n.Label</div>
            @if (IsImageUrl(val))
            {
                <img class="pack-firma-img" src="@val" alt="firma" />
            }
            else
            {
                <div class="pack-value">@(fieldDisplay ?? "")</div>
            }
        </div>
    };

    /// <summary>Detecta si el valor de un campo es una firma/imagen ya subida.
    /// Reglas: data URL de imagen, ruta relativa que empieza en /uploads/, o URL
    /// http(s) con extensión de imagen. Se mantiene en línea con la misma logica
    /// de FormViewer para que la impresión coincida con lo que ve el operador.</summary>
    /// <summary>Base URL publica para el QR: config Branding:PublicBaseUrl o el host actual.</summary>
    private string QrBaseUrl()
    {
        var cfg = Config["Branding:PublicBaseUrl"];
        return (string.IsNullOrWhiteSpace(cfg) ? Nav.BaseUri : cfg).TrimEnd('/');
    }

    /// <summary>Emite la orden de medicamentos de esta HC (firma + QR + snapshot
    /// inmutable) reusando el mismo pipeline de prefill que /orden-doc: paciente +
    /// sistema (usuario/registro/firma) + firmas + tabla de medicamentos +
    /// diagnosticos. El firmante es el usuario logueado que imprime. El caller ya
    /// verifico que no hay emision activa.</summary>
    private async Task AutoEmitirMedAsync(int numeroOrden, List<OrdenMedicamentoItemDto> meds)
    {
        if (_hc is null || _paciente is null || _fdMed is null || meds.Count == 0) { return; }

        var valores = new Dictionary<string, string?>();
        var rutas = PrefillRouteSet.FromJson(_fdMed.PrefillRoutesJson);
        PacientePrefillHelper.Aplicar(valores, _paciente, _schMed, rutas);

        // Datos del usuario/profesional logueado (identificacion, registro, firma).
        Guid? profId = null, platformUid = null, tenantId = null;
        string? uName = null, uEmail = null, uSede = null;
        if (AuthState is not null)
        {
            var st = await AuthState;
            uName = st.User.Identity?.Name ?? st.User.FindFirst("display_name")?.Value;
            uEmail = st.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            uSede = st.User.FindFirst("sede_nombre")?.Value;
            if (Guid.TryParse(st.User.FindFirst("profesional_id")?.Value, out var pid)) { profId = pid; }
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var puid)) { platformUid = puid; }
            if (Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out var tid)) { tenantId = tid; }
        }

        // La formula la FIRMA el medico tratante de la HC (especialista), no quien
        // da Imprimir. Resolvemos por el ProfesionalId de la HC; si la HC no tiene
        // profesional vinculado, caemos al usuario logueado (compatibilidad).
        var firmanteProfId = _hc.ProfesionalId ?? profId;

        string? profNombre = _hc.EspecialistaNombre;
        string? profRegistro = null;
        try
        {
            var datosProf = await FirmaResolverSvc.ResolverDatosProfesionalAsync(
                firmanteProfId, firmanteProfId is null ? platformUid : null, tenantId);
            profRegistro = datosProf?.RegistroMedico;
            if (!string.IsNullOrWhiteSpace(datosProf?.Nombre)) { profNombre = datosProf!.Nombre; }
            else if (string.IsNullOrWhiteSpace(profNombre)) { profNombre = uName; }
            SistemaPrefillHelper.Aplicar(valores, new SistemaPrefillHelper.SistemaCtx(
                Ahora: DateTimeOffset.Now,
                AgenciaNombre: null, AgenciaSlogan: null,
                SedeNombre: uSede ?? _paciente.Sede, SedeCiudad: _paciente.Ciudad,
                UsuarioNombre: uName, UsuarioEmail: uEmail,
                UsuarioIdentificacion: datosProf?.Identificacion,
                UsuarioRegistroMedico: datosProf?.RegistroMedico,
                UsuarioFirmaUrl: datosProf?.FirmaUrl), rutas);
        }
        catch { }

        try
        {
            var firmaPac = await FirmaResolverSvc.ResolverFirmaPacienteAsync(_paciente.Id);
            string? firmaProf = null;
            if (firmanteProfId is Guid pid2 && pid2 != Guid.Empty)
            {
                firmaProf = await FirmaResolverSvc.ResolverFirmaPorProfesionalAsync(pid2);
            }
            else if (platformUid is Guid puid2 && tenantId is Guid tid2)
            {
                firmaProf = await FirmaResolverSvc.ResolverFirmaProfesionalPorPlatformUserAsync(puid2, tid2);
            }
            FirmasPrefillHelper.Aplicar(valores, firmaPac, firmaProf, rutas);
        }
        catch { }

        var fuentes = new HistoriaMedicaPrefillHelper.HmFuentes(
            meds,
            new List<RemisionItemDto>(), new List<IncapacidadItemDto>(), new List<CertificacionItemDto>(),
            new List<OrdenServicioItemDto>(), new List<InsumoItemDto>(),
            new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(),
            new List<SuministroMedicamentoItemDto>(),
            HcDiagnosticosReader.Leer(_hc.SchemaJson, _hc.ValoresJson));
        HistoriaMedicaPrefillHelper.Aplicar(valores, fuentes, rutas, _schMed);

        valores["profesional_nombre"] = profNombre;
        valores["profesional_registro"] = profRegistro;

        var items = meds.Select(m => new OrdenItemPublicoDto(
            m.NombreMedicamento, m.CodigoMedicamento, m.Cantidad, m.Frecuencia, m.Dias, m.Posologia)).ToList();
        var req = new EmitirOrdenRequest(
            _hc.Id, JsonSerializer.Serialize(valores), DateTimeOffset.Now,
            Iniciales(_paciente.NombreCompleto), profNombre, profRegistro, items, "MED", numeroOrden);
        await PubSvc.EmitirAsync(req, await ActorIdAsync());
    }

    private async Task<Guid> ActorIdAsync()
    {
        if (AuthState is not null)
        {
            var st = await AuthState;
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id))
            {
                return id;
            }
        }
        return Guid.Empty;
    }

    /// <summary>Iniciales del paciente (privacidad): "MERCEDES PULIDO" -> "M.P.".</summary>
    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) { return "N.N."; }
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini = partes.Where(p => p.Length > 0).Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Join(".", ini) + ".";
    }

    /// <summary>Arma el bag para renderizar la orden de medicamentos con el
    /// formato ORD-MEDI (schema-driven, con pie de formula: firma + QR + recibido
    /// + barra). Si la orden esta emitida usa el snapshot congelado (documento
    /// firmado inmutable); si no, un borrador prellenado con paciente + tabla de
    /// medicamentos desde las rutas del formato.</summary>
    // Fecha de expedicion de la formula medica para el encabezado: la fecha de
    // emision de la orden (documento firmado). Si aun es borrador, la de hoy.
    private string FechaFormulaMed()
    {
        var f = _emisionMed?.EmitidoAt ?? DateTimeOffset.Now;
        return "Fecha: " + f.ToLocalTime().ToString("dd/MM/yyyy");
    }

    private Dictionary<string, string?> ConstruirBagMed(List<OrdenMedicamentoItemDto> meds, OrdenPublicaResumenDto? emision)
    {
        // Orden emitida: snapshot inmutable (paciente + meds + firma + prof + codigo).
        if (emision is not null && !string.IsNullOrWhiteSpace(emision.BagJson))
        {
            try
            {
                var frozen = JsonSerializer.Deserialize<Dictionary<string, string?>>(emision.BagJson);
                if (frozen is not null)
                {
                    // El diagnostico NO se congela con la orden: es dato de la HC, y el
                    // medico puede completar la historia (agregar un diagnostico que
                    // olvido) despues de emitir. Se toma siempre en vivo para que la
                    // formula lo refleje sin alterar los medicamentos/firma firmados.
                    AplicarDiagnosticoEnVivo(frozen);
                    return frozen;
                }
            }
            catch { }
        }
        // Borrador (sin emitir): prellenar paciente + tabla de medicamentos para
        // que el documento use el diseno del formato aunque no haya firma/QR aun.
        var valores = new Dictionary<string, string?>();
        if (_schMed is null || _fdMed is null) { return valores; }
        var rutas = PrefillRouteSet.FromJson(_fdMed.PrefillRoutesJson);
        if (_paciente is not null) { PacientePrefillHelper.Aplicar(valores, _paciente, _schMed, rutas); }
        var fuentes = new HistoriaMedicaPrefillHelper.HmFuentes(
            meds,
            new List<RemisionItemDto>(), new List<IncapacidadItemDto>(), new List<CertificacionItemDto>(),
            new List<OrdenServicioItemDto>(), new List<InsumoItemDto>(),
            new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(),
            new List<SuministroMedicamentoItemDto>(),
            HcDiagnosticosReader.Leer(_hc?.SchemaJson, _hc?.ValoresJson));
        HistoriaMedicaPrefillHelper.Aplicar(valores, fuentes, rutas, _schMed);
        if (string.IsNullOrWhiteSpace(valores.TryGetValue("profesional_nombre", out var pn) ? pn : null))
        {
            valores["profesional_nombre"] = _hc?.EspecialistaNombre;
        }
        return valores;
    }

    /// <summary>Aplica SOLO el/los mapeo(s) de diagnostico (source "diagnosticos.*")
    /// de la ruta historiaMedica sobre un bag ya existente, tomando los diagnosticos
    /// EN VIVO de la HC. Se usa sobre el snapshot congelado de una orden emitida para
    /// que la formula refleje diagnosticos que el medico haya completado despues de
    /// emitir, sin tocar los medicamentos ni la firma (que si son inmutables).</summary>
    private void AplicarDiagnosticoEnVivo(Dictionary<string, string?> bag)
    {
        if (_fdMed is null || _hc is null) { return; }
        try
        {
            var rutas = PrefillRouteSet.FromJson(_fdMed.PrefillRoutesJson);
            var ruta = rutas.Routes.FirstOrDefault(r =>
                string.Equals(r.SourceModule, "historiaMedica", StringComparison.OrdinalIgnoreCase));
            if (ruta is null) { return; }

            var dxs = HcDiagnosticosReader.Leer(_hc.SchemaJson, _hc.ValoresJson);
            var fuentes = new HistoriaMedicaPrefillHelper.HmFuentes(
                Array.Empty<OrdenMedicamentoItemDto>(),
                new List<RemisionItemDto>(), new List<IncapacidadItemDto>(), new List<CertificacionItemDto>(),
                new List<OrdenServicioItemDto>(), new List<InsumoItemDto>(),
                new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(),
                new List<SuministroMedicamentoItemDto>(),
                dxs);
            var stringFuente = HistoriaMedicaPrefillHelper.BuildValores(fuentes);

            foreach (var m in ruta.Mappings)
            {
                if (string.IsNullOrWhiteSpace(m.Source) || string.IsNullOrWhiteSpace(m.Target)) { continue; }
                if (!m.Source.StartsWith("diagnosticos.", StringComparison.OrdinalIgnoreCase)) { continue; }
                // El diagnostico de la formula (ORD-MEDI) es un campo de texto; tomamos
                // el string derivado en vivo (ej. "CIE 10: [Z251] ...").
                if (stringFuente.TryGetValue(m.Source, out var v))
                {
                    bag[m.Target] = v;
                }
            }
        }
        catch { }
    }

    private static bool IsImageUrl(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) { return false; }
        var s = v.Trim();
        if (s.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)) { return true; }
        if (s.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) { return true; }
        if (s.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || s.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            var lower = s.ToLowerInvariant();
            return lower.EndsWith(".png") || lower.EndsWith(".jpg") || lower.EndsWith(".jpeg")
                || lower.EndsWith(".svg") || lower.EndsWith(".gif") || lower.EndsWith(".webp");
        }
        return false;
    }

    private static FormSchema? TryParseSchema(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return null; }
        try { return JsonSerializer.Deserialize<FormSchema>(json); } catch { return null; }
    }

    /// <summary>
    /// Si la celda pertenece a una columna date y el valor esta en ISO
    /// (yyyy-MM-dd) lo reformatea a dd/MM/yyyy para impresion. Cualquier
    /// otra cosa se devuelve tal cual.
    /// </summary>
    private static string? FormatCellForPrint(string? raw, string? fieldType)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return raw; }
        if (string.Equals(fieldType, "date", StringComparison.OrdinalIgnoreCase))
        {
            if (DateOnly.TryParseExact(raw, "yyyy-MM-dd", out var d))
            {
                return d.ToString("dd/MM/yyyy");
            }
            return raw;
        }
        if (string.Equals(fieldType, "datetime", StringComparison.OrdinalIgnoreCase))
        {
            // <input type="datetime-local"> guarda como "2026-07-09T15:30" (sin
            // zona horaria). Reformateamos a "09/07/2026 15:30" para impresion.
            if (DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeLocal, out var dt))
            {
                return dt.ToString("dd/MM/yyyy HH:mm");
            }
            return raw;
        }
        return raw;
    }

    private static Dictionary<string, string?> TryParseValores(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return new(); }
        try { return JsonSerializer.Deserialize<Dictionary<string, string?>>(json) ?? new(); } catch { return new(); }
    }

    /// <summary>Calcula el valor de una celda calculada (FieldType="calculated")
    /// para impresion, leyendo las celdas hermanas de la MISMA fila con la misma
    /// precedencia que el render (seedVal si tiene, sino el valor del store). Reusa
    /// el motor de formulas compartido (FormFormulaEvaluator), igual que el
    /// FormViewer. Devuelve "" si falta la formula o algun operando no es numerico.</summary>
    private static string ComputeRowFormula(FormNode table, FormColumn col, int rowIdx,
        List<string?>? seedRow, Dictionary<string, string?> vals)
    {
        if (table.Columns is null || string.IsNullOrWhiteSpace(col.Formula)) { return ""; }
        var rowVals = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        var ci = 0;
        foreach (var sib in table.Columns)
        {
            if (!string.IsNullOrWhiteSpace(sib.Name))
            {
                var sVal = (seedRow is not null && ci < seedRow.Count) ? seedRow[ci] : null;
                string? v;
                if (!string.IsNullOrEmpty(sVal)) { v = sVal; }
                else { vals.TryGetValue($"tbl:{table.Id}:{rowIdx}:{sib.Id}", out v); }
                rowVals[sib.Name!] = v;
            }
            ci++;
        }
        return FormFormulaEvaluator.EvaluateRow(col.Formula!, rowVals);
    }
}
