@page "/config/revision-policy"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Authorization
@using Visal.Application.Revision
@using Visal.Application.Tenancy
@inject IRevisionPolicyService Svc
@inject IAiUsageService UsageSvc
@inject Visal.Application.Tenancy.IFormDefinitionService FormsSvc

<PageTitle>Politica de Revision Clinica - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Configuracion de la Entidad</div>
        <h1 class="ase-title">Politica de Revision Clinica</h1>
        <small class="text-muted">
            Controla el comportamiento automatico del ciclo de revision (Capa 08 Ola 4).
            Aplica a todas las HCs del tenant.
        </small>
    </div>
</div>

@if (!_puedeConfig)
{
    <div class="ase-card">
        <div class="ase-alert">
            Solo el Owner del tenant o el SuperAdmin de la plataforma pueden modificar esta politica.
        </div>
    </div>
}
else if (_cargando && _policy is null)
{
    <div class="ase-card">
        <div class="ase-empty" style="padding:24px;">Cargando politica...</div>
    </div>
}
else if (_policy is not null)
{
    @* Ola 7 RC7c — KPI de cupo IA del tenant. Alerta visual si >70% (amarillo) o >90% (rojo). *@
    @if (_quota is not null && _quota.HasLimit)
    {
        var pctClase = _quota.UsedPct >= 90 ? "rp-cupo-rojo" : (_quota.UsedPct >= 70 ? "rp-cupo-amarillo" : "rp-cupo-verde");
        <div class="ase-card">
            <div class="ase-card-h">Cupo mensual de tokens IA</div>
            <div class="ase-card-body">
                <div class="rp-cupo @pctClase" style="display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;">
                    <div style="font-size:32px;font-weight:700;line-height:1;">
                        @_quota.UsedPct%
                    </div>
                    <div>
                        <div style="font-weight:600;">
                            @_quota.MonthlyUsedTokens.ToString("N0") / @_quota.MonthlyLimitTokens.ToString("N0") tokens
                        </div>
                        <div class="text-muted" style="font-size:13px;">
                            Restantes: @_quota.Remaining.ToString("N0")
                            · Modo: @(_quota.Hard ? "duro (bloquea al agotarse)" : "blando (solo alerta)")
                            · Reset: primero de cada mes UTC
                        </div>
                        <div style="background:#e5e7eb;border-radius:4px;height:8px;margin-top:6px;overflow:hidden;">
                            <div style="height:100%;width:@(_quota.UsedPct)%;background:@(_quota.UsedPct >= 90 ? "#dc2626" : _quota.UsedPct >= 70 ? "#f59e0b" : "#10b981");"></div>
                        </div>
                    </div>
                    @if (_quota.Exceeded)
                    {
                        <div class="rp-cupo-badge" style="background:#dc2626;color:#fff;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:700;">
                            AGOTADO
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (_quota is not null)
    {
        <div class="ase-card">
            <div class="ase-card-h">Cupo mensual de tokens IA</div>
            <div class="ase-card-body">
                <div class="text-muted">Este plan no tiene limite de tokens configurado.</div>
            </div>
        </div>
    }

    <div class="ase-card">
        <div class="ase-card-h">Trigger automatico</div>
        <div class="ase-card-body">
            <div class="rp-row rp-row-hero">
                <div class="rp-row-body">
                    <label class="form-check form-switch rp-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               @bind="_policy.AutoTriggerCierre" />
                        <span class="rp-switch-l">Enviar automaticamente a revision al cerrar HC</span>
                    </label>
                    <p class="rp-help">
                        Cuando esta activo, al pulsar <b>Guardar definitivamente</b> una HC,
                        el sistema crea la revision y la deja en la columna <b>Cerradas</b> del
                        Kanban en <a href="/ordenes" target="_blank">Ordenes Clinicas</a>.
                        Si esta desactivado, el profesional debe pulsar manualmente
                        <b>Enviar a revision</b> desde el tab Revision del modal HC.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="ase-card">
        <div class="ase-card-h">Parametros del ciclo</div>
        <div class="ase-card-body">
            <div class="rp-grid">
                <div class="rp-field">
                    <label>Motivo minimo al inactivar (caracteres)</label>
                    <input type="number" class="form-control form-control-sm"
                           min="0" max="500" step="1"
                           @bind="_policy.MotivoInactivacionMinChars" />
                    <small class="rp-help-sm">
                        Cuantos caracteres minimo se exigen al inactivar una revision.
                        El rechazo siempre exige texto no vacio, este ajuste solo aplica a la inactivacion.
                    </small>
                </div>

                <div class="rp-field">
                    <label>
                        <input type="checkbox" @bind="_policy.ConfirmarAprobado" />
                        Pedir confirmacion antes de aprobar
                    </label>
                    <small class="rp-help-sm">
                        Cuando esta activo, la UI del Kanban abre un modal preguntando
                        antes de mover una card a Aprobadas.
                    </small>
                </div>

                <div class="rp-field">
                    <label>
                        <input type="checkbox" @bind="_policy.NotificarRechazoWhatsApp" />
                        Notificar al profesional por WhatsApp cuando su HC es rechazada
                    </label>
                    <small class="rp-help-sm">
                        Cuando esta activo y hay linea WhatsApp conectada, el
                        profesional autor recibe un mensaje con el motivo y un link
                        para abrir la HC. Best-effort: si algo falla el rechazo se
                        aplica igual, solo se loguea el warning.
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="ase-card">
        <div class="ase-card-h">Agente IA (reservado para olas futuras)</div>
        <div class="ase-card-body">
            <p class="rp-help">
                Estos toggles quedan disponibles pero no tienen efecto hasta que el
                agente <b>REVISOR CLINICO IA</b> este operativo (Ola 5 del plan) y la
                adopcion automatica del veredicto este implementada (Ola 6). Puedes
                dejarlos como estan por ahora.
            </p>
            <div class="rp-grid">
                <div class="rp-field">
                    <label>
                        <input type="checkbox" @bind="_policy.PreRevisionIAAutoTrigger" />
                        Pre-revision IA automatica al crear la revision (Ola 5)
                    </label>
                </div>
                <div class="rp-field">
                    <label>
                        <input type="checkbox" @bind="_policy.AdopcionAutomaticaAgente" />
                        Adopcion automatica del veredicto del agente (Ola 6)
                    </label>
                </div>
                <div class="rp-field">
                    <label>Umbral de confianza (0-1) para adopcion automatica</label>
                    <input type="number" class="form-control form-control-sm"
                           min="0" max="1" step="0.01"
                           @bind="_policy.UmbralConfianza" />
                    <small class="rp-help-sm">Default 0.95. Un veredicto del agente por debajo de este umbral requiere humano.</small>
                </div>
                <div class="rp-field">
                    <label>Ventana de asignaciones relacionadas (dias)</label>
                    <input type="number" class="form-control form-control-sm"
                           min="1" max="365" step="1"
                           @bind="_policy.VentanaAsignacionesRelacionadasDias" />
                    <small class="rp-help-sm">Cuantos dias hacia atras el agente busca contexto de asignaciones del paciente.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="ase-card">
        <div class="ase-card-h">Historial del paciente para el agente IA</div>
        <div class="ase-card-body">
            <div class="rp-row rp-row-hero">
                <label class="rp-switch">
                    <input type="checkbox" @bind="_policy.EnviarHistorialPaciente" />
                    <span class="rp-switch-l">Enviar historial del paciente al agente de revisión</span>
                </label>
                <p class="rp-help">
                    Además de la historia que revisa, el agente recibe las historias <strong>anteriores</strong> del paciente
                    (por fecha de atención, en orden cronológico) como contexto separado. Las usa para validar continuidad,
                    evolución, texto copiado y contradicciones. El veredicto y los hallazgos son solo sobre la historia revisada.
                </p>
            </div>
            <div class="rp-grid" style="margin-top:12px;">
                <div class="rp-field">
                    <label>Meses hacia atrás</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="36" step="1"
                           disabled="@(!_policy.EnviarHistorialPaciente)"
                           @bind="_policy.HistorialMeses" />
                    <small class="rp-help-sm">Ventana desde la fecha de atención de la historia revisada. Default 8.</small>
                </div>
                <div class="rp-field">
                    <label>Máximo de historias completas</label>
                    <input type="number" class="form-control form-control-sm" min="0" max="100" step="1"
                           disabled="@(!_policy.EnviarHistorialPaciente)"
                           @bind="_policy.HistorialMaxCompletas" />
                    <small class="rp-help-sm">Las más recientes (priorizando el mismo tipo de servicio) van con todo su contenido; el resto de la ventana va solo como índice (fecha, formato, profesional). Default 30.</small>
                </div>
                <div class="rp-field">
                    <label>Tope de tokens del historial</label>
                    <input type="number" class="form-control form-control-sm" min="5000" max="120000" step="1000"
                           disabled="@(!_policy.EnviarHistorialPaciente)"
                           @bind="_policy.HistorialMaxTokens" />
                    <small class="rp-help-sm">Salvavidas de costo: si el historial se pasa, las historias completas más antiguas pasan a índice. Default 60.000.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="ase-card">
        <div class="ase-card-h">Auditoría IA al cerrar la historia</div>
        <div class="ase-card-body">
            <div class="rp-row rp-row-hero">
                <label class="rp-switch">
                    <input type="checkbox" @bind="_policy.AuditoriaIaAlCerrar" />
                    <span class="rp-switch-l">Auditar con IA al pulsar "Guardar definitivamente"</span>
                </label>
                <p class="rp-help">
                    Antes de cerrar, el agente de revisión audita la historia y le muestra el resultado al profesional.
                    Si la <strong>aprueba</strong>, la historia se cierra sola; si la <strong>rechaza</strong>, muestra los hallazgos y
                    el texto sugerido, y el profesional elige <em>volver a corregir</em> o <em>cerrar de todas formas</em>.
                    Es informativo: nunca bloquea el cierre. El resultado queda en Órdenes Clínicas sin volver a procesarlo.
                </p>
                <p class="rp-help">
                    Costo aproximado: ~US$0,025 por historia auditada (cada intento de cierre se audita). La aprobación
                    automática de la revisión usa <b>Adopción automática del veredicto</b> y el <b>umbral de confianza</b>
                    configurados arriba.
                </p>
            </div>
            <div class="rp-grid" style="margin-top:12px;">
                <div class="rp-field">
                    <label>Tiempo máximo de espera (segundos)</label>
                    <input type="number" class="form-control form-control-sm" min="30" max="180" step="5"
                           disabled="@(!_policy.AuditoriaIaAlCerrar)"
                           @bind="_policy.AuditoriaIaTimeoutSeg" />
                    <small class="rp-help-sm">Si la auditoría tarda más, la historia se cierra normal y la auditoría sigue en segundo plano. Default 90.</small>
                </div>
                <div class="rp-field">
                    <label>Formatos que se auditan al cerrar (@(_formatosSel.Count == 0 ? "todos" : _formatosSel.Count.ToString()))</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Buscar formato..."
                           disabled="@(!_policy.AuditoriaIaAlCerrar)"
                           @bind="_formatoFiltro" @bind:event="oninput" />
                    <div class="rp-fmt-list">
                        @foreach (var f in _formatos.Where(f => string.IsNullOrWhiteSpace(_formatoFiltro)
                                                              || (f.Codigo + " " + f.Nombre).Contains(_formatoFiltro, StringComparison.OrdinalIgnoreCase)))
                        {
                            var marcado = _formatosSel.Contains(f.Codigo);
                            <label class="rp-fmt">
                                <input type="checkbox" checked="@marcado" disabled="@(!_policy.AuditoriaIaAlCerrar)"
                                       @onchange="e => ToggleFormato(f.Codigo, e.Value is bool b && b)" />
                                <span>@f.Nombre</span>
                            </label>
                        }
                    </div>
                    <small class="rp-help-sm">Ninguno marcado = se auditan todos los formatos. Marca algunos para un piloto.</small>
                </div>
            </div>
        </div>
    </div>

    @if (_msg is not null) { <div class="ase-ok" style="margin-top:12px;">@_msg</div> }
    @if (_error is not null) { <div class="ase-alert" style="margin-top:12px;">@_error</div> }

    <div class="rp-actions">
        <button class="btn btn-primary" @onclick="GuardarAsync" disabled="@_guardando">
            @(_guardando ? "Guardando..." : "💾 Guardar politica")
        </button>
    </div>
}

<style>
    .rp-row { padding:16px 20px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; }
    .rp-row-hero { border-left:4px solid #1565c0; background:#f0f9ff; }
    .rp-switch { display:flex; align-items:center; gap:10px; margin:0; font-size:14px; }
    .rp-switch input { width:44px; height:24px; }
    .rp-switch-l { font-weight:600; color:#0f172a; }
    .rp-help { color:#475569; font-size:12.5px; margin:8px 0 0; }
    .rp-help-sm { color:#64748b; font-size:11.5px; display:block; margin-top:2px; }
    .rp-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px,1fr)); gap:16px; }
    .rp-field { background:#fff; padding:12px 14px; border:1px solid #e5e7eb; border-radius:6px; }
    .rp-field > label { display:block; font-size:12px; font-weight:600; color:#334155; margin-bottom:6px; }
    .rp-field input[type=checkbox] { margin-right:6px; }
    .rp-actions { display:flex; justify-content:flex-end; padding:14px 0; }
    .rp-fmt-list { max-height:220px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:6px; padding:6px 8px; margin-top:6px; }
    .rp-fmt { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:400 !important; color:#334155; padding:2px 0; margin:0; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private sealed class PolicyModel
    {
        public bool AutoTriggerCierre { get; set; }
        public bool PreRevisionIAAutoTrigger { get; set; }
        public bool AdopcionAutomaticaAgente { get; set; }
        public decimal UmbralConfianza { get; set; }
        public int VentanaAsignacionesRelacionadasDias { get; set; }
        public bool ConfirmarAprobado { get; set; }
        public int MotivoInactivacionMinChars { get; set; }
        public bool NotificarRechazoWhatsApp { get; set; }
        public bool EnviarHistorialPaciente { get; set; } = true;
        public int HistorialMeses { get; set; } = 8;
        public int HistorialMaxCompletas { get; set; } = 30;
        public int HistorialMaxTokens { get; set; } = 60000;
        public bool AuditoriaIaAlCerrar { get; set; }
        public int AuditoriaIaTimeoutSeg { get; set; } = 90;
    }

    private PolicyModel? _policy;
    private AiQuotaDto? _quota;
    private bool _cargando = true;
    private bool _guardando;
    private bool _puedeConfig;
    private Guid _actorId;
    private string? _msg;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ResolverPermisosAsync();
        if (_puedeConfig)
        {
            await CargarAsync();
            try { _quota = await UsageSvc.GetQuotaAsync(); }
            catch { /* Sin cupo (edge case en dev sin plan) — el widget se oculta. */ }
        }
        _cargando = false;
    }

    private async Task ResolverPermisosAsync()
    {
        if (AuthState is null) { return; }
        try
        {
            var state = await AuthState;
            var tenantRole = state.User.FindFirst("tenant_role")?.Value;
            var platformRole = state.User.FindFirst("platform_role")?.Value;
            _puedeConfig = string.Equals(tenantRole, "Owner", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(platformRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
            var uidStr = state.User.FindFirst("user_id")?.Value ?? state.User.FindFirst("sub")?.Value;
            _actorId = Guid.TryParse(uidStr, out var uid) ? uid : Guid.Empty;
        }
        catch { }
    }

    private async Task CargarAsync()
    {
        try
        {
            var dto = await Svc.GetAsync();
            _policy = new PolicyModel
            {
                AutoTriggerCierre = dto.AutoTriggerCierre,
                PreRevisionIAAutoTrigger = dto.PreRevisionIAAutoTrigger,
                AdopcionAutomaticaAgente = dto.AdopcionAutomaticaAgente,
                UmbralConfianza = dto.UmbralConfianza,
                VentanaAsignacionesRelacionadasDias = dto.VentanaAsignacionesRelacionadasDias,
                ConfirmarAprobado = dto.ConfirmarAprobado,
                MotivoInactivacionMinChars = dto.MotivoInactivacionMinChars,
                NotificarRechazoWhatsApp = dto.NotificarRechazoWhatsApp,
                EnviarHistorialPaciente = dto.EnviarHistorialPaciente,
                HistorialMeses = dto.HistorialMeses,
                HistorialMaxCompletas = dto.HistorialMaxCompletas,
                HistorialMaxTokens = dto.HistorialMaxTokens,
                AuditoriaIaAlCerrar = dto.AuditoriaIaAlCerrar,
                AuditoriaIaTimeoutSeg = dto.AuditoriaIaTimeoutSeg,
            };
            _formatosSel = new HashSet<string>(dto.AuditoriaIaFormatos ?? Array.Empty<string>(), StringComparer.OrdinalIgnoreCase);
            try
            {
                // Formatos clinicos activos (sin las ordenes ni escalas/consentimientos).
                var excluir = new[] { "FORMATO", "ESCALAS", "CONSENTIMIENTO" };
                _formatos = (await FormsSvc.ListAsync())
                    .Where(f => f.Activo && !string.IsNullOrWhiteSpace(f.Codigo)
                                && !excluir.Contains((f.Tipo ?? "").Trim().ToUpperInvariant()))
                    .OrderBy(f => f.Nombre, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch { _formatos = new(); }
        }
        catch (Exception ex) { _error = "No se pudo cargar la politica: " + ex.Message; }
    }

    private List<Visal.Application.Tenancy.FormDefinitionDto> _formatos = new();
    private HashSet<string> _formatosSel = new(StringComparer.OrdinalIgnoreCase);
    private string _formatoFiltro = "";

    private void ToggleFormato(string codigo, bool marcado)
    {
        if (marcado) { _formatosSel.Add(codigo); } else { _formatosSel.Remove(codigo); }
    }

    private async Task GuardarAsync()
    {
        if (_policy is null) { return; }
        _guardando = true;
        _msg = null; _error = null;
        try
        {
            var dto = new RevisionPolicyDto(
                _policy.AutoTriggerCierre,
                _policy.PreRevisionIAAutoTrigger,
                _policy.AdopcionAutomaticaAgente,
                _policy.UmbralConfianza,
                _policy.VentanaAsignacionesRelacionadasDias,
                _policy.ConfirmarAprobado,
                _policy.MotivoInactivacionMinChars,
                _policy.NotificarRechazoWhatsApp,
                _policy.EnviarHistorialPaciente,
                _policy.HistorialMeses,
                _policy.HistorialMaxCompletas,
                _policy.HistorialMaxTokens,
                _policy.AuditoriaIaAlCerrar,
                _formatosSel.ToList(),
                _policy.AuditoriaIaTimeoutSeg);
            await Svc.SaveAsync(dto, _actorId);
            _msg = "Politica guardada. Aplica en el proximo cierre de HC.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }
}
