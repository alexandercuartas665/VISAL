.seg-tabs { display:flex; gap:.25rem; border-bottom:1px solid #e5e7eb; margin-bottom:1rem; }
.seg-tab { background:transparent; border:none; padding:.55rem 1rem; font-size:.9rem; color:#64748b; cursor:pointer; border-bottom:2px solid transparent; }
