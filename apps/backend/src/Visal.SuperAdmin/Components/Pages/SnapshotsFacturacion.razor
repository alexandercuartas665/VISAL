    // Modal Archivar.
    private bool _showArchivar;
    private Guid _archivarId;
    private string _archivarNombre = "";
    private string _archivarMotivo = "";
    private bool _archivando;
    private string? _archivarErr;

    // Modal Configurar columnas (aplica al archivo Excel/CSV de salida).
    private bool _showColConfig;
    private TipoSnapshot _colConfigTipo = TipoSnapshot.RelacionFacturas;
    private List<ColumnaConfigItemDto> _colConfigItems = new();
    private bool _colConfigCargando;
    private bool _colConfigGuardando;
    private string? _colConfigErr;

    // Usuario / permisos.
    private Guid _actorId;
    private bool _esAdminAgencia;
    private Guid? _completandoId;

    /// <summary>Completa HC N° / Cod. Asignacion en un snapshot viejo, de forma segura
    /// (reconstruye con los mismos filtros y verifica fila por fila). Si no alinea, no
    /// toca nada y muestra el motivo.</summary>
    private async Task CompletarCodigos(Guid snapshotId)
    {
        _error = null; _ok = null;
        _completandoId = snapshotId;
        try
        {
            var r = await Svc.CompletarCodigosSnapshotAsync(snapshotId, _actorId);
            if (r.Ok) { _ok = r.Mensaje; await CargarLista(); }
            else { _error = r.Mensaje; }
        }
        catch (Exception ex) { _error = "Error al completar códigos: " + ex.Message; }
        finally { _completandoId = null; }
