.ep-card-top { display:flex; justify-content:space-between; align-items:flex-start; }
.ep-card-name { font-weight:600; color:#0f172a; }
.ep-card-email { color:#64748b; font-size:.8rem; }
.ep-badge { font-size:.7rem; padding:.12rem .5rem; border-radius:99px; }
.ep-badge-on { background:#dcfce7; color:#15803d; }
.ep-badge-off { background:#f1f5f9; color:#64748b; }
