<script>
    window.visalAuth = {
        show: function (mode) {
            var shell = document.querySelector('.axon-shell');
            if (!shell) return;
            shell.classList.toggle('is-signup', mode === 'signup');
        },
        toggle: function (id, btn) {
            var input = document.getElementById(id);
            if (!input) return;
            // Solo alterna el tipo; el boton conserva su icono de ojo.
            input.type = input.type === 'password' ? 'text' : 'password';
            if (btn) { btn.classList.toggle('is-on'); }
        },
        googleSignup: function () {
            var input = document.getElementById('reg-agency');
            var hint = document.getElementById('reg-google-hint');
            var agency = input ? (input.value || '').trim() : '';
            if (!agency) {
                if (hint) hint.hidden = false;
                if (input) { input.classList.add('axon-input-error'); input.focus(); }
                return;
            }
            if (hint) hint.hidden = true;
            window.location = '/connect/google?mode=signup&agency=' + encodeURIComponent(agency);
        }
    };

    // Al escribir el usuario en el login, filtramos el dropdown SEDE a las sedes
    // que ese usuario tiene asignadas. Si el usuario no existe, el backend devuelve
    // el listado completo (fallback anti-enumeracion), asi no revelamos existencia.
    (function () {
        var usuarioInput = document.getElementById('login-usuario');
        var sedeSelect = document.getElementById('login-sede');
        if (!usuarioInput || !sedeSelect) return;

        var lastQuery = null;
        var pending = null;

        function refreshSedes() {
            var q = (usuarioInput.value || '').trim();
            if (q === lastQuery) return;
            lastQuery = q;

            fetch('/api/login/sedes?usuario=' + encodeURIComponent(q), {
                headers: { 'Accept': 'application/json' },
                credentials: 'same-origin'
            })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data) return;
                    var previo = sedeSelect.value;
                    sedeSelect.innerHTML = '';
                    var ph = document.createElement('option');
                    ph.value = '';
                    ph.disabled = true;
                    ph.selected = true;
                    ph.textContent = 'Selecciona SEDE';
                    sedeSelect.appendChild(ph);

                    if (data.mostrarGlobal) {
                        var g = document.createElement('option');
                        g.value = 'GLOBAL';
                        g.textContent = 'GLOBAL';
                        sedeSelect.appendChild(g);
                    }
                    (data.sedes || []).forEach(function (s) {
                        var opt = document.createElement('option');
                        opt.value = s.id;
                        opt.textContent = s.nombre;
                        sedeSelect.appendChild(opt);
                    });

                    if (previo) {
                        var match = Array.prototype.find.call(sedeSelect.options, function (o) { return o.value === previo; });
                        if (match) { sedeSelect.value = previo; }
                    }
                })
                .catch(function () { /* silencioso: dejamos el listado actual */ });
        }

        function schedule() {
            if (pending) { clearTimeout(pending); }
            pending = setTimeout(refreshSedes, 250);
        }

        usuarioInput.addEventListener('change', refreshSedes);
        usuarioInput.addEventListener('blur', refreshSedes);
        usuarioInput.addEventListener('input', schedule);
    })();
</script>

@code {
    [SupplyParameterFromQuery] public int? Error { get; set; }
    [SupplyParameterFromQuery] public int? Reset { get; set; }
    [SupplyParameterFromQuery] public string? RegError { get; set; }
    [SupplyParameterFromQuery(Name = "gerror")] public string? GError { get; set; }
    [SupplyParameterFromQuery] public string? Mode { get; set; }

    private Visal.Application.Admin.PlatformBrandingDto _brand = Visal.Application.Admin.PlatformBrandingDto.Default;
    private bool _googleEnabled;
    private List<Visal.Application.Tenancy.SedePublicaDto> _sedes = new();

    // Logo y nombre que finalmente se renderizan en el panel de la izquierda.
    // Resueltos en OnInitializedAsync con la regla:
    //   1) Branding de plataforma (configurado por super-admin) tiene prioridad.
    //   2) Si no esta puesto, cae al logo/nombre del tenant principal (Mi cuenta).
    //   3) Si no hay ninguno, queda el default del PlatformBrandingDto.
    private string _displayName = "Visal";
    private string? _logoUrl;

    private bool StartSignup => string.Equals(Mode, "signup", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(RegError);

    protected override async Task OnInitializedAsync()
    {
        _brand = await BrandingSvc.GetAsync();
        _googleEnabled = (await GoogleCfg.GetAsync())?.IsEnabled == true;
        _sedes = (await SedesSvc.ListAsync()).ToList();

        // Empezamos con lo que dijo el branding de plataforma.
        _displayName = _brand.PlatformName;
        _logoUrl = _brand.LoginLogoUrl;

        // Si la plataforma no configuro logo (o el nombre quedo en "Visal" default),
        // intentamos cargar el branding del tenant principal de esta instancia.
        // Eso cubre instalaciones on-premise donde hay un solo tenant operando.
        var sinLogo = string.IsNullOrWhiteSpace(_logoUrl);
        var nombreDefault = string.Equals(_displayName, "Visal", StringComparison.OrdinalIgnoreCase);
        if (sinLogo || nombreDefault)
        {
            var t = await TenantBrand.GetDefaultAsync();
            if (t is not null)
            {
                if (sinLogo) { _logoUrl = t.LogoUrl; }
                if (nombreDefault && !string.IsNullOrWhiteSpace(t.Name)) { _displayName = t.Name; }
            }
        }
    }
}
