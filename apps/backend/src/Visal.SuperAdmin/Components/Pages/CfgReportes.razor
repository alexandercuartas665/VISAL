@page "/config/reportes"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Visal.Application.Tenancy
@using Visal.Application.Common
@using Microsoft.EntityFrameworkCore
@inject IReporteService ReportSvc
@inject IApplicationDbContext Db

<PageTitle>Reportes - Visal</PageTitle>

<div class="gr-page">
    <div class="gr-head">
        <div>
            <div class="gr-eyebrow">Administracion</div>
            <h1 class="gr-title">Galeria de reportes</h1>
            <div class="gr-sub">Activa los reportes que quieres usar en tu agencia y define que usuarios pueden verlos.
                Los reportes los define y publica el equipo de plataforma.</div>
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <div class="gr-empty">No hay reportes publicados en el catalogo todavia.</div>
    }
    else
    {
        <div class="gr-cards">
            @foreach (var r in _items)
            {
                <div class="gr-card @(r.Activo ? "gr-on" : "")">
                    <div class="gr-card-top">
                        <div class="gr-card-icon">📊</div>
                        <label class="gr-switch" title="@(r.Activo ? "Activo" : "Inactivo")">
                            <input type="checkbox" checked="@r.Activo" @onchange="e => ToggleActivoAsync(r, (bool)(e.Value ?? false))" />
                            <span class="gr-slider"></span>
                        </label>
                    </div>
                    <div class="gr-card-title">@r.Nombre</div>
                    <div class="gr-card-desc">@(string.IsNullOrWhiteSpace(r.Descripcion) ? "(Sin descripcion)" : r.Descripcion)</div>
                    <div class="gr-card-tags">
                        @if (!string.IsNullOrWhiteSpace(r.Categoria)) { <span class="gr-tag gr-tag-cat">@r.Categoria</span> }
                        @if (r.FiltraFechas) { <span class="gr-tag">Fechas</span> }
                        @if (r.FiltraSede) { <span class="gr-tag">Sede</span> }
                    </div>
                    <div class="gr-card-foot">
                        <span class="gr-users-count">
                            @(r.UsuariosAsignados.Count == 0 ? "Visible para todos" : $"{r.UsuariosAsignados.Count} usuario(s)")
                        </span>
                        <button class="btn-outline btn-sm" disabled="@(!r.Activo)" @onclick="() => AbrirUsuarios(r)">Usuarios</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="gr-toast @(_error ? "gr-toast-err" : "gr-toast-ok")">@_msg</div>
    }
</div>

@if (_editUsuarios is not null)
{
    <div class="gr-modal-back" @onclick="CerrarUsuarios"></div>
    <div class="gr-modal">
        <div class="gr-modal-head">
            <div>
                <div class="gr-modal-eyebrow">Permisos de visualizacion</div>
                <h3>@_editUsuarios.Nombre</h3>
            </div>
            <button class="gr-close" @onclick="CerrarUsuarios">×</button>
        </div>
        <div class="gr-modal-body">
            <label class="gr-hint">Usuarios que pueden ver este reporte (deja vacio = visible para todos con acceso al modulo):</label>
            <input class="gr-user-search" type="text" placeholder="Buscar usuario por nombre o correo..."
                   value="@_userFilter" @oninput="e => _userFilter = e.Value?.ToString() ?? string.Empty" />
            @{ var visibles = FiltrarUsuarios().ToList(); }
            <div class="gr-users-list">
                @foreach (var u in visibles)
                {
                    var yes = _seleccion.Contains(u.Id);
                    <label class="gr-user">
                        <input type="checkbox" checked="@yes" @onchange="e => ToggleUsuario(u.Id, (bool)(e.Value ?? false))" />
                        @u.Nombre <small>@u.Email</small>
                    </label>
                }
                @if (visibles.Count == 0)
                {
                    <div class="gr-user-empty">Sin coincidencias para "@_userFilter".</div>
                }
            </div>
            <div class="gr-user-count">@_seleccion.Count usuario(s) seleccionado(s)</div>
        </div>
        <div class="gr-modal-foot">
            <button class="btn-outline" @onclick="CerrarUsuarios">Cancelar</button>
            <button class="btn-primary" @onclick="GuardarUsuariosAsync">Guardar</button>
        </div>
    </div>
}

<style>
.gr-page { padding: 1rem 1.25rem; }
.gr-head { margin-bottom: 1rem; }
.gr-eyebrow { color:#64748b; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; }
.gr-title { margin:.15rem 0 0 0; font-size:1.55rem; color:#0f172a; }
.gr-sub { color:#64748b; font-size:.85rem; margin-top:.35rem; max-width:720px; }
.gr-empty { padding:2rem; text-align:center; color:#94a3b8; }

.gr-cards { display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap:.85rem; }
.gr-card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:.9rem 1rem; display:flex; flex-direction:column; gap:.4rem; transition: box-shadow .15s, border-color .15s; }
.gr-card.gr-on { border-color:#93c5fd; box-shadow: 0 2px 10px rgba(37,99,235,.08); }
.gr-card-top { display:flex; justify-content:space-between; align-items:center; }
.gr-card-icon { font-size:1.7rem; line-height:1; }
.gr-card-title { font-weight:600; color:#0f172a; }
.gr-card-desc { color:#64748b; font-size:.8rem; line-height:1.35; min-height:2.1em; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.gr-card-tags { display:flex; gap:.3rem; flex-wrap:wrap; }
.gr-tag { background:#eff6ff; color:#1e3a8a; font-size:.7rem; padding:.1rem .45rem; border-radius:99px; }
.gr-tag-cat { background:#f1f5f9; color:#334155; }
.gr-card-foot { display:flex; justify-content:space-between; align-items:center; margin-top:.35rem; padding-top:.55rem; border-top:1px solid #f1f5f9; }
.gr-users-count { font-size:.76rem; color:#64748b; }

.gr-switch { position:relative; display:inline-block; width:42px; height:22px; }
.gr-switch input { opacity:0; width:0; height:0; }
.gr-slider { position:absolute; cursor:pointer; inset:0; background:#cbd5e1; border-radius:99px; transition:.15s; }
.gr-slider:before { content:""; position:absolute; height:16px; width:16px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:.15s; }
.gr-switch input:checked + .gr-slider { background:#2563eb; }
.gr-switch input:checked + .gr-slider:before { transform:translateX(20px); }

.gr-modal-back { position:fixed; inset:0; background:rgba(15,23,42,.4); z-index:1400; }
.gr-modal { position:fixed; top:5%; left:50%; transform:translateX(-50%); width:min(640px, 96vw); max-height:90vh;
            background:#fff; border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.25); z-index:1401; display:flex; flex-direction:column; overflow:hidden; }
.gr-modal-head { display:flex; justify-content:space-between; align-items:flex-start; padding:.85rem 1.15rem; border-bottom:1px solid #e5e7eb; }
.gr-modal-eyebrow { color:#64748b; font-size:.72rem; text-transform:uppercase; letter-spacing:.06em; }
.gr-modal-head h3 { margin:.15rem 0 0; font-size:1.15rem; color:#0f172a; }
.gr-close { background:transparent; border:none; font-size:1.5rem; line-height:1; cursor:pointer; color:#64748b; }
.gr-modal-body { padding:1rem 1.15rem; overflow:auto; }
.gr-hint { display:block; font-size:.8rem; color:#334155; margin-bottom:.5rem; }
.gr-users-list { display:grid; grid-template-columns: repeat(2, 1fr); gap:.35rem; max-height:320px; overflow:auto; border:1px solid #e5e7eb; padding:.5rem; border-radius:8px; }
.gr-user { display:flex; gap:.4rem; align-items:center; font-size:.85rem; }
.gr-user small { color:#94a3b8; }
.gr-user-search { width:100%; padding:.5rem .65rem; border:1px solid #cbd5e1; border-radius:8px; margin-bottom:.5rem; font:inherit; }
.gr-user-empty { grid-column:1/-1; color:#94a3b8; text-align:center; padding:.75rem 0; font-size:.85rem; }
.gr-user-count { margin-top:.5rem; font-size:.78rem; color:#64748b; }
.gr-modal-foot { padding:.75rem 1.15rem; border-top:1px solid #e5e7eb; display:flex; justify-content:flex-end; gap:.5rem; }
.gr-toast { position:fixed; bottom:1.25rem; left:50%; transform:translateX(-50%); padding:.55rem 1rem; border-radius:8px; font-size:.85rem; z-index:1500; box-shadow:0 6px 20px rgba(0,0,0,.15); }
.gr-toast-ok { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.gr-toast-err { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
.btn-primary { background:#2563eb; color:#fff; border:none; padding:.45rem .95rem; border-radius:6px; cursor:pointer; }
.btn-outline { background:#fff; color:#334155; border:1px solid #cbd5e1; padding:.4rem .75rem; border-radius:6px; cursor:pointer; }
.btn-outline:disabled { opacity:.5; cursor:not-allowed; }
.btn-sm { padding:.25rem .6rem; font-size:.8rem; }
</style>

@code {
    private record UsuarioItem(Guid Id, string Nombre, string Email);

    private List<ReporteGaleriaDto> _items = new();
    private List<UsuarioItem> _usuarios = new();
    private ReporteGaleriaDto? _editUsuarios;
    private HashSet<Guid> _seleccion = new();
    private string _userFilter = string.Empty;
    private string _msg = string.Empty;
    private bool _error;

    private IEnumerable<UsuarioItem> FiltrarUsuarios()
    {
        var q = _usuarios.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_userFilter))
        {
            var f = _userFilter.Trim().ToLowerInvariant();
            q = q.Where(u => u.Nombre.ToLowerInvariant().Contains(f) || u.Email.ToLowerInvariant().Contains(f));
        }
        return q;
    }

    protected override async Task OnInitializedAsync()
    {
        await RecargarAsync();
        _usuarios = await ((DbContext)Db).Set<Visal.Domain.Entities.PlatformUser>().AsNoTracking()
            .OrderBy(u => u.DisplayName ?? u.Username)
            .Select(u => new UsuarioItem(u.Id, u.DisplayName ?? u.Username ?? "(sin nombre)", u.Email ?? ""))
            .ToListAsync();
    }

    private async Task RecargarAsync()
    {
        _items = (await ReportSvc.ListarGaleriaAsync()).ToList();
    }

    private async Task ToggleActivoAsync(ReporteGaleriaDto r, bool on)
    {
        try
        {
            await ReportSvc.SetActivoAsync(r.Id, on, Guid.Empty);
            await RecargarAsync();
            Toast(on ? $"'{r.Nombre}' activado." : $"'{r.Nombre}' desactivado.", false);
        }
        catch (Exception ex) { Toast(ex.Message, true); await RecargarAsync(); }
    }

    private void AbrirUsuarios(ReporteGaleriaDto r)
    {
        _editUsuarios = r;
        _seleccion = r.UsuariosAsignados.ToHashSet();
        _userFilter = string.Empty;
    }

    private void CerrarUsuarios() { _editUsuarios = null; _seleccion = new(); _userFilter = string.Empty; }

    private void ToggleUsuario(Guid uid, bool on)
    {
        if (on) { _seleccion.Add(uid); } else { _seleccion.Remove(uid); }
    }

    private async Task GuardarUsuariosAsync()
    {
        if (_editUsuarios is null) { return; }
        try
        {
            await ReportSvc.SetUsuariosAsync(_editUsuarios.Id, _seleccion.ToList(), Guid.Empty);
            await RecargarAsync();
            CerrarUsuarios();
            Toast("Permisos actualizados.", false);
        }
        catch (Exception ex) { Toast(ex.Message, true); }
    }

    private void Toast(string m, bool err) { _msg = m; _error = err; }
}
