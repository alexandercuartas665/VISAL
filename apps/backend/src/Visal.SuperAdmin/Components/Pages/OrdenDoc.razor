@page "/orden-doc/{HcId:guid}/{Tipo}"
@page "/orden-doc/{HcId:guid}/{Tipo}/{NumeroOrden:int}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Visal.Application.Tenancy
@using Visal.Application.Tenancy.Forms
@using Visal.SuperAdmin.Components.Forms
@inject IHistoriaClinicaService HcSvc
@inject IAsignacionService AsigSvc
@inject IFormDefinitionService FormsSvc
@inject IOrdenMedicamentoService MedSvc
@inject IInsumoService InsumoSvc
@inject IOrdenServicioService SrvSvc
@inject IIncapacidadService IncSvc
@inject ICertificacionService CertSvc
@inject ISuministroMedicamentoService SumMedSvc
@inject IOrdenMedicamentoPublicaService PubSvc
@inject IFirmaResolverService FirmaResolverSvc
@inject IJSRuntime JS

@*
   Vista documento de una "Orden" emitida durante una atencion. Resuelve el
   FormDefinition activo por Tipo (ORDEN_MEDICAMENTOS / ORDEN_SERVICIOS /
   REMISIONES / INCAPACIDADES / CERTIFICADOS) y arma una pagina imprimible:
   encabezado (del Form), datos del paciente (de la HC), una tabla con los
   items YA persistidos en la HC para ese tipo, y el pie de firma.
*@

<PageTitle>@(_titulo) - Visal</PageTitle>

<style>
    .doc-actions { display: flex; gap: 8px; align-items: center; margin: 14px auto; max-width: 920px; }
    .doc-actions .dbtn { padding: 8px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); font-size: 13px; font-weight: 600; cursor: pointer; color: var(--foreground); text-decoration: none; }
    .doc-actions .dbtn.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .doc-actions .spacer { flex: 1; }
    .doc-actions .meta { font-size: 12px; color: var(--muted-foreground); }

    .doc { max-width: 920px; margin: 0 auto; background: #fff; color: #000; font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; line-height: 1.35; border: 1px solid #000; }
    .doc-header { border-bottom: 1px solid #000; padding: 8px 10px; }
    .doc-hdr-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .doc-hdr-brand { display: flex; align-items: center; gap: 8px; }
    .doc-hdr-brand svg { width: 30px; height: 30px; color: #1565c0; }
    .doc-hdr-logo { max-height: 48px; max-width: 180px; object-fit: contain; }
    .doc-hdr-inst { font-size: 16px; font-weight: 800; color: #1565c0; letter-spacing: .02em; }
    .doc-hdr-tag { font-size: 10px; font-style: italic; color: #555; }
    .doc-hdr-nohist { font-size: 11px; white-space: nowrap; text-align: right; }
    .doc-hdr-nohist b { font-size: 12px; color: #1565c0; }
    .doc-hdr-title { text-align: center; font-size: 15px; font-weight: 800; text-transform: uppercase; margin: 6px 0; }
    .doc-hdr-meta { display: flex; gap: 28px; font-size: 11px; flex-wrap: wrap; }
    .doc-hdr-meta b { color: #1565c0; }

    .doc-band { background: #dde7f3; font-weight: 800; font-size: 11px; padding: 4px 8px; text-transform: uppercase; border-bottom: 1px solid #000; letter-spacing: .04em; }
    .doc-table { width: 100%; border-collapse: collapse; }
    .doc-table th { border: 1px solid #000; background: #dde7f3; font-size: 10px; padding: 4px 6px; text-align: left; font-weight: 700; text-transform: uppercase; }
    .doc-table td { border: 1px solid #000; padding: 4px 6px; font-size: 11px; vertical-align: top; }
    .doc-table td.mono { font-family: 'JetBrains Mono', 'Consolas', monospace; font-size: 10.5px; }
    .doc-table td.num { text-align: center; }
    .doc-empty-row { text-align: center; font-style: italic; color: #666; padding: 18px !important; }

    .doc-section { padding: 8px 10px; border-bottom: 1px solid #000; white-space: pre-wrap; font-size: 11.5px; }
    .doc-section h4 { margin: 0 0 4px; font-size: 11px; text-transform: uppercase; color: #1565c0; }

    .doc-footer { display: flex; justify-content: space-between; gap: 24px; padding: 24px 14px 12px; border-top: 1px solid #000; margin-top: 0; font-size: 11px; }
    .doc-firma { flex: 1; max-width: 280px; }
    .doc-firma-line { border-top: 1px solid #000; padding-top: 4px; font-weight: 700; }
    .doc-firma-rol { font-size: 10px; color: #555; }

    @@media print {
        .visal-sidebar, .visal-topbar, .doc-actions { display: none !important; }
        .visal-main, .visal-shell { margin: 0 !important; padding: 0 !important; }
        .doc { max-width: none; border: 1px solid #000; }
        body { background: #fff !important; }
        @@page { size: A4; margin: 12mm; }
    }
</style>

@if (_loading)
{
    <p class="doc-actions">Cargando orden...</p>
}
else if (_hc is null)
{
    <p class="doc-actions">Historia clinica no encontrada.</p>
}
else if (_form is null && !string.Equals(Tipo, "REGISTRO_MEDICAMENTOS", StringComparison.OrdinalIgnoreCase))
{
    @* REGISTRO_MEDICAMENTOS es autocontenido — no depende de un FormDefinition
       porque el layout es fijo (bitacora de administracion). Para todos los
       demas tipos exigimos el form activo (header + firmas del formato). *@
    <p class="doc-actions">
        No hay un formulario activo del tipo <b>@Tipo</b> en este tenant.
        Crea uno desde <a href="/formularios" target="_blank">/formularios</a> antes de imprimir.
    </p>
}
else
{
    var esMed = string.Equals(Tipo, "ORDEN_MEDICAMENTOS", StringComparison.OrdinalIgnoreCase);
    var esMedEmitida = esMed && _emision is not null;

    <div class="doc-actions">
        <a class="dbtn" href="javascript:window.close()">&times; Cerrar</a>
        @* Un solo boton: al imprimir una orden de medicamentos se emite
           automaticamente (firma + QR + snapshot inmutable) si aun no lo estaba,
           para que el documento salga siempre con su codigo de verificacion. El
           resto de tipos (y las ya emitidas) solo imprime. *@
        <button class="dbtn primary" @onclick="ImprimirAsync" disabled="@_emitBusy">
            @if (_emitBusy)
            {
                <text>Preparando...</text>
            }
            else
            {
                <text>&#128424; Imprimir / Guardar PDF</text>
            }
        </button>
        @if (esMedEmitida)
        {
            <button class="dbtn" style="border-color:#dc2626;color:#dc2626;" @onclick="RevocarOrdenAsync" disabled="@_emitBusy"
                    title="Anula la emision para poder editar la orden; luego vuelves a imprimir">Revocar</button>
        }
        <span class="spacer"></span>
        @if (esMedEmitida)
        {
            <span class="meta">Emitida @_emision!.EmitidoAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm") &middot; Codigo <b>@_emision!.Codigo</b></span>
        }
        else
        {
            <span class="meta">Formato: <b>@(_form?.Codigo ?? "REGMED")</b> &middot; @_tipoLabel</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(_emitError))
    {
        <div class="doc-actions" style="color:#dc2626;">@_emitError</div>
    }

    @if (esMedEmitida)
    {
        @* Orden emitida: documento firmado, inmutable, schema-driven con el QR
           (viene del snapshot congelado — no se recalcula desde la HC actual). *@
        <div class="doc">
            <DocumentoImprimible Schema="_schema" Values="_emisionBag"
                PacienteNombre="@(_paciente?.NombreCompleto)"
                PacienteTipoDoc="@(_paciente?.TipoDocumento)"
                PacienteDoc="@(_paciente?.NumeroDocumento)"
                EspecialistaNombre="@(_hc?.EspecialistaNombre)"
                MostrarPieFormula="@DocumentoImprimible.EsFormatoOrdenMedicamentos(_form?.Codigo, _form?.CodigoSecundario, Tipo)"
                FechaLinea="@FechaFormulaOrd()"
                OrdenNum="@_ordenNumero" TipoCortoHeader="ORD" TituloFallback="@_tipoLabel" />
        </div>
    }
    else
    {
    <div class="doc">
        @* ============ ENCABEZADO (del FormDefinition) ============ *@
        <div class="doc-header">
            <div class="doc-hdr-top">
                <div class="doc-hdr-brand">
                    @if (!string.IsNullOrWhiteSpace(Hdr.LogoUrl))
                    {
                        <img class="doc-hdr-logo" src="@Hdr.LogoUrl" alt="logo" />
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    }
                    <div>
                        <div class="doc-hdr-inst">@Hdr.Institucion</div>
                        <div class="doc-hdr-tag">@Hdr.Tagline</div>
                    </div>
                </div>
                <div class="doc-hdr-nohist">
                    Orden N°: <b>@_ordenNumero</b><br />
                    Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")<br />
                    HC: <b>@_hc.Id.ToString().Substring(0,8).ToUpperInvariant()</b>
                </div>
            </div>
            <div class="doc-hdr-title">@(_form?.Nombre ?? _tipoLabel)</div>
            <div class="doc-hdr-meta">
                <span><b>Paciente:</b> @(_paciente?.NombreCompleto ?? "-")</span>
                <span><b>Doc:</b> @(_paciente?.TipoDocumento) @(_paciente?.NumeroDocumento)</span>
                @if (!string.IsNullOrWhiteSpace(_hc.EspecialistaNombre))
                {
                    <span><b>Atiende:</b> @_hc.EspecialistaNombre</span>
                }
            </div>
        </div>

        @* ============ CUERPO: tabla / texto segun Tipo ============ *@
        <div class="doc-band">Detalle de la orden</div>

        @switch (Tipo.ToUpperInvariant())
        {
            case "ORDEN_MEDICAMENTOS":
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th>Medicamento</th>
                            <th style="width:140px">Posologia</th>
                            <th style="width:80px">Cantidad</th>
                            <th>Observacion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_meds.Count == 0)
                        {
                            <tr><td colspan="5" class="doc-empty-row">No hay medicamentos registrados en esta historia.</td></tr>
                        }
                        else
                        {
                            @foreach (var m in _meds)
                            {
                                <tr>
                                    <td class="num">@m.Orden</td>
                                    <td><b>@m.NombreMedicamento</b></td>
                                    <td>@(string.IsNullOrWhiteSpace(m.Posologia) ? "-" : m.Posologia)</td>
                                    <td class="num">@(string.IsNullOrWhiteSpace(m.Cantidad) ? "-" : m.Cantidad)</td>
                                    <td>@(m.Observacion ?? "")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;

            case "INSUMOS":
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:120px">Codigo</th>
                            <th>Descripcion</th>
                            <th style="width:90px">Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_insumos.Count == 0)
                        {
                            <tr><td colspan="5" class="doc-empty-row">No hay insumos en esta orden.</td></tr>
                        }
                        else
                        {
                            @foreach (var it in _insumos)
                            {
                                <tr>
                                    <td class="num">@it.Orden</td>
                                    <td class="mono">@(string.IsNullOrWhiteSpace(it.Codigo) ? "-" : it.Codigo)</td>
                                    <td><b>@it.Descripcion</b></td>
                                    <td class="num">@(string.IsNullOrWhiteSpace(it.Cantidad) ? "-" : it.Cantidad)</td>
                                    <td>@(it.Observaciones ?? "")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;

            case "ORDEN_SERVICIOS":
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="width:110px">Cod. Servicio</th>
                            <th>Descripcion</th>
                            <th style="width:80px">Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_srv.Count == 0)
                        {
                            <tr><td colspan="5" class="doc-empty-row">No hay servicios registrados en esta historia.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _srv)
                            {
                                <tr>
                                    <td class="num">@s.Orden</td>
                                    <td class="mono">@(string.IsNullOrWhiteSpace(s.CodigoServicio) ? "-" : ServicioCodigo.Base(s.CodigoServicio))</td>
                                    <td><b>@s.Descripcion</b></td>
                                    <td class="num">@(string.IsNullOrWhiteSpace(s.Cantidad) ? "-" : s.Cantidad)</td>
                                    <td>@(s.Observaciones ?? "")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;

            case "INCAPACIDADES":
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th>Motivo</th>
                            <th style="width:90px">Desde</th>
                            <th style="width:90px">Hasta</th>
                            <th style="width:50px">Dias</th>
                            <th style="width:160px">Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_inc.Count == 0)
                        {
                            <tr><td colspan="6" class="doc-empty-row">No hay incapacidades registradas en esta historia.</td></tr>
                        }
                        else
                        {
                            @foreach (var i in _inc)
                            {
                                <tr>
                                    <td class="num">@i.Orden</td>
                                    <td>@i.Motivo</td>
                                    <td class="num">@(i.FechaDesde?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="num">@(i.FechaHasta?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="num">@(i.Dias?.ToString() ?? "-")</td>
                                    <td>@(i.Tipo ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;

            case "CERTIFICADOS":
                @if (_cert.Count == 0)
                {
                    <div class="doc-section"><i>No hay certificaciones registradas en esta historia.</i></div>
                }
                else
                {
                    @foreach (var c in _cert)
                    {
                        <div class="doc-section">
                            <h4>#@c.Orden &middot; @c.Titulo</h4>
                            @c.Contenido
                        </div>
                    }
                }
                break;

            case "REMISIONES":
                <div class="doc-section">
                    <i>Modulo de remisiones en desarrollo. El formulario sera completado en una proxima iteracion.</i>
                </div>
                break;

            case "REGISTRO_MEDICAMENTOS":
                @* Bitacora de medicamentos suministrados — replica el layout del
                   PDF "REG MEDICAMENTOS": Fecha y Hora | Presentacion | Dosis |
                   Via | Usuario Creacion. Sin firmas: es un registro operativo. *@
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th style="width:120px">Fecha y Hora</th>
                            <th>Presentacion</th>
                            <th style="width:90px">Dosis</th>
                            <th style="width:130px">Via</th>
                            <th style="width:180px">Usuario Creacion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_sumMed.Count == 0)
                        {
                            <tr><td colspan="5" class="doc-empty-row">No hay registros de suministros en esta historia.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _sumMed)
                            {
                                <tr>
                                    <td class="mono">@s.FechaHora.LocalDateTime.ToString("dd/MM/yy HH:mm")</td>
                                    <td><b>@s.Presentacion</b></td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Dosis) ? "-" : s.Dosis)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Via) ? "-" : s.Via)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.UsuarioCreacionNombre) ? "-" : s.UsuarioCreacionNombre)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;

            default:
                <div class="doc-section">
                    Tipo de orden desconocido: <b>@Tipo</b>.
                </div>
                break;
        }

        @* ============ PIE: firma del profesional ============ *@
        <div class="doc-footer">
            <div class="doc-firma">
                <div class="doc-firma-line">@(_hc.EspecialistaNombre ?? "Especialista")</div>
                <div class="doc-firma-rol">Firma del profesional tratante</div>
            </div>
            <div class="doc-firma">
                <div class="doc-firma-line">@(_paciente?.NombreCompleto ?? "Paciente")</div>
                <div class="doc-firma-rol">Recibido por paciente / acudiente</div>
            </div>
        </div>
    </div>
    }
}

@code {
    [Parameter] public Guid HcId { get; set; }
    [Parameter] public string Tipo { get; set; } = "";
    /// <summary>Numero de orden (grupo) cuando la HC tiene 1..N ordenes del mismo tipo.
    /// Null = imprimir todos los items del tipo (compatibilidad con la orden unica).</summary>
    [Parameter] public int? NumeroOrden { get; set; }

    private HistoriaClinicaDetailDto? _hc;
    private PacienteAsignacionDto? _paciente;
    private FormDefinitionDetailDto? _form;
    private FormSchema _schema = new();
    private bool _loading = true;
    private string _titulo = "Orden";
    private string _tipoLabel = "Orden";
    private string _ordenNumero = "-";

    // Listas por tipo (solo se llena la que aplica).
    private List<OrdenMedicamentoItemDto> _meds = new();
    private List<InsumoItemDto> _insumos = new();
    private List<OrdenServicioItemDto> _srv = new();
    private List<IncapacidadItemDto> _inc = new();
    private List<CertificacionItemDto> _cert = new();
    private List<SuministroMedicamentoItemDto> _sumMed = new();

    // Emision publica (ORD-MEDI): snapshot congelado + QR.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private OrdenPublicaResumenDto? _emision;
    private Dictionary<string, string?> _emisionBag = new();
    private bool _emitBusy;
    private string? _emitError;

    private FormHeader Hdr => _schema.Header ?? FormHeader.Default();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _meds = new(); _insumos = new(); _srv = new(); _inc = new(); _cert = new(); _sumMed = new();
        _emision = null; _emisionBag = new(); _emitError = null;

        _tipoLabel = TipoLabel(Tipo);
        _titulo = $"{_tipoLabel}";

        _hc = await HcSvc.GetAsync(HcId);
        if (_hc is null) { _loading = false; return; }
        _paciente = await AsigSvc.GetPacienteAsync(_hc.PacienteId);
        // El mapeo real Tipo->formato vive en codigo_secundario (ORD-MEDI tiene
        // codigo_secundario="ORDEN_MEDICAMENTOS", tipo="FORMATO"). Resolvemos por
        // codigo_secundario y caemos a tipo por compatibilidad.
        _form = await FormsSvc.GetActivoByCodigoSecundarioAsync(Tipo)
                ?? await FormsSvc.GetActivoByTipoAsync(Tipo);
        if (_form is not null)
        {
            try { _schema = JsonSerializer.Deserialize<FormSchema>(_form.SchemaJson) ?? new(); }
            catch { _schema = new(); }
        }

        // Numero corto de orden basado en HC + tipo (+ numero de orden si aplica).
        var sufOrden = NumeroOrden is int nOrd ? $"-{nOrd}" : "";
        _ordenNumero = $"{_hc.Id.ToString().Substring(0,8).ToUpperInvariant()}-{Tipo.Substring(0, Math.Min(4, Tipo.Length))}{sufOrden}";

        switch (Tipo.ToUpperInvariant())
        {
            case "ORDEN_MEDICAMENTOS":
                _meds = (await MedSvc.ListarPorHistoriaAsync(HcId))
                    .Where(m => NumeroOrden is null || m.NumeroOrden == NumeroOrden).ToList();
                // QR por orden: la emision activa se busca para (HC, MED, numero de orden).
                _emision = await PubSvc.ObtenerEmisionActivaAsync(HcId, "MED", NumeroOrden ?? 1);
                _emisionBag = _emision is null ? new() : DeserializarBag(_emision.BagJson);
                break;
            case "INSUMOS":
                _insumos = (await InsumoSvc.ListarPorHistoriaAsync(HcId))
                    .Where(i => NumeroOrden is null || i.NumeroOrden == NumeroOrden).ToList();
                break;
            case "ORDEN_SERVICIOS":
                _srv = (await SrvSvc.ListarPorHistoriaAsync(HcId)).ToList();
                break;
            case "INCAPACIDADES":
                _inc = (await IncSvc.ListarPorHistoriaAsync(HcId)).ToList();
                break;
            case "CERTIFICADOS":
                _cert = (await CertSvc.ListarPorHistoriaAsync(HcId)).ToList();
                break;
            case "REMISIONES":
                /* sin servicio aun */
                break;
            case "REGISTRO_MEDICAMENTOS":
                _sumMed = (await SumMedSvc.ListarPorHistoriaAsync(HcId)).ToList();
                break;
        }

        _loading = false;
    }

    private async Task PrintAsync() { await JS.InvokeVoidAsync("print"); }

    // Cuando la impresion dispara una emision, el print real se aplaza hasta que
    // el documento emitido (con QR) termine de renderizarse — se hace en OnAfterRender.
    private bool _pendingPrint;

    /// <summary>Boton unico de impresion. Para ordenes de medicamentos que aun no
    /// estan emitidas, emite primero (firma + QR + snapshot inmutable) y luego
    /// imprime, para que el documento salga siempre con su codigo de verificacion.
    /// El resto de tipos (y las ordenes ya emitidas) solo imprime.</summary>
    private async Task ImprimirAsync()
    {
        var esMed = string.Equals(Tipo, "ORDEN_MEDICAMENTOS", StringComparison.OrdinalIgnoreCase);
        if (esMed && _emision is null && _meds.Count > 0)
        {
            await EmitirOrdenAsync();          // emite + recarga: _emision pasa a != null
            if (_emision is null) { return; }  // fallo la emision (hay _emitError): no imprimir
            _pendingPrint = true;              // imprimir tras renderizar el doc emitido con QR
            return;
        }
        await PrintAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPrint && _emision is not null)
        {
            _pendingPrint = false;
            await PrintAsync();
        }
    }

    /// <summary>Emite (firma) la orden ORD-MEDI: arma el bag prellenado del formato,
    /// captura la proyeccion publica, y persiste el snapshot inmutable con codigo.</summary>
    private async Task EmitirOrdenAsync()
    {
        if (_hc is null || _paciente is null || _form is null) { return; }
        if (_meds.Count == 0) { _emitError = "La orden no tiene medicamentos para emitir."; return; }
        _emitBusy = true; _emitError = null;
        try
        {
            var (bag, profNombre, profRegistro) = await ConstruirBagOrdenAsync();
            var items = _meds.Select(m => new OrdenItemPublicoDto(
                m.NombreMedicamento, m.CodigoMedicamento, m.Cantidad, m.Frecuencia, m.Dias, m.Posologia)).ToList();
            var fecha = DateTimeOffset.Now;
            var actor = await ActorIdAsync();
            var req = new EmitirOrdenRequest(
                _hc.Id, JsonSerializer.Serialize(bag), fecha,
                Iniciales(_paciente.NombreCompleto), profNombre, profRegistro, items,
                "MED", NumeroOrden ?? 1);
            await PubSvc.EmitirAsync(req, actor);
            await OnParametersSetAsync();
        }
        catch (Exception ex) { _emitError = ex.Message; }
        finally { _emitBusy = false; }
    }

    private async Task RevocarOrdenAsync()
    {
        if (_emision is null) { return; }
        _emitBusy = true; _emitError = null;
        try
        {
            var actor = await ActorIdAsync();
            await PubSvc.RevocarAsync(_emision.Id, actor, null);
            await OnParametersSetAsync();
        }
        catch (Exception ex) { _emitError = ex.Message; }
        finally { _emitBusy = false; }
    }

    /// <summary>Construye el bag del formato ORD-MEDI prellenando paciente, sistema
    /// (fecha/usuario/registro/firma), firmas y la tabla de medicamentos — el mismo
    /// pipeline de prefill que usan las escalas/consentimientos al iniciarse.</summary>
    // Fecha de expedicion para el encabezado del documento: la de emision si esta
    // emitido (documento firmado), o la de hoy si es borrador.
    private string FechaFormulaOrd()
    {
        var f = _emision?.EmitidoAt ?? DateTimeOffset.Now;
        return "Fecha: " + f.LocalDateTime.ToString("dd/MM/yyyy");
    }

    private async Task<(Dictionary<string, string?> Bag, string? ProfNombre, string? ProfRegistro)> ConstruirBagOrdenAsync()
    {
        var valores = new Dictionary<string, string?>();
        string? profNombre = _hc?.EspecialistaNombre;
        string? profRegistro = null;
        if (_paciente is null || _form is null) { return (valores, profNombre, profRegistro); }

        var rutas = PrefillRouteSet.FromJson(_form.PrefillRoutesJson);
        PacientePrefillHelper.Aplicar(valores, _paciente, _schema, rutas);

        // Datos del profesional/usuario logueado (identificacion, registro, firma).
        Guid? profId = null, platformUid = null, tenantId = null;
        string? uName = null, uEmail = null, uSede = null;
        if (AuthState is not null)
        {
            var st = await AuthState;
            uName = st.User.Identity?.Name ?? st.User.FindFirst("display_name")?.Value;
            uEmail = st.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            uSede = st.User.FindFirst("sede_nombre")?.Value;
            if (Guid.TryParse(st.User.FindFirst("profesional_id")?.Value, out var pid)) { profId = pid; }
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var puid)) { platformUid = puid; }
            if (Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out var tid)) { tenantId = tid; }
        }
        // La formula la FIRMA el medico tratante de la HC (especialista), no quien
        // la emite. Resolvemos por el ProfesionalId de la HC; si no tiene profesional
        // vinculado, caemos al usuario logueado (compatibilidad).
        var firmanteProfId = _hc?.ProfesionalId ?? profId;

        try
        {
            var datosProf = await FirmaResolverSvc.ResolverDatosProfesionalAsync(
                firmanteProfId, firmanteProfId is null ? platformUid : null, tenantId);
            profRegistro = datosProf?.RegistroMedico;
            // El firmante de la formula es el profesional-usuario que la emite:
            // nombre + registro + firma del mismo. Solo si el usuario no tiene
            // profesional vinculado caemos al especialista de la HC o al nombre
            // del usuario logueado.
            if (!string.IsNullOrWhiteSpace(datosProf?.Nombre)) { profNombre = datosProf!.Nombre; }
            else if (string.IsNullOrWhiteSpace(profNombre)) { profNombre = uName; }
            SistemaPrefillHelper.Aplicar(valores, new SistemaPrefillHelper.SistemaCtx(
                Ahora: DateTimeOffset.Now,
                AgenciaNombre: null, AgenciaSlogan: null,
                SedeNombre: uSede ?? _paciente.Sede, SedeCiudad: _paciente.Ciudad,
                UsuarioNombre: uName, UsuarioEmail: uEmail,
                UsuarioIdentificacion: datosProf?.Identificacion,
                UsuarioRegistroMedico: datosProf?.RegistroMedico,
                UsuarioFirmaUrl: datosProf?.FirmaUrl), rutas);
        }
        catch { }

        try
        {
            var firmaPac = await FirmaResolverSvc.ResolverFirmaPacienteAsync(_paciente.Id);
            string? firmaProf = null;
            if (firmanteProfId is Guid pid2 && pid2 != Guid.Empty)
            {
                firmaProf = await FirmaResolverSvc.ResolverFirmaPorProfesionalAsync(pid2);
            }
            else if (platformUid is Guid puid2 && tenantId is Guid tid2)
            {
                firmaProf = await FirmaResolverSvc.ResolverFirmaProfesionalPorPlatformUserAsync(puid2, tid2);
            }
            FirmasPrefillHelper.Aplicar(valores, firmaPac, firmaProf, rutas);
        }
        catch { }

        // Tabla de medicamentos (solo se poblan las filas de la HC actual).
        var fuentes = new HistoriaMedicaPrefillHelper.HmFuentes(
            _meds,
            new List<RemisionItemDto>(), new List<IncapacidadItemDto>(), new List<CertificacionItemDto>(),
            new List<OrdenServicioItemDto>(), new List<InsumoItemDto>(),
            new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(), new List<OrdenExternaItemDto>(),
            new List<SuministroMedicamentoItemDto>(),
            // Diagnosticos viajan desde la HC padre (tabla del formulario), no de un servicio.
            HcDiagnosticosReader.Leer(_hc?.SchemaJson, _hc?.ValoresJson));
        HistoriaMedicaPrefillHelper.Aplicar(valores, fuentes, rutas, _schema);

        // Firmante para el pie de la formula: nombre = especialista de la HC
        // (o usuario logueado), registro medico resuelto. Se congelan en el
        // snapshot para que el documento emitido nunca cambie.
        valores["profesional_nombre"] = profNombre;
        valores["profesional_registro"] = profRegistro;

        return (valores, profNombre, profRegistro);
    }

    private async Task<Guid> ActorIdAsync()
    {
        if (AuthState is not null)
        {
            var st = await AuthState;
            if (Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id))
            {
                return id;
            }
        }
        return Guid.Empty;
    }

    /// <summary>Iniciales del paciente (privacidad): "MERCEDES PULIDO" -> "M.P.".</summary>
    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) { return "N.N."; }
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini = partes.Where(p => p.Length > 0).Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Join(".", ini) + ".";
    }

    private static Dictionary<string, string?> DeserializarBag(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) { return new(); }
        try { return JsonSerializer.Deserialize<Dictionary<string, string?>>(json) ?? new(); }
        catch { return new(); }
    }

    private static string TipoLabel(string tipo) => tipo.ToUpperInvariant() switch
    {
        "ORDEN_MEDICAMENTOS" => "Orden de Medicamentos",
        "INSUMOS"            => "Orden de Insumos",
        "ORDEN_SERVICIOS"    => "Orden a Servicios",
        "REMISIONES"         => "Orden de Remision",
        "INCAPACIDADES"      => "Orden de Incapacidad",
        "CERTIFICADOS"       => "Certificacion Medica",
        "REGISTRO_MEDICAMENTOS" => "Medicamentos",
        _                    => "Orden"
    };
}
