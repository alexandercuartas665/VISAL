    // Sub-tabs del detalle: Datos (la tabla) y Tipologias/Archivos (resumen).
    private enum VerTab { Datos, Tipologias }
    private VerTab _verTab = VerTab.Datos;
    private bool _tipCargado;
    private bool _tipCargando;
    private CuentaMedicaConfigDto? _tipConfig;
    private List<InformeItemDto> _tipArchivos = new();
    private List<PacienteSnapshotDto> _tipPacientes = new();
    // archivoItemId -> nro de pacientes del snapshot que SI tienen contenido para ese archivo.
    private IReadOnlyDictionary<Guid, int> _tipConteos = new Dictionary<Guid, int>();
    private InformeItemDto? _archModal;

    private void AbrirArchivoModal(InformeItemDto a) => _archModal = a;
    private void CerrarArchivoModal() => _archModal = null;

    // --- Generacion de ZIP en background + descarga al terminar ---
    // El boton arranca un job (desacoplado del request), se consulta su progreso cada
    // ~800ms y, al terminar, se dispara la descarga del resultado ya cacheado. Asi un
    // archivo con cientos de formularios no muere por timeout del navegador/proxy.
    private async Task IniciarZip(InformeItemDto a)
    {
        if (_verDetalle is null) { return; }
        var (tenantId, userId, sucursalId) = await ClaimsAsync();
        if (tenantId is not Guid tid) { _error = "No se pudo determinar el tenant para generar el ZIP."; return; }

        var ui = new ZipUi { Corriendo = true, Fase = "Preparando", Hechos = 0, Total = 0 };
        _zipUi[a.Id] = ui;
        ui.JobId = ZipJobSvc.Iniciar(_verDetalle.Metadata.Id, a.Id, tid, userId, sucursalId);
        StateHasChanged();
        _ = PollZipAsync(_verDetalle.Metadata.Id, a.Id, ui.JobId);
    }

    private async Task PollZipAsync(Guid snapshotId, Guid archivoId, Guid jobId)
    {
        while (!_disposed)
        {
            await Task.Delay(800);
            if (_disposed) { return; }
            // Si el usuario relanzo el mismo archivo, este poll es viejo: abortar.
            if (!_zipUi.TryGetValue(archivoId, out var ui) || ui.JobId != jobId) { return; }

            var info = ZipJobSvc.Obtener(jobId);
            if (info is null) { return; }

            ui.Fase = info.Fase; ui.Hechos = info.Hechos; ui.Total = info.Total;

            if (info.Estado == Visal.SuperAdmin.Facturacion.ZipJobEstado.Listo)
            {
                ui.Corriendo = false;
                var url = $"/facturacion-clinica/snapshots/{snapshotId}/tipologia/{archivoId}/zip/result/{jobId}";
                await InvokeAsync(StateHasChanged);
                try { await JS.InvokeVoidAsync("snapFccDescargarZip", url); } catch { /* no bloquear si falla JS */ }
                _zipUi.Remove(archivoId);
                await InvokeAsync(StateHasChanged);
                return;
            }
            if (info.Estado == Visal.SuperAdmin.Facturacion.ZipJobEstado.Error)
            {
                ui.Corriendo = false;
                ui.Error = string.IsNullOrWhiteSpace(info.Error) ? "Error generando el ZIP." : info.Error;
                await InvokeAsync(StateHasChanged);
                return;
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<(Guid? tenant, Guid? user, Guid? sucursal)> ClaimsAsync()
    {
