@page "/informe/terapias-pendientes"
@attribute [AllowAnonymous]
@layout Visal.SuperAdmin.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Visal.Application.Tenancy
@inject IInformeTerapiasService Svc

<PageTitle>Terapias pendientes - @(_data?.TenantNombre ?? "Visal")</PageTitle>

<div class="inf-shell">
    <div class="inf-card">
        @if (_invalido)
        {
            <div class="inf-brand"><div class="inf-brand-name">Visal</div></div>
            <div class="inf-state inf-state-err">
                <div class="inf-state-h">Enlace invalido o vencido</div>
                <p>Este enlace no es valido o ya expiro. Solicita uno nuevo desde el sistema.</p>
            </div>
        }
        else if (_data is not null)
        {
            <div class="inf-brand">
                @if (!string.IsNullOrWhiteSpace(_data.LogoUrl))
                {
                    <img src="@_data.LogoUrl" class="inf-brand-logo" alt="" />
                }
                <div class="inf-brand-name">@_data.TenantNombre</div>
                <div class="inf-brand-sub">Pacientes pendientes por terapias</div>
                <div class="inf-fecha">Generado el @_data.Fecha.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="inf-resumen">
                <span class="inf-badge">@_data.Filas.Count paciente(s)</span>
                <span class="inf-badge inf-badge-alt">@_data.Filas.Sum(f => f.SesionesPendientes) sesion(es) pendientes</span>
            </div>

            @if (_data.Filas.Count == 0)
            {
                <div class="inf-state inf-state-ok">
                    <div class="inf-state-ico">&#10003;</div>
                    <div class="inf-state-h">Sin terapias pendientes</div>
                    <p>No hay pacientes con sesiones de terapia pendientes en este momento.</p>
                </div>
            }
            else
            {
                <div class="inf-charts">
                    @* "Por profesional" solo aporta cuando hay mas de uno (si el enlace se acoto a uno, se omite). *@
                    @if (_porProf.Count > 1)
                    {
                        <div class="inf-chart">
                            <div class="inf-chart-h">Sesiones pendientes por profesional</div>
                            @foreach (var d in _porProf)
                            {
                                <div class="inf-bar-row">
                                    <div class="inf-bar-lbl" title="@d.Label">@d.Label</div>
                                    <div class="inf-bar-track"><div class="inf-bar-fill" style="width:@(Pct(d.Value, _maxProf))%"></div></div>
                                    <div class="inf-bar-val">@d.Value</div>
                                </div>
                            }
                        </div>
                    }
                    @if (_porServ.Count > 0)
                    {
                        <div class="inf-chart">
                            <div class="inf-chart-h">Sesiones pendientes por servicio</div>
                            @foreach (var d in _porServ)
                            {
                                <div class="inf-bar-row">
                                    <div class="inf-bar-lbl" title="@d.Label">@d.Label</div>
                                    <div class="inf-bar-track"><div class="inf-bar-fill inf-bar-fill-alt" style="width:@(Pct(d.Value, _maxServ))%"></div></div>
                                    <div class="inf-bar-val">@d.Value</div>
                                </div>
                            }
                        </div>
                    }
                    @if (_porCiudad.Count > 0)
                    {
                        <div class="inf-chart">
                            <div class="inf-chart-h">Sesiones pendientes por ciudad</div>
                            @foreach (var d in _porCiudad)
                            {
                                <div class="inf-bar-row">
                                    <div class="inf-bar-lbl" title="@d.Label">@d.Label</div>
                                    <div class="inf-bar-track"><div class="inf-bar-fill inf-bar-fill-c" style="width:@(Pct(d.Value, _maxCiudad))%"></div></div>
                                    <div class="inf-bar-val">@d.Value</div>
                                </div>
                            }
                        </div>
                    }
                    @if (_porAntiguedad.Count > 0)
                    {
                        <div class="inf-chart">
                            <div class="inf-chart-h">Sesiones pendientes por antiguedad</div>
                            @foreach (var d in _porAntiguedad)
                            {
                                <div class="inf-bar-row">
                                    <div class="inf-bar-lbl" title="@d.Label">@d.Label</div>
                                    <div class="inf-bar-track"><div class="inf-bar-fill inf-bar-fill-d" style="width:@(Pct(d.Value, _maxAntig))%"></div></div>
                                    <div class="inf-bar-val">@d.Value</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="inf-table-wrap">
                    <table class="inf-table">
                        <thead>
                            <tr>
                                <th>Paciente</th>
                                <th>Servicio</th>
                                <th class="inf-center">Pendientes</th>
                                <th>Ultima atencion</th>
                                <th>Profesional</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _data.Filas)
                            {
                                <tr>
                                    <td><b>@f.Paciente</b><div class="inf-xsmall">@f.Documento</div></td>
                                    <td>@f.Servicio</td>
                                    <td class="inf-center"><span class="inf-pill">@f.SesionesPendientes</span></td>
                                    <td>@(f.UltimaAtencion is { } u ? u.ToString("dd/MM/yyyy") : "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.Profesional) ? "-" : f.Profesional)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="inf-foot">Informe generado por Visal - IPS. Uso interno.</div>
        }
        else
        {
            <div class="inf-state">Cargando informe...</div>
        }
    </div>
</div>

<style>
    .inf-shell { min-height: 100vh; background: #f1f5f9; display: flex; justify-content: center; padding: 24px 12px; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
    .inf-card { width: 100%; max-width: 860px; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 8px 30px rgba(15,23,42,.08); padding: 22px; }
    .inf-brand { text-align: center; border-bottom: 1px solid #eef2f7; padding-bottom: 14px; margin-bottom: 14px; }
    .inf-brand-logo { max-height: 54px; margin-bottom: 6px; }
    .inf-brand-name { font-size: 18px; font-weight: 800; color: #0f172a; }
    .inf-brand-sub { font-size: 14px; color: #1565c0; font-weight: 600; }
    .inf-fecha { font-size: 12px; color: #64748b; margin-top: 2px; }
    .inf-resumen { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 14px; }
    .inf-badge { background: #dbeafe; color: #1e40af; font-weight: 700; font-size: 12px; border-radius: 999px; padding: 4px 12px; }
    .inf-badge-alt { background: #fef3c7; color: #92400e; }
    .inf-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .inf-chart { background: #f8fafc; border: 1px solid #eef2f7; border-radius: 10px; padding: 12px 14px; }
    .inf-chart-h { font-size: 12px; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 10px; }
    .inf-bar-row { display: grid; grid-template-columns: 110px 1fr 30px; align-items: center; gap: 8px; margin-bottom: 7px; }
    .inf-bar-lbl { font-size: 11px; color: #475569; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .inf-bar-track { background: #e2e8f0; border-radius: 999px; height: 14px; overflow: hidden; }
    .inf-bar-fill { background: #1565c0; height: 100%; border-radius: 999px; min-width: 2px; }
    .inf-bar-fill-alt { background: #d97706; }
    .inf-bar-fill-c { background: #0d9488; }
    .inf-bar-fill-d { background: #7c3aed; }
    .inf-bar-val { font-size: 11px; font-weight: 700; color: #334155; text-align: right; }
    @@media (max-width: 640px) { .inf-charts { grid-template-columns: 1fr; } }
    .inf-table-wrap { overflow-x: auto; }
    .inf-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .inf-table th { text-align: left; font-size: 11px; text-transform: uppercase; color: #64748b; border-bottom: 2px solid #e2e8f0; padding: 8px 10px; }
    .inf-table td { border-bottom: 1px solid #eef2f7; padding: 8px 10px; color: #334155; vertical-align: top; }
    .inf-center { text-align: center; }
    .inf-xsmall { font-size: 11px; color: #94a3b8; }
    .inf-pill { background: #fee2e2; color: #b91c1c; font-weight: 700; border-radius: 999px; padding: 1px 9px; }
    .inf-state { text-align: center; padding: 28px 10px; color: #334155; }
    .inf-state-h { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
    .inf-state-ico { font-size: 30px; color: #16a34a; }
    .inf-state-err .inf-state-h { color: #b91c1c; }
    .inf-foot { text-align: center; font-size: 11px; color: #94a3b8; margin-top: 16px; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "t")] public string? T { get; set; }

    private InformeTerapiasResult? _data;
    private bool _invalido;

    // Agregados para los graficos (barras): sesiones pendientes por profesional, por
    // servicio, por ciudad del paciente y por antiguedad de la programacion. Se calculan
    // una vez tras cargar el informe.
    private IReadOnlyList<(string Label, int Value)> _porProf = Array.Empty<(string, int)>();
    private IReadOnlyList<(string Label, int Value)> _porServ = Array.Empty<(string, int)>();
    private IReadOnlyList<(string Label, int Value)> _porCiudad = Array.Empty<(string, int)>();
    private IReadOnlyList<(string Label, int Value)> _porAntiguedad = Array.Empty<(string, int)>();
    private int _maxProf = 1;
    private int _maxServ = 1;
    private int _maxCiudad = 1;
    private int _maxAntig = 1;

    private void CalcularGraficos()
    {
        _porProf = Agrupar(f => string.IsNullOrWhiteSpace(f.Profesional) ? "(sin profesional)" : f.Profesional);
        _porServ = Agrupar(f => string.IsNullOrWhiteSpace(f.Servicio) ? "(sin servicio)" : f.Servicio);
        _porCiudad = Agrupar(f => string.IsNullOrWhiteSpace(f.Ciudad) ? "(Sin ciudad)" : f.Ciudad!.Trim().ToUpperInvariant());
        _porAntiguedad = AgruparAntiguedad();
        _maxProf = _porProf.Count > 0 ? _porProf.Max(x => x.Value) : 1;
        _maxServ = _porServ.Count > 0 ? _porServ.Max(x => x.Value) : 1;
        _maxCiudad = _porCiudad.Count > 0 ? _porCiudad.Max(x => x.Value) : 1;
        _maxAntig = _porAntiguedad.Count > 0 ? _porAntiguedad.Max(x => x.Value) : 1;
    }

    // Antiguedad = dias desde el inicio de la programacion (Asignacion.FechaInicio) hasta
    // la fecha del informe. Se agrupan las sesiones pendientes en rangos fijos y se muestran
    // en orden cronologico (omitiendo los rangos vacios). Las filas sin fecha de inicio se
    // ignoran en este grafico.
    private IReadOnlyList<(string Label, int Value)> AgruparAntiguedad()
    {
        if (_data is null || _data.Filas.Count == 0) { return Array.Empty<(string, int)>(); }
        var hoy = _data.Fecha;
        var buckets = new (string Label, int Value)[]
        {
            ("0-15 dias", 0), ("16-30 dias", 0), ("31-60 dias", 0), ("60+ dias", 0),
        };
        foreach (var f in _data.Filas)
        {
            if (f.InicioPrograma is not { } ini) { continue; }
            var dias = hoy.DayNumber - ini.DayNumber;
            if (dias < 0) { dias = 0; }
            var idx = dias <= 15 ? 0 : dias <= 30 ? 1 : dias <= 60 ? 2 : 3;
            buckets[idx].Value += f.SesionesPendientes;
        }
        return buckets.Where(b => b.Value > 0).ToList();
    }

    private IReadOnlyList<(string Label, int Value)> Agrupar(Func<TerapiaPendienteDto, string> clave)
    {
        if (_data is null || _data.Filas.Count == 0) { return Array.Empty<(string, int)>(); }
        return _data.Filas
            .GroupBy(clave)
            .Select(g => (Label: g.Key, Value: g.Sum(x => x.SesionesPendientes)))
            .OrderByDescending(x => x.Value)
            .ThenBy(x => x.Label, StringComparer.OrdinalIgnoreCase)
            .Take(12)
            .ToList();
    }

    private static int Pct(int v, int max) => max <= 0 ? 0 : (int)Math.Round(100.0 * v / max);

    protected override async Task OnInitializedAsync()
    {
        var info = Svc.ValidarToken(T ?? "");
        if (info is null) { _invalido = true; return; }
        _data = await Svc.ObtenerAsync(info.TenantId, info.ProfesionalId);
        if (_data is null) { _invalido = true; return; }
        CalcularGraficos();

        // Control de lectura: registrar que el doctor abrio su enlace. Best-effort;
        // nunca debe impedir que se vea el informe.
        try { await Svc.RegistrarAccesoAsync(info.TenantId, info.ProfesionalId); }
        catch { /* el registro es secundario al informe */ }
    }
}
