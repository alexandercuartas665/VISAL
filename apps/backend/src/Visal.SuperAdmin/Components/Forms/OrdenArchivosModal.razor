@code {
    [Parameter] public Guid HistoriaClinicaId { get; set; }
    [Parameter] public Guid PacienteId { get; set; }
    [Parameter] public string PacienteNombre { get; set; } = "";
    /// <summary>Se conserva por compatibilidad con el caller (/ordenes). Ya NO condiciona
    /// editar/eliminar: los archivos subidos aqui son externos de la HC (NotaMedicaId null)
    /// y el backend permite editarlos/eliminarlos aunque la HC este cerrada — justo lo que
    /// se necesita en Ordenes Clinicas, donde la HC casi siempre esta cerrada.</summary>
    [Parameter] public bool HcAbierta { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<NotaDocumentoDto> _docsHc = new();
    private List<DocumentoPacienteDto> _docsPaciente = new();
    private List<TipologiaArchivoDto> _tipologias = new();

    private bool _subiendo;
    private string? _subiendoN;
    private bool _dragOver;
    private string? _msg;
    private string? _error;
    private string? _categoria;
    private string? _subcategoria;
    private string? _anotaciones;

    private string _grupo = "hc";       // hc | pac
    private string _vista = "galeria";  // galeria | tabla

    // Edicion combinada de un documento: tipologia + subcategoria + fecha + observacion.
    private Guid? _editDocId;
    private string? _editTip;
    private string? _editSubcat;
    private string? _editObs;
    private DateOnly? _editFecha;
    private NotaDocumentoDto? _visorDoc;

    private static readonly TimeSpan Bog = TimeSpan.FromHours(-5);

    // Un documento es editable (tipologia/subcategoria/fecha/observacion) y eliminable
    // SOLO si no es anexo de una nota medica (NotaMedicaId null): adjuntos directos de
    // Admision, externos de la HC o firmas del paciente. Es el MISMO gate que aplica el
    // backend (ActualizarDocumentoEditableAsync lanza si NotaMedicaId != null), por eso
    // sirve igual en el tab "Archivos de esta HC" como en "Documentos del paciente".
    private static bool Editable(NotaDocumentoDto d) => d.NotaMedicaId is null;

    // Subcategorias activas de una tipologia por su nombre (dependiente del select de tipologia).
    private IReadOnlyList<SubcategoriaArchivoDto> SubcatsDe(string? tipNombre)
    {
        if (string.IsNullOrWhiteSpace(tipNombre)) { return Array.Empty<SubcategoriaArchivoDto>(); }
        var t = _tipologias.FirstOrDefault(x => x.Nombre == tipNombre);
        return t?.Subcategorias ?? (IReadOnlyList<SubcategoriaArchivoDto>)Array.Empty<SubcategoriaArchivoDto>();
    }

    private void OnCategoriaChanged(ChangeEventArgs e)
    {
        _categoria = e.Value?.ToString() ?? "";
        _subcategoria = ""; // al cambiar la tipologia, la subcategoria anterior ya no aplica
    }

    private void OnEditTipChanged(ChangeEventArgs e)
    {
        _editTip = e.Value?.ToString() ?? "";
        _editSubcat = ""; // idem en el edit inline
    }

    // Fecha (dia) -> DateTimeOffset a mediodia Bogota (evita saltos de dia por zona).
    private static DateTimeOffset? ParseFechaDoc(DateOnly? d)
    {
        if (d is not DateOnly v) { return null; }
        return new DateTimeOffset(v.Year, v.Month, v.Day, 12, 0, 0, Bog);
    }

    protected override async Task OnInitializedAsync()
    {
        try { _tipologias = (await TipSvc.ListAsync(soloActivos: true)).ToList(); }
        catch { _tipologias = new(); }
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        try
        {
            _docsHc = (await NotaSvc.ListarDocumentosPorHistoriaAsync(HistoriaClinicaId)).ToList();
            _docsPaciente = (await NotaSvc.ListarDocumentosPorPacienteAsync(PacienteId)).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _dragOver = false;
        _subiendo = true; _msg = _error = null;
        int ok = 0;
        try
        {
            var dir = Path.Combine(Env.WebRootPath, "uploads", "notas");
            Directory.CreateDirectory(dir);
            foreach (var f in e.GetMultipleFiles(50))
            {
                _subiendoN = f.Name; StateHasChanged();
                try
                {
                    var ext = Path.GetExtension(f.Name);
                    var nombreEnDisco = $"{Guid.NewGuid()}{ext}";
                    var rutaDisco = Path.Combine(dir, nombreEnDisco);
                    await using (var fs = File.Create(rutaDisco))
                    await using (var rs = f.OpenReadStream(20L * 1024 * 1024))
                    {
                        await rs.CopyToAsync(fs);
                    }
                    // FechaDocumento no se envia: el servicio la inicializa con la fecha de
                    // atencion de la HC. CreatedBy (quien cargo) lo estampa el interceptor de auditoria.
                    await NotaSvc.AdjuntarDocumentoHcAsync(new AdjuntarDocumentoHcRequest(
                        HistoriaClinicaId, PacienteId, f.Name, $"/uploads/notas/{nombreEnDisco}",
                        f.ContentType, f.Size,
                        string.IsNullOrWhiteSpace(_categoria) ? null : _categoria,
                        string.IsNullOrWhiteSpace(_anotaciones) ? null : _anotaciones,
                        string.IsNullOrWhiteSpace(_subcategoria) ? null : _subcategoria), Guid.Empty);
                    ok++;
                }
                catch (Exception exf) { _error = $"'{f.Name}': {exf.Message}"; }
            }
            if (ok > 0) { _msg = $"{ok} archivo(s) subido(s)."; _anotaciones = ""; _subcategoria = ""; }
            await RecargarAsync();
        }
        catch (Exception ex) { _error = "No se pudo subir: " + ex.Message; }
        finally { _subiendo = false; _subiendoN = null; }
    }

    private void AbrirVisor(NotaDocumentoDto d) => _visorDoc = d;
    private void CerrarVisor() => _visorDoc = null;

    private void AbrirEditInline(NotaDocumentoDto d)
    {
        _editDocId = d.Id;
        _editTip = d.Categoria ?? "";
        _editSubcat = d.Subcategoria ?? "";
        _editObs = d.Anotaciones ?? "";
        _editFecha = d.FechaDocumento is DateTimeOffset fd ? DateOnly.FromDateTime(fd.ToOffset(Bog).DateTime) : null;
    }

    private void CancelarEditInline()
    {
        _editDocId = null;
        _editTip = _editSubcat = _editObs = null;
        _editFecha = null;
    }

    private async Task GuardarEdicionAsync(Guid docId)
    {
        try
        {
            await NotaSvc.ActualizarDocumentoEditableAsync(
                docId, _editTip, _editSubcat, _editObs, ParseFechaDoc(_editFecha), Guid.Empty);
            _msg = "Datos del archivo actualizados.";
            CancelarEditInline();
            await RecargarAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task EliminarAsync(Guid docId, string nombre)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminar '{nombre}'? No se puede deshacer.");
        if (!ok) { return; }
        try
        {
            await NotaSvc.EliminarDocumentoAsync(docId, Guid.Empty);
            _msg = "Archivo eliminado.";
            if (_visorDoc?.Id == docId) { _visorDoc = null; }
            await RecargarAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Cerrar()
    {
        if (OnClose.HasDelegate) { await OnClose.InvokeAsync(); }
    }

    private static NotaDocumentoDto Proxy(DocumentoPacienteDto d) => new(
        d.Id, d.NotaMedicaId, d.NombreOriginal, d.RutaArchivo, d.TipoMime, d.Tamano,
        d.Categoria, d.TipoTerapia, d.Mes, d.Anotaciones, d.CreatedAt,
        d.Subcategoria, d.SubidoPor, d.FechaDocumento);

    private RenderFragment RenderCard(NotaDocumentoDto d) => __builder =>
    {
        <div class="oa-card">
            @if (EsImagen(d.TipoMime, d.NombreOriginal))
            {
                <img class="oa-thumb" src="@d.RutaArchivo" alt="@d.NombreOriginal" @onclick="() => AbrirVisor(d)" />
            }
            else
            {
                <div class="oa-thumb-icon" @onclick="() => AbrirVisor(d)">@IconoPara(d.NombreOriginal)</div>
            }
            <div class="oa-nombre" title="@d.NombreOriginal">@d.NombreOriginal</div>
            <div class="oa-meta">@FormatoTamano(d.Tamano) &middot; cargado @d.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            <div class="oa-meta oa-user" title="Usuario que cargo el archivo">
                &#128100; @(string.IsNullOrWhiteSpace(d.SubidoPor) ? "(sin registro de usuario)" : d.SubidoPor)
            </div>
            @if (_editDocId == d.Id)
            {
                @RenderEditForm(d)
            }
            else
            {
                <div class="oa-tip-row">
                    @if (!string.IsNullOrWhiteSpace(d.Categoria)) { <span class="oa-cat">@d.Categoria</span> }
                    else { <span class="oa-cat oa-cat-empty">(sin tipologia)</span> }
                    @if (!string.IsNullOrWhiteSpace(d.Subcategoria)) { <span class="oa-cat oa-subcat">@d.Subcategoria</span> }
                    @if (Editable(d))
                    {
                        <button class="btn btn-link btn-sm p-0" title="Editar tipologia / subcategoria / fecha / observacion" @onclick="() => AbrirEditInline(d)">&#9998;</button>
                    }
                </div>
                @if (d.FechaDocumento is DateTimeOffset fd)
                {
                    <div class="oa-meta oa-fechadoc" title="Fecha del documento (editable)">&#128197; @fd.ToOffset(Bog).ToString("dd/MM/yyyy")</div>
                }
                @if (!string.IsNullOrWhiteSpace(d.Anotaciones))
                {
                    <div class="oa-obs" title="Observacion">&#128221; @d.Anotaciones</div>
                }
            }
            <div class="oa-acts">
                <button class="btn btn-outline-primary btn-sm" @onclick="() => AbrirVisor(d)">Ver</button>
                @if (Editable(d))
                {
                    <button class="btn btn-link btn-sm text-danger" title="Eliminar" @onclick="() => EliminarAsync(d.Id, d.NombreOriginal)">&#128465;</button>
                }
            </div>
        </div>
    };

    // Formulario de edicion combinada (tipologia + subcategoria + fecha + observacion),
    // compartido por la card de galeria y la fila expandida de la tabla.
    private RenderFragment RenderEditForm(NotaDocumentoDto d) => __builder =>
    {
        <div class="oa-edit">
            <label class="oa-edit-lbl">Tipologia</label>
            <select class="form-select form-select-sm" value="@_editTip" @onchange="OnEditTipChanged">
                <option value="">(sin tipologia)</option>
                @foreach (var t in _tipologias) { <option value="@t.Nombre">@t.Nombre</option> }
            </select>
            @if (SubcatsDe(_editTip).Count > 0)
            {
                <label class="oa-edit-lbl">Subcategoria</label>
                <select class="form-select form-select-sm" @bind="_editSubcat">
                    <option value="">(sin subcategoria)</option>
                    @foreach (var s in SubcatsDe(_editTip)) { <option value="@s.Nombre">@s.Nombre</option> }
                </select>
            }
            <label class="oa-edit-lbl">Fecha del documento</label>
            <input type="date" class="form-control form-control-sm" @bind="_editFecha" />
            <label class="oa-edit-lbl">Observacion</label>
            <input type="text" class="form-control form-control-sm" @bind="_editObs"
                   placeholder="Observacion del archivo" maxlength="500" />
            <div class="oa-edit-acts">
                <button class="btn btn-primary btn-sm" title="Guardar" @onclick="() => GuardarEdicionAsync(d.Id)">&#10003; Guardar</button>
                <button class="btn btn-outline-secondary btn-sm" title="Cancelar" @onclick="CancelarEditInline">&#10005;</button>
            </div>
        </div>
    };

    private static bool EsImagen(string? mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) { return true; }
        var ext = Path.GetExtension(nombre).ToLowerInvariant();
        return ext is ".png" or ".jpg" or ".jpeg" or ".webp" or ".gif" or ".bmp";
    }

    private static bool EsPdf(string? mime, string nombre)
    {
        if (!string.IsNullOrEmpty(mime) && mime.Contains("pdf", StringComparison.OrdinalIgnoreCase)) { return true; }
        return Path.GetExtension(nombre).ToLowerInvariant() == ".pdf";
    }

    private static string IconoPara(string nombre) => Path.GetExtension(nombre).ToLowerInvariant() switch
    {
        ".pdf" => "\U0001F4D5",
        ".doc" or ".docx" => "\U0001F4D8",
        ".xls" or ".xlsx" => "\U0001F4D7",
        ".ppt" or ".pptx" => "\U0001F4D9",
        ".zip" or ".rar" => "\U0001F5DC",
        ".txt" or ".log" => "\U0001F4C4",
        _ => "\U0001F4CE"
    };

    private static string FormatoTamano(long bytes)
    {
        if (bytes < 1024) { return bytes + " B"; }
        double kb = bytes / 1024.0;
        if (kb < 1024) { return kb.ToString("F1") + " KB"; }
        double mb = kb / 1024.0;
        return mb.ToString("F1") + " MB";
    }
}
