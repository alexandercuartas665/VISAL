@page "/config/alertas"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Visal.Application.Admin
@using Visal.Application.Tenancy
@using Visal.Application.Tenancy.Alertas
@using Visal.Application.Tenancy.WhatsApp
@inject IAlertaService Svc
@inject IHsmTemplateService HsmSvc
@inject IInformeTerapiasService InformeSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Alertas - Visal</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Configuracion del Sistema</div>
        <h1 class="ase-title">Alertas automaticas</h1>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="AbrirInformeTerapias" title="Abre el informe de pacientes pendientes por terapias en una pestana nueva">
            Informe terapias
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="CopiarInformeTerapias" title="Copia el enlace publico del informe para pegarlo en un mensaje">
            Copiar enlace informe
        </button>
        <button class="btn btn-outline-primary btn-sm" @onclick="EjecutarAhora" disabled="@_busy">
            @(_busy ? "Ejecutando..." : "Ejecutar ahora")
        </button>
        <button class="btn btn-primary btn-sm" @onclick="NuevaRegla">+ Nueva regla</button>
    </div>
</div>

@if (_msg is not null) { <div class="ase-ok">@_msg</div> }
@if (_error is not null) { <div class="ase-alert">@_error</div> }

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-sm @(_tab == "reglas" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _tab = "reglas"'>Reglas</button>
    <button class="btn btn-sm @(_tab == "bandeja" ? "btn-primary" : "btn-outline-secondary")" @onclick="AbrirBandeja">Bandeja de alertas</button>
    <button class="btn btn-sm @(_tab == "control" ? "btn-primary" : "btn-outline-secondary")" @onclick="AbrirControl">Control de lectura</button>
</div>

@if (_tab == "reglas")
{
<div class="ase-card">
    <div class="ase-card-h">Reglas configuradas</div>
    <div class="ase-card-body">
        <p class="text-muted small">
            Cada regla revisa las asignaciones y, cuando se cumple la condicion y el disparo,
            envia una alerta al destinatario por correo o WhatsApp. Se ejecuta automaticamente
            una vez al dia; usa <b>Ejecutar ahora</b> para probar sin esperar.
        </p>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Condicion</th>
                        <th>Disparo</th>
                        <th>Destinatario</th>
                        <th>Canal</th>
                        <th class="text-center">Activa</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_reglas.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted p-3">Sin reglas. Crea la primera con "+ Nueva regla".</td></tr>
                    }
                    @foreach (var r in _reglas)
                    {
                        <tr>
                            <td>
                                <b>@r.Nombre</b>
                                @if (!string.IsNullOrWhiteSpace(r.FiltroModulo))
                                {
                                    <div class="small text-muted">Servicios: @r.FiltroModulo</div>
                                }
                            </td>
                            <td>@CondicionTxt(r.Condicion)</td>
                            <td class="small">@DisparoTxt(r)</td>
                            <td class="small">@DestinatarioTxt(r)</td>
                            <td>@(r.Canal == AlertaCanal.Correo ? "Correo" : "WhatsApp")</td>
                            <td class="text-center">
                                <input type="checkbox" checked="@r.Activa" @onchange="e => ToggleActiva(r, (bool)e.Value!)" />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(r)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(r)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
}

@if (_tab == "bandeja")
{
<div class="ase-card">
    <div class="ase-card-h">Bandeja de alertas emitidas</div>
    <div class="ase-card-body">
        <p class="text-muted small">
            Tarjetas de las alertas que se dispararon (correo/WhatsApp). Marca cada una
            como <b>Atendida</b> o <b>Descartada</b> a medida que las gestionas.
        </p>
        @if (_envios.Count == 0)
        {
            <div class="text-muted p-3">Aun no hay alertas emitidas. Usa "Ejecutar ahora" en Reglas para generar.</div>
        }
        else
        {
            <div class="alertas-cards">
                @foreach (var e in _envios)
                {
                    <div class="alerta-card @(e.EstadoGestion == AlertaGestion.Atendida ? "is-atendida" : e.EstadoGestion == AlertaGestion.Descartada ? "is-descartada" : "")">
                        <div class="alerta-card-h">
                            <span class="alerta-card-regla">@e.ReglaNombre</span>
                            <span class="alerta-card-estado alerta-@e.EstadoGestion.ToString().ToLower()">@GestionTxt(e.EstadoGestion)</span>
                        </div>
                        <div class="alerta-card-pac">@e.PacienteNombre</div>
                        <div class="alerta-card-meta">
                            <span>@(e.Canal == AlertaCanal.Correo ? "&#9993; Correo" : "&#128241; WhatsApp")</span>
                            @if (!string.IsNullOrWhiteSpace(e.Contacto)) { <span>&middot; @e.Contacto</span> }
                            <span>&middot; @e.FechaEnvio.LocalDateTime.ToString("dd/MM/yy HH:mm")</span>
                            @if (e.Exito) { <span class="alerta-ok">&middot; enviada</span> } else { <span class="alerta-err" title="@e.Error">&middot; error</span> }
                        </div>
                        @if (!e.Exito && !string.IsNullOrWhiteSpace(e.Error)) { <div class="alerta-card-error">@e.Error</div> }
                        <div class="alerta-card-acts">
                            @if (e.EstadoGestion != AlertaGestion.Atendida)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => Gestionar(e, AlertaGestion.Atendida)">Atendida</button>
                            }
                            @if (e.EstadoGestion != AlertaGestion.Descartada)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Gestionar(e, AlertaGestion.Descartada)">Descartar</button>
                            }
                            @if (e.EstadoGestion != AlertaGestion.Nueva)
                            {
                                <button class="btn btn-sm btn-link" @onclick="() => Gestionar(e, AlertaGestion.Nueva)">Reabrir</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
}

@if (_tab == "control")
{
<div class="ase-card">
    <div class="ase-card-h">Control de lectura del informe</div>
    <div class="ase-card-body">
        <p class="text-muted small">
            Cruza los doctores a los que se les <b>envio</b> la alerta del informe en el periodo
            contra quienes <b>abrieron</b> su enlace. Asi sabes quien consume el informe y quien no.
            La alerta de control (condicion "doctores que no leen") manda este resumen a gerencia.
        </p>
        <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
            <div>
                <label class="form-label small fw-bold mb-0">Periodo <span class="text-muted fw-normal">(AAAA-MM)</span></label>
                <input type="text" class="form-control form-control-sm" @bind="_controlPeriodo" placeholder="2026-09" style="max-width:170px" />
            </div>
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadControl" disabled="@_controlBusy">
                @(_controlBusy ? "Cargando..." : "Actualizar")
            </button>
        </div>

        @if (_controlError is not null) { <div class="ase-alert small">@_controlError</div> }

        @if (_control is not null)
        {
            @if (_control.TotalDoctores == 0)
            {
                <div class="text-muted p-3">
                    No hay envios a doctores registrados en <b>@_control.Periodo</b>. Ejecuta alertas de
                    doctor (WhatsApp) en este periodo para empezar a medir la lectura.
                </div>
            }
            else
            {
                <div class="ctrl-top">
                    <svg viewBox="0 0 140 140" width="132" height="132" aria-hidden="true">
                        <circle cx="70" cy="70" r="54" fill="none" stroke="#e2e8f0" stroke-width="16"></circle>
                        <circle cx="70" cy="70" r="54" fill="none" stroke="#16a34a" stroke-width="16"
                                stroke-dasharray="@_dashCons" stroke-dashoffset="0" transform="rotate(-90 70 70)"></circle>
                        <circle cx="70" cy="70" r="54" fill="none" stroke="#dc2626" stroke-width="16"
                                stroke-dasharray="@_dashNo" stroke-dashoffset="@_offNo" transform="rotate(-90 70 70)"></circle>
                        <text x="70" y="66" text-anchor="middle" font-size="24" font-weight="700" fill="#0f172a">@_pctCons%</text>
                        <text x="70" y="88" text-anchor="middle" font-size="11" fill="#64748b">leyeron</text>
                    </svg>
                    <div class="ctrl-legend">
                        <div><span class="ctrl-dot" style="background:#16a34a"></span> Consumieron: <b>@_control.Consumieron</b></div>
                        <div><span class="ctrl-dot" style="background:#dc2626"></span> No leyeron: <b>@_control.NoLeyeron</b></div>
                        <div class="text-muted small mt-1">Doctores notificados: <b>@_control.TotalDoctores</b> &middot; periodo @_control.Periodo</div>
                    </div>
                </div>

                <div class="ctrl-grid">
                    @* --- Mini-reporte: Consumieron --- *@
                    <div class="ctrl-mini">
                        <div class="ctrl-mini-h ctrl-mini-g">Consumieron (@_control.Consumieron)</div>
                        @if (_control.Consumieron == 0)
                        {
                            <div class="text-muted small p-2">Ningun doctor abrio su enlace en el periodo.</div>
                        }
                        else
                        {
                            <div class="ctrl-bars">
                                @foreach (var d in _control.ListaConsumieron.Take(8))
                                {
                                    <div class="bar-row">
                                        <span class="bar-lbl" title="@d.Nombre">@Corto(d.Nombre)</span>
                                        <span class="bar-track"><span class="bar-fill" style="width:@Pct(d.Aperturas, _maxAp)%;background:#16a34a"></span></span>
                                        <span class="bar-val">@d.Aperturas</span>
                                    </div>
                                }
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th>Doctor</th><th class="text-center">Aperturas</th><th>Ultima</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in _control.ListaConsumieron)
                                        {
                                            <tr>
                                                <td>@d.Nombre</td>
                                                <td class="text-center">@d.Aperturas</td>
                                                <td>@(d.UltimaApertura is { } u ? u.LocalDateTime.ToString("dd/MM HH:mm") : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    @* --- Mini-reporte: No leyeron --- *@
                    <div class="ctrl-mini">
                        <div class="ctrl-mini-h ctrl-mini-r">No leyeron (@_control.NoLeyeron)</div>
                        @if (_control.NoLeyeron == 0)
                        {
                            <div class="text-muted small p-2">Todos los doctores notificados abrieron su enlace. &#10003;</div>
                        }
                        else
                        {
                            <div class="ctrl-bars">
                                @foreach (var d in _control.ListaNoLeyeron.Take(8))
                                {
                                    <div class="bar-row">
                                        <span class="bar-lbl" title="@d.Nombre">@Corto(d.Nombre)</span>
                                        <span class="bar-track"><span class="bar-fill" style="width:@Pct(d.Enviados, _maxEn)%;background:#dc2626"></span></span>
                                        <span class="bar-val">@d.Enviados</span>
                                    </div>
                                }
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th>Doctor</th><th>Celular</th><th class="text-center">Envios</th><th>Ultimo envio</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in _control.ListaNoLeyeron)
                                        {
                                            <tr>
                                                <td>@d.Nombre</td>
                                                <td>@(string.IsNullOrWhiteSpace(d.Celular) ? "-" : d.Celular)</td>
                                                <td class="text-center">@d.Enviados</td>
                                                <td>@(d.UltimoEnvio is { } ue ? ue.LocalDateTime.ToString("dd/MM/yyyy") : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
}

@if (_form is not null)
{
    <div class="al-backdrop" @onclick="() => _form = null"></div>
    <div class="al-modal">
        <div class="al-modal-h">
            <h3>@(_form.Id is null ? "Nueva regla" : "Editar regla")</h3>
            <button class="al-modal-close" @onclick="() => _form = null">&times;</button>
        </div>
        <div class="al-modal-body">
            <div class="al-tabs">
                <button class="al-tab @(_modalTab == "config" ? "is-active" : "")" @onclick='() => _modalTab = "config"'>Configuracion</button>
                <button class="al-tab @(_modalTab == "sim" ? "is-active" : "")" @onclick="AbrirSimulacion">Simulacion</button>
            </div>

            @if (_modalTab == "config")
            {
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small fw-bold">Nombre</label>
                    <input class="form-control form-control-sm" @bind="_form.Nombre" placeholder="Ej: Recordatorio sesiones pendientes" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Activa</label>
                    <div><label class="asg-chk"><input type="checkbox" @bind="_form.Activa" /> <span>Regla activa</span></label></div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Condicion</label>
                    <select class="form-select form-select-sm" @bind="_form.Condicion" @bind:after="OnCondicionChanged">
                        <option value="@AlertaCondicion.SesionPendiente">Paciente con sesion pendiente</option>
                        <option value="@AlertaCondicion.AtencionesTerminadas">Paciente con todas las atenciones terminadas</option>
                        <option value="@AlertaCondicion.InformeNoLeido">Control a gerencia: doctores que no leen el informe</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">
                        Filtro por servicio del contrato
                        <span class="text-muted fw-normal">(opcional; vacio = todos)</span>
                    </label>
                    @if (_servicios.Count == 0)
                    {
                        <div class="text-muted small border rounded p-2">
                            No hay servicios cargados en los contratos. Configuralos en
                            <b>Entidades Aseguradoras</b>.
                        </div>
                    }
                    else
                    {
                        @if (_form.FiltroModulos.Count > 0)
                        {
                            <div class="al-chips">
                                @foreach (var code in _form.FiltroModulos)
                                {
                                    var c = code;
                                    <span class="al-chip" title="@DescServicio(c)">
                                        <span class="mono fw-bold">@c</span>
                                        <span class="al-chip-desc">@DescServicio(c)</span>
                                        <button type="button" class="al-chip-x" @onclick="() => QuitarServicio(c)" aria-label="Quitar">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                        <div class="al-ac">
                            <input class="form-control form-control-sm" autocomplete="off"
                                   placeholder="Escribe codigo o descripcion para agregar..."
                                   @bind="_busqSvc" @bind:event="oninput" />
                            @{ var _sug = Sugerencias(); }
                            @if (!string.IsNullOrWhiteSpace(_busqSvc))
                            {
                                <div class="al-ac-list">
                                    @if (_sug.Count == 0)
                                    {
                                        <div class="al-ac-empty">Sin coincidencias para "@_busqSvc".</div>
                                    }
                                    else
                                    {
                                        @foreach (var s in _sug)
                                        {
                                            var code = s.Codigo;
                                            <button type="button" class="al-ac-item" @onclick="() => AgregarServicio(code)">
                                                <span class="mono fw-bold">@s.Codigo</span> <span class="text-muted">@s.Descripcion</span>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <div class="small text-muted mt-1">@SeleccionTxt()</div>
                    }
                </div>

                @* ---- Disparo ---- *@
                <div class="col-12"><hr class="my-1" /><span class="small fw-bold text-uppercase text-muted">Cuando disparar</span></div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Tipo de disparo</label>
                    <select class="form-select form-select-sm" @bind="_form.DisparoTipo">
                        <option value="@AlertaDisparoTipo.DiasDelMes">Dias fijos del mes</option>
                        <option value="@AlertaDisparoTipo.MesesDespues">N meses despues</option>
                    </select>
                </div>
                @if (_form.DisparoTipo == AlertaDisparoTipo.DiasDelMes)
                {
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Dias del mes (separados por coma)</label>
                        <input class="form-control form-control-sm" @bind="_form.DiasDelMes" placeholder="15,16,17" />
                    </div>
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Meses despues</label>
                        <input type="number" class="form-control form-control-sm" @bind="_form.MesesDespues" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Contados desde</label>
                        <select class="form-select form-select-sm" @bind="_form.Ancla">
                            <option value="@AlertaAnclaRelativa.UltimaAtencion">La ultima atencion</option>
                            <option value="@AlertaAnclaRelativa.FinAsignacion">El fin de la asignacion</option>
                        </select>
                    </div>
                }

                @* ---- Destinatario ---- *@
                <div class="col-12"><hr class="my-1" /><span class="small fw-bold text-uppercase text-muted">A quien</span></div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Destinatario</label>
                    <select class="form-select form-select-sm" @bind="_form.Destinatario">
                        <option value="@AlertaDestinatario.Paciente">El paciente</option>
                        <option value="@AlertaDestinatario.DoctorAtendio">El doctor que atendio</option>
                        <option value="@AlertaDestinatario.UsuarioSistema">Un usuario del sistema</option>
                    </select>
                </div>
                @if (_form.Destinatario == AlertaDestinatario.UsuarioSistema)
                {
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Usuario</label>
                        <select class="form-select form-select-sm" @bind="_form.UsuarioSel">
                            <option value="">-- elige --</option>
                            @foreach (var u in _usuarios)
                            {
                                <option value="@u.Id">@u.Nombre</option>
                            }
                        </select>
                    </div>
                }

                @* ---- Canal ---- *@
                <div class="col-12"><hr class="my-1" /><span class="small fw-bold text-uppercase text-muted">Como</span></div>
                @if (_form.Condicion == AlertaCondicion.InformeNoLeido)
                {
                    <div class="col-12">
                        <div class="alert alert-info py-2 px-3 small mb-0">
                            <b>Control a gerencia.</b> Se envia por <b>correo</b> al usuario de gerencia elegido arriba;
                            el cuerpo (doctores que no leyeron su informe + resumen) se genera automaticamente en cada
                            corrida. Configura el <b>disparo</b> (dias del mes) para decidir cuando se manda.
                        </div>
                    </div>
                }
                else
                {
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Canal</label>
                    <select class="form-select form-select-sm" @bind="_form.Canal">
                        <option value="@AlertaCanal.Correo">Correo</option>
                        <option value="@AlertaCanal.WhatsApp">WhatsApp (plantilla HSM)</option>
                    </select>
                </div>

                @if (_form.Canal == AlertaCanal.Correo)
                {
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Asunto</label>
                        <input class="form-control form-control-sm" @bind="_form.Asunto" placeholder="Ej: Recordatorio de {servicio}" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Cuerpo del correo</label>
                        <textarea class="form-control form-control-sm" rows="5" @bind="_form.Cuerpo"
                                  placeholder="Hola {paciente}, tienes pendiente {servicio}..."></textarea>
                    </div>
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Linea WhatsApp (Gupshup)</label>
                        <select class="form-select form-select-sm" @bind="_form.LineaSel">
                            <option value="">-- elige --</option>
                            @foreach (var l in _lineas)
                            {
                                <option value="@l.Id">@l.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CargarPlantillas" disabled="@(string.IsNullOrEmpty(_form.LineaSel) || _cargandoPlantillas)">
                            @(_cargandoPlantillas ? "Cargando..." : "Cargar plantillas")
                        </button>
                    </div>
                    @if (_plantillas.Count > 0)
                    {
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Plantilla HSM</label>
                            <select class="form-select form-select-sm" @bind="_form.TemplateSel" @bind:after="OnTemplateChanged">
                                <option value="">-- elige --</option>
                                @foreach (var t in _plantillas)
                                {
                                    <option value="@t.Id">@t.ElementName (@t.Status, @t.ParameterCount par.)</option>
                                }
                            </select>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_form.HsmTemplateId))
                    {
                        <div class="col-12">
                            <label class="form-label small fw-bold">
                                Parametros de la plantilla (@_form.HsmParameterCount) — token por cada {{n}}
                            </label>
                            @for (int i = 0; i < _form.HsmParametros.Count; i++)
                            {
                                var idx = i;
                                <div class="input-group input-group-sm mb-1" style="max-width:520px">
                                    <span class="input-group-text">{{@(idx + 1)}}</span>
                                    <input class="form-control" @bind="_form.HsmParametros[idx]" placeholder="Ej: {paciente}" />
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">
                                URL imagen de encabezado <span class="text-muted fw-normal">(header multimedia; requerido si la plantilla lleva imagen)</span>
                            </label>
                            <input class="form-control form-control-sm" @bind="_form.HsmHeaderUrl" style="max-width:640px"
                                   placeholder="https://.../logo.png" />
                            <div class="form-text small">
                                Se autollena con el header detectado de la plantilla. Gupshup exige reenviar este link
                                en cada envio; sin el, Meta marca "enviada" pero no entrega. Dejalo vacio si la plantilla no tiene imagen.
                            </div>
                        </div>
                    }
                }

                <div class="col-12">
                    <div class="alert alert-secondary py-2 px-3 small mb-0">
                        <b>Tokens disponibles:</b> {paciente}, {documento}, {servicio}, {contrato}, {cantidad},
                        {doctor}, {fecha}, {fecha_inicio}, {fecha_fin}, {ultima_atencion}
                    </div>
                </div>
                }
            </div>
            }

            @if (_modalTab == "sim")
            {
                <div class="sim-wrap">
                    <p class="text-muted small mb-2">
                        Simula una fecha y prueba la consulta del sistema: <b>Paso 1</b> muestra que pacientes
                        traeria la regla y a quien se emitiria (sin enviar), con el <b>enlace del informe</b> de cada
                        doctor para que lo abras y verifiques. Marca en la columna izquierda a quien quieras enviar.
                        <b>Paso 2</b> emite de verdad solo a los <b>marcados</b>. Usa la configuracion actual de la
                        pestana <b>Configuracion</b>.
                    </p>
                    <div class="d-flex flex-wrap align-items-end gap-2 mb-2">
                        <div>
                            <label class="form-label small fw-bold mb-0">Fecha a simular</label>
                            <input type="date" class="form-control form-control-sm" @bind="_simFecha" style="max-width:190px" />
                        </div>
                        <div>
                            <label class="form-label small fw-bold mb-0">Telefono de prueba <span class="text-muted fw-normal">(opcional, WhatsApp)</span></label>
                            <input class="form-control form-control-sm" @bind="_simTelefono" placeholder="Ej: 3217626882" style="max-width:200px" />
                        </div>
                        <button class="btn btn-outline-primary btn-sm" @onclick="SimularVer" disabled="@_simBusy">
                            @(_simBusy ? "Consultando..." : "1. Ver a quien emitiria")
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="SimularEmitir" disabled="@(_simBusy || _form.Id is null)"
                                title="@(_form.Id is null ? "Guarda la regla primero para poder emitir" : "Envia realmente a los destinatarios")">
                            @(_simBusy ? "Emitiendo..." : "2. Emitir ahora (real)")
                        </button>
                    </div>
                    <div class="mb-2">
                        <label class="asg-chk small"><input type="checkbox" @bind="_simForzar" /> <span>Reenviar aunque ya se haya enviado este periodo (ignora deduplicacion)</span></label>
                    </div>
                    @if (_form.Id is null)
                    {
                        <div class="small text-muted mb-2">Para el paso 2 (emitir) primero guarda la regla en la pestana Configuracion.</div>
                    }

                    @if (_simError is not null) { <div class="ase-alert small">@_simError</div> }

                    @if (_sim is not null)
                    {
                        @if (!string.IsNullOrEmpty(_sim.Aviso)) { <div class="alert alert-warning py-2 px-3 small">@_sim.Aviso</div> }
                        <div class="sim-totals small">
                            <span>Fecha: <b>@_sim.Fecha.ToString("dd/MM/yyyy")</b></span>
                            <span>Coinciden: <b>@_sim.Coinciden</b></span>
                            <span>Se emitirian: <b>@_sim.Emitibles</b></span>
                            @if (_sim.SinContacto > 0) { <span class="text-danger">Sin contacto: <b>@_sim.SinContacto</b></span> }
                            @if (_sim.YaEnviadas > 0) { <span>Ya enviadas: <b>@_sim.YaEnviadas</b></span> }
                            @if (_sim.Emitido) { <span class="text-success">Enviadas: <b>@_sim.Enviadas</b></span> }
                            @if (_sim.Emitido && _sim.Errores > 0) { <span class="text-danger">Errores: <b>@_sim.Errores</b></span> }
                        </div>

                        @if (_sim.Filas.Count == 0)
                        {
                            <div class="text-muted small p-2">Sin candidatos para esta fecha.</div>
                        }
                        else
                        {
                            <div class="table-responsive sim-table">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:34px" title="Seleccionar a quien emitir en el Paso 2">
                                                <input type="checkbox" checked="@TodosSeleccionados()" @onchange="ToggleSeleccionarTodos" />
                                            </th>
                                            <th>Paciente</th>
                                            <th>Servicio</th>
                                            <th>Destinatario</th>
                                            <th>Correo</th>
                                            <th>Telefono</th>
                                            <th>Informe</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in _sim.Filas)
                                        {
                                            <tr>
                                                <td>
                                                    @if (f.AsignacionId != Guid.Empty)
                                                    {
                                                        <input type="checkbox" checked="@_seleccion.Contains(f.AsignacionId)"
                                                               @onchange="e => ToggleFila(f.AsignacionId, (bool)(e.Value ?? false))" />
                                                    }
                                                </td>
                                                <td>@f.Paciente<div class="text-muted xsmall">@f.Documento</div></td>
                                                <td>@f.Servicio<div class="text-muted xsmall mono">@f.CodigoServicio</div></td>
                                                <td>@f.DestinatarioTipo<div class="text-muted xsmall">@f.DestinatarioNombre</div></td>
                                                <td class="@(string.IsNullOrEmpty(f.Correo) ? "text-muted" : "")">@(string.IsNullOrEmpty(f.Correo) ? "—" : f.Correo)</td>
                                                <td class="@(string.IsNullOrEmpty(f.Telefono) ? "text-muted" : "")">@(string.IsNullOrEmpty(f.Telefono) ? "—" : f.Telefono)</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(f.InformeUrl))
                                                    {
                                                        <a href="@f.InformeUrl" target="_blank" rel="noopener" class="xsmall">Abrir informe</a>
                                                    }
                                                    else { <span class="text-muted">—</span> }
                                                </td>
                                                <td><span class="sim-estado @SimEstadoClass(f)">@f.Estado</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            }

            <div class="d-flex gap-2 mt-3">
                @if (_modalTab == "config")
                {
                    <button class="btn btn-primary btn-sm" @onclick="Guardar" disabled="@_busy">Guardar regla</button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _form = null">Cerrar</button>
            </div>
        </div>
    </div>
}

