.ep-res-Error { background:#fef2f2; color:#b91c1c; }
.ep-res-Duplicado { background:#fef9c3; color:#854d0e; }
.ep-res-SinConfig { background:#fef2f2; color:#b91c1c; }
.ep-toast { position:fixed; bottom:1.25rem; left:50%; transform:translateX(-50%); padding:.55rem 1rem; border-radius:8px; font-size:.85rem; z-index:1500; box-shadow:0 6px 20px rgba(0,0,0,.15); max-width:90vw; }
.ep-toast-ok { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.ep-toast-err { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
.ep-num { text-align:right; font-variant-numeric:tabular-nums; color:#334155; }
.ep-chips { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.4rem; }
