    private void Abrir(Guid id)
    {
        _openId = id;
        _msg = string.Empty;
        var it = _items.First(x => x.Id == id);
        _edit = new EditForm
        {
            FechaLlamada = it.FechaLlamada ?? DateTime.Now,
            Pregunta1 = it.Pregunta1,
            Pregunta2 = it.Pregunta2,
            Pregunta3 = it.Pregunta3,
            Pregunta4 = it.Pregunta4,
            Pregunta5 = it.Pregunta5,
            PersonaAtiende = it.PersonaAtiende,
            Observaciones = it.Observaciones
        };
    }

    private void Cerrar()
    {
        _openId = null;
        _msg = string.Empty;
    }

    private int? GetPregunta(int idx) => idx switch
    {
        1 => _edit.Pregunta1,
        2 => _edit.Pregunta2,
        3 => _edit.Pregunta3,
        4 => _edit.Pregunta4,
        5 => _edit.Pregunta5,
        _ => null
    };

    private void SetPregunta(int idx, int? val)
    {
        switch (idx)
        {
            case 1: _edit.Pregunta1 = val; break;
            case 2: _edit.Pregunta2 = val; break;
            case 3: _edit.Pregunta3 = val; break;
            case 4: _edit.Pregunta4 = val; break;
            case 5: _edit.Pregunta5 = val; break;
        }
    }

    private async Task Guardar()
    {
        if (_openId is not Guid id) { return; }
        try
        {
            var req = new GuardarEncuestaRequest(
                _edit.FechaLlamada, _edit.Pregunta1, _edit.Pregunta2,
                _edit.Pregunta3, _edit.Pregunta4, _edit.Pregunta5,
                _edit.PersonaAtiende, _edit.Observaciones);
            var ok = await SegSvc.GuardarEncuestaAsync(id, req, Guid.Empty);
            if (ok)
            {
                _msg = "Encuesta guardada.";
                Cerrar();
                await RecargarAsync();
            }
        }
        catch (Exception ex)
        {
            _msg = "Error al guardar: " + ex.Message;
        }
    }

    private async Task MarcarNoContactado()
    {
        if (_openId is not Guid id) { return; }
        try
        {
            await SegSvc.CambiarEstadoAsync(id, "NoContactado", Guid.Empty);
            Cerrar();
            await RecargarAsync();
        }
        catch (Exception ex) { _msg = "Error: " + ex.Message; }
    }

    private static string FormatoMes(int mes)
    {
        var y = mes / 100;
        var m = mes % 100;
        return $"{m:00}/{y}";
    }

    // === Navegacion y mover columna kanban desde el modal ===

    private (int Pos, int Total, bool HasPrev, bool HasNext) NavContext(SeguimientoEncuestaDto cur)
    {
        var lista = _items
            .OrderBy(x => x.Estado == "Pendiente" ? 0 : x.Estado == "NoContactado" ? 1 : 2)
            .ThenBy(x => x.PacienteNombre)
            .ToList();
        var pos = lista.FindIndex(x => x.Id == cur.Id);
        return (pos, lista.Count, pos > 0, pos >= 0 && pos < lista.Count - 1);
    }

    private async Task NavAsync(int delta)
    {
        if (_openId is not Guid id) { return; }
        var cur = _items.FirstOrDefault(x => x.Id == id);
        if (cur is null) { return; }
        var nav = NavContext(cur);
        if (delta < 0 && !nav.HasPrev) { return; }
        if (delta > 0 && !nav.HasNext) { return; }
        var lista = _items
            .OrderBy(x => x.Estado == "Pendiente" ? 0 : x.Estado == "NoContactado" ? 1 : 2)
            .ThenBy(x => x.PacienteNombre)
            .ToList();
        var next = lista[nav.Pos + delta];
        Abrir(next.Id);
        await Task.CompletedTask;
    }

    // === Drag & drop entre columnas kanban ===

    private void OnDragStart(Guid id)
    {
        _dragId = id;
        _ = JS.InvokeVoidAsync("visalDragAllow.enable");
    }

    private void OnDragEnd()
    {
        _dragId = null;
        _dragOverCol = null;
        _ = JS.InvokeVoidAsync("visalDragAllow.disable");
    }

    private void OnDragEnterCol(string estado) { _dragOverCol = estado; }
    private void OnDragLeaveCol(string estado)
    {
        if (_dragOverCol == estado) { _dragOverCol = null; }
    }

    private async Task OnDropCol(string estadoDestino)
    {
        _dragOverCol = null;
        if (_dragId is not Guid id) { return; }
        var dragId = id; _dragId = null;
        _ = JS.InvokeVoidAsync("visalDragAllow.disable");
        var cur = _items.FirstOrDefault(x => x.Id == dragId);
        if (cur is null || cur.Estado == estadoDestino) { return; }
        try
        {
            await SegSvc.CambiarEstadoAsync(dragId, estadoDestino, Guid.Empty);
            await RecargarAsync();
        }
        catch (Exception ex) { _msg = "Error al mover: " + ex.Message; }
    }

    // === Filtro dias en columna Realizada ===

    private void OnDiasRealizadaChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) { _diasRealizada = n; }
    }

    // === Tab Historial: todas las Realizadas del tenant ===

    private void OnHistFiltroInput(ChangeEventArgs e)
    {
        _histFiltro = e.Value?.ToString() ?? "";
    }

    private IEnumerable<SeguimientoEncuestaDto> FiltrarHistorial()
    {
        if (!_histCargado) { _ = RecargarHistorialAsync(); return Enumerable.Empty<SeguimientoEncuestaDto>(); }
        var q = _historial.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_histFiltro))
        {
            var f = _histFiltro.Trim().ToLowerInvariant();
            q = q.Where(x =>
                (x.PacienteNombre ?? "").ToLowerInvariant().Contains(f) ||
                (x.PacienteDocumento ?? "").ToLowerInvariant().Contains(f) ||
                (x.Observaciones ?? "").ToLowerInvariant().Contains(f) ||
                (x.PersonaAtiende ?? "").ToLowerInvariant().Contains(f));
        }
        return q.OrderByDescending(x => x.FechaLlamada ?? DateTime.MinValue);
    }

    private async Task RecargarHistorialAsync()
    {
        _histLoading = true;
        StateHasChanged();
        try
        {
            _historial = (await SegSvc.ListarHistorialRealizadasAsync()).ToList();
            _histCargado = true;
        }
        catch (Exception ex) { _msg = "Error historial: " + ex.Message; }
        finally { _histLoading = false; StateHasChanged(); }
    }

    private void VerHistorialItem(SeguimientoEncuestaDto h)
    {
        // Abre el modal Kanban con este id. Si no esta en _items (por ser de otro mes),
        // lo agregamos temporalmente para que Abrir funcione.
        if (!_items.Any(x => x.Id == h.Id)) { _items.Add(h); }
        _tab = "kanban";
        Abrir(h.Id);
    }

    private async Task OnMoverEstadoAsync(ChangeEventArgs e)
    {
        if (_openId is not Guid id) { return; }
        var nuevo = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(nuevo)) { return; }
        try
        {
            await SegSvc.CambiarEstadoAsync(id, nuevo, Guid.Empty);
            await RecargarAsync();
            // Re-sincronizar la copia en memoria para que el modal siga abierto
            // con el estado nuevo reflejado.
            var actualizado = _items.FirstOrDefault(x => x.Id == id);
            if (actualizado is null) { Cerrar(); }
            _msg = $"Movido a {nuevo}.";
        }
        catch (Exception ex) { _msg = "Error al mover: " + ex.Message; }
    }
